function_create_superlibrarian() {
    require_database || return 0
    local branch cat_ user pass first_name surname hash exists
    esc() { printf '%s' "${1//\'/\'\'}"; }
    branch=$(run_sql "SELECT branchcode FROM ${DB_NAME}.branches LIMIT 1;")
    cat_=$(run_sql "SELECT categorycode FROM ${DB_NAME}.categories WHERE category_type='S' LIMIT 1;")
    [ -z "$cat_" ] && cat_=$(run_sql "SELECT categorycode FROM ${DB_NAME}.categories LIMIT 1;")
    if [ -z "$branch" ] || [ -z "$cat_" ]; then
        msg_error "" "$(t "There are no libraries or patron categories yet.\nFinish the Web Installer first.")" 10 74
        return 0
    fi
    user=$(whiptail --title "$(t "Username")" --inputbox "$(t "Username (login):")" 9 60 3>&1 1>&2 2>&3) || return 0
    [ -z "$user" ] && return 0
    if ! [[ "$user" =~ ^[A-Za-z0-9._-]+$ ]]; then
        msg_error "" "$(t "Use only letters, numbers, dot, hyphen or underscore.")" 8 66
        return 0
    fi
    exists=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE userid='${user}';")
    if [ "${exists:-0}" -gt 0 ] 2>/dev/null; then
        msg_error "" "$(t "User '\$user' already exists.\nUse the Koha web interface to change its password.")" 9 70
        return 0
    fi

    local cardnumber exists_card
    cardnumber=$(whiptail --title "$(t "Card Number")" --inputbox "$(t "Card number for \$user:")" 9 60 3>&1 1>&2 2>&3) || return 0
    [ -z "$cardnumber" ] && return 0
    if ! [[ "$cardnumber" =~ ^[A-Za-z0-9._-]+$ ]]; then
        msg_error "" "$(t "Use only letters, numbers, dot, hyphen or underscore.")" 8 66
        return 0
    fi

    exists_card=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE cardnumber='$(esc "$cardnumber")';")
    if [ "${exists_card:-0}" -gt 0 ] 2>/dev/null; then
        msg_error "" "$(t "Card number '\$cardnumber' is already in use by another patron. Try again with a different number.")" 10 74
        return 0
    fi

    pass=$(whiptail --title "$(t "Password")" --passwordbox "$(t "Password for \$user (at least 8 characters):")" 9 64 3>&1 1>&2 2>&3) || return 0
    [ "${#pass}" -lt 8 ] && { msg_error "" "$(t "Password too short (minimum 8 characters).")" 8 62; return 0; }
    local pass2
    pass2=$(whiptail --title "$(t "Confirm Password")" --passwordbox "$(t "Type the password again:")" 9 64 3>&1 1>&2 2>&3) || return 0
    [ "$pass" != "$pass2" ] && { msg_error "" "$(t "Passwords do not match.")" 8 60; return 0; }
    first_name=$(whiptail --title "$(t "First name")" --inputbox "$(t "First name:")" 9 60 "Super" 3>&1 1>&2 2>&3) || return 0
    surname=$(whiptail --title "$(t "Surname")" --inputbox "$(t "Surname:")" 9 60 "Admin" 3>&1 1>&2 2>&3) || return 0
    clear
    display_explanation "Hashing the password..."
    local hash_script
    hash_script=$(mktemp /tmp/koha_hash.XXXXXX) || return 1
    cat > "$hash_script" << 'EOF'
use strict; use warnings;
use Koha::AuthUtils qw(hash_password);
my $pw = <STDIN>; chomp $pw;
print hash_password($pw);
EOF
    chmod 644 "$hash_script"
    hash=$(printf '%s\n' "$pass" | /usr/sbin/koha-shell "$INSTANCE" -c "perl $hash_script" 2>/dev/null)
    rm -f "$hash_script"
    if [ -z "$hash" ]; then
        msg_error "" "$(t "Failed to hash the password.")" 8 62
        return 1
    fi
    if mysql --default-character-set=utf8mb4 "$DB_NAME" << SQLEOF 2>/dev/null
INSERT INTO borrowers (userid, cardnumber, password, surname, firstname, branchcode, categorycode, flags)
VALUES ('$(esc "$user")', '$(esc "$cardnumber")', '$(esc "$hash")', '$(esc "$surname")', '$(esc "$first_name")', '$(esc "$branch")', '$(esc "$cat_")', 1);
SQLEOF
    then
        log "super librarian created: $user (cardnumber: $cardnumber)"
        msg_ok "$(t "Super Librarian created successfully.\n\nUser: \$user\nCard: \$cardnumber\n\nKeep the password safe: it is not stored anywhere.")" 12 70
    else
        msg_error "" "$(t "Could not create the user. It may already exist or this Koha version requires more fields.\nCreate it in the web interface and tick 'Superlibrarian'.")" 11 76
    fi
}

