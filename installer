# ======================================================================
# 31. MESSAGING: WHATSAPP AND TELEGRAM (opt-in)
# ----------------------------------------------------------------------
# Koha already produces the notices (checkout, check-in, overdue, due,
# hold) and queues the "sms" ones for the SMS::Send driver named in the
# SMSSendDriver preference. The panel adds such a driver
# (SMS::Send::KohaEasy::Gateway): each message goes to Telegram when the
# patron linked the library's bot, otherwise to a WhatsApp gateway
# (Evolution API or another self-hosted one). Numbers are completed and
# corrected on the way (country and area code, 9th mobile digit). Nothing
# changes in Koha until "Send Koha notices" is chosen, and turning it off
# puts the previous driver back. Settings: kei-messaging.conf next to
# koha-conf.xml (root and the instance user only: it holds the tokens).
# ======================================================================
KEI_PERL_DIR="${KEI_PERL_DIR:-/usr/local/lib/site_perl}"
KEI_LIBEXEC="${KEI_LIBEXEC:-/usr/local/lib/koha-easy-installer}"
MSG_DRIVER="KohaEasy::Gateway"
MSG_CONF="/etc/koha/sites/${INSTANCE}/kei-messaging.conf"
MSG_DATA="/var/lib/koha/${INSTANCE}/kei-messaging"
MSG_STATE="${CONF_DIR}/messaging.state"
CRON_MSG="/etc/cron.d/koha_messaging"

# The Perl module shared by the driver, the Telegram link job and the
# phone report (one implementation of the phone rules).
msg_pm_messaging() {
    cat <<'MSGPM'
package KohaEasy::Messaging;

# koha-easy-installer: WhatsApp and Telegram delivery for Koha's notices.
# Koha hands every "sms" notice (checkout, check-in, overdue, due, hold...)
# to the SMS::Send driver named in SMSSendDriver; the driver of the panel
# (SMS::Send::KohaEasy::Gateway) calls send_message() below. Settings come
# from kei-messaging.conf next to koha-conf.xml (written by the panel).

use strict;
use warnings;
use Encode qw( decode );
use File::Basename qw( dirname );
use HTTP::Tiny;
use JSON::PP;

our $VERSION = '1';
our $LAST_CHANNEL = '';

# Brazilian area codes (DDD) in use.
my %DDD = map { $_ => 1 } qw(
    11 12 13 14 15 16 17 18 19 21 22 24 27 28 31 32 33 34 35 37 38
    41 42 43 44 45 46 47 48 49 51 53 54 55 61 62 63 64 65 66 67 68 69
    71 73 74 75 77 79 81 82 83 84 85 86 87 88 89 91 92 93 94 95 96 97 98 99
);

sub conf_path {
    return $ENV{KEI_MESSAGING_CONF} if $ENV{KEI_MESSAGING_CONF};
    return $ENV{KOHA_CONF} ? dirname( $ENV{KOHA_CONF} ) . '/kei-messaging.conf' : '';
}

# key=value lines; "\n" in a value is a line break.
sub load_conf {
    my ($path) = @_;
    $path ||= conf_path();
    open( my $fh, '<:encoding(UTF-8)', $path ) or die "kei-messaging: cannot read the settings ($path)\n";
    my %c;
    while ( my $line = <$fh> ) {
        chomp $line;
        next if $line =~ /^\s*(#|$)/;
        my ( $k, $v ) = split /=/, $line, 2;
        next unless defined $v;
        $v =~ s/\\n/\n/g;
        $c{$k} = $v;
    }
    close $fh;
    return \%c;
}

# normalize_phone(NUMBER, COUNTRY_CODE, AREA_CODE)
# Returns (E.164 number, kind) or (undef, 'invalid'). kind: "ok" (already
# complete), "fixed" (completed or corrected: country or area code added,
# trunk or carrier prefix removed, 9th mobile digit added) or "landline".
sub normalize_phone {
    my ( $raw, $cc, $area ) = @_;
    return ( undef, 'invalid' ) unless defined $raw && $raw =~ /\d/;
    $cc   = defined $cc   ? $cc   : '';
    $area = defined $area ? $area : '';
    $cc   =~ s/\D//g;
    $area =~ s/\D//g;
    $cc = '55' if $cc eq '';    # the default of the panel
    my $intl = $raw =~ /^\s*(\+|00)/ ? 1 : 0;
    ( my $d = $raw ) =~ s/\D//g;
    $d =~ s/^00// if $raw =~ /^\s*00/;
    ( my $given = $raw ) =~ s/[^\d+]//g;

    if ( $intl && $d !~ /^55/ ) {
        return ( undef, 'invalid' ) if length($d) < 8 || length($d) > 15 || $d =~ /^0/;
        return ( "+$d", $given eq "+$d" ? 'ok' : 'fixed' );
    }
    if ( $intl || $cc eq '55' ) {
        my $n = $d;
        if    ($intl)                                                                    { $n = substr( $n, 2 ) }
        elsif ( length($n) >= 12 && length($n) <= 13 && $n =~ /^55(\d\d)/ && $DDD{$1} ) { $n = substr( $n, 2 ) }
        elsif ( $n =~ /^0/ && ( length($n) == 13 || length($n) == 14 ) )               { $n = substr( $n, 3 ) }    # 0 + carrier + DDD
        elsif ( $n =~ /^0/ && ( length($n) == 11 || length($n) == 12 ) )               { $n = substr( $n, 1 ) }    # 0 + DDD
        if ( length($n) == 8 || length($n) == 9 ) {
            return ( undef, 'invalid' ) unless $DDD{$area};
            $n = $area . $n;
        }
        return ( undef, 'invalid' ) unless length($n) == 10 || length($n) == 11;
        my ( $ddd, $local ) = ( substr( $n, 0, 2 ), substr( $n, 2 ) );
        return ( undef, 'invalid' ) unless $DDD{$ddd};
        my $kind = '';
        if ( length($local) == 9 ) {
            return ( undef, 'invalid' ) unless $local =~ /^9/;
        } elsif ( $local =~ /^[6-9]/ ) {
            $local = "9$local";    # mobile numbers have 9 digits since 2016
        } elsif ( $local =~ /^[2-5]/ ) {
            $kind = 'landline';
        } else {
            return ( undef, 'invalid' );
        }
        my $e164 = "+55$ddd$local";
        return ( $e164, $kind || ( $given eq $e164 ? 'ok' : 'fixed' ) );
    }

    # Other countries: international prefix or trunk zero, then the country code.
    return ( undef, 'invalid' ) if $cc eq '';
    my $n = $d;
    if ( $n =~ /^\Q$cc\E/ && length($n) - length($cc) >= 7 ) {
        $n = substr( $n, length($cc) );
    } else {
        $n =~ s/^0+//;
        $n = $area . $n if $area ne '' && length($n) <= 8;
    }
    my $e164 = "+$cc$n";
    return ( undef, 'invalid' ) if length($e164) < 9 || length($e164) > 16;
    return ( $e164, $given eq $e164 ? 'ok' : 'fixed' );
}

sub _post_json {
    my ( $c, $url, $headers, $body ) = @_;
    my $http = HTTP::Tiny->new( timeout => $c->{timeout} || 15, verify_SSL => 1, agent => "koha-easy-installer/$VERSION" );
    my $res  = $http->request(
        'POST', $url,
        {
            headers => { 'Content-Type' => 'application/json', %$headers },
            content => JSON::PP->new->utf8->canonical->encode($body),
        }
    );
    my $data = eval { JSON::PP->new->utf8->decode( $res->{content} // '' ) };
    return ( $res, $data );
}

sub _short { my $s = shift // ''; $s =~ s/\s+/ /g; $s =~ s/ at \S+ line \d+\.?//g; return substr( $s, 0, 200 ) }

sub send_whatsapp {
    my ( $c, $e164, $text ) = @_;
    ( my $number = $e164 ) =~ s/^\+//;
    my $url = $c->{wa_url} // '';
    $url =~ s{/+$}{};
    return ( 0, 'WhatsApp: gateway address missing' ) unless $url =~ m{^https?://};
    my ( $res, $data );
    if ( ( $c->{wa_type} // 'evolution' ) eq 'evolution' ) {
        # Evolution API v2: POST /message/sendText/{instance}, header apikey.
        ( $res, $data ) = _post_json( $c, "$url/message/sendText/" . ( $c->{wa_instance} // '' ),
            { apikey => $c->{wa_token} // '' }, { number => $number, text => $text } );
    } else {
        # Other gateways (Baileys-based and similar): one documented JSON body.
        ( $res, $data ) = _post_json( $c, $url, { Authorization => 'Bearer ' . ( $c->{wa_token} // '' ) },
            { number => $number, to => $e164, text => $text } );
    }
    return ( 1, 'whatsapp' ) if $res->{success};
    return ( 0, "WhatsApp: HTTP $res->{status} " . _short( $res->{content} ) );
}

sub telegram_map_path { my ($c) = @_; return ( $c->{data_dir} || '.' ) . '/telegram.map' }

sub telegram_map {
    my ($c) = @_;
    my %m;
    if ( open( my $fh, '<', telegram_map_path($c) ) ) {
        while (<$fh>) { $m{$1} = $2 if /^(\+\d+)\s+(-?\d+)$/ }
        close $fh;
    }
    return \%m;
}

sub _write_atomic {
    my ( $path, $content ) = @_;
    my $tmp = "$path.tmp$$";
    open( my $fh, '>', $tmp ) or die "kei-messaging: cannot write $tmp\n";
    print {$fh} $content;
    close($fh) or die "kei-messaging: cannot write $tmp\n";
    chmod 0640, $tmp;
    rename( $tmp, $path ) or die "kei-messaging: cannot replace $path\n";
    return 1;
}

sub telegram_map_save {
    my ( $c, $m ) = @_;
    return _write_atomic( telegram_map_path($c), join( '', map { "$_ $m->{$_}\n" } sort keys %$m ) );
}

sub telegram_call {
    my ( $c, $method, $body ) = @_;
    my $api = $c->{tg_api} || 'https://api.telegram.org';
    $api =~ s{/+$}{};
    my ( $res, $data ) = _post_json( $c, "$api/bot" . ( $c->{tg_token} // '' ) . "/$method", {}, $body || {} );
    return $data if $res->{success} && ref $data eq 'HASH' && $data->{ok};
    die 'Telegram: HTTP ' . $res->{status} . ' ' . _short( ref $data eq 'HASH' ? $data->{description} : $res->{content} ) . "\n";
}

sub send_telegram {
    my ( $c, $e164, $text ) = @_;
    my $chat = telegram_map($c)->{$e164};
    return ( 0, 'Telegram: number not linked to the bot' ) unless defined $chat;
    my $ok = eval { telegram_call( $c, 'sendMessage', { chat_id => $chat + 0, text => $text } ); 1 };
    return $ok ? ( 1, 'telegram' ) : ( 0, _short($@) );
}

# send_message(CONF, NUMBER, TEXT): Telegram when the patron linked the bot,
# otherwise WhatsApp. Returns (1, channel) or (0, reason).
sub send_message {
    my ( $c, $to, $text ) = @_;
    $LAST_CHANNEL = '';
    my ($e164) = normalize_phone( $to, $c->{country}, $c->{area} );
    return ( 0, "invalid phone number: $to" ) unless $e164;
    $text = decode( 'UTF-8', $text ) unless utf8::is_utf8($text);
    my @why;
    for my $ch (qw( telegram whatsapp )) {
        next unless ( $c->{$ch} // '' ) eq 'on';
        my ( $ok, $info ) = $ch eq 'telegram' ? send_telegram( $c, $e164, $text ) : send_whatsapp( $c, $e164, $text );
        if ($ok) { $LAST_CHANNEL = $info; return ( 1, $info ) }
        push @why, $info;
    }
    push @why, 'no channel is on' unless @why;
    return ( 0, join( '; ', @why ) );
}

# Links Telegram chats to phone numbers: a patron opens the bot, taps Start
# and shares the contact (only their own contact is accepted); /stop undoes
# it. Run every two minutes from cron (kei-telegram-link).
sub telegram_poll {
    my ($c) = @_;
    my $offset_file = ( $c->{data_dir} || '.' ) . '/telegram.offset';
    my $offset = 0;
    if ( open( my $fh, '<', $offset_file ) ) { $offset = ( <$fh> // 0 ) + 0; close $fh }
    my $data = telegram_call( $c, 'getUpdates', { offset => $offset, timeout => 0, allowed_updates => ['message'] } );
    my $map = telegram_map($c);
    my ( $linked, $changed, $last ) = ( 0, 0, $offset - 1 );
    my $say = sub { my ( $chat, $text, $markup ) = @_; eval { telegram_call( $c, 'sendMessage', { chat_id => $chat, text => $text, ( $markup ? ( reply_markup => $markup ) : () ) } ) } };
    for my $u ( @{ $data->{result} || [] } ) {
        $last = $u->{update_id} if $u->{update_id} > $last;
        my $m = $u->{message} or next;
        next unless ref $m->{chat} eq 'HASH' && ( $m->{chat}{type} // '' ) eq 'private';
        my $chat = $m->{chat}{id};
        if ( my $ct = $m->{contact} ) {
            my ($e164) = normalize_phone( '+' . ( ( $ct->{phone_number} // '' ) =~ s/\D//gr ), $c->{country}, $c->{area} );
            if ( $e164 && defined $ct->{user_id} && ref $m->{from} eq 'HASH' && $ct->{user_id} == $m->{from}{id} ) {
                delete $map->{$_} for grep { $map->{$_} == $chat } keys %$map;
                $map->{$e164} = $chat;
                $changed = 1;
                $linked++;
                $say->( $chat, $c->{tg_linked} || 'OK', { remove_keyboard => JSON::PP::true } );
            } else {
                $say->( $chat, $c->{tg_not_own} || '?' );
            }
            next;
        }
        if ( ( $m->{text} // '' ) =~ m{^/stop} ) {
            my @gone = grep { $map->{$_} == $chat } keys %$map;
            delete @{$map}{@gone};
            $changed = 1 if @gone;
            $say->( $chat, $c->{tg_stopped} || 'OK', { remove_keyboard => JSON::PP::true } );
            next;
        }
        $say->( $chat, $c->{tg_start} || 'Share your phone number',
            { keyboard => [ [ { text => $c->{tg_button} || 'Share', request_contact => JSON::PP::true } ] ], resize_keyboard => JSON::PP::true, one_time_keyboard => JSON::PP::true } );
    }
    telegram_map_save( $c, $map ) if $changed;
    _write_atomic( $offset_file, ( $last + 1 ) . "\n" ) if $last + 1 > $offset;
    return $linked;
}

1;
MSGPM
}

msg_pm_driver() {
    cat <<'MSGDRV'
package SMS::Send::KohaEasy::Gateway;

# koha-easy-installer: SMS::Send driver for Koha (SMSSendDriver =
# KohaEasy::Gateway). The notice goes to Telegram or WhatsApp; a failure
# dies with the reason, which Koha keeps with the failed message.

use strict;
use warnings;
use parent 'SMS::Send::Driver';
use KohaEasy::Messaging;

sub new {
    my ( $class, %args ) = @_;
    return bless { conf => KohaEasy::Messaging::load_conf() }, $class;
}

sub send_sms {
    my ( $self, %args ) = @_;
    my ( $ok, $info ) = KohaEasy::Messaging::send_message( $self->{conf}, $args{to}, $args{text} );
    die "$info\n" unless $ok;
    return 1;
}

1;
MSGDRV
}

msg_link_script() {
    cat <<'MSGLINK'
#!/usr/bin/perl
# koha-easy-installer: links patrons' Telegram chats to their phone numbers
# (cron, every two minutes, as the Koha instance user).
use strict;
use warnings;
use KohaEasy::Messaging;
my $c = KohaEasy::Messaging::load_conf();
exit 0 unless ( $c->{telegram} // '' ) eq 'on' && $c->{tg_token};
my $n = KohaEasy::Messaging::telegram_poll($c);
print "Linked: $n\n" if -t STDOUT;
MSGLINK
}

msg_installed() { [ -f "$KEI_PERL_DIR/SMS/Send/KohaEasy/Gateway.pm" ] && [ -f "$KEI_PERL_DIR/KohaEasy/Messaging.pm" ]; }

# Writes (or refreshes) the driver, the shared module and the link job.
msg_install_files() {
    mkdir -p "$KEI_PERL_DIR/KohaEasy" "$KEI_PERL_DIR/SMS/Send/KohaEasy" "$KEI_LIBEXEC" "$MSG_DATA" || return 1
    msg_pm_messaging > "$KEI_PERL_DIR/KohaEasy/Messaging.pm.new" \
        && msg_pm_driver > "$KEI_PERL_DIR/SMS/Send/KohaEasy/Gateway.pm.new" \
        && msg_link_script > "$KEI_LIBEXEC/kei-telegram-link.new" || return 1
    chmod 644 "$KEI_PERL_DIR/KohaEasy/Messaging.pm.new" "$KEI_PERL_DIR/SMS/Send/KohaEasy/Gateway.pm.new"
    chmod 755 "$KEI_LIBEXEC/kei-telegram-link.new"
    mv -f "$KEI_PERL_DIR/KohaEasy/Messaging.pm.new" "$KEI_PERL_DIR/KohaEasy/Messaging.pm"
    mv -f "$KEI_PERL_DIR/SMS/Send/KohaEasy/Gateway.pm.new" "$KEI_PERL_DIR/SMS/Send/KohaEasy/Gateway.pm"
    mv -f "$KEI_LIBEXEC/kei-telegram-link.new" "$KEI_LIBEXEC/kei-telegram-link"
    chown "${INSTANCE}-koha:${INSTANCE}-koha" "$MSG_DATA" 2>/dev/null || true
    chmod 750 "$MSG_DATA"
}

# msg_conf KEY: value in the settings file (empty when missing).
msg_conf() {
    [ -r "$MSG_CONF" ] || return 0
    awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { printf "%s", v }' "$MSG_CONF"
}

# msg_conf_set KEY VALUE [KEY VALUE...]: rewrites the settings file (one
# line per key; line breaks kept as "\n"), readable by root and Koha only.
msg_conf_set() {
    local tmp k v args=()
    while [ $# -ge 2 ]; do
        v="${2//$'\n'/\\n}"
        args+=("$1=${v//$'\r'/}")
        shift 2
    done
    mkdir -p "${MSG_CONF%/*}" || return 1
    tmp=$(mktemp "${MSG_CONF}.XXXXXX") || return 1
    {
        if [ -s "$MSG_CONF" ]; then
            awk -v keys="$(printf '%s\n' "${args[@]%%=*}")" 'BEGIN { n = split(keys, a, "\n"); for (i = 1; i <= n; i++) skip[a[i]] = 1 }
                { k = $0; sub(/=.*/, "", k); if (!(k in skip)) print }' "$MSG_CONF"
        else
            printf '# koha-easy-installer: messaging settings (Library tools > Messaging)\n'
        fi
        for k in "${args[@]}"; do printf '%s\n' "$k"; done
    } > "$tmp" || { rm -f "$tmp"; return 1; }
    chown "root:${INSTANCE}-koha" "$tmp" 2>/dev/null || true
    chmod 640 "$tmp"
    mv -f "$tmp" "$MSG_CONF"
}

# Defaults, bot texts in the panel language and the data folder.
msg_conf_init() {
    local k v defaults=(whatsapp off telegram off country 55 area "" wa_type evolution tg_api "https://api.telegram.org" timeout 15)
    set --
    while [ ${#defaults[@]} -gt 0 ]; do
        k="${defaults[0]}"; v="${defaults[1]}"; defaults=("${defaults[@]:2}")
        grep -q "^${k}=" "$MSG_CONF" 2>/dev/null || set -- "$@" "$k" "$v"
    done
    [ $# -gt 0 ] && { msg_conf_set "$@" || return 1; }
    msg_conf_set data_dir "$MSG_DATA" \
        tg_start "$(t "Hello! To receive the notices of the library here (loans, returns, due dates and holds), tap the button below to share your phone number. It must be the mobile number registered at the library.")" \
        tg_button "$(t "Share my phone number")" \
        tg_linked "$(t "Done! The notices of the library will arrive in this chat. Send /stop to stop them.")" \
        tg_not_own "$(t "Please use the button to share your own phone number.")" \
        tg_stopped "$(t "You will not receive the notices of the library here anymore.")"
}

msg_notices_on() { [ "$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'SMSSendDriver';")" = "$MSG_DRIVER" ]; }

# Two-minute schedule: SMS-type notices (the Koha schedule sends the queue
# every 15 minutes) and the Telegram link job. Removed when nothing is on.
msg_cron_write() {
    local lines=()
    msg_notices_on && lines+=("*/2 * * * * root /usr/sbin/koha-shell ${INSTANCE} -c \"$(koha_script process_message_queue.pl || echo "$KOHA_BIN/cronjobs/process_message_queue.pl") -t sms\" >/dev/null 2>&1")
    [ "$(msg_conf telegram)" = "on" ] && lines+=("*/2 * * * * root /usr/sbin/koha-shell ${INSTANCE} -c \"/usr/bin/perl ${KEI_LIBEXEC}/kei-telegram-link\" >/dev/null 2>&1")
    if [ ${#lines[@]} -eq 0 ]; then
        rm -f "$CRON_MSG"
        return 0
    fi
    {
        printf '# koha-easy-installer: WhatsApp / Telegram notices (Library tools > Messaging)\n'
        printf 'SHELL=/bin/sh\nPATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin\n'
        printf '%s\n' "${lines[@]}"
    } > "${CRON_MSG}.new" && chmod 644 "${CRON_MSG}.new" && mv -f "${CRON_MSG}.new" "$CRON_MSG"
}

# msg_perl LOG LABEL SCRIPT [ARGS]: a Perl program of the panel run as the
# instance user, with the module folder on @INC.
msg_perl() {
    local log="$1" label="$2"
    shift 2
    koha_exec "$log" "$label" /usr/bin/perl -I "$KEI_PERL_DIR" "$@"
}

msg_status_text() {
    local wa tg notices linked=0 cc area
    wa=$(msg_conf whatsapp); tg=$(msg_conf telegram)
    cc=$(msg_conf country); area=$(msg_conf area)
    [ -r "$MSG_DATA/telegram.map" ] && linked=$(grep -c '^+' "$MSG_DATA/telegram.map")
    notices="$(t "off")"; msg_notices_on && notices="$(t "on")"
    printf '%s\n' "$(t "Koha notices (checkout, check-in, overdue, due, hold) sent through WhatsApp or Telegram. Nothing changes in Koha until you turn the notices on.")"
    printf '\n  WhatsApp: %s    Telegram: %s (%s: %s)\n' "$([ "$wa" = on ] && t "on" || t "off")" "$([ "$tg" = on ] && t "on" || t "off")" "$(t "linked patrons")" "$linked"
    printf '  %s: %s    %s: +%s %s\n' "$(t "Koha notices")" "$notices" "$(t "Numbers")" "${cc:-55}" "$area"
}

function_messaging() {
    require_database || return 0
    local opt
    while true; do
        opt=$(ui_menu "$(t "✉  Messaging: WhatsApp and Telegram")" "$(msg_status_text)" \
            "1" "$(t "WhatsApp gateway (Evolution API or other)")" \
            "2" "$(t "Telegram bot")" \
            "3" "$(t "Country and area code of the phone numbers")" \
            "4" "$(t "Send a test message")" \
            "5" "$(t "Send Koha notices through these channels (on / off)")" \
            "6" "$(t "What Koha needs to send the notices")" \
            "7" "$(t "Check the patrons' phone numbers")" \
            "8" "$(t "Remove the messaging module")") || return 0
        case "$opt" in
            1) lt_msg_whatsapp ;;
            2) lt_msg_telegram ;;
            3) lt_msg_country ;;
            4) lt_msg_test ;;
            5) lt_msg_notices ;;
            6) lt_msg_check ;;
            7) lt_msg_phones ;;
            8) lt_msg_remove ;;
        esac
        clear
    done
}

lt_msg_whatsapp() {
    local act type url inst token
    act=$(ui_menu "WhatsApp" "$(t "WhatsApp needs a gateway of your own (for example Evolution API, which uses Baileys), installed on this or another server and connected to the WhatsApp account of the library.")" \
        "setup" "$(t "Set up or change")" \
        "off"   "$(t "Turn off")") || return 0
    if [ "$act" = "off" ]; then
        msg_conf_set whatsapp off || return 1
        msg_cron_write
        log "messaging: WhatsApp off"
        msg_ok "$(t "✔ WhatsApp is off.")"
        return 0
    fi
    type=$(ui_menu "WhatsApp" "$(t "Gateway type:")" \
        "evolution" "Evolution API (v2)" \
        "generic"   "$(t "Other gateway (JSON: number, to, text; Bearer token)")") || return 0
    url=$(ui_input "WhatsApp" "$(t "Address of the gateway (e.g. http://127.0.0.1:8080):")" "$(msg_conf wa_url)") || return 0
    url="${url%/}"
    if ! [[ "$url" =~ ^https?://[A-Za-z0-9._:-]+(/[A-Za-z0-9._~/%-]*)?$ ]]; then
        msg_error "" "$(t "Invalid address. Use http:// or https:// followed by the server.\nNothing was changed.")" 9 72
        return 1
    fi
    inst=""
    if [ "$type" = "evolution" ]; then
        inst=$(ui_input "WhatsApp" "$(t "Name of the Evolution API instance:")" "$(msg_conf wa_instance)") || return 0
        if ! [[ "$inst" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; then
            msg_error "" "$(t "Invalid instance name (letters, digits, dot, dash and underscore).\nNothing was changed.")" 9 72
            return 1
        fi
    fi
    token=$(ui_input "WhatsApp" "$(t "Token (API key) of the gateway:")" "$(msg_conf wa_token)") || return 0
    if ! [[ "$token" =~ ^[A-Za-z0-9._~+/=:-]{8,512}$ ]]; then
        msg_error "" "$(t "Invalid token.\nNothing was changed.")" 9 72
        return 1
    fi
    msg_install_files && msg_conf_init && msg_conf_set whatsapp on wa_type "$type" wa_url "$url" wa_instance "$inst" wa_token "$token" || {
        msg_error "" "$(t "The settings could not be saved.\nNothing was changed.")" 9 70; return 1; }
    msg_cron_write
    log "messaging: WhatsApp on ($type $url)"
    msg_ok "$(t "✔ WhatsApp is on. Send a test message to check the gateway.")" 9 72
}

lt_msg_telegram() {
    local act token log bot
    act=$(ui_menu "Telegram" "$(t "Create a bot with @BotFather in Telegram and paste its token here. Patrons open the bot, tap Start and share their phone number (the one registered in Koha).")" \
        "setup" "$(t "Set up or change")" \
        "off"   "$(t "Turn off")") || return 0
    if [ "$act" = "off" ]; then
        msg_conf_set telegram off || return 1
        msg_cron_write
        log "messaging: Telegram off"
        msg_ok "$(t "✔ Telegram is off.")"
        return 0
    fi
