# ======================================================================
# 3. SHIELDED APT
# ======================================================================
APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o Acquire::ForceIPv4=true)
# Full APT output is kept here so a failed installation can be diagnosed.
APT_LOG="/var/log/koha-easy-install/apt.log"

apt_is_locked() {
    local f
    if command -v fuser >/dev/null 2>&1; then
        for f in /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock; do
            fuser "$f" >/dev/null 2>&1 && return 0
        done
        return 1
    fi
    pgrep -x 'apt|apt-get|dpkg|unattended-upgr' >/dev/null 2>&1
}

wait_for_apt_locks() {
    systemctl stop apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1
    APT_TIMERS_STOPPED="yes"

    local wait_time=0
    while apt_is_locked; do
        [ "$wait_time" -eq 0 ] && echo "$(t "Waiting for another package manager process to finish...")"
        sleep 3
        wait_time=$((wait_time + 3))
        if [ "$wait_time" -ge 300 ]; then
            restore_apt_timers
            return 1
        fi
    done
    if ! DEBIAN_FRONTEND=noninteractive dpkg --configure -a >>"$APT_LOG" 2>&1; then
        restore_apt_timers
        return 1
    fi
    return 0
}

apt_update_indices() {
    local attempt=1 max=3
    mkdir -p "$(dirname "$APT_LOG")" 2>/dev/null
    while [ "$attempt" -le "$max" ]; do
        if apt-get update -y -o Acquire::ForceIPv4=true >>"$APT_LOG" 2>&1; then
            return 0
        fi
        sleep 2
        if apt-get update -y --fix-missing -o Acquire::ForceIPv4=true >>"$APT_LOG" 2>&1; then
            return 0
        fi
        sleep 2
        attempt=$((attempt + 1))
    done
    return 1
}

apt_install() {
    local packages=("$@") attempt=1 max=3
    mkdir -p "$(dirname "$APT_LOG")" 2>/dev/null
    while [ "$attempt" -le "$max" ]; do
        printf '\n===== %s | apt-get install %s (attempt %s) =====\n' "$(date '+%F %T')" "${packages[*]}" "$attempt" >>"$APT_LOG"
        if DEBIAN_FRONTEND=noninteractive apt-get install "${APT_OPTS[@]}" "${packages[@]}" 2>&1 | tee -a "$APT_LOG"; then
            return 0
        fi
        apt_update_indices >/dev/null 2>&1
        DEBIAN_FRONTEND=noninteractive dpkg --configure -a >>"$APT_LOG" 2>&1
        DEBIAN_FRONTEND=noninteractive apt-get -f install "${APT_OPTS[@]}" >>"$APT_LOG" 2>&1
        sleep 3
        attempt=$((attempt + 1))
    done
    return 1
}

# Last lines of the APT log, for error dialogs.
apt_log_tail() {
    tail -n "${1:-8}" "$APT_LOG" 2>/dev/null | cut -c1-76
}

# One APT source line, pinned to the architecture dpkg reports (amd64,
# arm64...): nothing assumes x86_64, and foreign architectures enabled on
# the machine (e.g. i386 for Wine) do not query repositories without them.
apt_source_line() {
    local keyring="$1" url="$2" suite="$3" comp="$4" arch
    arch=$(dpkg --print-architecture 2>/dev/null)
    printf 'deb [%ssigned-by=%s] %s %s %s\n' "${arch:+arch=$arch }" "$keyring" "$url" "$suite" "$comp"
}

