lt_privacy_anonymise() {
    require_database || return 0
    local days
    days=$(ui_input "$(t "Privacy: anonymise history")" "$(t "Anonymise loans and holds that ended more than how many days ago?\n\nPatrons who chose to keep their history are skipped by Koha.")" "365") || return 0
    if ! [[ "$days" =~ ^[0-9]+$ ]] || [ "$days" -lt 30 ]; then
        msg_error "" "$(t "Type a number of days (30 or more).\nNothing was changed.")" 9 64
        return 1
    fi
    tools_locked _lt_anonymise_run "$days"
}

_lt_anonymise_run() {
    local days="$1" log anon loans holds
    log=$(tools_log privacy-anonymise)
    # The same selection as Koha (filter_by_anonymizable + filter_by_last_update).
    anon=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'AnonymousPatron';")
    [[ "$anon" =~ ^[0-9]+$ ]] || anon=0
    loans=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.old_issues o JOIN ${DB_NAME}.borrowers b ON b.borrowernumber = o.borrowernumber WHERE b.privacy <> 0 AND o.borrowernumber <> ${anon} AND o.returndate < DATE_SUB(CURDATE(), INTERVAL ${days} DAY);")
    holds=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.old_reserves r JOIN ${DB_NAME}.borrowers b ON b.borrowernumber = r.borrowernumber WHERE b.privacy <> 0 AND r.borrowernumber <> ${anon} AND r.timestamp < DATE_SUB(CURDATE(), INTERVAL ${days} DAY);")
    if ! [[ "$loans" =~ ^[0-9]+$ && "$holds" =~ ^[0-9]+$ ]]; then
        msg_error "" "$(t "The records could not be counted. Nothing was changed.")" 9 70
        return 1
    fi
    printf 'Preview (%s days): loans=%s holds=%s AnonymousPatron=%s\n' "$days" "$loans" "$holds" "$anon" >> "$log"
    if [ $((loans + holds)) -eq 0 ]; then
        msg_info "$(t "Privacy: anonymise history")" "$(t "Nothing to anonymise. Nothing was changed.")" 9 64
        return 0
    fi
    prompt_yes_no "$(t "Privacy: anonymise history")" "$(t 'Records that ended more than ${days} days ago:\n  Loans: ${loans}\n  Holds: ${holds}\n\nTheir link to the patrons is removed for good (the statistics stay). A verified backup is made first.\n\nContinue?')" 15 72 defaultno || return 0
    tools_safety_backup PRIVACY || return 1
    if ! koha_tool "$log" batch_anonymise.pl --days "$days" -v; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    loans=$(tools_lead "$log" "checkouts anonymised"); holds=$(tools_lead "$log" "holds anonymised")
    log "tools: history anonymised (loans=$loans holds=$holds, ${days} days)"
    msg_ok "$(t '✔ Anonymised: ${loans} loan(s) and ${holds} hold(s).\n\nSafety backup: ${TOOLS_PRE}\nLog: ${log}')" 12 76
}

