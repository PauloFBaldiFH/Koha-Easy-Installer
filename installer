# Brazilian area codes (DDD) in use.
BR_DDD=" 11 12 13 14 15 16 17 18 19 21 22 24 27 28 31 32 33 34 35 37 38 41 42 43 44 45 46 47 48 49 51 53 54 55 61 62 63 64 65 66 67 68 69 71 73 74 75 77 79 81 82 83 84 85 86 87 88 89 91 92 93 94 95 96 97 98 99 "
phone_ddd_valid() { [[ "$1" =~ ^[0-9]{2}$ ]] && [[ "$BR_DDD" == *" $1 "* ]]; }

# phone_normalize NUMBER [COUNTRY] [AREA]: "E164<TAB>kind" (kind: ok, fixed,
# landline, invalid), with the rules of the Perl module used by Koha (run
# as the instance user, like the other Perl of the panel).
phone_normalize() {
    local lib log rc=0
    tools_workdir || return 1
    lib=$(msg_perl_lib) || return 1
    log="$TOOLS_WORK/phone.log"; : > "$log"
    cat > "$TOOLS_WORK/phone.pl" <<'PHONEPL'
use strict; use warnings; use KohaEasy::Messaging;
my ( $e, $k ) = KohaEasy::Messaging::normalize_phone(@ARGV);
printf "%s\t%s\n", $e // '', $k;
exit( $e ? 0 : 1 );
PHONEPL
    koha_exec "$log" phone /usr/bin/perl -I "$lib" "$TOOLS_WORK/phone.pl" "$1" "${2:-$(msg_conf country)}" "${3:-$(msg_conf area)}" || rc=$?
    if [ "$rc" -eq 2 ] && ! grep -q . <<< "$(tools_output "$log")"; then printf '\tinvalid\n'; return 1; fi
    tools_output "$log"
    return "$rc"
}

