    case "$choice" in
        1) tools_locked _lt_reports_install census_reports_define "$CENSUS_TAG" "$title" CENSO ;;
        2) tools_locked _lt_reports_remove "$CENSUS_TAG" "$title" CENSO ;;
    esac
}

# ----------------------------------------------------------------------
# 5. ABNT references: bibliographies and collection listings formatted by
#    ABNT NBR 6023:2018 (references) and presented as NBR 14724 asks for
#    the reference list (heading centred in capitals, single spacing, left
#    aligned, a blank line between entries, alphabetical order). Read-only:
#    the records come from biblio_metadata, the files go to a chosen folder.
# ----------------------------------------------------------------------
# The MARC 21 to NBR 6023 formatter (written next to the data, run through
# koha-shell like the other MARC::Record programs). Input: one line per
# record, "biblionumber<TAB>call numbers<TAB>copies<TAB>MARCXML" as the
# mysql client prints it (tabs, line breaks and backslashes escaped).
abnt_write_formatter() {
    cat > "$1" <<'ABNTPL'
use strict;
use warnings;
use utf8;
use Getopt::Long;
use Encode qw( decode );
use MARC::Record;
use MARC::File::XML ( BinaryEncoding => 'utf8', RecordFormat => 'MARC21' );
use POSIX qw( strftime );
use Unicode::Normalize qw( NFD );

# koha-easy-installer: MARC 21 records -> references by ABNT NBR 6023:2018.
# Books, chapters (773 with the host book), articles (773 with the journal),
# theses (502) and online documents (856). Authors: SURNAME, Forenames; up
# to three separated by ";", four or more as the first one plus "et al.";
# organizers (org.), editors (ed.), coordinators (coord.). Without an
# author the entry is the title with its first word (and a leading article
# or monosyllable) in capitals. The title of the book or journal is in bold.
my %o = ( caption => '', access => '' );
GetOptions( \%o, 'in=s', 'html=s', 'text=s', 'caption=s', 'listing', 'access=s' ) or exit 2;
binmode STDOUT, ':encoding(UTF-8)';
$o{$_} = decode( 'UTF-8', $o{$_} ) for qw( caption access );
my @MONTHS = qw( jan. fev. mar. abr. maio jun. jul. ago. set. out. nov. dez. );
my @now = localtime;
$o{access} ||= sprintf '%d %s %d', $now[3], $MONTHS[ $now[4] ], $now[5] + 1900;
my %ARTICLE = map { $_ => 1 } qw( o a os as um uma uns umas the an el la los las lo le les un une il gli der die das ein eine );
my ( $B, $E ) = ( "\x{1}", "\x{2}" );    # bold on / off

sub clean { my $s = shift // ''; $s =~ s/\s+/ /g; $s =~ s/^ | $//g; return $s }
# ISBD punctuation at the end ("Title /", "São Paulo :", "Ática,", "1997.").
# The full stop stays after an initial or an abbreviation ("J.", "ed.", "al.").
sub bare {
    my $s = clean(shift);
    1 while $s =~ s/\s*[\/:;,=+]$//;
    $s =~ s/\.$// unless $s =~ /(?:^|[\s.(])[[:alpha:]]{1,3}\.$/;
    return clean($s);
}
sub dot { my $s = clean(shift); return '' if $s eq ''; return $s =~ /[.?!]\x{2}?$/ ? $s : "$s." }
sub sub_all { my ( $f, $codes ) = @_; return clean( join ' ', map { $_->[1] } grep { index( $codes, $_->[0] ) >= 0 } $f->subfields ) }

sub person {    # "Assis, Machado de," -> "ASSIS, Machado de"
    my $f = shift;
    my $a = bare( scalar $f->subfield('a') );
    return '' if $a eq '';
    my ( $sur, $rest ) = $a =~ /^([^,]+),\s*(.*)$/ ? ( $1, $2 ) : ( $a, '' );
    return uc($sur) . ( $rest ne '' ? ", $rest" : '' );
}
sub direct_name {    # "Silva, José da" -> "José da Silva"
    my $a = bare( scalar shift->subfield('a') );
    return $a =~ /^([^,]+),\s*(.+)$/ ? "$2 $1" : $a;
}
sub corporate {      # "Brasil. Ministério da Educação" -> "BRASIL. Ministério da Educação"
    my $f = shift;
    my @b = map { bare($_) } $f->subfield('b');
    return join '. ', uc( bare( scalar $f->subfield('a') ) ), @b;
}
sub meeting {        # CONGRESSO BRASILEIRO DE BIBLIOTECONOMIA, 25., 2013, Florianópolis
    my $f = shift;
    my @p = ( uc( bare( scalar $f->subfield('a') ) ) );
    for my $c (qw( n d c )) {
        ( my $v = bare( scalar $f->subfield($c) ) ) =~ s/^\(|\)$//g;
        $v = bare($v);
        $v = "$1." if $c eq 'n' && $v =~ /^(\d+)(?:st|nd|rd|th|º|ª|o|a)?\.?$/;
        push @p, $v if $v ne '';
    }
    return join ', ', @p;
}
sub role {
    my $f = shift;
    my $r = lc join ' ', $f->subfield('e'), $f->subfield('4');
    return 'org.'   if $r =~ /\b(org|organi[sz]|comp|compil)/;
    return 'ed.'    if $r =~ /\b(edt|ed\b|editor)/;
    return 'coord.' if $r =~ /\bcoord/;
    return 'trl'    if $r =~ /\b(trl|trad|transl)/;
    return 'aut'    if $r eq '' || $r =~ /\b(aut|autor|author)/;
    return 'other';
}
sub author_list {
    my @n = @_;
    return '' unless @n;
    return @n > 3 ? "$n[0] et al" : join '; ', @n;
}
sub title_entry {    # "O pequeno príncipe" -> "O PEQUENO príncipe"
    my $t = shift;
    my @w = split / /, $t, -1;
    return $t unless @w;
    my $n = ( @w > 1 && ( $ARTICLE{ lc $w[0] } || length( $w[0] ) <= 2 ) ) ? 2 : 1;
    $w[$_] = uc( $w[$_] ) for 0 .. $n - 1;
    return join ' ', @w;
}
sub edition {        # "2nd ed.", "2ª edição rev. e ampl." -> "2. ed.", "2. ed. rev. e ampl."; 1st edition left out
    my $e = bare(shift);
    return '' if $e eq '';
    if ( $e =~ /^(\d+)\s*(?:st|nd|rd|th|ª|º|a|o)?\.?\s*(?:edição|edicao|edition|edición|ed\.|éd\.|ed|éd)(?![[:alpha:]])\s*(.*)$/i ) {
        my ( $n, $rest ) = ( $1, clean($2) );
        return '' if $n == 1 && $rest eq '';
        return dot( "$n. ed." . ( $rest ne '' ? " $rest" : '' ) );
    }
    return dot($e);
}
sub publisher {
    my $p = bare(shift);
    $p =~ s/,?\s+(?:Ltda\.?|S\.\s?A\.?|S\/A|Eireli|ME)$//i;
    return $p;
}
sub no_value { my $s = shift; return $s eq '' || $s =~ /^\[?\s*s\.\s*[ln]\.?\s*\]?$/i || $s =~ /^\[?\s*(?:s\.\s*l\.?\s*:\s*s\.\s*n\.?|sine loco|sine nomine)\s*\]?$/i }
sub year_of {
    my ( $m, $c ) = @_;
    my $y = clean( $c // '' );
    return $1 if $y =~ /(\[[^\]]*\d{2}[^\]]*\])/;    # [2010?] [199-] as catalogued
    return $1 if $y =~ /((?:1[5-9]|20)\d{2})/;
    my $f008 = $m->field('008');
    my $d = $f008 ? substr( $f008->data . ( ' ' x 40 ), 7, 4 ) : '';
    return $d if $d =~ /^\d{4}$/;
    return '';
}
sub imprint {        # "São Paulo: Ática, 1997"
    my ( $m, $thesis ) = @_;
    my ($f) = grep { $_->tag eq '260' || $_->indicator(2) eq '1' } $m->field( '260', '264' );
    my $year = year_of( $m, $f ? scalar $f->subfield('c') : $thesis ? sub_all( $thesis, 'ad' ) : '' );
    my $miss = $year eq '';
    $year = '[s. d.]' if $miss;
    return ( $year, $miss ) if !$f && $thesis;
    my $place = $f ? bare( scalar $f->subfield('a') ) : '';
    my $pub   = $f ? publisher( scalar $f->subfield('b') ) : '';
    $place = '' if no_value($place);
    $pub   = '' if no_value($pub);
    my $pp = $place ne '' && $pub ne '' ? "$place: $pub"
           : $place ne '' ? "$place: [s. n.]"
           : $pub ne ''   ? "[S. l.]: $pub"
           :                '[S. l.: s. n.]';
    return ( "$pp, $year", $miss );
}
sub extent {         # "xii, 250 p. :" -> "250 p."
    my ( $m, $thesis ) = @_;
    my $f = $m->field('300') or return '';
    my $a = sub_all( $f, 'a' );
    if ( $a =~ /(\d+)\s*(p|f|v|folhas|páginas|paginas|pages|volumes?)\b\.?/i ) {
        my ( $n, $u ) = ( $1, lc substr( $2, 0, 1 ) );
        $u = 'f' if $thesis && $u eq 'p';
        return "$n $u.";
    }
    return dot( bare($a) );
}
sub series { return join ' ', map { my $v = bare( scalar $_->subfield('v') ); '(' . bare( scalar $_->subfield('a') ) . ( $v ne '' ? ", $v" : '' ) . ').' } grep { bare( scalar $_->subfield('a') ) ne '' } $_[0]->field('490') }

sub reference {
    my $m = shift;
    my $t245 = $m->field('245') or return;
    my $main = bare( sub_all( $t245, 'anp' ) );
    my $sub  = bare( sub_all( $t245, 'b' ) );
    return if $main eq '';
    my $thesis = $m->field('502');
    my @people = $m->field('700');
    my ( $entry, $role ) = ( '', '' );
    if ( my $f = $m->field('100') ) {
        $entry = author_list( person($f), map { person($_) } grep { role($_) eq 'aut' } @people );
    } elsif ( $f = $m->field('110') ) {
        $entry = corporate($f);
    } elsif ( $f = $m->field('111') ) {
        $entry = meeting($f);
    } else {
        for my $r ( 'org.', 'ed.', 'coord.' ) {
            my @r = grep { role($_) eq $r } @people;
            next unless @r;
            $entry = author_list( map { person($_) } @r ) . " ($r)";
            last;
        }
        # AACR2 enters works of four or more authors under the title, with
        # the first author in 700: NBR 6023 keeps the author ("SILVA, Ana et al.").
        if ( $entry eq '' ) {
            my @a = map { person($_) } grep { role($_) eq 'aut' && $_->indicator(1) ne '3' } @people;
            $entry = author_list(@a) . ( @a && @a < 4 && sub_all( $t245, 'c' ) =~ /et al/i ? ' et al' : '' ) if @a;
        }
    }
    my @trl = map { direct_name($_) } grep { role($_) eq 'trl' } @people;
    my $host = $m->field('773');
    my $ref;
    if ($entry ne '') {
        $ref = dot($entry) . ' ';
        $ref .= $host ? dot( $main . ( $sub ne '' ? ": $sub" : '' ) ) : dot( "$B$main$E" . ( $sub ne '' ? ": $sub" : '' ) );
    } else {
        $ref = dot( title_entry($main) . ( $sub ne '' ? ": $sub" : '' ) );
    }
    $ref .= ' Tradução: ' . dot( join( ', ', @trl[ 0 .. ( $#trl < 2 ? $#trl : 2 ) ] ) ) if @trl;
    my $miss;
    if ($host) {
        my $ht = bare( scalar $host->subfield('t') );
        my $g  = bare( scalar $host->subfield('g') );
        my $d  = bare( scalar $host->subfield('d') );
        my $h7 = $host->subfield('7') // '';
        my $chapter = $d ne '' || $host->subfield('z') || substr( $h7 . '    ', 3, 1 ) eq 'm';
        my $year = year_of( $m, $d ne '' ? $d : $g );
        $miss = $year eq '';
        $year = '[s. d.]' if $miss;
        if ($chapter) {
            my $ha = bare( scalar $host->subfield('a') );
            $ha = $ha =~ /^([^,]+),\s*(.*)$/ ? uc($1) . ", $2" : uc($ha) if $ha ne '';
            $d =~ s/\s*:\s*/: /g;
            $d .= ", $year" if $d ne '' && index( $d, $year ) < 0;
            $ref .= ' In: ' . ( $ha ne '' ? dot($ha) . ' ' : '' ) . dot( $ht ne '' ? "$B$ht$E" : '' ) . ' ' . dot( $d ne '' ? $d : $year );
            $ref .= ' ' . dot($g) if $g ne '';
        } else {
            $g =~ s/\s*\(\s*\d{4}\s*\)//;    # "v. 10, n. 2 (2019), p. 33-50": the year goes last
            $g = clean($g);
            $g .= ( $g ne '' ? ', ' : '' ) . $year unless $g =~ /\Q$year\E$/;
            $ref .= ' ' . dot( "$B$ht$E, $g" );
        }
    } else {
        my $ed = edition( scalar( $m->field('250') ? $m->field('250')->subfield('a') : '' ) );
        $ref .= " $ed" if $ed ne '';
        my $imp;
        ( $imp, $miss ) = imprint( $m, $thesis );
        $ref .= ' ' . dot($imp);
        my $ext = extent( $m, $thesis );
        $ref .= " $ext" if $ext ne '';
        my $ser = series($m);
        $ref .= " $ser" if $ser ne '';
        if ($thesis) {
            my $a = bare( scalar $thesis->subfield('a') );
            if ( $a eq '' ) {    # 502 $b degree, $c institution, $d year
                my ( $deg, $inst, $when ) = map { bare( scalar $thesis->subfield($_) ) } qw( b c d );
                $a = join ' – ', grep { $_ ne '' } $deg, join( ', ', grep { $_ ne '' } $inst, $when );
            }
            $a =~ s/\s+-{1,2}\s+/ – /g;
            $ref .= ' ' . dot($a) if $a ne '';
        }
    }
    # Online documents only: 856 of the resource itself (2nd indicator 0), or
    # the whole record describes an online item (008/23 o, q or s).
    my $f008 = $m->field('008');
    my $online = $f008 && substr( $f008->data . ( ' ' x 40 ), 23, 1 ) =~ /[oqs]/;
    if ( my ($url) = grep { defined } map { scalar $_->subfield('u') } grep { $online || $_->indicator(2) eq '0' } $m->field('856') ) {
        $ref .= " Disponível em: $url. Acesso em: $o{access}.";
    }
    $ref =~ s/\.\././g;
    $ref =~ s/ {2,}/ /g;
    return ( $ref, $miss );
}

sub sort_key { my $s = NFD( lc shift ); $s =~ s/[\x{1}\x{2}]//g; $s =~ s/\p{Mn}//g; $s =~ s/[^\p{L}\p{N} ]+/ /g; $s =~ s/ +/ /g; return $s }
sub html_escape { my $s = shift; $s =~ s/&/&amp;/g; $s =~ s/</&lt;/g; $s =~ s/>/&gt;/g; $s =~ s/"/&quot;/g; return $s }

open( my $in, '<:encoding(UTF-8)', $o{in} ) or die "cannot read $o{in}\n";
my ( @refs, %seen, $bad, $undated );
( $bad, $undated ) = ( 0, 0 );
while ( my $line = <$in> ) {
    chomp $line;
    my ( $bn, $calls, $copies, $xml ) = split /\t/, $line, 4;
    next unless defined $xml && $xml ne '';
    $_ =~ s/\\(.)/$1 eq 'n' ? "\n" : $1 eq 't' ? "\t" : $1 eq '0' ? "\0" : $1/ge for $calls, $xml;
    my $m = eval { MARC::Record->new_from_xml( $xml, 'UTF-8', 'MARC21' ) };
    my ( $ref, $miss ) = $m ? reference($m) : ();
    unless ( defined $ref ) { $bad++; next }
    my $loc = '';
    if ( $o{listing} ) {
        $loc = !$copies ? 'Sem exemplares no acervo.'
             : 'Localização: ' . ( clean($calls) ne '' ? clean($calls) : 'sem número de chamada' ) . " ($copies ex.).";
    } else {
        next if $seen{$ref}++;
    }
    $undated++ if $miss;
    push @refs, [ sort_key($ref), $ref, $loc, $bn ];
}
close $in;
@refs = sort { $a->[0] cmp $b->[0] || $a->[3] <=> $b->[3] } @refs;

open( my $t, '>:encoding(UTF-8)', $o{text} ) or die "cannot write $o{text}\n";
print {$t} "$o{caption}\n\n" if $o{caption} ne '';
print {$t} "REFERÊNCIAS\n\n";
for (@refs) { ( my $r = $_->[1] ) =~ s/[\x{1}\x{2}]//g; print {$t} $r, "\n", ( $_->[2] ne '' ? "    $_->[2]\n" : '' ), "\n" }
close($t) or die "cannot write $o{text}\n";

open( my $h, '>:encoding(UTF-8)', $o{html} ) or die "cannot write $o{html}\n";
my $cap = html_escape( $o{caption} );
print {$h} <<"HTML";
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>${\( $cap ne '' ? $cap : 'Referências' )}</title>
<!-- Koha Easy Installer: references by ABNT NBR 6023:2018, presented as NBR 14724 (A4, margins 3 cm top/left and 2 cm bottom/right, Times 12, single spacing, a blank line between references). -->
<style>
\@page { size: A4; margin: 3cm 2cm 2cm 3cm; }
body { font-family: "Times New Roman", Times, serif; font-size: 12pt; line-height: 1; color: #000; background: #fff; max-width: 16cm; margin: 1cm auto; }
.caption { text-align: center; margin: 0 0 24pt; }
h1 { font-size: 12pt; font-weight: bold; text-align: center; text-transform: uppercase; margin: 0 0 12pt; }
p.ref { text-align: left; margin: 0 0 12pt; }
p.loc { text-align: left; margin: -9pt 0 12pt 1.25cm; font-size: 10pt; }
\@media print { body { margin: 0; max-width: none; } }
</style>
</head>
<body>
HTML
print {$h} qq{<p class="caption">$cap</p>\n} if $cap ne '';
print {$h} "<h1>Referências</h1>\n";
for (@refs) {
    my $r = html_escape( $_->[1] );
    $r =~ s/\x{1}/<strong>/g;
    $r =~ s/\x{2}/<\/strong>/g;
    print {$h} qq{<p class="ref">$r</p>\n};
    print {$h} qq{<p class="loc">} . html_escape( $_->[2] ) . "</p>\n" if $_->[2] ne '';
}
print {$h} "</body>\n</html>\n";
close($h) or die "cannot write $o{html}\n";
print "References: ", scalar(@refs), "\n";
print "Without date: $undated\n";
print "Records not read: $bad\n";
ABNTPL
}

lt_br_abnt() {
    require_database || return 0
    local title src sel a b n bib cond caption listing dir active="i.itemlost = 0 AND i.withdrawn = 0"
    title="$(t "ABNT references (NBR 6023)")"
    src=$(ui_menu "$title" "$(t "Bibliography or collection listing with the references by ABNT NBR 6023 and the NBR 14724 presentation (HTML for Word or LibreOffice, and plain text). Records to include:")" \
        "list"    "$(t "A Koha list (e.g. the basic bibliography of a course)")" \
        "new"     "$(t "Items added in a period (new acquisitions)")" \
        "class"   "$(t "Call numbers starting with a class (e.g. 869 or 3)")" \
        "branch"  "$(t "The whole collection of a library")" \
        "numbers" "$(t "Record numbers typed by hand")") || return 0
    case "$src" in
        list)
            if [ "$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.virtualshelves;")" = "0" ]; then
                msg_info "$title" "$(t "Koha has no list yet (OPAC or staff interface > Lists). Nothing was written.")" 9 72
                return 0
            fi
            sel=$(tools_pick "$title" "$(t "Koha list:")" "SELECT shelfnumber, shelfname FROM ${DB_NAME}.virtualshelves ORDER BY shelfname;") || return 0
            [[ "$sel" =~ ^[0-9]+$ ]] || return 0
            bib="SELECT biblionumber FROM ${DB_NAME}.virtualshelfcontents WHERE shelfnumber = ${sel}"
            cond="$active"
            caption="$(run_sql "SELECT shelfname FROM ${DB_NAME}.virtualshelves WHERE shelfnumber = ${sel};")" ;;
        new)
            a=$(ui_input "$title" "$(t "First day (YYYY-MM-DD):")" "$(date +%Y)-01-01") || return 0
            b=$(ui_input "$title" "$(t "Last day (YYYY-MM-DD):")" "$(date +%F)") || return 0
            if ! valid_date "$a" || ! valid_date "$b"; then
                msg_error "" "$(t "Invalid date. Use YYYY-MM-DD.\nNothing was written.")" 9 64
                return 1
            fi
            cond="$active AND i.dateaccessioned BETWEEN '${a}' AND '${b}'"
            bib="SELECT i.biblionumber FROM ${DB_NAME}.items i WHERE ${cond}"
            caption="$(t 'New acquisitions from ${a} to ${b}')" ;;
        class)
            a=$(ui_input "$title" "$(t "Beginning of the call number (e.g. 869 for Brazilian literature, 3 for social sciences):")" "") || return 0
            if ! [[ "$a" =~ ^[0-9A-Za-z.]{1,15}$ ]]; then
                msg_error "" "$(t "Use only digits, letters and dots (up to 15).\nNothing was written.")" 9 64
                return 1
            fi
            cond="$active AND i.itemcallnumber LIKE '${a}%'"
            bib="SELECT i.biblionumber FROM ${DB_NAME}.items i WHERE ${cond}"
            caption="$(t 'Collection: call numbers ${a}')" ;;
        branch)
            sel=$(tools_pick "$title" "$(t "Library")" "SELECT branchcode, branchname FROM ${DB_NAME}.branches ORDER BY branchname;") || return 0
            cond="$active AND i.homebranch = $(sql_quote "$sel")"
            bib="SELECT i.biblionumber FROM ${DB_NAME}.items i WHERE ${cond}"
            caption="$(run_sql "SELECT branchname FROM ${DB_NAME}.branches WHERE branchcode = $(sql_quote "$sel");")" ;;
        numbers)
            a=$(ui_input "$title" "$(t "Record numbers (biblionumber), separated by spaces or commas:")" "") || return 0
            a=$(tr ',;' '  ' <<< "$a" | xargs 2>/dev/null)
            if ! [[ "$a" =~ ^[0-9]+(\ [0-9]+)*$ ]]; then
                msg_error "" "$(t "Use only record numbers separated by spaces or commas.\nNothing was written.")" 9 70
                return 1
            fi
            bib="SELECT biblionumber FROM ${DB_NAME}.biblio WHERE biblionumber IN (${a// /, })"
            cond="$active"
            caption="" ;;
        *) return 0 ;;
    esac
    n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.biblio_metadata m WHERE m.format = 'marcxml' AND m.biblionumber IN (${bib});")
    if [ "${n:-0}" = "0" ]; then
        msg_info "$title" "$(t "No record found. Nothing was written.")" 8 60
        return 0
    fi
    listing=""
    prompt_yes_no "$title" "$(t 'Records found: ${n}\n\nAdd the call numbers and the number of copies under each reference (collection listing)?\n\nChoose No for a plain bibliography (e.g. for students or the MEC evaluators).')" 14 74 defaultno && listing="--listing"
    dir=$(select_directory "/root") || return 0
    tools_workdir || return 1
    _lt_br_abnt_run "$bib" "$cond" "$caption" "$listing" "$dir"
    local rc=$?
    [ -d "$TOOLS_WORK" ] && rm -f "$TOOLS_WORK"/abnt-*
    return "$rc"
}

_lt_br_abnt_run() {
    local bib="$1" cond="$2" caption="$3" listing="$4" dir="$5" log data script stamp html text refs undated bad
    local args=()
    log=$(tools_log abnt)
    # koha-shell cannot pass a single quote or a line break (kq): a list
    # named "Leitura d'água" gets a typographic apostrophe in the caption.
    caption="${caption//\'/’}"; caption="${caption//$'\n'/ }"
    data="$TOOLS_WORK/abnt-records.tsv"; script="$TOOLS_WORK/abnt-format.pl"
    stamp=$(date +%Y%m%d-%H%M%S)
    display_explanation "Formatting the references..."
    run_sql "SELECT m.biblionumber, COALESCE((SELECT GROUP_CONCAT(DISTINCT i.itemcallnumber ORDER BY i.itemcallnumber SEPARATOR ' | ') FROM ${DB_NAME}.items i WHERE i.biblionumber = m.biblionumber AND ${cond}), ''), (SELECT COUNT(*) FROM ${DB_NAME}.items i WHERE i.biblionumber = m.biblionumber AND ${cond}), REPLACE(REPLACE(REPLACE(m.metadata, '\r', ' '), '\n', ' '), '\t', ' ') FROM ${DB_NAME}.biblio_metadata m WHERE m.format = 'marcxml' AND m.biblionumber IN (${bib}) ORDER BY m.biblionumber;" > "$data"
    abnt_write_formatter "$script"
    chown "${INSTANCE}-koha:" "$data" "$script" 2>/dev/null || true
    chmod 600 "$data" "$script"
    args=(--in "$data" --html "$TOOLS_WORK/abnt-out.html" --text "$TOOLS_WORK/abnt-out.txt" --caption "$caption")
    [ -n "$listing" ] && args+=("$listing")
    if ! koha_exec "$log" abnt-format /usr/bin/perl "$script" "${args[@]}" || [ ! -s "$TOOLS_WORK/abnt-out.html" ]; then
        ui_textbox "$(t "ABNT references (NBR 6023)")" "$log"
        msg_error "" "$(t 'Koha could not complete the request. Nothing was written.\n\nLog: ${log}')" 10 74
        return 1
    fi
    html="${dir%/}/referencias-abnt-${stamp}.html"; text="${dir%/}/referencias-abnt-${stamp}.txt"
    if ! cp -f -- "$TOOLS_WORK/abnt-out.html" "$html" || ! cp -f -- "$TOOLS_WORK/abnt-out.txt" "$text"; then
        msg_error "" "$(t 'The files could not be written in ${dir}.')" 9 72
        return 1
    fi
    chmod 644 "$html" "$text"
    refs=$(tools_num "$log" "References:"); undated=$(tools_num "$log" "Without date:"); bad=$(tools_num "$log" "Records not read:")
    head -n 60 "$text" > "$TOOLS_WORK/abnt-preview.txt"
    ui_textbox "$(t "ABNT references (NBR 6023)")" "$TOOLS_WORK/abnt-preview.txt"
    log "tools: ABNT references written ($refs) in $dir"
    msg_ok "$(t '✔ References: ${refs}\nWithout a publication date: ${undated} (NBR 6023 asks for an estimated date in brackets, e.g. [2010?])\nRecords not read: ${bad}\n\nOpen the HTML file in Word or LibreOffice:\n${html}\n${text}')" 15 76
}

