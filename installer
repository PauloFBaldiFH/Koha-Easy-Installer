# ======================================================================
# 26. UPDATE THE PANEL
# ======================================================================
function_autoupdate() {
    clear
    display_explanation "Looking for updates in the repository..."

    local remote_version
    remote_version=$(curl -fsSL --retry 2 --connect-timeout 5 --max-time 10 "$UPDATE_URL" | grep -m1 '^PANEL_VERSION=' | cut -d'=' -f2 | tr -d '"' | tr -d "'")

    if [ -z "$remote_version" ]; then
        msg_error "" "$(t "Could not check the version on GitHub. Check your internet connection or the update URL.")" 10 76
        return 1
    fi

    if [ "$remote_version" = "$PANEL_VERSION" ]; then
        msg_ok "$(t "The panel is already at the latest version!\n\nNo update required.\nInstalled version: \${PANEL_VERSION}")" 10 70
        return 0
    fi

    if ! prompt_yes_no "$(t "Update Available")" \
"$(t "A new version of the panel was found on GitHub.\n\nCurrent installed version: \${PANEL_VERSION}\nNew available version    : \${remote_version}\n\nThe system will download it, validate the SHA-256 signature, and create a backup before replacing.\n\nDownload and update now?")" 16 80; then
        return 0
    fi

    clear
    display_explanation "Downloading version \${remote_version} and SHA-256 signature..."
    local target="/usr/local/bin/config.sh"
    local target_dir; target_dir=$(dirname "$target")
    
    local tmp; tmp="$(mktemp "${target_dir}/.config.sh.update.XXXXXX")"
    local tmp_sha; tmp_sha="$(mktemp "${target_dir}/.config.sh.sha256.XXXXXX")"
    
    if [ -z "$tmp" ] || [ -z "$tmp_sha" ]; then
        msg_error "" "$(t "Could not create temporary files in the panel directory.")" 9 76
        return 1
    fi

    if ! curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 "$UPDATE_URL" -o "$tmp" || \
       ! curl -fsSL --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 30 "${UPDATE_URL}.sha256" -o "$tmp_sha"; then
        rm -f "$tmp" "$tmp_sha"
        msg_error "" "$(t "Update download failed (script or signature missing). The current panel keeps working.")" 10 78
        return 1
    fi

    display_explanation "Verifying cryptographic signature (SHA-256)..."
    local expected_hash actual_hash
    expected_hash=$(awk '{print $1}' "$tmp_sha" 2>/dev/null)
    actual_hash=$(sha256sum "$tmp" | awk '{print $1}')

    if [ -z "$expected_hash" ] || [ "$expected_hash" != "$actual_hash" ]; then
        rm -f "$tmp" "$tmp_sha"
        msg_error "" "$(t "SECURITY ALERT: The downloaded file does NOT match the expected SHA-256 signature.\nUpdate aborted to protect the server.")" 11 78
        return 1
    fi

    if ! bash -n "$tmp" 2>/dev/null; then
        rm -f "$tmp" "$tmp_sha"
        msg_error "" "$(t "The downloaded file has a syntax error. Update cancelled to avoid system issues.")" 10 78
        return 1
    fi

    chmod 755 "$tmp"
    local backup
    backup="${target}.bak-$(date +%Y%m%d-%H%M%S)"
    if [ -f "$target" ]; then
        if ! cp -p "$target" "$backup"; then
            rm -f "$tmp" "$tmp_sha"
            msg_error "" "$(t "Could not create a backup of the current panel. Update cancelled.")" 10 76
            return 1
        fi
    fi

    if mv -f "$tmp" "$target" && chmod 755 "$target" && chown root:root "$target"; then
        log "panel updated from version $PANEL_VERSION to $remote_version (SHA-256 verified)"
        # Dictionaries are downloaded again on the next start (they are now
        # older than the panel); the bundled copy is dropped to force it.
        rm -f "${CONFIG_DIR}/lang/${SYS_LANG}.cache" 2>/dev/null || true
        msg_ok "$(t "Panel updated successfully to v\${remote_version}!\n\nBackup of the old version saved at:\n\${backup}\n\nPress OK to exit. Open again with: sudo config.sh")" 14 78
        rm -f "$tmp_sha"
        exit 0
    fi

    rm -f "$tmp" "$tmp_sha"
    if [ -f "$backup" ]; then
        cp -p "$backup" "$target" 2>/dev/null || true
    fi
    msg_error "" "$(t "Failed to replace the main file. The current version (\$PANEL_VERSION) was kept intact.")" 10 78
    return 1
}

# ======================================================================
# 26.1. SECURITY CENTER
# ======================================================================
# Security center under WSL: UFW and Fail2ban are not installed, network
# access to Koha is filtered by Windows Defender Firewall.
windows_firewall_notice() {
    msg_info "$(t "Windows firewall")" "$(t "On Windows (WSL), Koha is protected by Windows Defender Firewall: UFW and Fail2ban are not used.\n\nOther computers reach ports 80 and 8080 only when Windows allows it (Windows 11 with mirrored networking). To publish the catalog, use option 6 (Cloudflare Tunnel).")" 14 76
}

function_fail2ban_status() {
    local info="" jail
    if ! host_can fail2ban; then
        windows_firewall_notice
        return 0
    fi
    if ! command -v fail2ban-client >/dev/null 2>&1; then
        msg_error "" "$(t "Fail2ban is not installed. Install Koha first (option 1).")" 9 70
        return 0
    fi
    for jail in sshd apache-auth apache-badbots; do
        info+="=== ${jail} ===\n$(fail2ban-client status "$jail" 2>/dev/null || t 'jail inactive')\n\n"
    done
    whiptail --title "$(t '⚠ Fail2ban')" --scrolltext --msgbox "$(printf '%b' "$info")" 24 78 || true
}

function_staff_firewall() {
    if ! host_can firewall; then
        windows_firewall_notice
        return 0
    fi
    if ! command -v ufw >/dev/null 2>&1; then
        msg_error "" "$(t "UFW firewall is not installed. Install Koha first (option 1).")" 9 70
        return 0
    fi
    if prompt_yes_no "$(t 'Staff firewall')" \
"$(t 'Port 80 (OPAC) must stay open to the public.\nPort 8080 (staff) can be closed to the internet if you use\nCloudflare Tunnel or only access it from the local network.\n\nBLOCK direct external access to 8080?')" 14 78; then
        # UFW applies the first matching rule: the "allow" rules for the
        # local networks must exist before the final "deny".
        ufw delete allow 8080/tcp >/dev/null 2>&1
        ufw delete deny 8080/tcp >/dev/null 2>&1
        ufw allow from 127.0.0.1 to any port 8080 proto tcp >/dev/null 2>&1
        ufw allow from 10.0.0.0/8 to any port 8080 proto tcp >/dev/null 2>&1
        ufw allow from 172.16.0.0/12 to any port 8080 proto tcp >/dev/null 2>&1
        ufw allow from 192.168.0.0/16 to any port 8080 proto tcp >/dev/null 2>&1
        ufw deny 8080/tcp >/dev/null 2>&1
        log "staff port 8080 restricted to local networks"
        msg_ok "$(t 'Port 8080 now allowed only from 127.0.0.1 and the local network.')" 9 72
    else
        ufw delete deny 8080/tcp >/dev/null 2>&1
        ufw allow 8080/tcp >/dev/null 2>&1
        log "staff port 8080 opened"
        msg_ok "$(t 'Port 8080 is open.')" 8 60
    fi
}

function_rotate_db_password() {
    require_koha || return 0
    command -v xmllint >/dev/null 2>&1 || apt_install libxml2-utils >/dev/null 2>&1
    prompt_yes_no "$(t 'Rotate Password')" \
"$(t 'A new strong password will be generated for the database user,\nkoha-conf.xml updated and services restarted.\n\nContinue?')" 12 74 || return 0
    clear
    local new_pass old_pass xml_bak
    new_pass=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)
    old_pass=$(get_database_password)
    xml_bak="${KOHA_CONF}.bak-$(date +%s)"
    if ! cp -p "$KOHA_CONF" "$xml_bak"; then
        msg_error "" "$(t 'Could not back up koha-conf.xml. Password was not changed.')" 9 74
        return 1
    fi
    if ! mysql -e "ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${new_pass}'; FLUSH PRIVILEGES;"; then
        msg_error "" "$(t 'Failed to change the password in MariaDB. Nothing was changed.')" 9 72
        return 1
    fi
    sed -i "s|<pass>[^<]*</pass>|<pass>${new_pass}</pass>|g" "$KOHA_CONF"
    if ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1 || [ "$(get_database_password)" != "$new_pass" ]; then
        cp -p "$xml_bak" "$KOHA_CONF"
        mysql -e "ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${old_pass}'; FLUSH PRIVILEGES;" >/dev/null 2>&1 || true
        msg_error "" "$(t 'The new password was rolled back because koha-conf.xml became invalid.\nNothing was restarted.')" 11 76
        return 1
    fi
    # The credentials file is translated, so replace the old value itself
    # instead of looking for a "Password:" label.
    if [ -f "$CREDENTIALS_FILE" ] && [ -n "$old_pass" ]; then
        local cred
        cred=$(<"$CREDENTIALS_FILE")
        printf '%s\n' "${cred//"$old_pass"/"$new_pass"}" > "$CREDENTIALS_FILE"
    fi
    systemctl restart memcached koha-common >/dev/null 2>&1
    plack_restart
    sleep 2
    if curl -sS -o /dev/null --max-time 15 -w '%{http_code}' "http://127.0.0.1:8080/" 2>/dev/null | grep -Eq '^[23]'; then
        log "database password rotated"
        msg_ok "$(t 'Password rotated and Koha still responds.\n\nNew password: ')${new_pass}\n(${CREDENTIALS_FILE})" 12 74
    else
        msg_error "" "$(t 'Password changed but Koha did not answer the test.\nPrevious XML copy at ')${xml_bak}" 11 76
    fi
}

