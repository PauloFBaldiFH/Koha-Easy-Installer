        echo "  netsh int ipv6 set dynamic tcp start=49152 num=16384"
        echo '  rclone authorize "drive"'
        echo "----------------------------------------------------------------------"
        echo "$(t "STEP 2: Your browser will open. Log in with the library Google account and authorize.")"
        echo "$(t "STEP 3: Your PC will print a long token string starting with '{\"' and ending with '}'.")"
        echo "----------------------------------------------------------------------"
        echo ""
        local token_input=""
        ALLOW_CTRL_C_RETURN=1
        while true; do
            echo -e "\e[1;32m$(t "Paste the complete token JSON string below and press [ENTER]:")\e[0m"
