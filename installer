# Photos -> model -> rules -> a draft the librarian corrects.
sub do_vision {
    my ($cgi) = @_;
    my $conf = KohaEasy::Cataloguing::Vision::load_conf($VISION_CONF);
    my $bn   = digits( scalar $cgi->param('biblionumber') );
    if ( $bn ne '' && !Koha::Biblios->find($bn) ) {
        render_vision_form( $cgi, err_box( $T{err_nobib} . " ($bn)" ) );
        return;
    }
    my @images;
    for my $role (qw( cover title verso )) {
        my $fh = $cgi->upload("img_$role") or next;
        binmode $fh;
        my $raw = do { local $/; <$fh> };
        next unless defined $raw && length $raw;
        my $img = eval { KohaEasy::Cataloguing::Vision::prepare_image( $raw, $conf->{max_px} ) };
        if ( !$img ) {
            render_vision_form( $cgi, err_box( $T{v_err_image} ) );
            return;
        }
        push @images, { %$img, role => $role };
    }
    if ( !@images ) {
        render_vision_form( $cgi, err_box( $T{v_err_noimg} ) );
        return;
    }

    my $res = KohaEasy::Cataloguing::Vision::extract( $conf, \@images );
    if ( !$res->{ok} ) {
        my $code = $res->{error_code} eq 'CONFIG' ? $res->{error} : $res->{error_code};
        my $msg  = $T{v_err_model} . ' ' . ( $T{"e_$code"} // $code );
        $msg .= ' ' . $res->{error} if $res->{error_code} =~ /^(?:UNREACHABLE|HTTP|NO_JSON)$/ && $res->{error} ne '';
        render_vision_form( $cgi, err_box($msg) );
        return;
    }

    my $built = KohaEasy::Cataloguing::Rules::build(
        $res->{data},
        {
            lang        => $conf->{lang},
            country     => $conf->{country},
            org_code    => $conf->{org_code},
            ddc_edition => $conf->{ddc_edition},
            table       => $conf->{table},
            table_dir   => $TABLE_DIR,
        }
    );

    my $d = $res->{data};
    my @warnings;
    for my $w ( @{ $built->{warnings} } ) {
        if ( $w =~ /^ISBN ([0-9X]+)/ ) { push @warnings, "$T{v_w_isbn} $1"; next }
        push @warnings, $T{"v_w_$w"} if $T{"v_w_$w"};
    }
    my %label = map { $_ => $T{"f_$_"} // $_ } @{ $res->{missing} };
    my $info = '<p class="hint">' . h("$res->{provider} / $res->{model} ($res->{seconds} s)") . '</p>';
    $info .= warn_box( $T{v_missing} . ' ' . join( ', ', map { $label{$_} } @{ $res->{missing} } ) ) if @{ $res->{missing} };
    $info .= warn_box(@warnings) if @warnings;
    $info .= warn_box( $T{v_model_notes} . ' ' . $d->{notes} ) if $d->{notes} ne '';

    if ( @{ $built->{report} } ) {
        $info .= '<h3>' . h( $T{v_rules} ) . '</h3><table class="rules">';
        for my $r ( @{ $built->{report} } ) {
            my ( $rule, $value, $source, $detail ) = @$r;
            my $src =
                  $rule eq 'ddc'      ? $T{"src_$source"} // $source
                : $rule eq 'notation' ? $T{"table_$source"} // $source
                : $rule eq 'isbn'     ? ( $source eq 'ok' ? $T{isbn_ok} : $T{isbn_bad} )
                :                       '';
            $detail = ddc_caption_text($detail) if $rule eq 'ddc';
            $info .= '<tr><th>' . h( $T{"r_$rule"} // $rule ) . '</th><td><b>' . h($value) . '</b></td><td>' . h( join( ' ', grep { defined && $_ ne '' } $src, $detail ) ) . '</td></tr>';
        }
        $info .= '</table>';
    }

    my $photos = '<h3>' . h( $T{v_photos} ) . '</h3><div class="photos">'
        . join( '', map { '<img src="data:' . $_->{mime} . ';base64,' . encode_base64( $_->{data}, '' ) . '" alt="' . h( $T{"v_img_$_->{role}"} ) . '">' } @images )
        . '</div>';
    my $extraction = encode_base64( JSON::PP->new->utf8->canonical->encode( { provider => $res->{provider}, model => $res->{model}, data => $d } ), '' );
    render_draft( $cgi, $info . $photos, KohaEasy::Cataloguing::Rules::as_text( $built->{record} ), $extraction );
    return;
}

# The main class of the CDD in the language of the page (the caption of
# the schedule loaded by the library is shown as it is).
sub ddc_caption_text {
    my $detail = shift // '';
    return $detail =~ /^(\d)00 / && $T{"ddc$1"} ? "$1" . "00 " . $T{"ddc$1"} : $detail;
}

# The draft: MARC lines the librarian can correct, then the preview (the
# replacement's own preview when a biblionumber was given).
sub render_draft {
    my ( $cgi, $info, $text, $extraction ) = @_;
    my $bn   = digits( scalar $cgi->param('biblionumber') );
    my $itype = $cgi->param('itemtype') // '';
    my $body = '<h2>' . h( $T{v_draft} ) . ( $bn ne '' ? ' (' . h( $T{bn} ) . " $bn)" : '' ) . '</h2>' . $info;
    $body .= '<form method="post" enctype="multipart/form-data">'
        . '<input type="hidden" name="op" value="' . ( $bn ne '' ? 'cud-preview' : 'cud-vision-preview' ) . '">'
        . '<input type="hidden" name="csrf_token" value="' . h( csrf($cgi) ) . '">'
        . '<input type="hidden" name="biblionumber" value="' . h($bn) . '">'
        . '<input type="hidden" name="itemtype" value="' . h($itype) . '">'
        . '<input type="hidden" name="frameworkcode" value="' . h( framework_param( scalar $cgi->param('frameworkcode') ) ) . '">'
