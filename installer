# Patrons' SMS numbers checked with the same rules as the driver (read-only
# report; the corrected numbers can then be written, with a backup).
lt_msg_phones() {
    local lib data out log fixed
    tools_workdir || return 1
    lib=$(msg_perl_lib) || return 1
    data="$TOOLS_WORK/phones.tsv"; out="$TOOLS_WORK/phones-report.txt"; log=$(tools_log messaging-phones)
    run_sql "SELECT borrowernumber, cardnumber, smsalertnumber FROM ${DB_NAME}.borrowers WHERE smsalertnumber IS NOT NULL AND smsalertnumber <> '';" > "$data"
    printf '%s\n' "$(t "SMS numbers of the patrons (country and area code from the messaging settings):")" "$(t "Complete and correct")" \
        "$(t "Can be corrected")" "$(t "Landlines (WhatsApp only if the number has it)")" "$(t "Invalid (fix them by hand)")" > "$TOOLS_WORK/phones-labels.txt"
    cat > "$TOOLS_WORK/phones.pl" <<'PHONESPL'
use strict; use warnings; use KohaEasy::Messaging;
# phones.pl DATA SQL REPORT LABELS COUNTRY AREA: the patrons' SMS numbers
# checked with the rules of the driver; corrections go to SQL.
my ( $data, $sql, $report, $labels, $cc, $area ) = @ARGV;
open( my $l, '<:encoding(UTF-8)', $labels ) or die "$labels: $!\n";
chomp( my @l = <$l> );
close $l;
my %n = ( ok => 0, fixed => 0, landline => 0, invalid => 0 );
my @lines;
open( my $in, '<:encoding(UTF-8)', $data ) or die "$data: $!\n";
open( my $s, '>', $sql ) or die "$sql: $!\n";
print {$s} "START TRANSACTION;\n";
while ( my $row = <$in> ) {
    chomp $row;
    my ( $bn, $card, $num ) = split /\t/, $row, 3;
    next unless defined $bn && $bn =~ /^\d+$/;
    my ( $e, $k ) = KohaEasy::Messaging::normalize_phone( $num, $cc, $area );
    $n{$k}++;
    if ( $k eq 'fixed' ) {
        push @lines, sprintf( "  %-16s %-22s -> %s", $card // '', $num, $e );
        print {$s} "UPDATE borrowers SET smsalertnumber = '$e' WHERE borrowernumber = $bn;\n";
    } elsif ( $k eq 'invalid' ) {
        push @lines, sprintf( "  %-16s %-22s -> ?", $card // '', $num );
    }
}
print {$s} "COMMIT;\n";
close $s;
open( my $r, '>:encoding(UTF-8)', $report ) or die "$report: $!\n";
printf {$r} "%s\n\n  %s: %d\n  %s: %d\n  %s: %d\n  %s: %d\n\n", $l[0], $l[1], $n{ok}, $l[2], $n{fixed}, $l[3], $n{landline}, $l[4], $n{invalid};
print {$r} "$_\n" for @lines[ 0 .. ( $#lines < 299 ? $#lines : 299 ) ];
close $r;
print "Fixed: $n{fixed}\n";
PHONESPL
    chmod 644 "$data" "$TOOLS_WORK/phones.pl" "$TOOLS_WORK/phones-labels.txt"
    if ! koha_exec "$log" phones /usr/bin/perl -I "$lib" "$TOOLS_WORK/phones.pl" "$data" "$TOOLS_WORK/phones.sql" "$out" \
            "$TOOLS_WORK/phones-labels.txt" "$(msg_conf country)" "$(msg_conf area)" || [ ! -s "$out" ]; then
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    fixed=$(tools_num "$log" "Fixed:")
    ui_textbox "$(t "Check the patrons' phone numbers")" "$out"
    [ "${fixed:-0}" -gt 0 ] 2>/dev/null || return 0
    prompt_yes_no "$(t "Check the patrons' phone numbers")" "$(t 'Write the ${fixed} corrected number(s) to the SMS number of the patrons (international format, e.g. +5544998765432)? A verified backup is made first.')" 11 74 defaultno || return 0
    tools_locked _lt_msg_phones_fix "$fixed"
}

