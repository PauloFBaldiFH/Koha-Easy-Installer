function_manage_crons() {
    require_koha || return 0
    [ -f "$CRON_TASKS" ] || write_cron_tasks

    while true; do
        local cron_choice
        cron_choice=$(whiptail --title "$(t "Schedules & Scheduled Tasks")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "The Cron service runs routine maintenance and backup jobs without human intervention.")" 18 78 4 \
            "1" "$(t "📖 Understand what each automated task does")" \
            "2" "$(t "📋 View active tasks and schedules")" \
            "3" "$(t "⚙️ Restore/Regenerate default schedules")" \
            "4" "$(t "✏️ Edit schedules manually (Advanced - nano)")" \
            3>&1 1>&2 2>&3) || return 0

        [ -z "$cron_choice" ] && return 0

        case "$cron_choice" in
            1)
                local txt_help
                txt_help="$(t "AUTOMATED TASKS BREAKDOWN:\n\n")"
                txt_help+="$(t "• Database Backup (23:00 daily):\n  Generates .sql.gz archive, verifies integrity, and syncs to cloud.\n\n")"
                txt_help+="$(t "• MARC21 Records Backup (Sundays at 03:00):\n  Exports catalog and authorities in standard MARC21 exchange format.\n\n")"
                txt_help+="$(t "• DB & Session Cleanup (01:30 daily):\n  Purges stale web sessions keeping database and browsing responsive.\n\n")"
                txt_help+="$(t "• Plack Accelerator Maintenance (05:00 daily):\n  Flushes workers ensuring stable low memory consumption.\n\n")"
                txt_help+="$(t "• E-mail notices (Koha's own schedule, once e-mail is enabled):\n  Overdue and advance notices daily, message queue every 15 minutes.\n\n")"
                txt_help+="$(t "• Incremental Catalog Indexing (every 2 min):\n  Ensures new titles become searchable in the OPAC almost immediately.")"

                whiptail --title "$(t "Automated Tasks Guide")" --scrolltext --msgbox "$txt_help" 22 80 2>/dev/null || true
                ;;
            2)
                local current_content
                current_content=$(cat "$CRON_TASKS" 2>/dev/null || echo "$(t "File not found.")")
                whiptail --title "$(t "Active Tasks in /etc/cron.d/koha_tasks")" \
                    --scrolltext --msgbox "$current_content" 24 82 2>/dev/null || true
                ;;
            3)
                if prompt_yes_no "$(t "Regenerate Tasks")" \
                    "$(t "Do you want to regenerate default tasks?\nThis will recreate the file with full bilingual documentation.")" 10 74; then
                    write_cron_tasks
                    msg_ok "$(t "Automated tasks restored and cron restarted successfully!")" 8 68
                fi
                ;;
            4)
                msg_info "$(t "Advanced Editor")" \
                    "$(t "The schedule file will open in nano.\n\nChange only the NUMBERS in the first two columns (minute and hour).\nDo not delete the PATH line at the top.\n\nTo save: CTRL+O, ENTER, then CTRL+X.")" 16 76
                cp -f "$CRON_TASKS" "${CRON_TASKS}.bak" 2>/dev/null
                nano "$CRON_TASKS"
                chmod 644 "$CRON_TASKS"
                if ! grep -q '^PATH=' "$CRON_TASKS"; then
                    sed -i "1i $CRON_PATH" "$CRON_TASKS"
                    msg_info "$(t "Fixed")" "$(t "The PATH line had been removed. It was restored automatically.")" 9 70
                fi
                systemctl restart cron >/dev/null 2>&1
                msg_ok "$(t "Schedules updated successfully.\nPrevious copy saved at: \${CRON_TASKS}.bak")" 9 70
                ;;
        esac
    done
}

