# ======================================================================
# "user@ip" (plus -p PORT when SSH is not on 22) used to reach this server.
get_ssh_login() {
    local ip="${1:-$(get_server_ip)}" user="${REAL_USER:-root}" port
    [ "$user" = "root" ] && [ -n "${SUDO_USER:-}" ] && user="$SUDO_USER"
    port=$(get_ssh_ports | head -n1)
    if [ -n "$port" ] && [ "$port" != "22" ]; then
        printf '%s@%s -p %s' "$user" "$ip" "$port"
    else
        printf '%s@%s' "$user" "$ip"
    fi
}

function_view_credentials() {
    require_koha || return 0
    local ip cf_section="" cf_opac cf_staff ssh_login
    ip=$(get_server_ip)
    ssh_login=$(get_ssh_login "$ip")

    read -r cf_opac cf_staff < <(tunnel_public_hosts)
    [ "$cf_opac" = "-" ] && cf_opac=""
    [ "$cf_staff" = "-" ] && cf_staff=""
    if [ -n "$cf_opac" ] || [ -n "$cf_staff" ]; then
        cf_section="$(t "\n[ INTERNET / CLOUDFLARE TUNNEL ]\n")"
        [ -n "$cf_opac" ] && cf_section+="  $(t "OPAC  (catalog)       :") https://${cf_opac}\n"
        [ -n "$cf_staff" ] && cf_section+="  $(t "Staff (administration):") https://${cf_staff}\n"
    fi

    local body
    body="$(t "ON THIS MACHINE (localhost):")\n"
    body+="  $(t "OPAC  (catalog)       :") http://localhost:80\n"
    body+="  $(t "Staff (administration):") http://localhost:8080\n\n"
    body+="$(t "FROM OTHER COMPUTERS ON THE NETWORK:")\n"
    body+="  $(t "OPAC  (catalog)       :") http://${ip}:80\n"
    body+="  $(t "Staff (administration):") http://${ip}:8080\n"
    body+="${cf_section}\n"
    body+="$(t "SSH ACCESS (remote terminal):")\n"
    body+="  ssh ${ssh_login}\n\n"
    body+="$(t "DATABASE CREDENTIALS (1st Access / Web Installer):")\n"
    body+="  $(t "User :") ${DB_NAME}\n"
    body+="  $(t "Pass :") $(get_database_password)\n\n"
    body+="$(t "Full file:") ${CREDENTIALS_FILE}"

    whiptail --title "$(t "Access Credentials")" --scrolltext --msgbox "$body" 25 78 || true
}

