    printf "SET NAMES utf8mb4;\nSTART TRANSACTION;\nDELETE FROM creator_templates WHERE template_code LIKE 'KEI-PIMACO-%%';\nDELETE FROM creator_layouts WHERE layout_name LIKE 'KEI %%' AND creator = 'Labels';\nCOMMIT;\n" > "$sql"
    if ! koha_sql_run "$log" "$sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    msg_ok "$(t "✔ The panel's label templates were removed.")" 8 64
}

# Catalogue card (ficha catalográfica, AACR2): an XSLT that imports Koha's
# default detail view of the same language and adds the card below it.
# Koha picks the file per language ({langcode} in the system preference).
ficha_xsl() {   # ficha_xsl DEFAULT_XSL TITLE PRINT_LABEL
    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
    printf '<!-- Koha Easy Installer: Koha'"'"'s default detail view plus the Brazilian catalogue card (ficha catalografica, AACR2). Generated file. -->\n'
    printf '<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:marc="http://www.loc.gov/MARC21/slim" exclude-result-prefixes="marc">\n'
    printf '  <xsl:import href="%s"/>\n' "$(xml_escape "$1")"
    printf '  <xsl:variable name="kei-title">%s</xsl:variable>\n' "$(xml_escape "$2")"
    printf '  <xsl:variable name="kei-print">%s</xsl:variable>\n' "$(xml_escape "$3")"
    cat <<'FICHA'
  <xsl:template match="marc:record">
    <xsl:apply-imports/>
    <xsl:call-template name="kei-ficha"/>
  </xsl:template>

  <xsl:template name="kei-sub">
    <xsl:param name="codes"/>
    <xsl:for-each select="marc:subfield[contains($codes, @code)]">
      <xsl:if test="position() &gt; 1"><xsl:text> </xsl:text></xsl:if>
      <xsl:value-of select="normalize-space(.)"/>
    </xsl:for-each>
  </xsl:template>

  <!-- AACR2 tracings and headings end with a full stop. -->
  <xsl:template name="kei-dot">
    <xsl:param name="s"/>
    <xsl:variable name="v" select="normalize-space($s)"/>
    <xsl:variable name="last" select="substring($v, string-length($v))"/>
    <xsl:choose>
      <xsl:when test="$v = ''"/>
      <xsl:when test="$last = ',' or $last = ';' or $last = ':' or $last = '/'"><xsl:value-of select="concat(normalize-space(substring($v, 1, string-length($v) - 1)), '.')"/></xsl:when>
      <xsl:when test="$last = '.' or $last = '?' or $last = '!' or $last = ')' or $last = '-'"><xsl:value-of select="$v"/></xsl:when>
      <xsl:otherwise><xsl:value-of select="concat($v, '.')"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template name="kei-ficha">
    <xsl:variable name="class">
      <xsl:choose>
        <xsl:when test="marc:datafield[@tag='090']/marc:subfield[@code='a']"><xsl:value-of select="marc:datafield[@tag='090']/marc:subfield[@code='a']"/></xsl:when>
        <xsl:when test="marc:datafield[@tag='082']/marc:subfield[@code='a']"><xsl:value-of select="marc:datafield[@tag='082']/marc:subfield[@code='a']"/></xsl:when>
        <xsl:otherwise><xsl:value-of select="marc:datafield[@tag='080']/marc:subfield[@code='a']"/></xsl:otherwise>
      </xsl:choose>
    </xsl:variable>
    <xsl:variable name="has-entry" select="boolean(marc:datafield[@tag='100' or @tag='110' or @tag='111'])"/>
    <div class="kei-ficha-box" id="kei-ficha">
      <style type="text/css">
.kei-ficha-box { margin: 1.5em 0; }
.kei-ficha { display: flex; gap: 0.3cm; box-sizing: border-box; width: 12.5cm; min-height: 7.5cm; padding: 0.4cm 0.5cm; border: 1px solid #333; background: #fff; color: #000; font-family: "Times New Roman", Times, serif; font-size: 10pt; line-height: 1.35; }
.kei-ficha-num { flex: 0 0 1.7cm; white-space: nowrap; }
.kei-ficha-body { flex: 1 1 auto; }
.kei-ficha-body p { margin: 0 0 0.35em 0; }
.kei-entrada { padding-left: 2.2em; text-indent: -2.2em; }
.kei-par { text-indent: 2.2em; }
.kei-pistas { text-indent: 2.2em; margin-top: 0.7em !important; }
.kei-cdd { text-align: right; margin-top: 0.7em !important; }
@media print {
  body.kei-print * { visibility: hidden; }
  body.kei-print #kei-ficha, body.kei-print #kei-ficha * { visibility: visible; }
  body.kei-print #kei-ficha { position: absolute; left: 0; top: 0; }
  .kei-ficha-print { display: none; }
}
      </style>
      <h3 class="kei-ficha-title"><xsl:value-of select="$kei-title"/></h3>
      <div class="kei-ficha">
        <div class="kei-ficha-num">
          <div><xsl:value-of select="$class"/></div>
          <div><xsl:value-of select="marc:datafield[@tag='090']/marc:subfield[@code='b']"/></div>
        </div>
        <div class="kei-ficha-body">
          <xsl:for-each select="(marc:datafield[@tag='100'] | marc:datafield[@tag='110'] | marc:datafield[@tag='111'])[1]">
            <p class="kei-entrada"><xsl:call-template name="kei-dot"><xsl:with-param name="s"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abcdnq</xsl:with-param></xsl:call-template></xsl:with-param></xsl:call-template></p>
          </xsl:for-each>
          <p>
            <xsl:attribute name="class"><xsl:choose><xsl:when test="$has-entry">kei-par</xsl:when><xsl:otherwise>kei-entrada</xsl:otherwise></xsl:choose></xsl:attribute>
            <xsl:for-each select="marc:datafield[@tag='245'][1]"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abnpc</xsl:with-param></xsl:call-template></xsl:for-each>
            <xsl:for-each select="marc:datafield[@tag='250'][1]"><xsl:text> – </xsl:text><xsl:call-template name="kei-sub"><xsl:with-param name="codes">ab</xsl:with-param></xsl:call-template></xsl:for-each>
            <xsl:for-each select="(marc:datafield[@tag='260'] | marc:datafield[@tag='264'][@ind2='1'])[1]"><xsl:text> – </xsl:text><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abc</xsl:with-param></xsl:call-template></xsl:for-each>
          </p>
          <xsl:if test="marc:datafield[@tag='300' or @tag='490']">
            <p class="kei-par">
              <xsl:for-each select="marc:datafield[@tag='300'][1]"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abce</xsl:with-param></xsl:call-template></xsl:for-each>
              <xsl:for-each select="marc:datafield[@tag='490']"><xsl:text> – (</xsl:text><xsl:call-template name="kei-sub"><xsl:with-param name="codes">av</xsl:with-param></xsl:call-template><xsl:text>)</xsl:text></xsl:for-each>
            </p>
          </xsl:if>
          <xsl:for-each select="marc:datafield[@tag='500']"><p class="kei-par"><xsl:value-of select="normalize-space(marc:subfield[@code='a'])"/></p></xsl:for-each>
          <xsl:for-each select="marc:datafield[@tag='020']/marc:subfield[@code='a']"><p class="kei-par">ISBN <xsl:value-of select="normalize-space(.)"/></p></xsl:for-each>
          <p class="kei-pistas">
            <xsl:for-each select="marc:datafield[@tag='600' or @tag='610' or @tag='611' or @tag='630' or @tag='650' or @tag='651']">
              <xsl:value-of select="position()"/><xsl:text>. </xsl:text>
              <xsl:call-template name="kei-dot"><xsl:with-param name="s">
                <xsl:for-each select="marc:subfield[contains('abcdtvxyz', @code)]">
                  <xsl:if test="position() &gt; 1"><xsl:choose><xsl:when test="contains('vxyz', @code)"><xsl:text> – </xsl:text></xsl:when><xsl:otherwise><xsl:text> </xsl:text></xsl:otherwise></xsl:choose></xsl:if>
                  <xsl:value-of select="normalize-space(.)"/>
                </xsl:for-each>
              </xsl:with-param></xsl:call-template>
              <xsl:text> </xsl:text>
            </xsl:for-each>
            <xsl:for-each select="marc:datafield[@tag='700' or @tag='710' or @tag='711']">
              <xsl:number value="position()" format="I"/><xsl:text>. </xsl:text>
              <xsl:call-template name="kei-dot"><xsl:with-param name="s"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abcdq</xsl:with-param></xsl:call-template></xsl:with-param></xsl:call-template>
              <xsl:text> </xsl:text>
            </xsl:for-each>
            <xsl:if test="marc:datafield[@tag='245'][1]/@ind1 = '1'">
              <xsl:number value="count(marc:datafield[@tag='700' or @tag='710' or @tag='711']) + 1" format="I"/><xsl:text>. Título.</xsl:text>
            </xsl:if>
          </p>
          <p class="kei-cdd">
            <xsl:if test="marc:datafield[@tag='082']/marc:subfield[@code='a']">CDD <xsl:value-of select="marc:datafield[@tag='082']/marc:subfield[@code='a']"/></xsl:if>
            <xsl:if test="marc:datafield[@tag='080']/marc:subfield[@code='a']"><xsl:text>   CDU </xsl:text><xsl:value-of select="marc:datafield[@tag='080']/marc:subfield[@code='a']"/></xsl:if>
          </p>
        </div>
      </div>
      <button type="button" class="btn btn-default btn-sm kei-ficha-print" onclick="document.body.classList.add('kei-print'); window.print(); document.body.classList.remove('kei-print');"><xsl:value-of select="$kei-print"/></button>
    </div>
  </xsl:template>
</xsl:stylesheet>
FICHA
}

# Writes the card stylesheets for every language Koha has (OPAC and staff),
# each one importing the default view of its own language (English when a
# side lacks that language). Prints the number of languages.
ficha_write() {
    local langs=() l d opac staff title print_label
    title="$(t "Cataloguing card")"; print_label="$(t "Print the card")"
    for d in "$KOHA_OPAC_TMPL"/*/xslt/MARC21slim2OPACDetail.xsl "$KOHA_INTRA_TMPL"/*/xslt/MARC21slim2intranetDetail.xsl; do
        [ -f "$d" ] || continue
        l="${d%/xslt/*}"; l="${l##*/}"
        [[ " ${langs[*]} " == *" $l "* ]] || langs+=("$l")
    done
    [ ${#langs[@]} -gt 0 ] || return 1
    for l in "${langs[@]}"; do
        opac="$KOHA_OPAC_TMPL/$l/xslt/MARC21slim2OPACDetail.xsl"; [ -f "$opac" ] || opac="$KOHA_OPAC_TMPL/en/xslt/MARC21slim2OPACDetail.xsl"
        staff="$KOHA_INTRA_TMPL/$l/xslt/MARC21slim2intranetDetail.xsl"; [ -f "$staff" ] || staff="$KOHA_INTRA_TMPL/en/xslt/MARC21slim2intranetDetail.xsl"
        mkdir -p "$FICHA_DIR/$l" || return 1
        ficha_xsl "$opac" "$title" "$print_label" > "$FICHA_DIR/$l/opac-detail.xsl" || return 1
        ficha_xsl "$staff" "$title" "$print_label" > "$FICHA_DIR/$l/staff-detail.xsl" || return 1
    done
    chown -R "root:${INSTANCE}-koha" "$FICHA_DIR" 2>/dev/null || true
    chmod -R u=rwX,g=rX,o= "$FICHA_DIR"
    printf '%s' "${#langs[@]}"
}

# Languages installed after the card was enabled get their stylesheet too
# (at panel start): Koha would otherwise fail to show their detail pages.
ficha_refresh() {
    [ -s "$FICHA_STATE" ] || return 0
    ficha_write >/dev/null 2>&1 || true
}

lt_br_ficha() {
    require_database || return 0
    local state choice
    state="$(t "off")"
    [ -s "$FICHA_STATE" ] && state="$(t "on")"
    choice=$(ui_menu "$(t "Cataloguing card")" "$(t 'Brazilian catalogue card (ficha catalográfica, AACR2) below the record in the OPAC and in the staff interface. Now: ${state}')" \
        "on" "$(t "Show the card")" "off" "$(t "Hide the card (Koha's default view)")") || return 0
    case "$choice" in
        on)  tools_locked _lt_br_ficha_on ;;
        off) tools_locked _lt_br_ficha_off ;;
    esac
}

_lt_br_ficha_on() {
    local log n opac_now staff_now
    log=$(tools_log ficha)
    opac_now=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'OPACXSLTDetailsDisplay';")
    staff_now=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'XSLTDetailsDisplay';")
    prompt_yes_no "$(t "Cataloguing card")" "$(t 'The detail pages will use the stylesheets of the panel (the default Koha view plus the card):\n  OPACXSLTDetailsDisplay: ${opac_now}\n  XSLTDetailsDisplay: ${staff_now}\nThe current values are kept to be restored later. A verified backup is made first.')" 14 76 defaultno || return 0
    if ! n=$(ficha_write); then
        msg_error "" "$(t "Koha's default detail stylesheets were not found. Nothing was changed.")" 9 72
        return 1
    fi
    tools_safety_backup FICHA || return 1
    if [ ! -s "$FICHA_STATE" ]; then
        printf 'OPACXSLTDetailsDisplay=%s\nXSLTDetailsDisplay=%s\n' "${opac_now:-default}" "${staff_now:-default}" > "$FICHA_STATE"
    fi
    koha_tool "$log" koha-preferences set OPACXSLTDetailsDisplay "$FICHA_DIR/{langcode}/opac-detail.xsl"
    koha_tool "$log" koha-preferences set XSLTDetailsDisplay "$FICHA_DIR/{langcode}/staff-detail.xsl"
    if [ "$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'XSLTDetailsDisplay';")" != "$FICHA_DIR/{langcode}/staff-detail.xsl" ]; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    log "tools: catalogue card enabled ($n languages)"
    msg_ok "$(t '✔ The catalogue card is shown below each record (${n} language(s)).\n\nSafety backup: ${TOOLS_PRE}')" 11 72
}

_lt_br_ficha_off() {
    local log opac_prev staff_prev
    if [ ! -s "$FICHA_STATE" ]; then
        msg_info "$(t "Cataloguing card")" "$(t "The card is not enabled. Nothing was changed.")" 9 64
        return 0
    fi
    log=$(tools_log ficha)
    opac_prev=$(sed -n 's/^OPACXSLTDetailsDisplay=//p' "$FICHA_STATE"); staff_prev=$(sed -n 's/^XSLTDetailsDisplay=//p' "$FICHA_STATE")
    prompt_yes_no "$(t "Cataloguing card")" "$(t 'Restore the previous detail views?\n  OPACXSLTDetailsDisplay: ${opac_prev}\n  XSLTDetailsDisplay: ${staff_prev}\nA verified backup is made first.')" 12 76 defaultno || return 0
    tools_safety_backup FICHA || return 1
    koha_tool "$log" koha-preferences set OPACXSLTDetailsDisplay "${opac_prev:-default}"
    koha_tool "$log" koha-preferences set XSLTDetailsDisplay "${staff_prev:-default}"
    if [ "$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'XSLTDetailsDisplay';")" != "${staff_prev:-default}" ]; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    rm -f "$FICHA_STATE"
    case "$FICHA_DIR" in /var/lib/koha/*/kei-xslt) rm -rf "$FICHA_DIR" ;; esac
    log "tools: catalogue card disabled"
    msg_ok "$(t "✔ Koha's default detail view is back.")" 8 64
}

# ----------------------------------------------------------------------
# 3. Calendar: national holidays and the dates that depend on Easter.
# ----------------------------------------------------------------------
# Easter Sunday (Gregorian calendar), Meeus/Jones/Butcher: YYYY-MM-DD.
br_easter() {
    local y=$1 a b c d e f g h i k l m
    a=$((y % 19)); b=$((y / 100)); c=$((y % 100)); d=$((b / 4)); e=$((b % 4))
    f=$(((b + 8) / 25)); g=$(((b - f + 1) / 3)); h=$(((19 * a + b - d - g + 15) % 30))
    i=$((c / 4)); k=$((c % 4)); l=$(((32 + 2 * e + 2 * i - h - k) % 7))
    m=$(((a + 11 * h + 22 * l) / 451))
    printf '%04d-%02d-%02d\n' "$y" $(((h + l - 7 * m + 114) / 31)) $(((h + l - 7 * m + 114) % 31 + 1))
}

# br_holidays YEAR: "YYYY-MM-DD|title|kind" sorted by date. National
# holidays (Leis 662/1949, 6.802/1980, 14.759/2023) plus Carnival, Good
# Friday and Corpus Christi (Easter - 48/-47, -2, +60 days).
br_holidays() {
    local y=$1 e
    e=$(br_easter "$y")
    {
        printf '%s|%s|N\n' "$y-01-01" "Confraternização Universal" "$y-04-21" "Tiradentes" "$y-05-01" "Dia do Trabalho" \
            "$y-09-07" "Independência do Brasil" "$y-10-12" "Nossa Senhora Aparecida" "$y-11-02" "Finados" \
            "$y-11-15" "Proclamação da República" "$y-12-25" "Natal"
        [ "$y" -ge 2024 ] && printf '%s|%s|N\n' "$y-11-20" "Dia Nacional de Zumbi e da Consciência Negra"
        printf '%s|%s|P\n' "$(date -d "$e -48 days" +%F)" "Carnaval (segunda-feira)" "$(date -d "$e -47 days" +%F)" "Carnaval (terça-feira)" \
            "$(date -d "$e +60 days" +%F)" "Corpus Christi"
        printf '%s|%s|N\n' "$(date -d "$e -2 days" +%F)" "Sexta-feira Santa"
    } | sort
}

# The calendar table: special_holidays up to Koha 26.05, library_single_closures after.
br_calendar_table() {
    local tb
    for tb in special_holidays library_single_closures; do
        [ -n "$(run_sql "SHOW TABLES FROM ${DB_NAME} LIKE '$tb';")" ] && { printf '%s' "$tb"; return 0; }
    done
    return 1
}

lt_br_holidays() {
    require_database || return 0
    local action year branch local_spec=""
    action=$(ui_menu "$(t "Brazilian holidays")" "$(t "Days the library is closed in the Koha calendar:")" \
        "add" "$(t "Add the holidays of a year")" "remove" "$(t "Remove the holidays added by the panel")") || return 0
    year=$(ui_input "$(t "Brazilian holidays")" "$(t "Year (YYYY):")" "$(date +%Y)") || return 0
    if ! [[ "$year" =~ ^20[0-9][0-9]$ ]]; then
        msg_error "" "$(t "Invalid year. Nothing was changed.")" 8 60
        return 1
    fi
    branch=$(tools_pick "$(t "Brazilian holidays")" "$(t "Library")" "SELECT branchcode, branchname FROM ${DB_NAME}.branches ORDER BY branchname;" "*" "$(t "All libraries")") || return 0
    if [ "$action" = "add" ]; then
        local_spec=$(ui_input "$(t "Brazilian holidays")" "$(t "Local holiday (city anniversary, patron saint): DD/MM and the name, e.g. 20/01 São Sebastião.\nLeave it empty to skip.")" "") || return 0
        if [ -n "$local_spec" ]; then
            if ! [[ "$local_spec" =~ ^([0-3][0-9])/([01][0-9])\ +([^|]{2,40})$ ]] || ! date -d "$year-${BASH_REMATCH[2]}-${BASH_REMATCH[1]}" >/dev/null 2>&1; then
                msg_error "" "$(t "Invalid local holiday. Use DD/MM and the name.\nNothing was changed.")" 9 66
                return 1
            fi
            local_spec="$year-${BASH_REMATCH[2]}-${BASH_REMATCH[1]}|${BASH_REMATCH[3]}|M"
        fi
        tools_locked _lt_br_holidays_add "$year" "$branch" "$local_spec"
    else
        tools_locked _lt_br_holidays_remove "$year" "$branch"
    fi
}

# Libraries chosen ("*" = all), quoted for SQL: 'CPL','MPL'
br_branch_list() {
    local b out=""
    if [ "$1" = "*" ]; then
        while IFS= read -r b; do [ -n "$b" ] && out+="${out:+,}$(sql_quote "$b")"; done < <(run_sql "SELECT branchcode FROM ${DB_NAME}.branches ORDER BY branchcode;")
    else
        out=$(sql_quote "$1")
    fi
    printf '%s' "$out"
}

_lt_br_holidays_add() {
    local year="$1" branch="$2" extra="$3" log table branches sql day title kind desc before after added d m
    log=$(tools_log holidays)
    if ! table=$(br_calendar_table); then
        msg_error "" "$(t "Koha's calendar table was not found. Nothing was changed.")" 9 66
        return 1
    fi
    branches=$(br_branch_list "$branch")
    sql="${TOOLS_WORK}/holidays.sql"
    printf 'SET NAMES utf8mb4;\nSTART TRANSACTION;\n' > "$sql"
    {
        printf '%s: %s\n\n' "$(t "Libraries")" "${branches//\'/}"
        { br_holidays "$year"; [ -n "$extra" ] && printf '%s\n' "$extra"; } | sort | while IFS='|' read -r day title kind; do
            printf '  %s  %s  %s\n' "$day" "$(date -d "$day" +%a)" "$title"
        done
    } > "${TOOLS_WORK}/preview.txt"
    { br_holidays "$year"; [ -n "$extra" ] && printf '%s\n' "$extra"; } | while IFS='|' read -r day title kind; do
        case "$kind" in N) desc="Feriado nacional" ;; P) desc="Ponto facultativo nacional" ;; *) desc="Feriado municipal" ;; esac
        desc="$desc [$BR_TAG]"
        d=$((10#${day:8:2})); m=$((10#${day:5:2}))
        if [ "$table" = "special_holidays" ]; then
            printf "INSERT INTO special_holidays (branchcode, day, month, year, isexception, title, description) SELECT b.branchcode, %d, %d, %d, 0, %s, %s FROM branches b WHERE b.branchcode IN (%s) AND NOT EXISTS (SELECT 1 FROM special_holidays s WHERE s.branchcode = b.branchcode AND s.year = %d AND s.month = %d AND s.day = %d AND s.isexception = 0);\n" \
                "$d" "$m" "$year" "$(sql_quote "$title")" "$(sql_quote "$desc")" "$branches" "$year" "$m" "$d"
        else
            printf "INSERT IGNORE INTO library_single_closures (library_id, date, title, description) SELECT b.branchcode, '%s', %s, %s FROM branches b WHERE b.branchcode IN (%s);\n" \
                "$day" "$(sql_quote "$title")" "$(sql_quote "$desc")" "$branches"
        fi
    done >> "$sql"
    printf 'COMMIT;\n' >> "$sql"
    cat "${TOOLS_WORK}/preview.txt" >> "$log"
    ui_textbox "$(t "Preview (dry run)")" "${TOOLS_WORK}/preview.txt"
    prompt_yes_no "$(t "Brazilian holidays")" "$(t 'Add these closed days of ${year} to the Koha calendar? Days already in the calendar are skipped. A verified backup is made first.\n\nCarnival and Corpus Christi are optional days off (ponto facultativo): remove them in Tools > Calendar if the library opens.')" 14 76 defaultno || return 0
    tools_safety_backup CALENDAR || return 1
    before=$(br_holiday_count "$table" "$year")
    if ! koha_sql_run "$log" "$sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    memcached_flush || log "tools: memcached flush failed (the calendar cache expires by itself)"
    after=$(br_holiday_count "$table" "$year")
    added=$((after - before))
    log "tools: holidays $year added ($added rows, $table)"
    msg_ok "$(t '✔ Closed days added to the calendar: ${added}\n\nIn Koha: Tools > Calendar.\nSafety backup: ${TOOLS_PRE}')" 11 72
}

# Rows the panel added for a year (all libraries).
br_holiday_count() {
    if [ "$1" = "special_holidays" ]; then
        run_sql "SELECT COUNT(*) FROM ${DB_NAME}.special_holidays WHERE year = $2 AND description LIKE '%[${BR_TAG}]%';"
    else
        run_sql "SELECT COUNT(*) FROM ${DB_NAME}.library_single_closures WHERE YEAR(date) = $2 AND description LIKE '%[${BR_TAG}]%';"
    fi
}

_lt_br_holidays_remove() {
    local year="$1" branch="$2" log table branches sql n where
    log=$(tools_log holidays)
    table=$(br_calendar_table) || { msg_error "" "$(t "Koha's calendar table was not found. Nothing was changed.")" 9 66; return 1; }
    branches=$(br_branch_list "$branch")
    if [ "$table" = "special_holidays" ]; then
        where="year = $year AND description LIKE '%[${BR_TAG}]%' AND branchcode IN ($branches)"
    else
        where="YEAR(date) = $year AND description LIKE '%[${BR_TAG}]%' AND library_id IN ($branches)"
    fi
    n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.${table} WHERE ${where};")
    if [ "${n:-0}" = "0" ]; then
        msg_info "$(t "Brazilian holidays")" "$(t "The panel added no holiday for this year. Nothing was changed.")" 9 70
        return 0
    fi
    prompt_yes_no "$(t "Brazilian holidays")" "$(t 'Remove ${n} closed day(s) of ${year} added by the panel? Days added by hand are not touched. A verified backup is made first.')" 11 72 defaultno || return 0
    tools_safety_backup CALENDAR || return 1
    sql="${TOOLS_WORK}/holidays.sql"
    printf 'SET NAMES utf8mb4;\nSTART TRANSACTION;\nDELETE FROM %s WHERE %s;\nCOMMIT;\n' "$table" "$where" > "$sql"
    if ! koha_sql_run "$log" "$sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    memcached_flush || true
    log "tools: holidays $year removed ($n rows)"
    msg_ok "$(t '✔ Closed days removed: ${n}')" 8 60
}

