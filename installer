# ======================================================================
# 32. AUTHOR NOTATION AND CDD TABLES OF THE AI CATALOGUING
# ----------------------------------------------------------------------
# The author tables (Tabela PHA of Heloísa de Almeida Prado, Cutter-Sanborn)
# and the Dewey schedule the AI cataloguing of marc_replace.pl reads
# (KohaEasy::Cataloguing::Rules). They are copyrighted and are not
# distributed with the panel: each library loads its own copy as a text
# file (one entry and its number per line; the PHA rows as printed, entry -
# number - entry, are read as they are) under Library tools > Replace a
# MARC record. The notation follows the rules of the PHA explanation: the
# entry that comes right before the name in alphabetical order, the initial
# of the surname, the number and the initial of the title (the initial
# article never counts; a title starting with "l" gets a capital L),
# prefixes read as one word (La Fonte, O'Donnel) and M' / Mc read as Mac.
# cat_notation is the reference the Perl port in Rules.pm is checked
# against (tests C02 and V07): change both together.
# ======================================================================
CAT_DIR="${CONF_DIR}/tables"

# awk functions shared by the table import and the lookup.
cat_awk_lib() {
    cat <<'CATAWK'
function trim(s) { gsub(/^[ \t\r]+|[ \t\r]+$/, "", s); return s }
function unaccent(s) {
    gsub(/á|à|â|ã|ä|Á|À|Â|Ã|Ä/, "a", s); gsub(/é|è|ê|ë|É|È|Ê|Ë/, "e", s); gsub(/í|ì|î|ï|Í|Ì|Î|Ï/, "i", s)
    gsub(/ó|ò|ô|õ|ö|Ó|Ò|Ô|Õ|Ö/, "o", s); gsub(/ú|ù|û|ü|Ú|Ù|Û|Ü/, "u", s); gsub(/ç|Ç/, "c", s); gsub(/ñ|Ñ/, "n", s)
    gsub(/ý|ÿ|Ý/, "y", s)
    return s
}
# Name as the tables sort it: lower case, no accents, M' and Mc as Mac,
# a prefix joined to the word after it, only letters and single spaces.
function name_key(s) {
    s = tolower(unaccent(trim(s)))
    if (s ~ /^m'/) s = "mac" substr(s, 3)
    else if (s ~ /^mc/) s = "mac" substr(s, 3)
    gsub(/’|'/, "", s)
    gsub(/[^a-z0-9 ]/, " ", s); gsub(/  +/, " ", s); s = trim(s)
    if (s ~ /^(van der|van den|van de|de la|de las|de los|von der|von) [a-z]/) { sub(/ /, "", s); sub(/ /, "", s) }
    else if (s ~ /^(la|le|les|du|des|van|ten|ter|del|della|delle|di|da|de|dos|das|do|lo|el|al) [a-z]/) sub(/ /, "", s)
    return s
}
# "Surname, Forename" -> key of the surname plus the forename.
function author_key(s,   p, sur, fore) {
    p = index(s, ",")
    if (p == 0) return name_key(s)
    sur = name_key(substr(s, 1, p - 1)); fore = name_key(substr(s, p + 1))
    return fore == "" ? sur : sur " " fore
}
function is_article(w) {
    return w ~ /^(o|a|os|as|um|uma|uns|umas|the|an|el|la|los|las|lo|le|les|un|une|il|gli|der|die|das|ein|eine)$/
}
# Title without its initial article (or without the first IND2 characters).
function title_rest(t, ind2,   w) {
    t = trim(t)
    if (ind2 ~ /^[1-9]$/) return trim(substr(t, ind2 + 1))
    if (tolower(t) ~ /^l'/) return trim(substr(t, 3))
    w = tolower(unaccent(t)); sub(/[ \t].*/, "", w)
    if (is_article(w) && index(t, " ")) return trim(substr(t, index(t, " ") + 1))
    return t
}
function work_mark(t, ind2,   c) {
    t = tolower(unaccent(title_rest(t, ind2)))
    gsub(/[^a-z0-9]/, "", t)
    c = substr(t, 1, 1)
    return c == "l" ? "L" : c
}
CATAWK
}

# cat_table_import KIND SOURCE OUT: author table (pha, cutter) or CDD
# schedule (cdd) in the panel format; the report goes to stdout.
cat_table_import() {
    local kind="$1" src="$2" out="$3"
    LC_ALL=C awk -v kind="$kind" -v out="$out" \
        -v l_lines="$(t "Lines read")" -v l_entries="$(t "Entries")" -v l_skipped="$(t "Lines not understood")" \
        -v l_order="$(t "Numbers out of order (check these lines against the book)")" -v l_dup="$(t "Repeated entries (the first one is kept)")" \
        -v l_letter="$(t "Entries per letter")" -v l_line="$(t "line")" \
        "$(cat_awk_lib)"'
function add(e, num,   k, L) {
    e = trim(e); if (e == "") return
    k = name_key(e); L = substr(k, 1, 1)
    if (L !~ /[a-z]/) { skipped++; if (nsk < 30) sk[++nsk] = l_line " " NR ": " $0; return }
    if ((L SUBSEP k) in seen) { dup++; if (ndu < 30) du[++ndu] = l_line " " NR ": " e " (" seen[L, k] ")"; return }
    seen[L, k] = e " " num
    n++; LET[n] = L; KEY[n] = k; NUM[n] = num; ENT[n] = e; LN[n] = NR
    cnt[L]++
}
{
    line = $0; sub(/\r$/, "", line)
    if (NR == 1) sub(/^\357\273\277/, "", line)
    if (line ~ /^[ \t]*(#|$)/) next
    lines++
    if (kind == "cdd") {
        if (match(line, /^[ \t]*[0-9][0-9][0-9](\.[0-9]+)?/)) {
            num = trim(substr(line, RSTART, RLENGTH)); cap = trim(substr(line, RSTART + RLENGTH))
            sub(/^[\t;,:-]+[ \t]*/, "", cap); cap = trim(cap)
            if (cap != "" && !(num in cdd)) { cdd[num] = cap; order[++n] = num; next }
        }
        skipped++; if (nsk < 30) sk[++nsk] = l_line " " NR ": " line
        next
    }
    # "Entry<sep>number", "number<sep>entry" or the row of the book "Entry number Entry".
    nf = split(line, f, /[\t;]/)
    if (nf < 2 && index(line, ",")) nf = split(line, f, /,/)
    if (nf < 2) {
        nw = split(line, w, /[ ]+/); left = ""; right = ""; num = ""
        for (i = 1; i <= nw; i++) {
            if (num == "" && w[i] ~ /^[0-9]+$/) num = w[i]
            else if (num == "") left = left (left == "" ? "" : " ") w[i]
            else right = right (right == "" ? "" : " ") w[i]
        }
    } else {
        left = ""; right = ""; num = ""
        for (i = 1; i <= nf; i++) {
            v = trim(f[i])
            if (num == "" && v ~ /^[0-9]+$/) num = v
            else if (num == "") left = left (left == "" ? "" : " ") v
            else right = right (right == "" ? "" : " ") v
        }
    }
    if (num == "" || (left == "" && right == "")) { skipped++; if (nsk < 30) sk[++nsk] = l_line " " NR ": " line; next }
    add(left, num); add(right, num)
}
END {
    if (kind == "cdd") {
        for (i = 1; i <= n; i++) printf "%s\t%s\n", order[i], cdd[order[i]] > out
        printf "%s: %d\n%s: %d\n%s: %d\n", l_lines, lines, l_entries, n, l_skipped, skipped
        for (i = 1; i <= nsk; i++) print "  " sk[i]
        printf "@@entries %d\n@@problems %d\n", n, skipped
        exit
    }
    # Sort by letter and key (insertion sort per letter keeps it simple and stable).
    for (i = 1; i <= n; i++) { L = LET[i]; m = ++per[L]; IDX[L, m] = i }
    bad = 0
    for (L in per) {
        for (a = 2; a <= per[L]; a++) {
            x = IDX[L, a]; b = a - 1
            while (b >= 1 && KEY[IDX[L, b]] > KEY[x]) { IDX[L, b + 1] = IDX[L, b]; b-- }
            IDX[L, b + 1] = x
        }
        for (a = 1; a <= per[L]; a++) {
            x = IDX[L, a]
            printf "%s\t%s\t%s\t%s\n", L, KEY[x], NUM[x], ENT[x] > out
            # Decimal numbering (1, 11, 111, 112 ... 12): compared as text.
            if (a > 1 && (NUM[x] "") < (NUM[IDX[L, a - 1]] "")) { bad++; if (nba < 50) ba[++nba] = l_line " " LN[x] ": " ENT[x] " " NUM[x] " < " ENT[IDX[L, a - 1]] " " NUM[IDX[L, a - 1]] }
        }
    }
    printf "%s: %d\n%s: %d\n%s: %d\n", l_lines, lines, l_entries, n, l_skipped, skipped
    printf "%s:", l_letter
    for (c = 97; c <= 122; c++) { L = sprintf("%c", c); if (L in cnt) printf " %s=%d", toupper(L), cnt[L] }
    printf "\n"
    if (skipped) { print l_skipped ":"; for (i = 1; i <= nsk; i++) print "  " sk[i] }
    if (bad) { printf "%s: %d\n", l_order, bad; for (i = 1; i <= nba; i++) print "  " ba[i] }
    if (dup) { printf "%s: %d\n", l_dup, dup; for (i = 1; i <= ndu; i++) print "  " du[i] }
    printf "@@entries %d\n@@problems %d\n", n, skipped + bad
}' "$src"
}

cat_table_path() { printf '%s/%s.tsv' "$CAT_DIR" "$1"; }
cat_table_name() {
    case "$1" in
        pha) printf '%s' "$(t "PHA table (Heloísa de Almeida Prado)")" ;;
        cutter) printf 'Cutter-Sanborn' ;;
        cdd) printf '%s' "$(t "CDD (Dewey) schedule")" ;;
    esac
}
cat_table_count() { [ -s "$(cat_table_path "$1")" ] && wc -l < "$(cat_table_path "$1")" || echo 0; }

# cat_notation KIND "Surname, Forename" TITLE [IND2] [MODE]: prints
# "NOTATION<TAB>ENTRY<TAB>NUMBER<TAB>PREVIOUS<TAB>NEXT" (numbers of the
# neighbouring entries). MODE: person (default), corporate (first word of
# the name) or title (anonymous work: first word of the title, no mark).
cat_notation() {
    local kind="$1" name="$2" title="${3:-}" ind2="${4:-}" mode="${5:-person}" table
    table=$(cat_table_path "$kind")
    [ -s "$table" ] || return 2
    LC_ALL=C awk -F'\t' -v name="$name" -v title="$title" -v ind2="$ind2" -v mode="$mode" "$(cat_awk_lib)"'
BEGIN {
    if (mode == "title") { key = title_rest(title, ind2); sub(/[ \t].*/, "", key); key = name_key(key); mark = "" }
    else if (mode == "corporate") { key = name; sub(/[ \t,].*/, "", key); key = name_key(key); mark = work_mark(title, ind2) }
    else { key = author_key(name); mark = work_mark(title, ind2) }
    L = substr(key, 1, 1)
    if (L !~ /[a-z]/) exit 3
}
$1 == L {
    if ($2 <= key) { prev = hit; hit = $3; ent = $4; next_n = ""; found = 1; next }
    if (found && next_n == "") next_n = $3
    if (!found && first == "") { first = $3; firstent = $4 }
}
END {
    if (L !~ /[a-z]/) exit 3
    if (!found) { if (first == "") exit 4; hit = first; ent = firstent }
    printf "%s%s%s\t%s\t%s\t%s\t%s\n", toupper(L), hit, mark, ent, hit, prev, next_n
}' "$table"
}

lt_cat_load() {
    local kind file utf8 new report problems entries
    kind=$(ui_menu "$(t "Load a table")" "$(t "The tables are copyrighted and are not distributed with the panel. Load the copy of your library: a text file (UTF-8 or Windows-1252) with one entry and its number per line, e.g. Sampaio M.;184, or the rows of the PHA book as printed (Rau 184 Sampaio M.).")" \
        "pha"    "$(cat_table_name pha)" \
        "cutter" "Cutter-Sanborn" \
        "cdd"    "$(t "CDD (Dewey) schedule: number and caption per line")") || return 0
    file=$(select_file "/root" "txt csv tsv" "$(t "Pick the table file (.txt, .csv or .tsv):")" "$(t "Table")") || return 0
    if [ ! -r "$file" ] || [ ! -s "$file" ]; then
        msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70
        return 1
    fi
    tools_workdir || return 1
    utf8="$TOOLS_WORK/table-utf8.txt"; new="$TOOLS_WORK/table.tsv"; report="$TOOLS_WORK/table-report.txt"
    if file_is_utf8 "$file"; then cp -f -- "$file" "$utf8"; else iconv -f WINDOWS-1252 -t UTF-8 "$file" > "$utf8" 2>/dev/null || return 1; fi
    : > "$new"
    cat_table_import "$kind" "$utf8" "$new" > "$report" 2>&1
    entries=$(sed -n 's/^@@entries //p' "$report"); problems=$(sed -n 's/^@@problems //p' "$report")
    sed -i '/^@@/d' "$report"
    { printf '%s\n\n' "$(cat_table_name "$kind")"; cat "$report"; } > "$report.2" && mv -f "$report.2" "$report"
    ui_textbox "$(t "Load a table")" "$report"
    if [ "${entries:-0}" = "0" ]; then
        msg_error "" "$(t "No entry was understood. Nothing was changed.")" 8 64
        return 1
    fi
    if [ "${problems:-0}" != "0" ]; then
        prompt_yes_no "$(t "Load a table")" "$(t 'The file has ${problems} problem(s) listed in the report. Load the ${entries} entries anyway? You can correct the file and load it again later.')" 11 74 defaultno || return 0
    else
        prompt_yes_no "$(t "Load a table")" "$(t 'Load the ${entries} entries? A table loaded before is replaced.')" 9 70 || return 0
    fi
    mkdir -p "$CAT_DIR" && chmod 755 "$CAT_DIR"
    install -m 644 "$new" "$(cat_table_path "$kind").new" && mv -f "$(cat_table_path "$kind").new" "$(cat_table_path "$kind")" || return 1
    log "cataloguing: $kind table loaded ($entries entries from $file)"
    msg_ok "$(t '✔ Table loaded: ${entries} entries.')" 8 60
}

lt_cat_remove() {
    local items=() k kind
    for k in pha cutter cdd; do [ -s "$(cat_table_path "$k")" ] && items+=("$k" "$(cat_table_name "$k") ($(cat_table_count "$k"))"); done
    if [ ${#items[@]} -eq 0 ]; then
        msg_info "$(t "Remove a table")" "$(t "No table is loaded.")" 8 60
        return 0
    fi
    kind=$(ui_menu "$(t "Remove a table")" "$(t "Table to remove from this server:")" "${items[@]}") || return 0
    prompt_yes_no "$(t "Remove a table")" "$(t "Remove this table from the server? The catalogue is not changed.")" 9 70 defaultno || return 0
    rm -f "$(cat_table_path "$kind")"
    log "cataloguing: $kind table removed"
    msg_ok "$(t "✔ Table removed.")"
}

