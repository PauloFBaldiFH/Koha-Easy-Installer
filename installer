# NOTE: the helpers below use "__t_" local names on purpose. Values are read
# with ${!name} from the caller's scope, so a local called e.g. "name" here
# would hide the caller's variable of the same name.

# Prints the variables referenced in a template ("name", or "name:-" when
# it has a default value), one per line, sorted. A "${" that is not closed
# (typical machine-translation damage) is reported as "?broken".
_t_vars() {
    local __t_s="$1" __t_rest __t_names=()
    while [[ "$__t_s" == *'$'* ]]; do
        __t_rest="${__t_s#*\$}"
        if [[ "$__t_rest" =~ ^\{([A-Za-z_][A-Za-z0-9_]*)(:-[^}]*)?\} ]]; then
            __t_names+=("${BASH_REMATCH[1]}${BASH_REMATCH[2]:+:-}")
        elif [[ "$__t_rest" == '{'* ]]; then
            __t_names+=("?broken")
        elif [[ "$__t_rest" =~ ^([A-Za-z_][A-Za-z0-9_]*) ]]; then
            __t_names+=("${BASH_REMATCH[1]}")
        fi
        __t_s="$__t_rest"
    done
    [ ${#__t_names[@]} -gt 0 ] && printf '%s\n' "${__t_names[@]}" | sort -u
    return 0
}

# A translation is only used if it keeps the same variables and printf markers.
_t_is_safe() {
    local __t_a="${1//[^%]/}" __t_b="${2//[^%]/}"
    [ "${#__t_a}" -eq "${#__t_b}" ] || return 1
    if [[ "$1" == *'$'* || "$2" == *'$'* ]]; then
        [ "$(_t_vars "$1")" = "$(_t_vars "$2")" ] || return 1
    fi
    return 0
}

# Replaces $VAR, ${VAR} and ${VAR:-default} with the caller's values (no eval).
_t_expand() {
    local __t_s="$1" __t_out="" __t_rest __t_name
    local __t_re_brace='^\{([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}(.*)$'
    local __t_re_plain='^([A-Za-z_][A-Za-z0-9_]*)(.*)$'
    while [[ "$__t_s" == *'$'* ]]; do
        __t_out+="${__t_s%%\$*}"
        __t_rest="${__t_s#*\$}"
        if [[ "$__t_rest" =~ $__t_re_brace ]]; then
            __t_name="${BASH_REMATCH[1]}"
            __t_s="${BASH_REMATCH[4]}"
            if [ -n "${BASH_REMATCH[2]}" ] && [ -z "${!__t_name:-}" ]; then
                __t_out+="${BASH_REMATCH[3]}"
            else
                __t_out+="${!__t_name:-}"
            fi
        elif [[ "$__t_rest" =~ $__t_re_plain ]]; then
            __t_name="${BASH_REMATCH[1]}"
            __t_s="${BASH_REMATCH[2]}"
            __t_out+="${!__t_name:-}"
        else
            __t_out+='$'
            __t_s="$__t_rest"
        fi
    done
    printf '%s' "${__t_out}${__t_s}"
}

t() {
    local __t_src="${1:-}" __t_res __t_val
    [ -z "$__t_src" ] && return 0
    __t_res="$__t_src"
    if [ "${SYS_LANG:-en}" != "en" ]; then
        if [ "$SYS_LANG" = "pt" ] && [ -n "${_MENU_PT[$__t_src]+x}" ]; then
            __t_res="${_MENU_PT[$__t_src]}"
        elif [ -n "${_TRANS_CACHE[$__t_src]+x}" ]; then
            __t_val="${_TRANS_CACHE[$__t_src]}"
            _t_is_safe "$__t_src" "$__t_val" && __t_res="$__t_val"
        fi
    fi
    if [ "${KEI_PLAIN_GLYPHS:-0}" = "1" ]; then
        kei_plain_text "$__t_res"
        __t_res=$REPLY
    fi
    if [[ "$__t_res" == *'$'* ]]; then
        _t_expand "$__t_res"
    else
        printf '%s' "$__t_res"
    fi
}

# Every dictionary starts with a header naming the panel version it was
# generated for. A dictionary from another version (e.g. the lang/ folder of
# an old git clone) is only used as a last resort: it lacks the new texts and
# may still carry old, bad translations.
LANG_CACHE_HEADER="# koha-easy-installer lang ${PANEL_VERSION# }"
_cache_is_current() {
    [ -s "$1" ] && [ "$(head -n1 "$1" 2>/dev/null)" = "$LANG_CACHE_HEADER" ]
}

# Locates the dictionary of a language. Order: a copy made for this panel
# version (lang/ folder next to the script, copy installed with the panel,
# copy downloaded from GitHub); otherwise download it again; otherwise any
# copy available.
_find_translation_cache() {
    local lang="$1" f
    local near="" bundled="${CONFIG_DIR}/lang/${lang}.cache"
    local dl="${CONFIG_DIR}/translations_${lang}.cache"
    [ -n "$_SCRIPT_DIR" ] && near="${_SCRIPT_DIR}/lang/${lang}.cache"

    for f in "$near" "$bundled" "$dl"; do
        [ -n "$f" ] && _cache_is_current "$f" && { printf '%s' "$f"; return 0; }
    done

    # Download again when missing, older than the panel or more than a day old
    # (so an offline server does not wait for the network on every start).
    if [ "$(id -u)" -eq 0 ] && command -v curl >/dev/null 2>&1 && \
       { [ ! -s "$dl" ] || [ "$dl" -ot "$_SCRIPT_PATH" ] || [ -n "$(find "$dl" -mmin +1440 2>/dev/null)" ]; }; then
        mkdir -p "$CONFIG_DIR" 2>/dev/null
        if curl -4fsSL --connect-timeout 3 --max-time 15 "${LANG_REPO_URL}/${lang}.cache" -o "${dl}.part" 2>/dev/null \
           && grep -q '|' "${dl}.part" 2>/dev/null; then
            mv -f "${dl}.part" "$dl"
        else
            rm -f "${dl}.part"
            [ -s "$dl" ] && touch "$dl" 2>/dev/null
        fi
    fi
    _cache_is_current "$dl" && { printf '%s' "$dl"; return 0; }

    for f in "$dl" "$bundled" "$near"; do
        [ -n "$f" ] && [ -s "$f" ] && { printf '%s' "$f"; return 0; }
    done
    return 1
}

load_panel_translations() {
    _TRANS_CACHE=()
    [ "${SYS_LANG:-en}" = "en" ] && return 0
    local cache k v
    cache="$(_find_translation_cache "$SYS_LANG")" || return 0
    # The whole dictionary is decoded by a single base64 run (one process per
    # line took seconds): each "key|value" line becomes key, NUL, value, NUL,
    # "AA==" being a NUL byte. Lines that are not valid base64 are skipped so
    # they cannot shift the pairs.
    while IFS= read -r -d '' k && IFS= read -r -d '' v; do
        [ -n "$k" ] && [ -n "$v" ] && _TRANS_CACHE["$k"]="$v"
    done < <(awk -F'|' '
        NF == 2 && length($1) % 4 == 0 && length($2) % 4 == 0 &&
        $1 ~ /^[A-Za-z0-9+\/]+(==|=)?$/ && $2 ~ /^[A-Za-z0-9+\/]+(==|=)?$/ {
            print $1; print "AA=="; print $2; print "AA=="
        }' "$cache" | base64 -d 2>/dev/null)
    return 0
}

