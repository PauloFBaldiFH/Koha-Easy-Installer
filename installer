}

# ISBNs of the record (020 $a and $z, digits and X only).
sub record_isbns {
    my ($record) = @_;
    my %seen;
    return grep { length >= 10 && !$seen{$_}++ } map { ( my $x = uc $_ ) =~ s/[^0-9X]//g; $x } grep { defined } map { $_->subfield('a'), $_->subfield('z') } $record->field('020');
}

# Records of the catalogue with one of the ISBNs: [ biblionumber, title ].
sub find_duplicates {
    my ($record) = @_;
    my ( %seen, @dups );
    for my $isbn ( record_isbns($record) ) {
        my $rows = C4::Context->dbh->selectall_arrayref(
            "SELECT bi.biblionumber, b.title FROM biblioitems bi JOIN biblio b ON b.biblionumber = bi.biblionumber WHERE REPLACE(bi.isbn, '-', '') LIKE ? LIMIT 10",
            undef, "%$isbn%" ) || [];
        push @dups, grep { !$seen{ $_->[0] }++ } @$rows;
    }
    return @dups;
}

sub do_vision_preview {
    my ($cgi) = @_;
    my $text = $cgi->param('marctext') // '';
    my $back = sub { render_draft( $cgi, err_box( $_[0] ), $text, scalar $cgi->param('extraction') ) };
    if ( $text !~ /\S/ ) { $back->( $T{err_input} ); return }
    my ( $record, $bad ) = parse_mnemonic_marc($text);
    if (@$bad) { $back->( $T{err_lines} . ' ' . join( ', ', @$bad ) ); return }
    set_itemtype( $record, scalar $cgi->param('itemtype') );
    my $dropped = strip_items($record);
    if ( !$record->field('245') ) { $back->( $T{err_title} ); return }

    my $fw    = framework_param( scalar $cgi->param('frameworkcode') );
    my @dups  = find_duplicates($record);
    my $nonce = sha1_hex( join ':', time, $$, rand(), csrf($cgi) );
    my $xml   = encode( 'UTF-8', $record->as_xml_record('MARC21') );

    my $body = '<h2>' . h( $T{v_title} ) . '</h2><p>' . h( $T{v_new_confirm} ) . '</p>';
    $body .= '<p>' . h( $T{items_dropped} ) . " $dropped</p>" if $dropped;
    $body .= '<p>' . h( $T{v_framework} ) . ': ' . h( $fw eq '' ? $T{v_default_fw} : $fw ) . '</p>';
    if (@dups) {
        $body .= '<div class="msg warn"><b>' . h( $T{v_dups} ) . '</b><br>'
            . join( '<br>', map { '<a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=' . h( $_->[0] ) . '" target="_blank">' . h( $_->[0] ) . '</a> ' . h( $_->[1] // '' ) } @dups )
            . '</div>';
    }
    $body .= '<h3>' . h( $T{new} ) . '</h3><pre>' . h( $record->as_formatted ) . '</pre>';
    $body .= '<form method="post">'
        . '<input type="hidden" name="op" value="cud-vision-add">'
        . '<input type="hidden" name="csrf_token" value="' . h( csrf($cgi) ) . '">'
        . '<input type="hidden" name="record" value="' . encode_base64( $xml, '' ) . '">'
        . '<input type="hidden" name="frameworkcode" value="' . h($fw) . '">'
        . '<input type="hidden" name="nonce" value="' . h($nonce) . '">'
        . '<input type="hidden" name="extraction" value="' . h( scalar $cgi->param('extraction') // '' ) . '">'
        . ( @dups ? '<p><input type="checkbox" id="allow_dup" name="allow_dup" value="1"> <label class="inline" for="allow_dup">' . h( $T{v_dup_ok} ) . '</label></p>' : '' )
        . '<input type="submit" value="' . h( $T{v_add} ) . '"> '
        . '<a href="marc_replace.pl?op=vision">' . h( $T{cancel} ) . '</a></form>';
    render_page( $body, 'vision' );
    return;
}

# The new record and what the model read, next to the saved versions;
# returns the stamp (dies on failure).
sub save_new_copy {
    my ( $biblionumber, $record, $extraction ) = @_;
    my $dir = "$BACKUP_DIR/vision";
    my $stamp = strftime( '%Y%m%d-%H%M%S', localtime );
    write_atomic( "$dir/$biblionumber-$stamp.xml", encode( 'UTF-8', $record->as_xml_record('MARC21') ) );
    write_atomic( "$dir/$biblionumber-$stamp.json", $extraction ) if $extraction ne '';
    return $stamp;
}

# Adds the record: the form is claimed first (a second send adds nothing),
# then under a database lock and in one transaction the ISBN is checked
# again, the record added and its copy saved; any failure keeps nothing.
sub do_vision_add {
    my ($cgi) = @_;
    my $record = eval { MARC::Record->new_from_xml( decode_base64( scalar $cgi->param('record') // '' ), 'UTF-8', 'MARC21' ) };
    my $nonce  = $cgi->param('nonce') // '';
    if ( !$record || !$record->field('245') || $nonce !~ /^[0-9a-f]{40}$/ ) {
        render_vision_form( $cgi, err_box( $T{err_parse} ) );
        return;
    }
    strip_items($record);
    my $fw         = framework_param( scalar $cgi->param('frameworkcode') );
    my $extraction = eval { decode_base64( scalar $cgi->param('extraction') // '' ) } // '';
    $extraction = '' unless length($extraction) <= 500_000 && eval { JSON::PP->new->utf8->decode($extraction); 1 };

    my $dir = "$BACKUP_DIR/vision";
    mkdir( $dir, 0750 ) unless -d $dir;
    my $claim = "$dir/.sent-$nonce";
    my $cfh;
    if ( !sysopen( $cfh, $claim, O_WRONLY | O_CREAT | O_EXCL, 0640 ) ) {
        my $done;
        if ( -e $claim && open( my $in, '<', $claim ) ) { local $/; $done = <$in> // ''; close $in }
        if ( defined $done && $done =~ /^(\d+)$/ ) {
            render_page( '<h2>' . h( $T{v_title} ) . '</h2>' . warn_box( $T{v_twice} ) . record_links($1), 'vision' );
        } else {
            render_vision_form( $cgi, err_box( defined $done ? $T{v_err_busy} : "$T{err_backup} $claim: $!" ) );
        }
        return;
    }

    my $dbh = C4::Context->dbh;
    my ($locked) = $dbh->selectrow_array( 'SELECT GET_LOCK(?, 30)', undef, 'kei_marc_replace_vision' );
    if ( !$locked ) {
        close $cfh;
        unlink $claim;
        render_vision_form( $cgi, err_box( $T{v_err_busy} ) );
        return;
    }
    my ( $biblionumber, $stamp );
    my $success = eval {
        Koha::Database->new->schema->txn_do(
            sub {
                die "DUPLICATE\n" if find_duplicates($record) && !$cgi->param('allow_dup');
                ($biblionumber) = AddBiblio( $record, $fw );
                die "ADDBIBLIO\n" unless $biblionumber;
                $stamp = eval { save_new_copy( $biblionumber, $record, $extraction ) };
                die 'BACKUP ' . short_error($@) . "\n" unless $stamp;
            }
        );
        1;
    };
    my $err = $@ // '';
    $dbh->selectrow_array( 'SELECT RELEASE_LOCK(?)', undef, 'kei_marc_replace_vision' );

    if ($success) {
        print {$cfh} $biblionumber;
        close $cfh;
        render_page( '<h2>' . h( $T{v_title} ) . '</h2><div class="msg ok">' . h( $T{v_added} ) . " ($biblionumber)</div>" . record_links($biblionumber), 'vision' );
        return;
    }
    close $cfh;
    unlink $claim;
    unlink glob("$dir/$biblionumber-$stamp.*") if $biblionumber && $stamp;
    my $msg =
          $err =~ /^DUPLICATE/     ? $T{v_err_dup}
        : $err =~ /^BACKUP (.*)/   ? "$T{err_backup} $1"
        :                            $T{v_err_add} . ' ' . short_error( $err =~ /^ADDBIBLIO/ ? 'AddBiblio' : $err );
    render_vision_form( $cgi, err_box($msg) );
    return;
}

sub record_links {
    my $bn = shift;
    return '<p>'
        . qq{<a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=$bn" target="_blank">} . h( $T{view} ) . '</a><br>'
        . qq{<a href="/cgi-bin/koha/cataloguing/additem.pl?biblionumber=$bn" target="_blank">} . h( $T{v_add_items} ) . '</a><br>'
        . qq{<a href="/cgi-bin/koha/cataloguing/addbiblio.pl?biblionumber=$bn" target="_blank">} . h( $T{v_edit} ) . '</a></p>'
        . '<p><a href="marc_replace.pl?op=vision">' . h( $T{v_another} ) . '</a></p>';
}

