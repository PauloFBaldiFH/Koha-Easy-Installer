        sed -i -E 's/^[[:space:]]*INTRAPORT=.*/INTRAPORT="8080"/' "$conf"
        grep -q '^OPACPORT=' "$conf" || echo 'OPACPORT="80"' >> "$conf"
        grep -q '^INTRAPORT=' "$conf" || echo 'INTRAPORT="8080"' >> "$conf"
    else
        cat << 'EOF' > "$conf"
OPACPORT="80"
INTRAPORT="8080"
DEFAULTSOPACMAIL="library@localhost"
