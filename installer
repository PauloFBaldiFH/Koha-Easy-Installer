function_cloudflare_status() {
    if [ ! -f /etc/cloudflared/config.yml ] && ! tunnel_mode_is broker; then
        msg_error "" "$(t "The tunnel is not configured yet.\nUse the installation option first.")" 9 70
        return
    fi

    local opac_host staff_host c_status
    read -r opac_host staff_host < <(tunnel_public_hosts)
    [ "$opac_host" = "-" ] && opac_host="$(t "Not configured")"
    if [ "$staff_host" = "-" ]; then
        staff_host="$(t "Not configured")"
        tunnel_mode_is broker && staff_host="$(t "local network only (remote staff access is off)")"
    fi

    c_status="OFFLINE"
    systemctl is-active --quiet cloudflared && c_status="ONLINE"

    local tmp_cf
    tmp_cf=$(mktemp /tmp/koha_cf.XXXXXX) || return 1

    cat > "$tmp_cf" << EOF
$(t "TUNNEL STATUS:") ${c_status}
----------------------------------------------------------------------

$(t "PUBLIC INTERNET URLS:")

  $(t "Public Catalog (OPAC):")
  https://${opac_host}

  $(t "Administration (Staff):")
  https://${staff_host}

----------------------------------------------------------------------
$(t "ACTIVE SECURITY FEATURES:")

  • $(t "Hidden IP: server real IP is invisible from internet attacks.")
  • $(t "Closed Ports: no need to forward router/firewall ports.")
  • $(t "SSL Encryption: automatic secure HTTPS connections.")
EOF

    whiptail --title "$(t "Cloudflare Information")" --textbox "$tmp_cf" 20 76 2>/dev/null || true
    rm -f "$tmp_cf"
}

# set_koha_public_urls OPAC_URL [STAFF_URL]: OPACBaseURL / staffClientBaseURL
# and the defaults for new instances. An empty STAFF_URL leaves it as is.
set_koha_public_urls() {
    local opac="$1" staff="${2:-}" k_sites="/etc/koha/koha-sites.conf"
    [[ "$opac" =~ ^https?://[A-Za-z0-9.:-]+$ ]] || return 1
    [ -z "$staff" ] || [[ "$staff" =~ ^https?://[A-Za-z0-9.:-]+$ ]] || return 1
    is_database_ready || return 0
    display_explanation "Setting Koha URL system preferences..."
    mysql -e "INSERT INTO ${DB_NAME}.systempreferences (variable, value, type) VALUES ('OPACBaseURL', '${opac}', 'Free') ON DUPLICATE KEY UPDATE value='${opac}';" >/dev/null 2>&1 || true
    [ -n "$staff" ] && { mysql -e "INSERT INTO ${DB_NAME}.systempreferences (variable, value, type) VALUES ('staffClientBaseURL', '${staff}', 'Free') ON DUPLICATE KEY UPDATE value='${staff}';" >/dev/null 2>&1 || true; }
    if [ -f "$k_sites" ]; then
        sed -i -E "s|^[[:space:]]*DEFAULTSOPACURL=.*|DEFAULTSOPACURL=\"${opac}\"|" "$k_sites" 2>/dev/null || true
        [ -n "$staff" ] && { sed -i -E "s|^[[:space:]]*DEFAULTSINTRAURL=.*|DEFAULTSINTRAURL=\"${staff}\"|" "$k_sites" 2>/dev/null || true; }
    fi
    systemctl restart memcached >/dev/null 2>&1 || true
    plack_restart || true
}

# cloudflare_route_dns TUNNEL HOST: points HOST at the tunnel. An existing
# DNS record is never replaced silently: it may be another site of the same
# domain, so the person is asked first.
cloudflare_route_dns() {
    local tunnel="$1" host="$2"
    cloudflared tunnel route dns "$tunnel" "$host" && return 0
    if prompt_yes_no "$(t "DNS record exists")" "$(t "The address \$host already exists in your Cloudflare DNS.\n\nReplace it so it points to this Koha? Answer No if it belongs to another site.")" 11 74 defaultno; then
        cloudflared tunnel route dns -f "$tunnel" "$host" || true
    fi
    return 0
}

# Installs cloudflared from Cloudflare's signed APT repository (once).
cloudflared_install() {
    command -v cloudflared >/dev/null 2>&1 && return 0
    display_explanation "Installing cloudflared..."
    if ! wait_for_apt_locks; then return 1; fi
    mkdir -p /etc/apt/keyrings && chmod 0755 /etc/apt/keyrings
    if ! curl -fsSL --retry 3 --max-time 60 https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg; then
        restore_apt_timers
        msg_error "" "$(t "Failed to download the Cloudflare key.")" 8 66
        return 1
    fi
    apt_source_line /etc/apt/keyrings/cloudflare-main.gpg https://pkg.cloudflare.com/cloudflared any main > /etc/apt/sources.list.d/cloudflared.list
    if ! apt_update_indices; then
        rm -f /etc/apt/sources.list.d/cloudflared.list
        restore_apt_timers
        msg_error "" "$(t "Could not update the Cloudflare repository.")" 9 72
        return 1
    fi
    if ! apt_install cloudflared; then
        restore_apt_timers
        return 1
    fi
    restore_apt_timers
}

function_cloudflare_setup() {
    msg_info "$(t "Step 1: Domain & Nameservers")" \
"$(t "HOW TO LINK YOUR DOMAIN TO CLOUDFLARE:\n\n1. GET A FREE DOMAIN:\n    - Digital Plat (fast/automated): https://domain.digitalplat.org/\n    - nic.eu.org (manual, takes 14 to 45 days): https://nic.eu.org\n    - Or ask local IT for an official CNAME (e.g. catalog.palotina.pr.gov.br)\n\n2. ADD TO CLOUDFLARE (dash.cloudflare.com):\n    - Click 'Add a site/domain', type your domain and select Free.\n    - Cloudflare provides TWO Nameservers. Copy both.\n\n3. UPDATE AT YOUR DOMAIN REGISTRAR:\n    - Replace existing servers with the TWO from Cloudflare.\n    - In Cloudflare, click 'Check nameservers' until status is Active.\n\nThis part can't be automated, but everything from here on is fully automatic.")" 22 78

    if tunnel_mode_is broker; then
        msg_error "" "$(t "This server uses a free address. Leave it first (Free address menu), then set up your own domain.")" 10 74
        return 0
    fi
    clear
    cloudflared_install || return 1

    if [ ! -f "$REAL_HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_info "$(t "Cloudflare Tunnel")" \
"$(t "AUTHORIZATION (first time only):\n\nNext, choose how to open the Cloudflare page: a QR code for your phone,\nthe browser of this computer, or a link to copy. Select the domain\nyou already activated in Cloudflare and click Authorize.\n\nNo need to paste anything back - the server detects it automatically.")" 14 76
        ALLOW_CTRL_C_RETURN=1
        cloudflare_login
        ALLOW_CTRL_C_RETURN=0
        echo ""
    fi

    if [ ! -f "$REAL_HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_error "" "$(t "Authorization not completed. Try again.")" 8 66
        return 1
    fi

    local tunnel_name="koha-library"
    display_explanation "Checking Cloudflare tunnel..."
    
    local tunnel_id_check
    tunnel_id_check=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')

    if [ -n "$tunnel_id_check" ] && { [ -f "$REAL_HOME/.cloudflared/${tunnel_id_check}.json" ] || [ -f "/root/.cloudflared/${tunnel_id_check}.json" ]; }; then
        log "Tunnel '$tunnel_name' already exists with credentials; reusing..."
    else
        display_explanation "Creating tunnel '\$tunnel_name'..."
        if [ -n "$tunnel_id_check" ]; then
            cloudflared tunnel delete -f "$tunnel_name" >/dev/null 2>&1 || true
        fi

        if ! cloudflared tunnel create "$tunnel_name"; then
            msg_error "" "$(t "Failed to create tunnel.")" 10 74
            return 1
        fi
    fi

    local tunnel_id
    tunnel_id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')
    if [ -z "$tunnel_id" ]; then
        msg_error "" "$(t "Could not identify the tunnel ID.")" 8 66
        return 1
    fi

    local cred_file
    cred_file=$(find "$REAL_HOME/.cloudflared" /root/.cloudflared -name "${tunnel_id}.json" 2>/dev/null | head -n1)
    if [ -z "$cred_file" ]; then
        msg_error "" "$(t "Tunnel credentials file (.json) not found.")" 9 70
        return 1
    fi

    local dominio opac_sub staff_sub
    dominio=$(whiptail --title "$(t "Your Domain")" --inputbox "$(t "Enter the domain you already activated in Cloudflare (e.g. bibliotecapalotina.org):")" 10 74 3>&1 1>&2 2>&3) || return 0
    [ -z "$dominio" ] && return 0

    dominio=$(printf '%s' "$dominio" | tr 'A-Z' 'a-z' | sed -e 's|^[a-z]*://||' -e 's|/.*$||' -e 's/[[:space:]]//g')

    opac_sub=$(whiptail --title "OPAC" --inputbox "$(t "Public Catalog subdomain:")" 10 60 "catalog" 3>&1 1>&2 2>&3) || return 0
    staff_sub=$(whiptail --title "Staff" --inputbox "$(t "Administration subdomain:")" 10 60 "admin" 3>&1 1>&2 2>&3) || return 0
    opac_sub=$(printf '%s' "$opac_sub" | tr 'A-Z' 'a-z' | tr -d '[:space:]')
    staff_sub=$(printf '%s' "$staff_sub" | tr 'A-Z' 'a-z' | tr -d '[:space:]')

    local host_re='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$'
    if ! [[ "$dominio" =~ $host_re && "$dominio" == *.* && "$opac_sub" =~ $host_re && "$staff_sub" =~ $host_re ]] \
       || [ "$opac_sub" = "$staff_sub" ]; then
        msg_error "" "$(t "Invalid domain or subdomain. Use only letters, numbers and hyphens (e.g. catalog / admin / mylibrary.org), with different subdomains.")" 10 76
        return 1
    fi

    mkdir -p /etc/cloudflared
    cat > /etc/cloudflared/config.yml <<EOF
tunnel: ${tunnel_id}
credentials-file: ${cred_file}

ingress:
  - hostname: ${opac_sub}.${dominio}
    service: http://localhost:80
  - hostname: ${staff_sub}.${dominio}
    service: http://localhost:8080
  - service: http_status:404
EOF

    display_explanation "Registering subdomains in DNS..."
    cloudflare_route_dns "$tunnel_name" "${opac_sub}.${dominio}"
    cloudflare_route_dns "$tunnel_name" "${staff_sub}.${dominio}"

    display_explanation "Installing tunnel as a service..."
    cloudflared service uninstall >/dev/null 2>&1 || true
    cp /etc/cloudflared/config.yml /etc/cloudflared/config.yml.bak 2>/dev/null || true
    cloudflared --config /etc/cloudflared/config.yml service install
    systemctl enable --now cloudflared >/dev/null 2>&1
    sleep 3

    if systemctl is-active --quiet cloudflared; then
        set_koha_public_urls "https://${opac_sub}.${dominio}" "https://${staff_sub}.${dominio}"

        function_cloudflare_status
    else
        msg_error "" "$(t "The service is not active. Check: journalctl -u cloudflared -n 30")" 9 74
    fi
}

# ----------------------------------------------------------------------
# 14.1 FREE ADDRESS (SUBDOMAIN BROKER)
# ----------------------------------------------------------------------
# A library without its own domain asks the Koha broker (broker/ in this
# repository, a Cloudflare Worker) for an address such as
# palotina-pr.<central domain>. The request is approved on the broker's
# side; the panel only ever receives the token of its own tunnel, never a
# Cloudflare API credential. Every call after the request is signed with
# an Ed25519 key that never leaves this server (same format as
# broker/scripts/kei-sign.sh).
#
#   tunnel.conf        mode, library id and public hostnames (no secrets)
#   broker.key         Ed25519 private key (0600)
#   broker-enroll.conf request waiting for approval (0600: holds its code)
#   koha-broker.env    TUNNEL_TOKEN for the cloudflared service (0600)
# ----------------------------------------------------------------------
KEI_BROKER_URL="${KEI_BROKER_URL:-https://koha-broker.bibliotecamunicipalpalotina.org}"
TUNNEL_CONF="${CONF_DIR}/tunnel.conf"
BROKER_KEY="${CONF_DIR}/broker.key"
BROKER_ENROLL="${CONF_DIR}/broker-enroll.conf"
BROKER_ENV="${KEI_BROKER_ENV:-/etc/cloudflared/koha-broker.env}"
CLOUDFLARED_UNIT="${KEI_CLOUDFLARED_UNIT:-/etc/systemd/system/cloudflared.service}"
CRON_BROKER="/etc/cron.d/koha_broker"
BROKER_STATUS="" BROKER_BODY=""

# KEY=value files written by the panel. Read line by line, never sourced;
# only known keys and plain values are accepted.
kv_get() {    # kv_get FILE KEY -> value
    local line
    [ -f "$1" ] || return 1
    line=$(grep -E "^$2=" "$1" 2>/dev/null | tail -n1) || return 1
    line="${line#*=}"
    [[ "$line" =~ ^[A-Za-z0-9._:/@+=?-]*$ ]] || return 1
    printf '%s' "$line"
}

kv_write() {  # kv_write FILE MODE KEY VALUE [KEY VALUE ...]: merges into FILE
    local file="$1" mode="$2" tmp k v
    shift 2
    declare -A kv=()
    if [ -f "$file" ]; then
        while IFS='=' read -r k v; do
            [[ "$k" =~ ^[A-Z_]+$ ]] && kv[$k]="$v"
        done < "$file"
    fi
    while [ $# -ge 2 ]; do
        [[ "$1" =~ ^[A-Z_]+$ && "$2" =~ ^[A-Za-z0-9._:/@+=?-]*$ ]] || return 1
        kv[$1]="$2"
        shift 2
    done
    mkdir -p "$(dirname "$file")"
    tmp=$(mktemp "${file}.XXXXXX") || return 1
    chmod "$mode" "$tmp"
    for k in $(printf '%s\n' "${!kv[@]}" | sort); do
        printf '%s=%s\n' "$k" "${kv[$k]}"
    done > "$tmp"
    mv -f "$tmp" "$file"
}

tunnel_conf_get() { kv_get "$TUNNEL_CONF" "$1"; }
tunnel_mode_is() { [ "$(tunnel_conf_get TUNNEL_MODE 2>/dev/null)" = "$1" ]; }
broker_url() { tunnel_conf_get BROKER_URL 2>/dev/null || printf '%s' "$KEI_BROKER_URL"; }

# Public hostnames: "OPAC STAFF" (either may be "-"). The free address
# publishes the staff interface only while remote staff access is on.
tunnel_public_hosts() {
    local opac="" staff=""
    if tunnel_mode_is broker; then
        opac=$(tunnel_conf_get OPAC_HOST 2>/dev/null)
        [ "$(tunnel_conf_get STAFF_REMOTE 2>/dev/null)" = "yes" ] && staff=$(tunnel_conf_get STAFF_HOST 2>/dev/null)
    elif [ -f /etc/cloudflared/config.yml ]; then
        opac=$(grep -B1 "localhost:80$" /etc/cloudflared/config.yml | grep "hostname:" | awk '{print $NF}' 2>/dev/null)
        staff=$(grep -B1 "localhost:8080$" /etc/cloudflared/config.yml | grep "hostname:" | awk '{print $NF}' 2>/dev/null)
    fi
    printf '%s %s\n' "${opac:--}" "${staff:--}"
}

# json_field FILE KEY [KEY ...]: string, number or boolean at that path of a
# small JSON document (the broker's answers). Pure Bash, like the rest of
# the panel; prints nothing and returns 1 when the path is missing.
json_field() {
    local _j _i=0 _k _JS=""
    [ -r "$1" ] || return 1
    _j=$(<"$1")
    shift
    for _k in "$@"; do
        _json_ws
        [ "${_j:_i:1}" = "{" ] || return 1
        _i=$((_i + 1))
        _json_find_key "$_k" || return 1
    done
    _json_ws
    case "${_j:_i:1}" in
        '"') _json_string || return 1; printf '%s' "$_JS" ;;
        '{'|'['|'') return 1 ;;
        *)
            _k="${_j:_i}"
            _k="${_k%%[,\}\] $'\t\r\n']*}"
            [[ "$_k" =~ ^(true|false|-?[0-9][0-9.eE+-]*)$ ]] || return 1
            printf '%s' "$_k"
            ;;
    esac
}
# Helpers of json_field: they work on its _j (text) and _i (position).
_json_ws() {
    while [[ "${_j:_i:1}" == [$' \t\r\n'] ]]; do _i=$((_i + 1)); done
}
_json_string() {    # the string at _i, decoded, into _JS
    local rest part c
    [ "${_j:_i:1}" = '"' ] || return 1
    _i=$((_i + 1))
    _JS=""
    while true; do
        rest="${_j:_i}"
        part="${rest%%[\"\\]*}"
        [ ${#part} -lt ${#rest} ] || return 1
        _JS+="$part"
        _i=$((_i + ${#part}))
        c="${_j:_i:1}"
        _i=$((_i + 1))
        [ "$c" = '"' ] && return 0
        c="${_j:_i:1}"
        _i=$((_i + 1))
        case "$c" in
            n) _JS+=$'\n' ;;
            t) _JS+=$'\t' ;;
            r) _JS+=$'\r' ;;
            b|f) ;;
            u) [[ "${_j:_i:4}" =~ ^[0-9A-Fa-f]{4}$ ]] || return 1
               printf -v c "\\u${_j:_i:4}"; _JS+="$c"; _i=$((_i + 4)) ;;
            *) _JS+="$c" ;;
        esac
    done
}
_json_skip() {      # any value at _i
    local depth=0 c
    while true; do
        _json_ws
        c="${_j:_i:1}"
        case "$c" in
            '') return 1 ;;
            '"') _json_string || return 1; [ "$depth" -eq 0 ] && return 0 ;;
            '{'|'[') depth=$((depth + 1)); _i=$((_i + 1)) ;;
            '}'|']')
                [ "$depth" -eq 0 ] && return 0
                depth=$((depth - 1)); _i=$((_i + 1))
                [ "$depth" -eq 0 ] && return 0
                ;;
            ',') [ "$depth" -eq 0 ] && return 0; _i=$((_i + 1)) ;;
            *) _i=$((_i + 1)) ;;
        esac
    done
}
_json_find_key() {  # inside an object: moves _i to the value of key $1
    local key
    while true; do
        _json_ws
        _json_string || return 1
        key="$_JS"
        _json_ws
        [ "${_j:_i:1}" = ":" ] || return 1
        _i=$((_i + 1))
        _json_ws
        [ "$key" = "$1" ] && return 0
        _json_skip || return 1
        _json_ws
        [ "${_j:_i:1}" = "," ] || return 1
        _i=$((_i + 1))
    done
}

broker_ensure_key() {
    [ -s "$BROKER_KEY" ] && return 0
    mkdir -p "$CONF_DIR"
    ( umask 077 && openssl genpkey -algorithm ed25519 -out "$BROKER_KEY" ) >/dev/null 2>&1 || return 1
    chmod 600 "$BROKER_KEY"
}

broker_public_key() {
    openssl pkey -in "$BROKER_KEY" -pubout -outform DER 2>/dev/null | tail -c 32 | base64 | tr -d '\n'
}

# broker_sign_headers METHOD PATH BODYFILE: the four X-KEI-* headers.
broker_sign_headers() {
    local method="$1" path="$2" body="$3" lib ts nonce hash msg sig
    lib=$(tunnel_conf_get LIBRARY_ID) || return 1
    ts=$(date +%s)
    nonce=$(openssl rand -hex 16)
    hash=$(sha256sum < "$body" | cut -d' ' -f1)
    msg=$(mktemp) || return 1
    printf 'KEI-SIG-v1\n%s\n%s\n%s\n%s\n%s' "$method" "$path" "$ts" "$nonce" "$hash" > "$msg"
    sig=$(openssl pkeyutl -sign -inkey "$BROKER_KEY" -rawin -in "$msg" 2>/dev/null | base64 | tr -d '\n')
    rm -f "$msg"
    [ -n "$sig" ] || return 1
    printf 'X-KEI-Library: %s\nX-KEI-Timestamp: %s\nX-KEI-Nonce: %s\nX-KEI-Signature: %s\n' "$lib" "$ts" "$nonce" "$sig"
}

# broker_request METHOD PATH yes|no [JSON]: calls the broker (signed or
# not). The answer goes to BROKER_BODY, a 0600 file (it may hold the tunnel
# token), and the HTTP code to BROKER_STATUS. Returns 0 on 2xx.
broker_request() {
    local method="$1" path="$2" signed="$3" json="${4:-}" req h args=()
    broker_cleanup
    req=$(umask 077; mktemp /root/.kei-broker-req.XXXXXX) || return 1
    BROKER_BODY=$(umask 077; mktemp /root/.kei-broker-res.XXXXXX) || { rm -f "$req"; return 1; }
    printf '%s' "$json" > "$req"
    if [ "$signed" = "yes" ]; then
        while IFS= read -r h; do args+=(-H "$h"); done < <(broker_sign_headers "$method" "$path" "$req")
        [ ${#args[@]} -eq 8 ] || { rm -f "$req"; BROKER_STATUS=000; return 1; }
    fi
    [ -n "$json" ] && args+=(-H "Content-Type: application/json" --data-binary "@$req")
    BROKER_STATUS=$(curl -sS --max-time 30 -X "$method" "${args[@]}" -o "$BROKER_BODY" -w '%{http_code}' \
        "$(broker_url)$path" 2>/dev/null) || BROKER_STATUS=000
    rm -f "$req"
    [[ "$BROKER_STATUS" == 2[0-9][0-9] ]]
}

broker_cleanup() {
    [ -n "$BROKER_BODY" ] && rm -f "$BROKER_BODY"
    BROKER_BODY=""
}

# Error text of the last answer, for the dialogs.
broker_error() {
    local e=""
    [ -n "$BROKER_BODY" ] && e=$(json_field "$BROKER_BODY" error)
    [ "$BROKER_STATUS" = "000" ] && e="$(t "The address service could not be reached. Check the internet connection.")"
    printf '%s' "${e:-HTTP $BROKER_STATUS}"
}

# Runs in the background while the request link is on screen: ends with 0
# once the request is approved, 1 when it is denied or expired.
broker_wait_approval() {
    local code="$1" st
    while true; do
        if broker_request POST /v1/device/poll no "{\"device_code\":$(json_str "$code")}"; then
            st=$(json_field "$BROKER_BODY" status)
            case "$st" in
                approved) broker_cleanup; exit 0 ;;
                denied|expired|consumed) broker_cleanup; exit 1 ;;
            esac
        elif [ "$BROKER_STATUS" = "404" ]; then
            broker_cleanup; exit 1
        fi
        broker_cleanup
        sleep "${KEI_BROKER_POLL:-10}"
    done
}

# Asks for a new address. Leaves the request in BROKER_ENROLL.
broker_new_request() {
    local inst email name body
    inst=$(ui_input "$(t "Free address")" "$(t "Name of the library or institution:")") || return 1
    inst=$(printf '%s' "$inst" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ ${#inst} -ge 3 ] || { msg_error "" "$(t "Type the name of the library (at least 3 characters).")" 8 66; return 1; }
    email=$(ui_input "$(t "Free address")" "$(t "Contact e-mail of the library (preferably the institutional one):")") || return 1
    email=$(printf '%s' "$email" | tr -d '[:space:]')
    [[ "$email" =~ ^[^@]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { msg_error "" "$(t "Invalid e-mail address.")" 8 60; return 1; }
    name=$(ui_input "$(t "Free address")" "$(t "Name wanted for the address (letters, numbers and hyphens, e.g. palotina-pr). Leave blank to use the library name:")") || return 1
    name=$(printf '%s' "$name" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    clear
    display_explanation "Sending the request..."
    body="{\"institution_name\":$(json_str "$inst"),\"contact_email\":$(json_str "$email"),\"requested_name\":$(json_str "$name")}"
    if ! broker_request POST /v1/device/start no "$body"; then
        msg_error "" "$(t "The request was not accepted:")\n\n$(broker_error)" 10 74
        broker_cleanup
        return 1
    fi
    local device user url slug
    device=$(json_field "$BROKER_BODY" device_code)
    user=$(json_field "$BROKER_BODY" user_code)
    url=$(json_field "$BROKER_BODY" verification_uri)
    slug=$(json_field "$BROKER_BODY" suggested_slug)
    broker_cleanup
    if [ -z "$device" ] || ! is_auth_url "$url"; then
        msg_error "" "$(t "The address service gave an unexpected answer. Try again later.")" 8 70
        return 1
    fi
    kv_write "$BROKER_ENROLL" 600 DEVICE_CODE "$device" USER_CODE "$user" VERIFY_URL "$url" SLUG "$slug" \
        BROKER_URL "$(broker_url)" CREATED "$(date +%s)" || return 1
    log "broker: request $user sent for '$slug'"
}

# Shows the request link (QR code, browser or link) and waits for the
# approval. The request stays saved when the person leaves: approval may
# take a while, and this menu picks it up again.
broker_wait_request() {
    local user url pid rc
    user=$(kv_get "$BROKER_ENROLL" USER_CODE)
    url=$(kv_get "$BROKER_ENROLL" VERIFY_URL)
    ( KEI_BROKER_URL="$(kv_get "$BROKER_ENROLL" BROKER_URL)" broker_wait_approval "$(kv_get "$BROKER_ENROLL" DEVICE_CODE)" ) \
        >/dev/null 2>&1 < /dev/null 7>&- 8>&- 9>&- &
    pid=$!
    ALLOW_CTRL_C_RETURN=1
    auth_link_session "$pid" "$url" yes "$(t "Request code: \$user\nThe page shows the status of the request. It is reviewed by the address service; this screen continues on its own once it is approved.\nYou can leave with [C] and come back to this menu later: the request stays saved.")"
    rc=$?
    ALLOW_CTRL_C_RETURN=0
    return "$rc"
}

# After approval: registers this server's key, waits for the tunnel and
# installs it.
broker_complete_request() {
    local device pub lib job opac staff st i
    broker_ensure_key || { msg_error "" "$(t "Could not create the key of this server (openssl).")" 8 66; return 1; }
    pub=$(broker_public_key)
    device=$(kv_get "$BROKER_ENROLL" DEVICE_CODE)
    KEI_BROKER_URL="$(kv_get "$BROKER_ENROLL" BROKER_URL)"
    clear
    display_explanation "Registering this server..."
    if ! broker_request POST /v1/enroll no "{\"device_code\":$(json_str "$device"),\"public_key\":$(json_str "$pub")}"; then
        msg_error "" "$(t "The registration was not accepted:")\n\n$(broker_error)" 10 74
        [ "$BROKER_STATUS" = "409" ] && rm -f "$BROKER_ENROLL"
        broker_cleanup
        return 1
    fi
    lib=$(json_field "$BROKER_BODY" library_id)
    job=$(json_field "$BROKER_BODY" job_id)
    opac=$(json_field "$BROKER_BODY" hostnames opac)
    staff=$(json_field "$BROKER_BODY" hostnames staff)
    broker_cleanup
    kv_write "$TUNNEL_CONF" 644 TUNNEL_MODE broker BROKER_URL "$KEI_BROKER_URL" LIBRARY_ID "$lib" \
        OPAC_HOST "$opac" STAFF_HOST "$staff" STAFF_REMOTE no JOB_ID "$job" || return 1
    rm -f "$BROKER_ENROLL"
    log "broker: library $lib registered ($opac)"

    display_explanation "Creating the tunnel and the address..."
    st=""
    for i in $(seq 1 "${KEI_BROKER_WAIT:-90}"); do
        if broker_request GET "/v1/jobs/$job" yes; then
            st=$(json_field "$BROKER_BODY" state)
            [ "$st" = "done" ] || [ "$st" = "failed" ] && break
        fi
        sleep 2
    done
    broker_cleanup
    if [ "$st" != "done" ]; then
        msg_error "" "$(t "The address is not ready yet. Try again later with the same menu option.")" 9 70
        return 1
    fi
    broker_connect share
}

# broker_connect [share]: fetches the tunnel token and runs cloudflared as a
# service with it. The token goes to a 0600 environment file, never to the
# command line. "share" (first connection) then offers the sharing menu.
broker_connect() {
    local token opac staff_url="" bin
    cloudflared_install || return 1
    display_explanation "Connecting the tunnel..."
    if ! broker_request GET /v1/tunnel-token yes; then
        msg_error "" "$(t "Could not get the tunnel of this library:")\n\n$(broker_error)" 10 74
        broker_cleanup
        return 1
    fi
    token=$(json_field "$BROKER_BODY" tunnel_token)
    broker_cleanup
    [[ "$token" =~ ^[A-Za-z0-9+/=_-]{20,}$ ]] || { msg_error "" "$(t "The address service gave an unexpected answer. Try again later.")" 8 70; return 1; }

    # One cloudflared service per server: the own-domain setup steps aside.
    if [ -f /etc/cloudflared/config.yml ]; then
        cloudflared service uninstall >/dev/null 2>&1 || true
        mv -f /etc/cloudflared/config.yml /etc/cloudflared/config.yml.own-domain 2>/dev/null || true
    fi
    mkdir -p "$(dirname "$BROKER_ENV")"
    ( umask 077; printf 'TUNNEL_TOKEN=%s\n' "$token" > "$BROKER_ENV" )
    chmod 600 "$BROKER_ENV"
    bin=$(command -v cloudflared)
    cat > "$CLOUDFLARED_UNIT" <<EOF
[Unit]
Description=Cloudflare Tunnel for Koha (free address)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=${BROKER_ENV}
ExecStart=${bin} --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable cloudflared >/dev/null 2>&1 || true
    systemctl restart cloudflared >/dev/null 2>&1 || true
    broker_install_cron

    read -r opac _ < <(tunnel_public_hosts)
    [ "$(tunnel_conf_get STAFF_REMOTE 2>/dev/null)" = "yes" ] && staff_url="https://$(tunnel_conf_get STAFF_HOST)"
    set_koha_public_urls "https://${opac}" "$staff_url"

    display_explanation "Checking the address from the internet..."
    if tunnel_check_url "https://${opac}"; then
        if [ "${1:-}" = "share" ]; then
            msg_ok "$(t "Your catalog is online:")\n\n  https://${opac}\n\n$(t "Next, choose how to share the link.")" 12 70
            function_share_catalog_link
        else
            msg_ok "$(t "Your catalog is online:")\n\n  https://${opac}" 10 70
        fi
    else
        msg_info "$(t "Free address")" "$(t "The tunnel is installed, but the address does not answer yet:")\n\n  https://${opac}\n\n$(t "It can take a few minutes. Check again with \"View Public Links and Security Status\".")" 13 74
    fi
}

# tunnel_check_url URL: waits until the address answers through Cloudflare.
tunnel_check_url() {
    local code i
    for i in $(seq 1 "${KEI_TUNNEL_CHECKS:-12}"); do
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2>/dev/null)
        [[ "$code" == [23][0-9][0-9] ]] && return 0
        sleep "${KEI_TUNNEL_CHECK_DELAY:-5}"
    done
    return 1
}

# Daily signed heartbeat: tells the address service the library is alive
# (unused addresses are released after months without one).
broker_install_cron() {
    local panel="/usr/local/bin/config.sh"
    [ -x "$panel" ] || panel="$(readlink -f "$_SCRIPT_PATH")"
    printf 'SHELL=/bin/bash\n%d %d * * * root %s --broker-heartbeat >/dev/null 2>&1\n' \
        "$((RANDOM % 60))" "$((RANDOM % 5 + 1))" "$panel" > "$CRON_BROKER"
    chmod 644 "$CRON_BROKER"
}

# config.sh --broker-heartbeat (cron)
broker_heartbeat() {
    tunnel_mode_is broker || return 0
    local koha
    koha=$(dpkg-query -W -f='${Version}' koha-common 2>/dev/null | cut -c1-32)
    broker_request POST /v1/heartbeat yes \
        "{\"koha_version\":$(json_str "$koha"),\"installer_version\":$(json_str "${PANEL_VERSION# }")}"
    local rc=$?
    broker_cleanup
    return "$rc"
}

function_cloudflare_free_address() {
    if tunnel_mode_is broker; then
        function_broker_manage
        return 0
    fi
    local tool
    require_koha || return 0
    for tool in openssl perl curl; do
        command -v "$tool" >/dev/null 2>&1 || { msg_error "" "$(t "Missing tool:") $tool" 8 60; return 0; }
    done

    if [ ! -f "$BROKER_ENROLL" ]; then
        if [ -f /etc/cloudflared/config.yml ]; then
            prompt_yes_no "$(t "Free address")" "$(t "This server already publishes Koha with your own domain. A free address replaces it (your domain's tunnel is switched off).\n\nContinue?")" 11 74 defaultno || return 0
        fi
        msg_info "$(t "Free address")" "$(t "GET A FREE ADDRESS FOR YOUR CATALOG\n\nNo domain or Cloudflare account is needed. You send a short request\n(library name, contact e-mail and the name you want); the address service\nreviews it and this server then connects on its own.\n\nThe public catalog (OPAC) goes online. The staff interface stays on the\nlocal network until you turn on remote staff access, which adds a password\nchecked before anyone reaches Koha.")" 17 78
        broker_new_request || return 0
    fi

    broker_wait_request
    case $? in
        0) broker_complete_request ;;
        130) msg_info "$(t "Free address")" "$(t "The request stays saved. Come back to this menu to continue once it is approved.")" 9 70 ;;
        *)
            rm -f "$BROKER_ENROLL"
            msg_error "" "$(t "The request was not approved or has expired. You can send a new one.")" 9 70
            ;;
    esac
}

# Menu of a server that already has a free address.
function_broker_manage() {
    local choice opac staff remote
    while true; do
        opac=$(tunnel_conf_get OPAC_HOST)
        remote="$(t "off")"
        [ "$(tunnel_conf_get STAFF_REMOTE)" = "yes" ] && remote="$(t "on")"
        choice=$(ui_menu "$(t "Free address")" "$(t "Catalog address: https://\$opac\nRemote staff access: \$remote")" \
            "1" "$(t "Remote staff access (password at the edge)")" \
            "2" "$(t "Reconnect the tunnel (fetch the token again)")" \
            "3" "$(t "Renew the tunnel token")" \
            "4" "$(t "Give up the free address")") || return 0
        case "$choice" in
            1) function_broker_staff_access ;;
            2) clear; broker_connect ;;
            3)
                clear
                display_explanation "Renewing the tunnel token..."
                if broker_request POST /v1/rotate yes "{}"; then
                    broker_cleanup
                    broker_connect
                else
                    msg_error "" "$(broker_error)" 9 70
                    broker_cleanup
                fi
                ;;
            4) function_broker_leave && return 0 ;;
        esac
    done
}

# Remote staff access: the staff hostname answers only after a user and
# password checked by the broker at Cloudflare's edge (then Koha's own login).
function_broker_staff_access() {
    local user pass pass2 cidrs c list="" staff
    staff=$(tunnel_conf_get STAFF_HOST)
    local choice
    choice=$(ui_menu "$(t "Remote staff access")" "$(t "Staff interface from outside the library: https://\$staff\n\nBefore Koha's own login, the browser asks for a user and password that only the library knows. Optionally, only some networks are allowed.")" \
        "on" "$(t "Turn on or change the password")" \
        "off" "$(t "Turn off (staff interface only on the local network)")") || return 0

    if [ "$choice" = "off" ]; then
        if broker_request DELETE /v1/staff-credentials yes; then
            broker_cleanup
            kv_write "$TUNNEL_CONF" 644 STAFF_REMOTE no
            set_koha_public_urls "https://$(tunnel_conf_get OPAC_HOST)" "http://$(get_server_ip):8080"
            msg_ok "$(t "Remote staff access is off.")" 8 60
        else
            msg_error "" "$(broker_error)" 9 70
            broker_cleanup
        fi
        return 0
    fi

    user=$(ui_input "$(t "Remote staff access")" "$(t "User for the remote access (not a Koha user):")" "biblioteca") || return 0
    [[ "$user" =~ ^[A-Za-z0-9._@-]{3,64}$ ]] || { msg_error "" "$(t "Use 3 to 64 letters, numbers or . _ @ -")" 8 60; return 0; }
    pass=$(whiptail --title "$(t "Password")" --passwordbox "$(t "Password for the remote access (at least 12 characters):")" 9 70 3>&1 1>&2 2>&3) || return 0
    [ ${#pass} -ge 12 ] || { msg_error "" "$(t "The password must have at least 12 characters.")" 8 60; return 0; }
    pass2=$(whiptail --title "$(t "Confirm Password")" --passwordbox "$(t "Type the password again:")" 9 64 3>&1 1>&2 2>&3) || return 0
    [ "$pass" = "$pass2" ] || { msg_error "" "$(t "The passwords do not match.")" 8 60; return 0; }
    cidrs=$(ui_input "$(t "Remote staff access")" "$(t "Allowed networks (optional), e.g. 200.10.0.0/16, separated by spaces. Leave blank to allow any network:")") || return 0
    for c in $cidrs; do
        [[ "$c" =~ ^[0-9A-Fa-f.:]+(/[0-9]{1,3})?$ ]] || { msg_error "" "$(t "Invalid network:") $c" 8 60; return 0; }
        list+="${list:+,}$(json_str "$c")"
    done

    clear
    display_explanation "Saving the remote access..."
    if broker_request PUT /v1/staff-credentials yes \
        "{\"username\":$(json_str "$user"),\"password\":$(json_str "$pass"),\"allow_cidrs\":[${list}]}"; then
        broker_cleanup
        kv_write "$TUNNEL_CONF" 644 STAFF_REMOTE yes
        set_koha_public_urls "https://$(tunnel_conf_get OPAC_HOST)" "https://${staff}"
        msg_ok "$(t "Remote staff access is on:")\n\n  https://${staff}\n\n$(t "The browser asks for the remote access user and password first, then shows Koha's login.")" 13 74
    else
        msg_error "" "$(t "The remote access was not saved:")\n\n$(broker_error)" 10 74
        broker_cleanup
    fi
    unset pass pass2
}

function_broker_leave() {
    local opac
    opac=$(tunnel_conf_get OPAC_HOST)
    prompt_yes_no "$(t "Give up the free address")" "$(t "The address https://\$opac is released and the catalog goes offline to the internet (it stays on the local network).\n\nContinue?")" 11 74 defaultno || return 1
    clear
    display_explanation "Releasing the address..."
    if ! broker_request DELETE /v1/library yes && [ "$BROKER_STATUS" != "401" ]; then
        msg_error "" "$(t "The address service did not confirm:")\n\n$(broker_error)" 10 74
        broker_cleanup
        return 1
    fi
    broker_cleanup
    systemctl disable --now cloudflared >/dev/null 2>&1 || true
    rm -f "$CLOUDFLARED_UNIT" "$BROKER_ENV" "$CRON_BROKER" "$TUNNEL_CONF" "$BROKER_KEY"
    systemctl daemon-reload >/dev/null 2>&1 || true
    set_koha_public_urls "http://$(get_server_ip)" "http://$(get_server_ip):8080"
    log "broker: address $opac released"
    msg_ok "$(t "The free address was released.\nKoha is now only accessible on the local network.")" 10 70
    return 0
}

# Share the catalog link: QR code on this screen, a QR code image to print,
# the browser of this computer, or the link to copy.
function_share_catalog_link() {
    local opac url items=() choice png
    read -r opac _ < <(tunnel_public_hosts)
    if [ "$opac" = "-" ]; then
        msg_error "" "$(t "The catalog has no internet address yet. Set up the tunnel first.")" 9 70
        return 0
    fi
    url="https://${opac}"
    is_auth_url "$url" || return 0
    while true; do
        items=("qr" "$(t "QR code on this screen")" "png" "$(t "Save a QR code image to print")")
        browser_opener >/dev/null && items+=("browser" "$(t "Open in the browser of this computer")")
        items+=("link" "$(t "Show the link to copy")")
        choice=$(ui_menu "$(t "Share the catalog")" "$url" "${items[@]}") || return 0
        case "$choice" in
            qr)
                clear
                ensure_qrencode && qrencode -t ANSIUTF8 -l M -m 2 "$url"
                printf '\n  %s\n\n' "$url"
                pause_terminal
                ;;
            png)
                png="${REAL_HOME:-/root}/koha-catalog-qr.png"
                if ensure_qrencode && qrencode -t PNG -l M -s 12 -m 4 -o "$png" "$url"; then
                    [ -n "${REAL_USER:-}" ] && chown "$REAL_USER" "$png" 2>/dev/null
                    msg_ok "$(t "QR code image saved:")\n\n  $png" 10 70
                else
                    msg_error "" "$(t "Could not create the image.")" 8 60
                fi
                ;;
            browser) open_in_browser "$url" ;;
            link)
                clear
                printf '%s\n\n  %s\n\n' "$(t "Link of the catalog:")" "$url"
                pause_terminal
                ;;
        esac
    done
}

ensure_qrencode() {
    command -v qrencode >/dev/null 2>&1 && return 0
    echo "$(t "Installing the QR code generator (qrencode)...")"
    apt_install qrencode >/dev/null 2>&1
    command -v qrencode >/dev/null 2>&1
}

function_configure_cloudflare() {
    while true; do
        local tunnel_active
        tunnel_active="$(t "INACTIVE")"
        systemctl is-active --quiet cloudflared && tunnel_active="$(t "ACTIVE")"

        local choice
        choice=$(whiptail --title "$(t "Cloudflare Tunnel Manager")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Tunnel Status: \$tunnel_active\n\nCloudflare Tunnel safely exposes Koha without opening ports.\n\nWhat do you want to do?")" 20 78 6 \
            "1" "$(t "★  Free Address (no domain needed)")" \
            "2" "$(t "⚙  Use My Own Domain (Cloudflare account)")" \
            "3" "$(t "ℹ  View Public Links and Security Status")" \
            "4" "$(t "▣  Share the Catalog Link (QR code, link)")" \
            "5" "$(t "↻  Restart Tunnel Service")" \
            "6" "$(t "✖  Disable and Remove Tunnel (Go Offline)")" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 ]] && break

        case "$choice" in
            1) function_cloudflare_free_address ;;
            2) function_cloudflare_setup ;;
            3) function_cloudflare_status ;;
            4) function_share_catalog_link ;;
            5)
                clear
                display_explanation "Restarting Cloudflare Tunnel..."
                systemctl restart cloudflared >/dev/null 2>&1
                msg_ok "$(t "Service restarted successfully.")" 8 60
                ;;
            6)
                if tunnel_mode_is broker; then
                    function_broker_leave
                    continue
                fi
                if prompt_yes_no "$(t "Disable Tunnel")" "$(t "This will stop the service and remove auto-start.\nYour catalog will go offline to the internet.\n\nContinue?")" 10 70; then
                    clear
                    display_explanation "Uninstalling service..."
                    cloudflared service uninstall >/dev/null 2>&1 || true
                    systemctl disable --now cloudflared >/dev/null 2>&1 || true
                    msg_ok "$(t "Tunnel disabled.\nKoha is now only accessible on the local network.")" 10 70
                fi
                ;;
        esac
    done
}

# ======================================================================
# 15. GOOGLE SEARCH CONSOLE / OPAC INDEXING
# ======================================================================
function_google_search_console() {
    local opac_url=""
    local sitemap_path="sitemapindex.xml"
    local sitemap_url=""
    local robots_url=""
    local http_code=""
    local sitemap_code=""
    local robots_body=""
    local meta_robots=""
    local sitemap_script=""
    local choice=""

    clear
    require_koha || return 0

    if ! command -v curl >/dev/null 2>&1; then
        msg_error "$(t "Google Search Console")" \
            "$(t "The curl command is not available.\n\nInstall the panel dependencies before continuing.")" 10 72
        return 1
    fi

    opac_url=$(whiptail \
        --title "$(t "Google Search Console — OPAC address")" \
        --inputbox "$(t "Enter the complete PUBLIC OPAC address.\n\nExample:\nhttps://catalog.example.org\n\nDo not enter localhost, 127.0.0.1 or a private IP address.")" \
        15 80 "https://" 3>&1 1>&2 2>&3) || return 0

    opac_url="${opac_url%/}"
    case "$opac_url" in
        http://*|https://*) ;;
        *)
            msg_error "$(t "Invalid address")" \
                "$(t "Enter a URL beginning with http:// or https://.")" 9 68
            return 1
            ;;
    esac

    sitemap_url="${opac_url}/${sitemap_path}"
    robots_url="${opac_url}/robots.txt"

    msg_info "$(t "Google Search Console — Indexing Assistant")" \
        "$(t "This assistant prepares and checks the OPAC for Google.\n\nThe panel will automatically:\n• check whether the OPAC is publicly accessible;\n• check robots.txt;\n• locate Koha's official sitemap script;\n• generate the sitemap when possible;\n• check the OpacMetaRobots preference;\n• check whether the sitemap is publicly accessible.\n\nWhat you will need to do manually:\n• add/verify the property in Google Search Console;\n• submit the sitemap in Search Console;\n• request indexing for specific pages when necessary.\n\nThe panel does NOT request or store your Google password.")" 24 88

    display_explanation "Checking public OPAC access..."

    http_code=$(curl -L -k -sS -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 30 "$opac_url" 2>/dev/null)

    if [[ "$http_code" =~ ^[23][0-9][0-9]$ ]]; then
        msg_ok "$(t "OPAC accessible.\n\nURL:\n\$opac_url\n\nHTTP status:\n\$http_code")" 11 76
    else
        msg_error "$(t "Connection Error")" \
            "$(t "The OPAC did not respond correctly from the internet.\n\nURL:\n\$opac_url\n\nHTTP:\n\${http_code:-no response}\n\nCheck DNS, Cloudflare Tunnel, Apache, HTTPS and firewall before attempting indexing.")" 16 82

        prompt_yes_no "$(t "Continue?")" \
            "$(t "The OPAC is not responding correctly yet.\n\nDo you want to continue with local checks?")" 11 74 || return 0
    fi

    if is_database_ready; then
        display_explanation "Checking OpacMetaRobots..."

        meta_robots=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable='OpacMetaRobots' LIMIT 1;" 2>/dev/null || true)

        if printf '%s' "$meta_robots" | grep -qi 'noindex'; then
            msg_error "$(t "Warning: NOINDEX Detected")" \
                "$(t "WARNING: the OPAC is configured with NOINDEX.\n\nCurrent value:\n\$meta_robots\n\nWhile 'noindex' is configured, Google may be instructed not to index the pages.\n\nTo fix it manually:\n\nKoha Staff\n→ Administration\n→ System preferences\n→ OPAC\n→ OpacMetaRobots\n\nRemove the 'noindex' option and save.\nThe panel does NOT change this automatically.")" 22 88
        else
            msg_ok "$(t "OpacMetaRobots does not contain 'noindex'.\n\nCurrent value:\n\${meta_robots:-not defined}")" 12 78
        fi
    fi

    # Package installs keep the cron scripts in /usr/share/koha/bin/cronjobs.
    sitemap_script=""
    local candidate
    for candidate in /usr/share/koha/bin/cronjobs/sitemap.pl /usr/share/koha/misc/cronjobs/sitemap.pl; do
        [ -f "$candidate" ] && { sitemap_script="$candidate"; break; }
    done
    [ -z "$sitemap_script" ] && sitemap_script=$(find /usr/share/koha -type f -name 'sitemap.pl' 2>/dev/null | head -n 1 || true)
    if [ -n "$sitemap_script" ]; then
        display_explanation "Generating Koha sitemap..."
        # The script runs as the instance user, which cannot write in the OPAC
        # document root: generate in a temporary folder, then publish as root.
        local sm_tmp opac_root="/usr/share/koha/opac/htdocs"
        sm_tmp=$(mktemp -d /tmp/koha_sitemap.XXXXXX)
        chown "${INSTANCE}-koha:${INSTANCE}-koha" "$sm_tmp" 2>/dev/null || chmod 777 "$sm_tmp"
        if /usr/sbin/koha-shell "$INSTANCE" -c "/usr/bin/perl '$sitemap_script' --dir '$sm_tmp' --url '$opac_url'" \
                >"${LOG_DIR}/google-sitemap.log" 2>&1 && ls "$sm_tmp"/*.xml >/dev/null 2>&1; then
            if [ -d "$opac_root" ]; then
                cp -f "$sm_tmp"/*.xml "$opac_root"/ 2>/dev/null && chmod 644 "$opac_root"/sitemap*.xml 2>/dev/null
            fi
            log "Koha sitemap generated successfully."
        else
            log "Warning: could not run sitemap automatically (see ${LOG_DIR}/google-sitemap.log)."
        fi
        rm -rf "$sm_tmp"
    else
        log "Warning: sitemap.pl script not found."
    fi

    display_explanation "Checking the published sitemap..."

    sitemap_code=$(curl -L -k -sS -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 30 "$sitemap_url" 2>/dev/null)

    if [[ "$sitemap_code" =~ ^2[0-9][0-9]$ ]]; then
        msg_ok "$(t "Sitemap found!\n\nURL:\n\$sitemap_url\n\nHTTP:\n\$sitemap_code")" 12 82
    else
        msg_info "$(t "Sitemap unconfirmed")" \
            "$(t "The sitemap was not confirmed at this address.\n\n\$sitemap_url\n\nThis does not necessarily mean that Koha has a problem.\nThe sitemap may need to be configured/published at the OPAC root, or the path used by the installation may need to be confirmed.")" 16 84
    fi

    robots_body=$(curl -L -k -sS --connect-timeout 10 --max-time 30 "$robots_url" 2>/dev/null || true)
    if [ -n "$robots_body" ]; then
        if printf '%s\n' "$robots_body" | grep -Fqi 'Sitemap:'; then
            msg_ok "$(t "robots.txt found and already contains a Sitemap: line.")" 10 82
        else
            msg_info "$(t "robots.txt without sitemap")" \
                "$(t "robots.txt found, but without a sitemap reference.\n\nRecommendation:\n\nAdd a line similar to:\nSitemap: \$sitemap_url\n\nThe change should be made in the correct OPAC configuration, not in an arbitrary system file.")" 15 84
        fi
    else
        msg_info "$(t "robots.txt missing")" \
            "$(t "robots.txt did not respond.\n\nIt is recommended to make robots.txt correctly available on the public OPAC.")" 10 78
    fi

    choice=$(whiptail \
        --title "$(t "Google Search Console — Next steps")" \
        --menu "$(t "Automatic preparation is complete.\n\nChoose what you want to do:")" \
        20 88 7 \
        "1" "$(t "Open Google Search Console instructions")" \
        "2" "$(t "Property verification — step by step")" \
        "3" "$(t "Submit sitemap — step by step")" \
        "4" "$(t "Request indexing — step by step")" \
        "5" "$(t "Run the checks again")" \
        "6" "$(t "Official Google links")" \
        "7" "$(t "Back")" 3>&1 1>&2 2>&3) || return 0

    case "$choice" in
        1)
            msg_info "$(t "GOOGLE SEARCH CONSOLE")" \
                "$(t "Open on your computer:\nhttps://search.google.com/search-console\n\nThen add the property corresponding to the public OPAC address:\n\$opac_url")" 16 84
            ;;
        2)
            msg_info "$(t "PROPERTY VERIFICATION — DO THIS MANUALLY")" \
                "$(t "1. Open:\nhttps://search.google.com/search-console\n\n2. Click 'Add property'.\n\n3. Choose 'URL prefix'.\n\n4. Paste exactly:\n\$opac_url\n\n5. Google will show the available verification methods.\nOne option is DNS verification, performed at the domain provider.\nAnother option is HTML file or meta tag verification, when available.\n\nIMPORTANT:\nIf the domain belongs to a municipality or another institution, DNS changes may need to be performed by the IT administrator.\nThe panel does not need your Google password.")" 27 92
            ;;
        3)
            msg_info "$(t "SUBMIT THE SITEMAP — DO THIS MANUALLY")" \
                "$(t "After the property has been verified:\n\n1. Open:\nhttps://search.google.com/search-console\n\n2. Select:\n\$opac_url\n\n3. Open 'Sitemaps' in the left menu.\n\n4. Enter:\n\$sitemap_path\n\n5. Click 'Submit'.\n\nGoogle will then know where the sitemap is located.\n\nWARNING:\nSubmitting a sitemap does not guarantee that every page will be indexed.")" 22 88
            ;;
        4)
            msg_info "$(t "REQUEST INDEXING — DO THIS MANUALLY")" \
                "$(t "To test the main catalog address:\n\n1. Open Search Console.\n2. Select your property.\n3. Use 'URL Inspection'.\n4. Paste:\n\$opac_url\n5. Wait for the analysis.\n6. If available, use 'Request indexing'.\n\nYou do not need to request every book individually.\nA sitemap is the appropriate method for informing Google about a large set of URLs.\nA request for indexing also does not guarantee immediate indexing.")" 23 88
            ;;
        5)
            function_google_search_console
            return $?
            ;;
        6)
            msg_info "$(t "OFFICIAL LINKS")" \
                "$(t "Google Search Console:\nhttps://search.google.com/search-console\n\nOfficial sitemap documentation:\nhttps://developers.google.com/search/docs/crawling-indexing/sitemaps/overview\n\nOfficial indexing documentation:\nhttps://developers.google.com/search/docs/crawling-indexing/overview")" 19 88
            ;;
        7)
            return 0
            ;;
    esac

    msg_info "$(t "FINAL GOOGLE CHECKLIST")" \
        "$(t "AUTOMATICALLY BY THE PANEL:\n\n[✓] OPAC checked\n[✓] OpacMetaRobots checked\n[✓] Koha sitemap located/generated when possible\n[✓] Public sitemap tested\n[✓] robots.txt tested\n\nMANUALLY IN GOOGLE:\n\n[ ] Property added\n[ ] Property verified\n[ ] Sitemap submitted\n[ ] Homepage tested with URL Inspection\n[ ] Indexing requested if necessary\n\nIMPORTANT:\nSearch Console helps Google discover the catalog, but it does not guarantee that every page will be indexed or appear immediately in search results.")" 25 92

    log "Google Search Console assistant executed for OPAC: $opac_url"
}

# ======================================================================
# 16. SSL CERTIFICATE
# ======================================================================
function_configure_ssl() {
    require_koha || return 0
    prompt_yes_no "$(t "SSL / HTTPS")" \
"$(t "To issue the free certificate you NEED a domain with an A record\npointing to this server's PUBLIC IP, and port 80 reachable.\n\nIf you use Cloudflare Tunnel, CANCEL: HTTPS already comes from it.\n\nContinue?")" 15 76 || return 0
    clear
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! apt_install certbot python3-certbot-apache; then
        restore_apt_timers
        return 1
    fi
    restore_apt_timers
    if ! koha_ctl certbot --apache; then
        msg_error "" "$(t "Certbot could not complete certificate issuance/configuration. Apache will not be reloaded automatically.")" 10 78
        return 1
    fi
    if ! apachectl configtest; then
        msg_error "" "$(t "Apache configuration is invalid after Certbot. The service will not be reloaded.")" 10 76
        return 1
    fi
    if ! systemctl restart apache2 >/dev/null 2>&1; then
        msg_error "" "$(t "The certificate was configured, but Apache failed to restart. Check the service status.")" 10 76
        return 1
    fi
    msg_ok "$(t "HTTPS configured successfully. Certbot will handle automatic renewal.")" 9 72
}

# ======================================================================
# 17. INTEROPERABILITY (SIP2 / Z39.50)
# ======================================================================
function_interoperability() {
    require_koha || return 0
    prompt_yes_no "$(t "SIP2 & Z39.50")" \
"$(t "Z39.50 (port 2100): lets other libraries search your catalog.\nSIP2 (port 6001): lets you connect self-checkout terminals.\n\nEnable both and open the firewall ports?")" 13 78 || return 0
    clear
    ufw allow 2100/tcp >/dev/null 2>&1 || true
    ufw allow 6001/tcp >/dev/null 2>&1 || true

    /usr/sbin/koha-z3950-responder --enable "$INSTANCE" >/dev/null 2>&1 || true
    /usr/sbin/koha-sip --enable "$INSTANCE" >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true

    local z39_ok="no" sip_ok="no"
    if koha_ctl /usr/sbin/koha-z3950-responder --start "$INSTANCE" >/dev/null 2>&1 \
       || systemctl enable --now "koha-z3950-responder@${INSTANCE}" >/dev/null 2>&1 \
       || pgrep -f "z3950_responder.*${INSTANCE}" >/dev/null 2>&1; then
        z39_ok="yes"
    fi
    if koha_ctl /usr/sbin/koha-sip --start "$INSTANCE" >/dev/null 2>&1 \
       || systemctl enable --now "koha-sip-daemon@${INSTANCE}" >/dev/null 2>&1 \
       || pgrep -f "SIPServer.*${INSTANCE}" >/dev/null 2>&1; then
        sip_ok="yes"
    fi

    local z39_status sip_status
    [ "$z39_ok" = "yes" ] && z39_status="$(t "active")" || z39_status="$(t "inactive")"
    [ "$sip_ok" = "yes" ] && sip_status="$(t "active")" || sip_status="$(t "inactive")"

    if [ "$z39_ok" = "yes" ] && [ "$sip_ok" = "yes" ]; then
        msg_ok "$(t "Z39.50 and SIP2 were enabled successfully!\n\nFor SIP2 you still need a circulation account and\nto fill in:\n/etc/koha/sites/\${INSTANCE}/SIPconfig.xml")" 12 76
    else
        msg_error "" "$(t "Activation was partial.\n\nZ39.50: \${z39_status}\nSIP2:    \${sip_status}\n\nCheck: systemctl status koha-z3950-responder@\${INSTANCE} koha-sip-daemon@\${INSTANCE}")" 12 78
        return 1
    fi
}

# ======================================================================
# 18. CLOCK AND TIMEZONE
# ======================================================================
# Lists valid timezones. Falls back to /usr/share/zoneinfo when timedatectl
# does not work (containers, WSL, systems booted without systemd).
list_timezones() {
    local tz_list
    tz_list=$(timedatectl list-timezones 2>/dev/null)
    if [ -z "$tz_list" ] && [ -d /usr/share/zoneinfo ]; then
        tz_list=$(cd /usr/share/zoneinfo && find . -type f -o -type l 2>/dev/null \
            | sed 's|^\./||' \
            | grep -E '^(Africa|America|Antarctica|Arctic|Asia|Atlantic|Australia|Europe|Indian|Pacific)/[A-Za-z0-9_+/-]+$|^UTC$' \
            | sort -u)
    fi
    [ -z "$tz_list" ] && tz_list="UTC"
    printf '%s\n' "$tz_list"
}

get_current_timezone() {
    local tz=""
    command -v timedatectl >/dev/null 2>&1 && tz=$(timedatectl show -p Timezone --value 2>/dev/null)
    [ -z "$tz" ] && [ -f /etc/timezone ] && tz=$(tr -d '[:space:]' < /etc/timezone)
    [ -z "$tz" ] && [ -L /etc/localtime ] && tz=$(readlink -f /etc/localtime | sed 's|.*/zoneinfo/||')
    printf '%s' "${tz:-UTC}"
}

# Sets KEY=VALUE in [SECTION] of an INI file such as /etc/wsl.conf, keeping
# every other line; the section is added when missing. Replaced atomically.
ini_set_value() {
    local file="$1" section="$2" key="$3" value="$4" tmp
    tmp=$(mktemp "${file}.XXXXXX") || return 1
    { cat "$file" 2>/dev/null || true; } | awk -v sec="$section" -v key="$key" -v val="$value" '
        function put() { if (insec && !done) { print key "=" val; done = 1 } }
        /^[[:space:]]*\[.*\][[:space:]]*$/ {
            name = $0; gsub(/^[[:space:]]*\[[[:space:]]*|[[:space:]]*\][[:space:]]*$/, "", name)
            put()
            insec = (tolower(name) == tolower(sec))
            print; next
        }
        insec && index($0, "=") {
            k = substr($0, 1, index($0, "=") - 1); gsub(/[[:space:]]/, "", k)
            if (tolower(k) == tolower(key)) { if (!done) { print key "=" val; done = 1 }; next }
        }
        { print }
        END { put(); if (!done) { if (NR) print ""; print "[" sec "]"; print key "=" val } }
    ' > "$tmp" || { rm -f "$tmp"; return 1; }
    chmod 644 "$tmp" && mv -f "$tmp" "$file"
}

# Applies a timezone, with a fallback for systems where timedatectl fails.
# Under WSL, Windows' zone is copied into Debian at every start; a library
# that picks another zone has that switched off in /etc/wsl.conf
# ([time] useWindowsTimezone=false), or the choice would last one boot.
apply_timezone() {
    local tz="$1" before
    [ -n "$tz" ] && [ -f "/usr/share/zoneinfo/$tz" ] || return 1
    before=$(get_current_timezone)
    if ! timedatectl set-timezone "$tz" >/dev/null 2>&1; then
        ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime || return 1
        printf '%s\n' "$tz" > /etc/timezone
    fi
    if is_wsl && [ "$tz" != "$before" ]; then
        if ini_set_value "$KEI_WSL_CONF" time useWindowsTimezone false; then
            log "timezone: $tz differs from Windows ($before), useWindowsTimezone=false in $KEI_WSL_CONF"
        else
            log "timezone: could not update $KEI_WSL_CONF"
        fi
    fi
    log "timezone set to $tz"
    return 0
}

# Prints the chosen timezone on stdout. It is called as $(choose_timezone),
# so stdout is captured: every dialog is therefore drawn on the terminal
# (/dev/tty) and only the answer travels through the pipe. Before, the
# yes/no box was drawn inside the capture, stayed invisible and the
# installation looked frozen.
choose_timezone() {
    local detected_tz tty_dev="/dev/tty"
    detected_tz=$(get_current_timezone)
    [ -r "$tty_dev" ] && [ -w "$tty_dev" ] || { printf '%s' "$detected_tz"; return 0; }

    local ask_msg
    ask_msg="$(t 'Detected system timezone: ${detected_tz}\n\nDo you want to use this timezone?')"
    if whiptail --title "$(t "Timezone Configuration")" --yesno "$ask_msg" 11 70 \
            <"$tty_dev" >"$tty_dev" 2>&1; then
        printf '%s' "$detected_tz"
        return 0
    fi

    local all_tz regions=() reg region_menu=()
    all_tz=$(list_timezones)
    mapfile -t regions < <(printf '%s\n' "$all_tz" | cut -d/ -f1 | sort -u)
    for reg in "${regions[@]}"; do
        [ -n "$reg" ] && region_menu+=("$reg" "")
    done

    local chosen_region chosen_city cities=() city city_menu=()
    while true; do
        chosen_region=$(whiptail --title "$(t "Global Timezone Selection")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Select your region/continent:")" 20 60 12 \
            "${region_menu[@]}" 3>&1 1>"$tty_dev" 2>&3 <"$tty_dev") || return 1
        [ -z "$chosen_region" ] && return 1

        if [ "$chosen_region" = "UTC" ]; then
            printf '%s' "UTC"
            return 0
        fi

        mapfile -t cities < <(printf '%s\n' "$all_tz" | grep "^${chosen_region}/" | sed "s|^${chosen_region}/||" | sort)
        city_menu=()
        for city in "${cities[@]}"; do
            [ -n "$city" ] && city_menu+=("$city" "")
        done
        [ ${#city_menu[@]} -eq 0 ] && continue

        # "Back" returns to the region list instead of cancelling everything.
        chosen_city=$(whiptail --title "$(t "Global Timezone Selection")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Select the closest city/timezone:")" 22 65 14 \
            "${city_menu[@]}" 3>&1 1>"$tty_dev" 2>&3 <"$tty_dev") || continue
        if [ -n "$chosen_city" ]; then
            printf '%s' "${chosen_region}/${chosen_city}"
            return 0
        fi
    done
}

function_configure_clock() {
    local tz cur_tz cur_time
    if tz=$(choose_timezone) && [ -n "$tz" ]; then
        if ! apply_timezone "$tz"; then
            msg_error "" "$(t 'Could not apply the timezone ${tz}.')" 9 70
        fi
    fi
    host_can ntp && systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    systemctl restart cron >/dev/null 2>&1
    cur_tz=$(get_current_timezone)
    cur_time=$(date '+%Y-%m-%d %H:%M')
    msg_ok "$(t 'Timezone set to: ${cur_tz}\nCurrent time: ${cur_time}\n\nCron was restarted to pick up the new time.')" 11 74
}

# ======================================================================
# 19. UPDATE SYSTEM AND SCHEMAS
# ======================================================================
function_update_system() {
    prompt_yes_no "$(t "Update")" \
"$(t "System and Koha packages will be updated and database\nmigrations applied.\n\nRecommended: make a backup first.\n\nContinue?")" 13 74 || return 0
    clear
    # koha-common's own postinst migrates the database during "apt-get
    # upgrade": the verified safety copy must exist before the packages move.
    local cur_tables pre_update
    if is_koha_installed && cur_tables=$(koha_table_count) && [ "$cur_tables" -gt 0 ]; then
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Another backup or restore is already running.\nNothing was changed.")" 10 72
            return 1
        fi
        display_explanation "Generating the backup..."
        pre_update="${DIR_SQL}/PRE-UPDATE_$(date +%Y-%m-%d_%Hh%M%S).sql.gz"
        CLEANUP_FILE="$pre_update"
        if ! create_safety_backup "$pre_update"; then
            CLEANUP_FILE=""
            backup_lock_release
            msg_error "$(t "Safety backup failed")" "$(t 'The safety backup of the current database could not be created or validated (check the free space and ${DIR_SQL}).\n\nNothing was changed.')" 12 76
            return 1
        fi
        CLEANUP_FILE=""
        backup_lock_release
        echo "$(t "Safety backup:") $pre_update"
        log "pre-update safety backup: $pre_update"
    fi
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"; then
        restore_apt_timers
        msg_error "" "$(t "Package upgrade failed. Koha migrations will not run.")" 10 76
        return 1
    fi
    if is_koha_installed; then
        display_explanation "Applying database migrations..."
        if ! /usr/sbin/koha-upgrade-schema "$INSTANCE"; then
            restore_apt_timers
            msg_error "" "$(t "Database migration failed. Services will not be restarted automatically to avoid hiding the error.")" 11 78
            return 1
        fi
        if ! systemctl restart memcached apache2 koha-common >/dev/null 2>&1; then
            restore_apt_timers
            msg_error "" "$(t "One of the core services did not restart after the update.")" 9 72
            return 1
        fi
        if ! ensure_koha_services >/dev/null 2>&1 && ! plack_running; then
            restore_apt_timers
            msg_error "" "$(t "Plack did not restart after the update.")" 9 70
            return 1
        fi
        if [ "$(get_search_engine)" = "Elasticsearch" ]; then
            if ! manage_koha_indexers start; then
                restore_apt_timers
                msg_error "" "$(t "The Elasticsearch indexer could not be started after the update.")" 10 76
                return 1
            fi
        else
            zebra_stop
            if ! zebra_start; then
                restore_apt_timers
                msg_error "" "$(t "Zebra could not be started after the update.")" 9 72
                return 1
            fi
            ensure_search_indexing >/dev/null 2>&1
        fi
    fi
    display_explanation "Cleaning orphan packages..."
    apt-get clean -y >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1 || true
    journalctl --vacuum-time=14d >/dev/null 2>&1 || true
    restore_apt_timers
    if validate_complete_system "$(t "system update")"; then
        msg_ok "$(t "Update finished with no critical errors.")" 9 70
    else
        msg_info "$(t "Update with warnings")" "$(t "The update ran but validation found \$V_FAIL failure(s) and \$V_WARN warning(s).\n\nLog: \$VALIDATION_LOG")" 11 76
        show_validation_report
        return 1
    fi
    return 0
}

# ======================================================================
# 20. FULL SYSTEM VALIDATION
# ======================================================================
function_validate_system() {
    clear
    if validate_complete_system "$(t "manual validation")"; then
        msg_ok "$(t "No critical failures.\n\nOK: \$V_OK   Warnings: \$V_WARN")" 10 70
    else
        msg_info "$(t "Issues found")" "$(t "Failures: \$V_FAIL   Warnings: \$V_WARN   OK: \$V_OK")" 10 70
    fi
    show_validation_report
}

# ======================================================================
# 20.0. RESTART / REPAIR KOHA SERVICES
# ======================================================================
function_repair_services() {
    require_koha || return 0
    clear
    display_explanation "Restarting Koha services (Memcached, Plack, Apache)..."
    systemctl start mariadb >/dev/null 2>&1
    start_koha_workers
    is_koha_zebra_running || zebra_start >/dev/null 2>&1
    ensure_search_indexing >/dev/null 2>&1
    ensure_koha_services >/dev/null 2>&1
    local mc_state plack_state details="" cache cache_line
    memcached_alive && mc_state="$(t "active")" || mc_state="$(t "inactive")"
    plack_running && plack_state="$(t "running")" || plack_state="$(t "stopped")"
    cache=$(koha_cache_state)
    cache_line=$(koha_cache_text "$cache")
    log "services repaired: memcached=$mc_state plack=$plack_state koha-cache=$cache"
    if memcached_alive && plack_running && [ "$cache" != module ] && [ "$cache" != connect ]; then
        msg_ok "$(t 'Koha services restarted.\n\nMemcached: ${mc_state}\nPlack: ${plack_state}')\n\n${cache_line}" 13 76
    else
        if ! memcached_alive; then
            details=$(journalctl -u memcached -n 6 --no-pager 2>/dev/null | cut -c1-76)
        else
            details=$(tail -n 8 "/var/log/koha/${INSTANCE}/plack-error.log" 2>/dev/null | cut -c1-76)
        fi
        msg_error "" "$(t 'Koha services restarted.\n\nMemcached: ${mc_state}\nPlack: ${plack_state}')\n\n${cache_line}\n\n${details}" 22 80
    fi
}

# ======================================================================
# 20.1. DEEP MAINTENANCE & OPTIMIZATION
# ======================================================================
function_deep_maintenance() {
    require_database || return 0
    
    prompt_yes_no "$(t "Deep Maintenance")" \
"$(t "This routine will:\n\n• Repair and optimize MariaDB tables\n• Clean system journal logs (> 7 days)\n• Vacuum temporary and backup old files\n\nContinue?")" 14 76 || return 0

    clear
    display_explanation "Optimizing MariaDB tables and database..."
    
    if mysqlcheck --auto-repair --optimize --default-character-set=utf8mb4 "$DB_NAME" >/tmp/koha_db_optimize.log 2>&1; then
        log "database optimized successfully"
    else
        log "database optimization reported warnings or errors"
    fi

    display_explanation "Cleaning system and journal logs..."
    journalctl --vacuum-time=7d >/dev/null 2>&1 || true
    find "$LOG_DIR" -name "*.log" -mtime +14 -delete 2>/dev/null || true

    display_explanation "Restarting core services to free memory..."
    systemctl restart memcached >/dev/null 2>&1 || true
    plack_restart || true
    systemctl restart apache2 >/dev/null 2>&1 || true

    msg_ok "$(t "Maintenance completed successfully!\n\n• MariaDB tables optimized\n• System logs vacuumed\n• Services restarted and memory flushed")" 12 74
    log "deep maintenance completed"
}

