# ======================================================================
# 27. REBOOT SERVER
# ======================================================================
# Reboots even when a desktop session is open: on machines with a graphical
# login, GNOME/KDE "inhibit" a plain "reboot" while a user is logged in.
reboot_now() {
    # Inside WSL a reboot only shuts the Linux environment down, and nothing
    # starts it again until Windows does: Koha would stay offline.
    if ! host_can reboot; then
        log "reboot refused: Windows (WSL) owns the machine"
        msg_error "" "$(t "On Windows (WSL) the panel does not reboot the computer.\nUse 'Restart Koha services' (option 16), or restart Windows.")" 10 76
        return 1
    fi
    sync
    systemctl reboot -i >/dev/null 2>&1 \
        || systemctl reboot --check-inhibitors=no >/dev/null 2>&1 \
        || shutdown -r now >/dev/null 2>&1 \
        || /sbin/reboot >/dev/null 2>&1
    # The reboot was accepted: wait here instead of going back to the menu.
    sleep 60
    msg_error "" "$(t "The server did not reboot. Restart it manually with: sudo systemctl reboot -i")" 9 76
    return 1
}

# Restarts Koha's services without rebooting: MariaDB and the search engine
# first, then koha-common, and ensure_koha_services for Memcached, Plack and
# Apache (the boot order of install_boot_ordering). Used instead of a reboot
# under WSL.
restart_koha_stack() {
    local rc=0
    log "restart of Koha services requested"
    systemctl restart mariadb >/dev/null 2>&1 || rc=1
    if systemctl is-active --quiet elasticsearch 2>/dev/null; then
        systemctl restart elasticsearch >/dev/null 2>&1 || rc=1
    fi
    systemctl restart koha-common >/dev/null 2>&1 || rc=1
    ensure_koha_services >/dev/null 2>&1 || rc=1
    systemctl restart cron >/dev/null 2>&1
    log "restart of Koha services finished (rc=$rc)"
    return "$rc"
}

function_reboot_server() {
    if ! host_can reboot; then
        prompt_yes_no "$(t "Restart Koha services")" "$(t "Restart Koha services now?\nEveryone using the catalog will be disconnected for a minute.")" 10 74 || return 0
        clear
        display_explanation "Restarting Koha services (Memcached, Plack, Apache)..."
        if restart_koha_stack; then
            msg_ok "$(t "Koha services restarted.")"
        else
            msg_error "" "$(t "Some services did not restart. Open Diagnostics (option 7) for details.")" 9 74
        fi
        return 0
    fi
    prompt_yes_no "$(t "Reboot")" "$(t "Reboot the server now?\nEveryone using the catalog will be disconnected.")" 10 74 || return 0
    clear
    echo "$(t "Rebooting in 5 seconds...")"
    log "reboot requested by panel"
    sleep 5
    reboot_now
}

