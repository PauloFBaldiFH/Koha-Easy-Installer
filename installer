# ======================================================================
# 20.0. RESTART / REPAIR KOHA SERVICES
# ======================================================================
function_repair_services() {
    require_koha || return 0
    clear
    display_explanation "Restarting Koha services (Memcached, Plack, Apache)..."
    systemctl start mariadb >/dev/null 2>&1
    start_koha_workers
    is_koha_zebra_running || zebra_start >/dev/null 2>&1
    ensure_search_indexing >/dev/null 2>&1
    ensure_koha_services >/dev/null 2>&1
    local mc_state plack_state details=""
    memcached_alive && mc_state="$(t "active")" || mc_state="$(t "inactive")"
    plack_running && plack_state="$(t "running")" || plack_state="$(t "stopped")"
    log "services repaired: memcached=$mc_state plack=$plack_state"
    if memcached_alive && plack_running; then
        msg_ok "$(t 'Koha services restarted.\n\nMemcached: ${mc_state}\nPlack: ${plack_state}')" 11 70
    else
        details=$(tail -n 8 "/var/log/koha/${INSTANCE}/plack-error.log" 2>/dev/null | cut -c1-76)
        msg_error "" "$(t 'Koha services restarted.\n\nMemcached: ${mc_state}\nPlack: ${plack_state}')\n\n${details}" 20 80
    fi
}

# ======================================================================
# 20.1. DEEP MAINTENANCE & OPTIMIZATION
# ======================================================================
function_deep_maintenance() {
    require_database || return 0
    
    prompt_yes_no "$(t "Deep Maintenance")" \
"$(t "This routine will:\n\n• Repair and optimize MariaDB tables\n• Clean system journal logs (> 7 days)\n• Vacuum temporary and backup old files\n\nContinue?")" 14 76 || return 0

    clear
    display_explanation "Optimizing MariaDB tables and database..."
    
    if mysqlcheck --auto-repair --optimize --default-character-set=utf8mb4 "$DB_NAME" >/tmp/koha_db_optimize.log 2>&1; then
        log "database optimized successfully"
    else
        log "database optimization reported warnings or errors"
    fi

    display_explanation "Cleaning system and journal logs..."
    journalctl --vacuum-time=7d >/dev/null 2>&1 || true
    find "$LOG_DIR" -name "*.log" -mtime +14 -delete 2>/dev/null || true

    display_explanation "Restarting core services to free memory..."
    systemctl restart memcached >/dev/null 2>&1 || true
    plack_restart || true
    systemctl restart apache2 >/dev/null 2>&1 || true

    msg_ok "$(t "Maintenance completed successfully!\n\n• MariaDB tables optimized\n• System logs vacuumed\n• Services restarted and memory flushed")" 12 74
    log "deep maintenance completed"
}

