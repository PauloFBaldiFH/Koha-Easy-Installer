        return 1
    fi
    found=$(tools_lead "$log" "found,")
    if [ "$found" = "0" ]; then
        msg_info "$(t "School-year turnover")" "$(t "No patron matches. Nothing was changed.")" 9 64
        return 0
    fi
    ui_textbox "$(t "Preview (dry run)")" "$log"
    prompt_yes_no "$(t "School-year turnover")" "$(t '${found} patron(s) will move from ${from} to ${to}.\n\nContinue? A verified backup is made first.')" 11 70 defaultno || return 0
    tools_safety_backup PATRONS || return 1
    if ! koha_tool "$log" update_patrons_category.pl "${args[@]}" --confirm; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
