write_backup_config() {
    [ -f "$BACKUP_CONF" ] && return 0
    cat > "$BACKUP_CONF" << 'EOF'
# Koha backup settings.
RCLONE_REMOTE=""
RCLONE_SQL_FOLDER="Backup_SQL_Koha"
RCLONE_MARC_FOLDER="Backup_MARC_Koha"
KEEP_DAYS=7
EOF
    chmod 600 "$BACKUP_CONF"
}

write_backup_scripts() {
    mkdir -p "$DIR_SQL" "$DIR_MARC"
    write_backup_config

    cat > /root/backup_sql.sh << EOF
#!/bin/bash
# Koha database backup. Generated by Koha Easy Install & Tools.
set -euo pipefail
umask 077
CONF="${BACKUP_CONF}"
DB="${DB_NAME}"
DIR="${DIR_SQL}"
LOG="${LOG_DIR}/backup_sql.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_SQL_FOLDER="Backup_SQL_Koha"; KEEP_DAYS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${KEEP_DAYS}" in ''|*[!0-9]*) KEEP_DAYS=7;; esac

log_backup() { mkdir -p "\$(dirname "\$LOG")" 2>/dev/null || true; printf '%s | %s\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
    log_backup "INFO: SQL backup skipped because another backup/restore is running"
    exit 0
fi
if ! mkdir -p "\$DIR" 2>/dev/null; then
    log_backup "FAILED: cannot create \$DIR"
    exit 1
fi

FILE="\$DIR/\${DB}_\$(date +%Y-%m-%d_%Hh%M).sql.gz"

if ! mysqldump --single-transaction --quick --routines --triggers \
        --default-character-set=utf8mb4 "\$DB" 2>>"\$LOG" | gzip 2>>"\$LOG" > "\$FILE"; then
    log_backup "FAILED to generate \$FILE"
    rm -f "\$FILE"
    exit 1
fi

if ! gzip -t "\$FILE" 2>/dev/null; then
    log_backup "FAILED: corrupt file removed: \$FILE"
    rm -f "\$FILE"
    exit 1
fi

# A complete dump ends with mysqldump's "-- Dump completed" line.
if [ "\$(zcat "\$FILE" | tail -c 512 | grep -c '^-- Dump completed')" -eq 0 ]; then
    log_backup "FAILED: incomplete dump (no completion line) removed: \$FILE"
    rm -f "\$FILE"
    exit 1
fi

SIZE=\$(stat -c %s "\$FILE" 2>/dev/null || echo 0)
if [ "\$SIZE" -lt 10240 ]; then
    log_backup "FAILED: suspicious backup (\$SIZE bytes), removed: \$FILE"
    rm -f "\$FILE"
    exit 1
fi
log_backup "OK: \$FILE (\$SIZE bytes)"

RCLONE_REMOTE="\$(printf '%s' "\$RCLONE_REMOTE" | xargs)"
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -qx "\${RCLONE_REMOTE}:"; then
        log_backup "WARN: RCLONE_REMOTE='\${RCLONE_REMOTE}' does not exist in rclone.conf; skipping upload"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$FILE" "\${RCLONE_REMOTE}:\${RCLONE_SQL_FOLDER}/" >>"\$LOG" 2>&1; then
        log_backup "Cloud OK: \${RCLONE_REMOTE}:\${RCLONE_SQL_FOLDER}/"
    else
        log_backup "WARN: cloud upload failed (local copy preserved)"
    fi
fi

find "\$DIR" -name '*.sql.gz' -mtime "+\${KEEP_DAYS}" -delete 2>/dev/null || true
exit 0
EOF

    cat > /root/backup_marc.sh << EOF
#!/bin/bash
# Koha MARC21 records backup (bibliographic and authority).
set -euo pipefail
umask 077
CONF="${BACKUP_CONF}"
INST="${INSTANCE}"
DIR="${DIR_MARC}"
LOG="${LOG_DIR}/backup_marc.log"
LOCK_FILE="/var/lock/koha_backup.lock"
RCLONE_REMOTE=""; RCLONE_MARC_FOLDER="Backup_MARC_Koha"; KEEP_DAYS=7
[ -f "\$CONF" ] && . "\$CONF"
case "\${KEEP_DAYS}" in ''|*[!0-9]*) KEEP_DAYS=7;; esac

log_backup() { mkdir -p "\$(dirname "\$LOG")" 2>/dev/null || true; printf '%s | %s\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }
exec 9>"\$LOCK_FILE"
if ! flock -n 9; then
    log_backup "INFO: MARC backup skipped because another backup/restore is running"
    exit 0
fi
if ! mkdir -p "\$DIR" 2>/dev/null; then
    log_backup "FAILED: cannot create \$DIR"
    exit 1
fi

EXPORT_CMD="/usr/share/koha/bin/export_records.pl"
[ -f "\$EXPORT_CMD" ] || EXPORT_CMD="\$(find /usr/share/koha -name export_records.pl 2>/dev/null | head -n1)"
if [ -z "\$EXPORT_CMD" ]; then log_backup "FAILED: export_records.pl not found"; exit 1; fi

DATE=\$(date '+%Y-%m-%d_%H%M')
BIB_FILE="\$DIR/biblios_\${DATE}.mrc"
AUTH_FILE="\$DIR/authorities_\${DATE}.mrc"
PACKAGE="\$DIR/koha_marc_\${DATE}.tar.gz"

if ! /usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT_CMD --record-type=bibs --format=marc --filename=\$BIB_FILE" >>"\$LOG" 2>&1; then
    log_backup "FAILED: bibliographic export"; rm -f "\$BIB_FILE" "\$AUTH_FILE"; exit 1
fi
if ! /usr/sbin/koha-shell "\$INST" -c "perl \$EXPORT_CMD --record-type=auths --format=marc --filename=\$AUTH_FILE" >>"\$LOG" 2>&1; then
    log_backup "FAILED: authority export"; rm -f "\$BIB_FILE" "\$AUTH_FILE"; exit 1
fi

if [ ! -s "\$BIB_FILE" ]; then
    log_backup "FAILED: empty bibliographic export"
    rm -f "\$BIB_FILE" "\$AUTH_FILE"
    exit 1
fi
if [ ! -s "\$AUTH_FILE" ]; then
    log_backup "WARN: empty authority export"
fi

if ! tar -czf "\$PACKAGE" -C "\$DIR" "\$(basename "\$BIB_FILE")" "\$(basename "\$AUTH_FILE")" 2>>"\$LOG"; then
    log_backup "FAILED: creating MARC package"
    rm -f "\$PACKAGE" "\$BIB_FILE" "\$AUTH_FILE"
    exit 1
fi
rm -f "\$BIB_FILE" "\$AUTH_FILE"
if ! tar -tzf "\$PACKAGE" >/dev/null 2>&1; then
    log_backup "FAILED: MARC package failed tar.gz test"
    rm -f "\$PACKAGE"
    exit 1
fi
log_backup "OK: \$PACKAGE (\$(stat -c %s "\$PACKAGE" 2>/dev/null) bytes)"

RCLONE_REMOTE="\$(printf '%s' "\$RCLONE_REMOTE" | xargs)"
if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
    if ! rclone listremotes --config /root/.config/rclone/rclone.conf 2>/dev/null | grep -qx "\${RCLONE_REMOTE}:"; then
        log_backup "WARN: RCLONE_REMOTE='\${RCLONE_REMOTE}' does not exist in rclone.conf; skipping upload"
    elif /usr/bin/rclone --config /root/.config/rclone/rclone.conf copy "\$PACKAGE" "\${RCLONE_REMOTE}:\${RCLONE_MARC_FOLDER}/" >>"\$LOG" 2>&1; then
        log_backup "Cloud OK: \${RCLONE_REMOTE}:\${RCLONE_MARC_FOLDER}/"
    else
        log_backup "WARN: cloud upload failed"
    fi
fi

find "\$DIR" -name 'koha_marc_*.tar.gz' -mtime "+\${KEEP_DAYS}" -delete 2>/dev/null || true
exit 0
EOF

    chmod 700 /root/backup_sql.sh /root/backup_marc.sh
    chown root:root /root/backup_sql.sh /root/backup_marc.sh
}

# E-mail notices are sent by koha-common's own schedule (cron.daily: overdue
# and advance notices; cron.d: the message queue every 15 minutes) for the
# instances enabled with koha-email-enable. Returns 0 when e-mail is on.
KOHA_EMAIL_FLAG="/var/lib/koha/${INSTANCE}/email.enabled"
koha_email_enable() {
    [ -e "$KOHA_EMAIL_FLAG" ] && return 0
    koha_ctl /usr/sbin/koha-email-enable "$INSTANCE" >> "$RUN_LOG" 2>&1
    [ -e "$KOHA_EMAIL_FLAG" ]
}

# Brings a koha_tasks file written by older panels up to date:
#  - the 01:30 cleanup_database.pl ran without --confirm, i.e. as a dry run
#    that never deleted anything;
#  - the 08:00/08:05 e-mail block duplicated koha-common's own jobs (notices
#    generated twice, the queue flushed once a day). It is replaced by
#    koha-email-enable and removed only once e-mail is enabled, so notices
#    never stop.
upgrade_cron_tasks() {
    [ -f "$CRON_TASKS" ] || return 0
    local changed=0
    if grep 'cleanup_database\.pl' "$CRON_TASKS" | grep -qv -- '--confirm'; then
        sed -i '/cleanup_database\.pl/{/--confirm/!s#cleanup_database\.pl#cleanup_database.pl --confirm#}' "$CRON_TASKS"
        changed=1
        log "cron: --confirm added to cleanup_database.pl"
    fi
    if grep -q '^# BEGIN KOHA EMAIL NOTICES$' "$CRON_TASKS"; then
        if koha_email_enable; then
            sed -i '/^# BEGIN KOHA EMAIL NOTICES$/,/^# END KOHA EMAIL NOTICES$/d' "$CRON_TASKS"
            changed=1
            log "cron: 08:00/08:05 e-mail block replaced by koha-email-enable"
        else
            log "cron: koha-email-enable failed; the old e-mail block was kept"
        fi
    fi
    [ "$changed" = "1" ] && systemctl restart cron >/dev/null 2>&1
    return 0
}

write_cron_tasks() {
    local legacy_email=""
    upgrade_cron_tasks
    # Still there only if e-mail could not be enabled: keep it running.
    if [ -f "$CRON_TASKS" ] && grep -q '^# BEGIN KOHA EMAIL NOTICES$' "$CRON_TASKS"; then
        legacy_email=$(sed -n '/^# BEGIN KOHA EMAIL NOTICES$/,/^# END KOHA EMAIL NOTICES$/p' "$CRON_TASKS")
    fi

    cat > "$CRON_TASKS" << EOF
# ======================================================================
# KOHA EASY INSTALL & TOOLS - SCHEDULED AUTOMATED TASKS
# ======================================================================
# This file controls Koha's periodic automated maintenance routines.
#
# Schedule format:
# MIN HOUR DAY_OF_MONTH MONTH DAY_OF_WEEK(0=Sunday) USER COMMAND
#
# E-mail notices are not scheduled here: koha-common sends them (overdue and
# advance notices daily, message queue every 15 minutes) once e-mail is
# enabled with "koha-email-enable ${INSTANCE}".
# ======================================================================
$CRON_PATH
MAILTO=""

# System log cleanup (keeps last 14 days) - Daily at 00:30
30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1

# Database table integrity check - 5th day of every month at 01:00
0 1 5 * * root /usr/bin/mysqlcheck --check --databases ${DB_NAME} >/dev/null 2>&1

# Plack accelerator restart to flush accumulated memory - Daily at 05:00
0 5 * * * root /usr/sbin/koha-plack --restart ${INSTANCE} >/dev/null 2>&1

# Full database backup (compressed SQL) - Daily at 23:00
0 23 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1

# MARC21 bibliographic and authority records backup - Sundays at 03:00
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1

# Clear old user sessions and Zebra queue - Daily at 01:30
# (without --confirm, cleanup_database.pl only reports what it would delete)
30 1 * * * root /usr/sbin/koha-shell ${INSTANCE} -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --confirm --sessions --sessdays 2 --zebraqueue 10" >/dev/null 2>&1
EOF
    [ -n "$legacy_email" ] && printf '\n%s\n' "$legacy_email" >> "$CRON_TASKS"

    chmod 644 "$CRON_TASKS"
    chown root:root "$CRON_TASKS"
    systemctl restart cron >/dev/null 2>&1
}

configure_firewall() {
    command -v ufw >/dev/null 2>&1 || return 0
    local p
    for p in $(get_ssh_ports); do ufw allow "${p}/tcp" >/dev/null 2>&1; done
    for p in 80 443 8080 587 53682; do ufw allow "${p}/tcp" >/dev/null 2>&1; done
    if ! ufw --force enable >/dev/null 2>&1; then
        log "$(t "UFW could not be enabled (likely WSL/container).")"
    fi
}

