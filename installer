# ======================================================================
# 3. RESTORE DATABASE
# ======================================================================
function_restore_database() {
    require_koha || return 0

    show_restore_transfer_help

    local file
    file=$(select_file "$REAL_HOME") || return 0
    [ -z "$file" ] && return 0

    display_explanation "Checking the backup file..."
    if [[ "$file" == *.gz ]]; then
        if ! gzip -t "$file" 2>/dev/null; then
            msg_error "" "$(t "The file is corrupt (failed the gzip test).\nNothing was changed.")" 9 70
            return 0
        fi
        if ! zcat "$file" 2>/dev/null | head -c 200000 | grep -qi 'CREATE TABLE'; then
            prompt_yes_no "$(t "Suspicious file")" "$(t "No SQL statements found at the start of the file.\nIt may not be a Koha backup.\n\nContinue anyway?")" 11 72 || return 0
        fi
    else
        if ! head -c 200000 "$file" | grep -qi 'CREATE TABLE'; then
            prompt_yes_no "$(t "Suspicious file")" "$(t "No SQL statements found at the start of the file.\n\nContinue anyway?")" 10 72 || return 0
        fi
    fi

    prompt_yes_no "$(t "Confirm Restore")" \
"$(t "File:\n\$file\n\nWARNING: the current catalog will be REPLACED.\n\nContinue?")" 13 74 || return 0

    clear
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Another backup or restore is already running.\nNothing was changed.")" 10 72
        return 0
    fi

    local import_log="${LOG_DIR}/restore-import.log" details tables
    printf '===== %s | restore from %s =====\n' "$(date '+%F %T')" "$file" >> "$import_log"

    # 1) Test the file in a temporary database: the current catalog is only
    #    touched after the backup has proven to be a complete Koha database.
    display_explanation "Checking the backup in a temporary database..."
    local check_db="koha_restore_check"
    if ! mysql -e "DROP DATABASE IF EXISTS \`${check_db}\`; CREATE DATABASE \`${check_db}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>>"$import_log" \
       || ! import_sql_file "$file" "$check_db" "$import_log"; then
        mysql -e "DROP DATABASE IF EXISTS \`${check_db}\`;" >/dev/null 2>&1
        backup_lock_release
        details=$(grep -v "^=====" "$import_log" | tail -n 6 | cut -c1-76)
        msg_error "" "$(t 'The backup could not be imported. Nothing was changed in the current catalog.\n\nLast error lines:\n${details}')" 18 80
        return 1
    fi
    tables=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${check_db}';")
    mysql -e "DROP DATABASE IF EXISTS \`${check_db}\`;" >/dev/null 2>&1
    if [ "${tables:-0}" -lt 50 ] 2>/dev/null; then
        backup_lock_release
        msg_error "" "$(t 'The backup has only ${tables} tables; it is not a complete Koha database. Nothing was changed.')" 10 76
        return 1
    fi

    # 2) Safety copy of the current catalog.
    local rescue="" cur_tables
    cur_tables=$(koha_table_count)
    if [ "${cur_tables:-0}" -gt 0 ] 2>/dev/null; then
        display_explanation "Saving a safety backup before deleting..."
        mkdir -p "$DIR_SQL"
        rescue="${DIR_SQL}/PRE-RESTORE_$(date +%Y-%m-%d_%Hh%M).sql.gz"
        if mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" 2>>"$import_log" | gzip > "$rescue" \
                && gzip -t "$rescue" 2>/dev/null; then
            echo "$(t "Safety backup:") $rescue"
            log "pre-restore safety backup: $rescue"
        else
            rm -f "$rescue"; rescue=""
            if ! prompt_yes_no "$(t "Safety backup failed")" \
                "$(t "The current database could not be backed up before the restore.\n\nContinue anyway? The current catalog will be lost if the import fails.")" 12 76; then
                backup_lock_release
                return 0
            fi
        fi
    fi

    # 3) Replace the catalog.
    display_explanation "Stopping Koha services..."
    stop_koha_db_clients

    display_explanation "Recreating the database with utf8mb4 charset..."
    if ! mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`; CREATE DATABASE \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>>"$import_log"; then
        backup_lock_release
        details=$(grep -v "^=====" "$import_log" | tail -n 6 | cut -c1-76)
        ensure_koha_services >/dev/null 2>&1
        msg_error "" "$(t 'Could not recreate the database.\n\n${details}')" 14 80
        return 1
    fi
    ensure_db_grants

    display_explanation "Importing the catalog (may take several minutes)..."
    local ok="yes"
    import_sql_file "$file" "$DB_NAME" "$import_log" || ok="no"
    tables=$(koha_table_count)
    if [ "$ok" = "no" ] || [ "${tables:-0}" -lt 50 ] 2>/dev/null; then
        details=$(grep -v "^=====" "$import_log" | tail -n 6 | cut -c1-76)
        # Put the previous catalog back.
        if [ -n "$rescue" ] && mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`; CREATE DATABASE \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>>"$import_log" \
           && import_sql_file "$rescue" "$DB_NAME" "$import_log"; then
            ensure_db_grants
            zebra_start >/dev/null 2>&1; start_koha_workers; ensure_koha_services >/dev/null 2>&1
            backup_lock_release
            log "restore failed; previous catalog restored from $rescue"
            msg_error "" "$(t 'The import failed. The previous catalog was restored from the safety backup.\n\nLast error lines:\n${details}')" 18 80
        else
            zebra_start >/dev/null 2>&1; start_koha_workers; ensure_koha_services >/dev/null 2>&1
            backup_lock_release
            log "restore failed; automatic rollback not possible (rescue=$rescue)"
            msg_error "" "$(t 'The import failed and the safety backup could not be restored automatically.\nRestore it with option 3: ${rescue}\n\nLast error lines:\n${details}')" 18 80
        fi
        return 1
    fi

    display_explanation "Upgrading the schema to the installed Koha version..."
    systemctl restart memcached >/dev/null 2>&1 || true
    /usr/sbin/koha-upgrade-schema "$INSTANCE" > "${LOG_DIR}/schema-upgrade.log" 2>&1 || true

    if ! mysql -e "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable='Version';" >/dev/null 2>&1; then
        start_koha_workers; ensure_koha_services >/dev/null 2>&1
        backup_lock_release
        msg_error "" "$(t "Schema migration failed. The imported database was preserved for diagnosis.")" 11 78
        return 1
    fi

    display_explanation "Synchronizing the search engine..."
    local engine="Zebra"
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && is_koha_es_active_in_xml; then engine="Elasticsearch"; fi
    if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='${engine}' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
        backup_lock_release
        msg_error "" "$(t "Could not set the search engine after restore.")" 9 72
        return 1
    fi
    systemctl restart memcached >/dev/null 2>&1 || true

    local rebuild_ok="yes"
    local cut_time
    cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    if [ "$engine" = "Elasticsearch" ]; then
        prepare_koha_broker || true
        ensure_koha_services >/dev/null 2>&1
        if ! manage_koha_indexers start; then rebuild_ok="no"; fi
        if [ "$rebuild_ok" = "yes" ] && ! rebuild_koha_elasticsearch "$cut_time"; then rebuild_ok="no"; fi
    else
        zebra_stop
        zebra_start >/dev/null 2>&1 || true
        write_cron_zebra
        display_explanation "Rebuilding the indices..."
        /usr/sbin/koha-rebuild-zebra -f -v -b -a "$INSTANCE" > "${LOG_DIR}/zebra-rebuild.log" 2>&1 || rebuild_ok="no"
        zebra_stop
        zebra_start >/dev/null 2>&1 || true
    fi

    backup_lock_release
    start_koha_workers
    display_explanation "Restarting Koha services (Memcached, Plack, Apache)..."
    ensure_koha_services >/dev/null 2>&1

    validate_complete_system "$(t "database restore")"
    log "restore completed from $file (engine=$engine rebuild=$rebuild_ok)"

    if [ "$rebuild_ok" = "no" ]; then
        msg_error "" "$(t "The database was restored, but index rebuilding failed.\nCheck /var/log/koha-easy-install/zebra-rebuild.log")" 11 78
        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    fi

    msg_ok "$(t "Catalog restored and indexed successfully!\n\nSearch engine: \${engine}\nTables: \${tables}")" 12 74

    if prompt_yes_no "$(t "View Report")" \
        "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
        show_validation_report
    fi

    return 0
}

# ======================================================================
# 4. MANUAL LOCAL BACKUP
# ======================================================================
function_manual_backup() {
    require_database || return 0
    if ! backup_lock_acquire; then
        msg_info "$(t "Backup in progress")" "$(t "Another backup or restore is already running. Try again later.")" 9 72
        return 0
    fi
    local srv_ip
    srv_ip=$(get_server_ip)
    msg_info "$(t "Backup Destination")" \
"$(t "Choose where to save the file.\n\n  USB drive: usually under /media or /mnt\n  To download later: scp root@\${srv_ip}:PATH Downloads/")" 12 76
    
    local target_dir
    target_dir=$(select_directory "$REAL_HOME") || { backup_lock_release; return 0; }
    [ -z "$target_dir" ] && { backup_lock_release; return 0; }
    local target_file="${target_dir%/}/${DB_NAME}_manual_$(date +%Y-%m-%d_%Hh%M).sql.gz"
    
    clear
    display_explanation "Generating the backup..."
    
    if mysqldump --single-transaction --quick --routines --triggers \
         --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$target_file" && gzip -t "$target_file" 2>/dev/null; then
        
        log "manual backup generated: $target_file"
        backup_lock_release
        
        local size ip_addr
        size=$(du -h "$target_file" | cut -f1)
        ip_addr=$(get_server_ip)
        
        echo "======================================================================"
        echo -e "\e[1;32m$(t "BACKUP GENERATED AND VERIFIED SUCCESSFULLY!")\e[0m"
        echo "======================================================================"
        echo "$(t "File:") $target_file"
        echo "$(t "Size:") $size"
        echo ""
        echo "----------------------------------------------------------------------"
        echo -e "\e[1;36m$(t "HOW TO SAVE TO YOUR DOWNLOADS FOLDER (WINDOWS / MAC / LINUX)")\e[0m"
        echo "----------------------------------------------------------------------"
        echo "$(t "Open Terminal or PowerShell on your personal computer and paste the exact command:")"
        echo ""
        echo -e "\e[1;33mscp ${REAL_USER:-root}@${ip_addr}:${target_file} Downloads/\e[0m"
        echo ""
        echo "$(t "1. The file will be saved directly into your Downloads folder.")"
        echo "$(t "2. Make sure to include 'Downloads/' at the end of the command.")"
        echo "$(t "3. You will be asked for the password of user '\${REAL_USER:-root}'.")"
        echo ""
        echo "======================================================================"
        pause_terminal
    else
        rm -f "$target_file"
        backup_lock_release
        msg_error "" "$(t "Failed to generate the backup. Check the free disk space.")" 9 70
    fi
}

# ======================================================================
# 5. TEST THE LATEST BACKUP
# ======================================================================
function_test_backup() {
    require_koha || return 0
    local newest
    newest=$(find "$DIR_SQL" -name '*.sql.gz' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)
    if [ -z "$newest" ]; then
        msg_error "" "$(t "No automatic backup found in \${DIR_SQL}.")" 9 70
        return 0
    fi
    if ! gzip -t "$newest" 2>/dev/null; then
        msg_error "" "$(t "The latest backup failed gzip validation and will not be tested.")" 9 74
        return 1
    fi

    local b_name b_date p_msg
    b_name="$(basename "$newest")"
    b_date="$(date -r "$newest" '+%Y-%m-%d %H:%M')"
    p_msg="$(printf "%s\n\n%s: %s\n%s: %s\n\n%s" \
        "$(t "A backup is only worth it if it restores. This test imports the newest file into a temporary database and checks it. Production data is NOT touched.")" \
        "$(t "File")" "$b_name" \
        "$(t "Date")" "$b_date" \
        "$(t "Run the test now?")")"

    prompt_yes_no "$(t "Test Backup")" "$p_msg" 15 76 || return 0

    clear
    local test_db="koha_teste_restauracao"
    display_explanation "Importing into a temporary database..."
    if ! mysql -e "DROP DATABASE IF EXISTS ${test_db}; CREATE DATABASE ${test_db} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" >/dev/null 2>&1; then
        msg_error "" "$(t "Could not create the temporary test database.")" 9 72
        return 1
    fi
    if ! zcat "$newest" | mysql --default-character-set=utf8mb4 "$test_db"; then
        mysql -e "DROP DATABASE IF EXISTS ${test_db};" >/dev/null 2>&1 || true
        msg_error "" "$(t "The backup DID NOT restore. Check the file urgently.")" 9 72
        return 1
    fi

    local tab bib usu
    tab=$(run_sql "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${test_db}';")
    bib=$(run_sql "SELECT COUNT(*) FROM ${test_db}.biblio;")
    usu=$(run_sql "SELECT COUNT(*) FROM ${test_db}.borrowers;")
    mysql -e "DROP DATABASE IF EXISTS ${test_db};" >/dev/null 2>&1 || true
    log "backup test: $newest tables=$tab biblios=$bib"

    if [ "${tab:-0}" -gt 50 ] 2>/dev/null && [ "${bib:-0}" -ge 0 ] 2>/dev/null; then
        local ok_test_msg
        ok_test_msg="$(printf "%s\n\n%s: %s\n%s: %s\n%s: %s\n%s: %s" \
            "$(t "BACKUP IS INTACT AND RESTORABLE.")" \
            "$(t "File")" "$b_name" \
            "$(t "Tables")" "${tab}" \
            "$(t "Bibliographic records")" "${bib}" \
            "$(t "Patrons")" "${usu}")"

        msg_ok "$ok_test_msg" 13 74
    else
        local err_tab_msg
        err_tab_msg="$(printf "$(t "The backup imported but has only %s tables. Suspicious.")" "${tab}")"
        msg_error "" "$err_tab_msg" 9 72
        return 1
    fi
    return 0
}

# ======================================================================
# 6. KOHA LANGUAGES
# ======================================================================
function_install_languages() {
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

    local sudo_cmd=""
    [ "$EUID" -ne 0 ] && sudo_cmd="sudo"
    local created_mock=0

    # ==================================================================
    # LANGUAGE SELECTOR (native names)
    # ==================================================================
    local choice
    choice=$(whiptail \
        --title "$(t "Koha & Panel Languages")" \
        --cancel-button "$(t "Back")" \
        --default-item "${KOHA_PANEL_LANG_FULL:-pt-BR}" \
        --menu "$(t "Choose the language to install in Koha and apply to this Panel:")" \
        22 72 13 \
        "${PANEL_LANG_ITEMS[@]}" \
        3>&1 1>&2 2>&3) || return 0
    [ -z "$choice" ] && return 0

    # ==================================================================
    # APPLY AND PERSIST THE PANEL LANGUAGE (works even without Koha)
    # ==================================================================
    set_panel_language "$choice"
    log "panel language set to $choice ($SYS_LANG)"

    if ! is_koha_installed || ! mysql -e "USE ${DB_NAME};" >/dev/null 2>&1; then
        msg_info "$(t "Koha & Panel Languages")" \
            "$(t "The panel language was changed.\n\nKoha is not installed yet, so its language pack will be installed later (the installer uses the panel language automatically).")" 12 74
        return 0
    fi

    if ! command -v koha-foreach >/dev/null 2>&1; then
        echo -e '#!/bin/bash\nexit 0' |
            $sudo_cmd tee /usr/local/bin/koha-foreach >/dev/null 2>&1 && chmod +x /usr/local/bin/koha-foreach 2>/dev/null || {
                echo -e '#!/bin/bash\nexit 0' > /tmp/koha-foreach
                chmod +x /tmp/koha-foreach
                export PATH="/tmp:$PATH"
            }
        created_mock=1
    fi

    # ==================================================================
    # PREPARE SYSTEM LOCALE
    # ==================================================================
    clear

    display_explanation "Preparing OS for language: \$choice"

    local loc_prefix
    loc_prefix=$(echo "$choice" | cut -d'-' -f1,2 | sed 's/-/_/')

    case "$choice" in
        zh-Hans-CN) loc_prefix="zh_CN" ;;
        zh-Hant-TW) loc_prefix="zh_TW" ;;
        ja-Jpan-JP) loc_prefix="ja_JP" ;;
        ko-Kore-KP) loc_prefix="ko_KR" ;;
        ar-Arab)    loc_prefix="ar_.*" ;;
        fa-Arab)    loc_prefix="fa_IR" ;;
        sr-Cyrl)    loc_prefix="sr_RS" ;;
        bg-Cyrl)    loc_prefix="bg_BG" ;;
        hi)         loc_prefix="hi_IN" ;;
        ta)         loc_prefix="ta_IN" ;;
        te)         loc_prefix="te_IN" ;;
        ml)         loc_prefix="ml_IN" ;;
        kn-Knda)    loc_prefix="kn_IN" ;;
        mr)         loc_prefix="mr_IN" ;;
        bn-IN)      loc_prefix="bn_IN" ;;
        gl)         loc_prefix="gl_ES" ;;
        eu)         loc_prefix="eu_ES" ;;
        my)         loc_prefix="my_MM" ;;
    esac

    if [ -f /etc/locale.gen ]; then
        $sudo_cmd sed -i -E \
            "s/^#[[:space:]]*(${loc_prefix}[^[:space:]]*\.UTF-8[[:space:]]+UTF-8)/\1/i" \
            /etc/locale.gen 2>/dev/null || true

        $sudo_cmd locale-gen >/dev/null 2>&1 || true
    fi

    # ==================================================================
    # KOHA TRANSLATION PACKAGE
    # ==================================================================
    local koha_trans_cmd
    koha_trans_cmd="$(command -v koha-translate || echo "/usr/sbin/koha-translate")"

    if [ ! -x "$koha_trans_cmd" ]; then
        msg_error "" \
            "$(t "Koha translation utility was not found.\n\nExpected:\n/usr/sbin/koha-translate")" \
            11 74

        [ "$created_mock" -eq 1 ] && rm -f /tmp/koha-foreach /usr/local/bin/koha-foreach 2>/dev/null
        return 0
    fi

    if $sudo_cmd "$koha_trans_cmd" --list 2>/dev/null | grep -Fq "$choice"; then
        display_explanation "Language already installed. Updating templates..."
        $sudo_cmd "$koha_trans_cmd" --update "$choice" > /tmp/koha_lang.log 2>&1
    else
        display_explanation "Compiling and installing language in Koha (may take a while): \$choice"
        $sudo_cmd "$koha_trans_cmd" --install "$choice" > /tmp/koha_lang.log 2>&1
        $sudo_cmd "$koha_trans_cmd" --update "$choice" >> /tmp/koha_lang.log 2>&1 || true
    fi

    # ==================================================================
    # VERIFY KOHA LANGUAGE
    # ==================================================================
    if $sudo_cmd "$koha_trans_cmd" --list 2>/dev/null | grep -Fq "$choice"; then
        $sudo_cmd systemctl restart memcached >/dev/null 2>&1 || true
        $sudo_cmd /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true

        # ==============================================================
        # ENABLE LANGUAGE IN KOHA
        # ==============================================================
        if prompt_yes_no "$(t "Enable language")" "$(t "Package processed.\n\nEnable it right away in the preferences (OPAC and Staff)?")" 10 70; then
            local mysql_runner="mysql"

            if ! mysql -e "SELECT 1" >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1; then
                mysql_runner="sudo mysql"
            fi

            # ----------------------------------------------------------
            # OPAC
            # ----------------------------------------------------------
            $mysql_runner -e "
                INSERT INTO ${DB_NAME}.systempreferences (variable, value, type)
                VALUES ('OPACLanguages', '${choice}', 'Free')
                ON DUPLICATE KEY UPDATE value = CASE
                    WHEN value = '' OR value IS NULL THEN '${choice}'
                    WHEN FIND_IN_SET('${choice}', value) THEN value
                    ELSE CONCAT(value, ',', '${choice}')
                END;
            " >/dev/null 2>&1 || true

            # ----------------------------------------------------------
            # STAFF INTERFACE
            # ----------------------------------------------------------
            $mysql_runner -e "
                INSERT INTO ${DB_NAME}.systempreferences (variable, value, type)
                VALUES ('StaffInterfaceLanguages', '${choice}', 'Free')
                ON DUPLICATE KEY UPDATE value = CASE
                    WHEN value = '' OR value IS NULL THEN '${choice}'
                    WHEN FIND_IN_SET('${choice}', value) THEN value
                    ELSE CONCAT(value, ',', '${choice}')
                END;
            " >/dev/null 2>&1 || true

            # ----------------------------------------------------------
            # Legacy compatibility
            # ----------------------------------------------------------
            $mysql_runner -e "
                UPDATE ${DB_NAME}.systempreferences SET value='${choice}' WHERE variable='language';
            " >/dev/null 2>&1 || true

            # ----------------------------------------------------------
            # Clear sessions
            # ----------------------------------------------------------
            $mysql_runner -e "DELETE FROM ${DB_NAME}.sessions;" >/dev/null 2>&1 || true

            $sudo_cmd systemctl restart memcached >/dev/null 2>&1 || true
            $sudo_cmd /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
            $sudo_cmd systemctl reload apache2 >/dev/null 2>&1 || true
        fi

        msg_ok "$(t "Language '\$choice' enabled successfully.\nFine tuning in: Administration > Preferences > I18N/L10N.")" 10 74

    else
        local err_msg
        err_msg=$(tail -n 12 /tmp/koha_lang.log 2>/dev/null || echo "$(t "Empty log.")")
        msg_error "" "$(t "Failed to process language '\$choice'.\n\nKoha native error details:\n\$err_msg")" 18 80
    fi

    [ "$created_mock" -eq 1 ] && rm -f /tmp/koha-foreach /usr/local/bin/koha-foreach 2>/dev/null
}

# ======================================================================
# 7. TOGGLE SEARCH ENGINE
# ======================================================================
function_toggle_search_engine() {
    require_koha_tables || return 0
    local engine; engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ]; then
        prompt_yes_no "$(t "Search Engine")" \
"$(t "Current engine: ELASTICSEARCH.\n\nSwitch back to ZEBRA? It uses about 1.5 GB less RAM,\nbut loses dynamic facets and advanced search.")" 12 74 || return 0
        clear
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Another backup/restore is running. Engine switch cancelled.")" 9 72
            return 1
        fi
        display_explanation "Stopping the Elasticsearch indexer..."
        manage_koha_indexers stop
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        display_explanation "Removing the <elasticsearch> block..."
        if ! set_xml_elasticsearch remover; then
            manage_koha_indexers start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            return 1
        fi
        if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Zebra' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
            set_xml_elasticsearch inserir >/dev/null 2>&1 || true
            manage_koha_indexers start >/dev/null 2>&1 || true
            systemctl enable --now elasticsearch >/dev/null 2>&1 || true
            backup_lock_release
            msg_error "" "$(t "Could not set SearchEngine to Zebra. Elasticsearch configuration was restored.")" 10 74
            return 1
        fi
        display_explanation "Flushing the preferences cache (Memcached)..."
        systemctl restart memcached >/dev/null 2>&1 || true
        display_explanation "Unlocking and restarting Zebra..."
        zebra_stop
        force_stop_koha_zebra
        rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
        rm -f /var/run/koha/${INSTANCE}/zebrasrv.pid 2>/dev/null
        chown -R "${INSTANCE}-koha:${INSTANCE}-koha" \
            "/var/lib/koha/${INSTANCE}/biblios" "/var/lib/koha/${INSTANCE}/authorities" \
            "/var/lock/koha/${INSTANCE}" 2>/dev/null || true
        zebra_start >/dev/null 2>&1
        if ! is_koha_zebra_running; then
            backup_lock_release
            msg_error "" "$(t "Zebra daemon could not be started. Engine switch was interrupted.")" 10 74
            return 1
        fi
        write_cron_zebra
        systemctl restart koha-common >/dev/null 2>&1 || true
        display_explanation "Reindexing the catalog into Zebra..."
        if ! /usr/sbin/koha-rebuild-zebra -f -v -b -a "$INSTANCE" 2>&1 | tee "${LOG_DIR}/zebra-rebuild.log"; then
            backup_lock_release
            msg_error "" "$(t "Zebra rebuild failed. The system will remain on Zebra; use the repair option.")" 11 76
            if prompt_yes_no "$(t "View Report")" \
                "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
                show_validation_report
            fi
            return 1
        fi
        backup_lock_release
        /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
        validate_complete_system "$(t "switch to Zebra")"
        msg_ok "$(t "System now running on ZEBRA.\nIncremental indexing runs every 2 minutes.")" 10 70

        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
            show_validation_report
        fi

        return 0
    fi

    prompt_yes_no "$(t "Search Engine")" \
"$(t "Current engine: ZEBRA.\n\nEnable ELASTICSEARCH? It brings advanced search and dynamic\nfacets, but needs about 1.5 GB more RAM and more disk.")" 12 76 || return 0
    if [ "$(get_free_space_mb /)" -lt 4096 ] 2>/dev/null; then
        prompt_yes_no "$(t "Low disk space")" "$(t "Less than 4 GB free. Elasticsearch may fail to start.\n\nContinue anyway?")" 10 70 || return 0
    fi

    clear
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Another backup/restore is running. Engine switch cancelled.")" 9 72
        return 1
    fi

    display_explanation "Disabling Zebra and its queue..."
    rm -f "$CRON_ZEBRA"; systemctl restart cron >/dev/null 2>&1 || true
    zebra_stop

    if ! dpkg -s koha-elasticsearch >/dev/null 2>&1 || ! dpkg -s elasticsearch >/dev/null 2>&1; then
        display_explanation "Installing Elasticsearch 7..."
        wait_for_apt_locks >/dev/null 2>&1
        ensure_elastic_repo || apt_update_indices
        if ! apt_install elasticsearch koha-elasticsearch; then
            restore_apt_timers
            write_cron_zebra
            zebra_start >/dev/null 2>&1 || true
            backup_lock_release
            msg_error "" "$(t "Elasticsearch installation failed. Zebra was restored.")" 10 72
            return 1
        fi
    fi

    display_explanation "Tuning Elasticsearch memory and configuration..."
    if ! adjust_elasticsearch_heap; then
        write_cron_zebra
        zebra_start >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Could not write Elasticsearch memory configuration. Zebra was restored.")" 11 78
        return 1
    fi
    if [ ! -f /etc/elasticsearch/elasticsearch.yml ]; then
        backup_lock_release
        msg_error "" "$(t "Elasticsearch configuration file is missing.")" 9 70
        write_cron_zebra; zebra_start >/dev/null 2>&1 || true
        return 1
    fi
    cp -f /etc/elasticsearch/elasticsearch.yml "/etc/elasticsearch/elasticsearch.yml.bak-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    grep -q '^discovery.type: single-node' /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo 'discovery.type: single-node' >> /etc/elasticsearch/elasticsearch.yml
    grep -q '^network.host: 127.0.0.1'     /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo 'network.host: 127.0.0.1'     >> /etc/elasticsearch/elasticsearch.yml
    if ! /usr/share/elasticsearch/bin/elasticsearch-plugin list 2>/dev/null | grep -q '^analysis-icu$'; then
        if ! /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu >/dev/null 2>&1; then
            systemctl disable --now elasticsearch >/dev/null 2>&1 || true
            write_cron_zebra
            zebra_start >/dev/null 2>&1 || true
            backup_lock_release
            msg_error "" "$(t "Could not install the Elasticsearch analysis-icu plugin. Zebra was restored.")" 11 78
            return 1
        fi
    fi

    display_explanation "Starting Elasticsearch (up to 1 minute)..."
    systemctl daemon-reload
    systemctl enable elasticsearch >/dev/null 2>&1 || true
    if ! systemctl restart elasticsearch; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra; zebra_start >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Elasticsearch failed to start. Zebra was restored.")" 12 76
        return 1
    fi
    local es_ok="no"
    for _ in $(seq 1 60); do
        curl -sS --max-time 2 http://127.0.0.1:9200 >/dev/null 2>&1 && { es_ok="yes"; break; }
        sleep 1
    done
    if [ "$es_ok" = "no" ]; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        zebra_start >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Elasticsearch did not start on port 9200. Zebra was kept.")" 12 76
        return 1
    fi

    display_explanation "Declaring Elasticsearch in koha-conf.xml..."
    if ! set_xml_elasticsearch inserir; then
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        write_cron_zebra
        zebra_start >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Could not enable the Elasticsearch block in koha-conf.xml. Zebra was restored.")" 11 78
        return 1
    fi
    if ! mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='Elasticsearch' WHERE variable='SearchEngine';" >/dev/null 2>&1; then
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        write_cron_zebra; zebra_start >/dev/null 2>&1 || true
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        backup_lock_release
        msg_error "" "$(t "Could not set SearchEngine to Elasticsearch. Zebra was restored.")" 10 76
        return 1
    fi
    display_explanation "Flushing the preferences cache (Memcached)..."
    systemctl restart memcached >/dev/null 2>&1 || true
    prepare_koha_broker || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_biblios" >/dev/null 2>&1 || true
    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_authorities" >/dev/null 2>&1 || true
    display_explanation "Restarting Koha with Elasticsearch enabled..."
    systemctl restart koha-common >/dev/null 2>&1 || true
    display_explanation "Starting the continuous indexer..."
    local indexer_ok="yes"
    if ! manage_koha_indexers start; then indexer_ok="no"; fi
    local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    local rebuild_ok="yes"
    display_explanation "Reindexing the catalog into Elasticsearch..."
    if [ "$indexer_ok" = "yes" ] && ! rebuild_koha_elasticsearch "$cut_time"; then rebuild_ok="no"; fi
    backup_lock_release
    /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
    validate_complete_system "$(t "Elasticsearch activation")"
    if [ "$indexer_ok" = "yes" ] && [ "$rebuild_ok" = "yes" ] && is_koha_indexer_running; then
        msg_ok "$(t "System now running on ELASTICSEARCH.\n\nThe indexer has automatic recovery and the watchdog checks the queue every 5 minutes.")" 12 78

        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
            show_validation_report
        fi
        return 0
    elif [ "$indexer_ok" = "no" ]; then
        msg_error "" "$(t "Elasticsearch is active but the indexer did not start. Use the repair option.")" 11 76
        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    else
        msg_error "" "$(t "Elasticsearch is active but rebuilding failed. Use Repair Indexing option.")" 11 78
        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    fi
}

# ======================================================================
# 8. REPAIR INDEXING
# ======================================================================
# The indexes are built from the Koha tables: an empty database (Web
# Installer not finished, or a restore that stopped halfway in older
# versions) is reported clearly instead of a cryptic rebuild error.
require_koha_tables() {
    require_database || return 1
    local tables rescue_hint=""
    tables=$(koha_table_count)
    if [ "${tables:-0}" -lt 50 ] 2>/dev/null; then
        local rescue
        rescue=$(ls -1t "${DIR_SQL}"/PRE-RESTORE_*.sql.gz "${DIR_SQL}"/PRE-REINSTALLATION_*.sql.gz 2>/dev/null | head -n1)
        [ -n "$rescue" ] && rescue_hint="\n\n$(t "Safety copy made before the last restore:")\n${rescue}"
        msg_error "" "$(t 'The Koha database is empty or incomplete (${tables} tables).\n\nRestore a backup (option 3) or finish the Web Installer first.')${rescue_hint}" 15 80
        return 1
    fi
    return 0
}

function_repair_indexing() {
    require_koha_tables || return 0
    local engine; engine=$(get_search_engine)
    if [ "$engine" = "Elasticsearch" ]; then
        local es_up idx broker pend bibs docs
        es_up=$(curl -s --max-time 5 http://127.0.0.1:9200 >/dev/null 2>&1 && echo "OK" || echo "$(t "DOWN")")
        is_koha_indexer_running && idx="$(t "running")" || idx="$(t "STOPPED")"
        ss -lnt 2>/dev/null | grep -q ':61613' && broker="OK" || broker="$(t "absent")"
        pend=$(get_pending_es_jobs); bibs=$(get_total_biblios); docs=$(get_total_es_documents)
        msg_info "$(t "Diagnostics")" \
"Elasticsearch (9200) : ${es_up}
$(t "Block in XML")         : $(is_koha_es_active_in_xml && echo OK || echo "$(t "MISSING")")
$(t "Indexer")              : ${idx}
RabbitMQ/STOMP       : ${broker}
$(t "Pending jobs")         : ${pend:-?}
$(t "Index / database")     : ${docs:-?} / ${bibs:-?}
$(t "Growing queue + smaller index = indexer is down.")" 18 76
        prompt_yes_no "$(t "Repair")" "$(t "Reinstall the indexer service, flush the cache and restart everything?")" 10 74 || return 0
        clear
        display_explanation "Repairing the indexing services..."
        systemctl restart elasticsearch >/dev/null 2>&1
        prepare_koha_broker
        systemctl restart memcached koha-common >/dev/null 2>&1
        manage_koha_indexers start
        /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1
        local rebuild_ok="yes"
        if prompt_yes_no "$(t "Reindex")" "$(t "Rebuild the whole index from scratch?\nOn large catalogs this can take several minutes.")" 10 74; then
            clear
            local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
            rebuild_koha_elasticsearch "$cut_time" || rebuild_ok="no"
        fi

        validate_complete_system "$(t "Elasticsearch indexing repair")"

        if is_koha_indexer_running && [ "$rebuild_ok" = "yes" ]; then
            msg_ok "$(t "Indexer is running and catalog synchronized.\nAdd a test record and search for it after ~10 seconds.")" 11 76

            if prompt_yes_no "$(t "View Report")" \
                "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
                show_validation_report
            fi
            return 0
        else
            msg_error "" "$(t "Elasticsearch repair failed (indexer stopped or rebuild error).\nCheck:\njournalctl -u koha-es-indexer@\${INSTANCE} -n 50")" 12 78
            if prompt_yes_no "$(t "View Report")" \
                "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
                show_validation_report
            fi
            return 1
        fi
    fi

    prompt_yes_no "$(t "Repair Zebra")" "$(t "Unlock Zebra and rebuild the indices from scratch?")" 10 70 || return 0
    clear
    display_explanation "Unlocking Zebra..."
    zebra_stop
    force_stop_koha_zebra
    rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
    rm -f /var/run/koha/${INSTANCE}/zebrasrv.pid 2>/dev/null
    chown -R "${INSTANCE}-koha:${INSTANCE}-koha" \
        "/var/lib/koha/${INSTANCE}/biblios" "/var/lib/koha/${INSTANCE}/authorities" \
        "/var/lock/koha/${INSTANCE}" 2>/dev/null
    zebra_start >/dev/null 2>&1
    write_cron_zebra
    display_explanation "Rebuilding the indices..."
    local zebra_ok="yes"
    /usr/sbin/koha-rebuild-zebra -f -v -b -a "$INSTANCE" 2>&1 | tee "${LOG_DIR}/zebra-rebuild.log" || zebra_ok="no"
    zebra_stop
    zebra_start >/dev/null 2>&1 || zebra_ok="no"
    display_explanation "Restarting Koha services (Memcached, Plack, Apache)..."
    ensure_koha_services >/dev/null 2>&1

    validate_complete_system "$(t "Zebra indexing repair")"

    if [ "$zebra_ok" = "yes" ]; then
        msg_ok "$(t "Zebra unlocked and catalog reindexed successfully.")" 9 68

        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the detailed system validation report now?")" 10 70; then
            show_validation_report
        fi
        return 0
    else
        local details
        details=$(tail -n 6 "${LOG_DIR}/zebra-rebuild.log" 2>/dev/null | cut -c1-76)
        msg_error "" "$(t "Zebra index rebuild encountered errors.\nCheck logs at /var/log/koha/\${INSTANCE}.")\n\n${details}" 16 80
        if prompt_yes_no "$(t "View Report")" \
            "$(t "Do you want to see the validation report to investigate the issues now?")" 10 72; then
            show_validation_report
        fi
        return 1
    fi
}

# ======================================================================
# 9. SERVER SIZING
# ======================================================================
function_size_server() {
    require_koha || return 0
    local ram ram_int recommended profile wk mem db
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo)
    ram_int=$(awk '/MemTotal:/ {printf "%d", ($2/1024/1024)+0.5}' /proc/meminfo)
    if   [ "$ram_int" -lt 4 ];  then recommended=1
    elif [ "$ram_int" -lt 8 ];  then recommended=2
    elif [ "$ram_int" -lt 16 ]; then recommended=3
    else recommended=4; fi
    profile=$(whiptail --title "$(t "Sizing")" \
        --cancel-button "$(t "Back")" \
        --default-item "$recommended" \
        --menu "$(t "Detected RAM:") ${ram} GB\n$(t "Recommended profile:") ${recommended}" 18 76 4 \
        "1" "< 4 GB   - 2 Plack, 64MB cache, 512M InnoDB" \
        "2" "4-8 GB   - 3 Plack, 128MB cache, 768M InnoDB" \
        "3" "8-16 GB  - 4 Plack, 128MB cache, 1G InnoDB" \
        "4" "16 GB+   - 6 Plack, 256MB cache, 2G InnoDB" 3>&1 1>&2 2>&3) || return 0
    [ -z "$profile" ] && return 0
    case "$profile" in
        1) wk=2; mem=64;  db=512M ;;
        2) wk=3; mem=128; db=768M ;;
        3) wk=4; mem=128; db=1G ;;
        4) wk=6; mem=256; db=2G ;;
        *) return 0 ;;
    esac
    clear
    display_explanation "Applying profile \$profile..."
    adjust_conf_key() {
        local file="$1" pattern="$2" line="$3"
        [ -f "$file" ] || return 0
        if grep -qE "$pattern" "$file"; then sed -i -E "s|${pattern}|${line}|" "$file"
        else echo "$line" >> "$file"; fi
    }
    adjust_conf_key /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=.*'      "PLACK_WORKERS=$wk"
    adjust_conf_key /etc/default/koha-common '^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=.*' "PLACK_MAX_REQUESTS=100"
    adjust_conf_key /etc/memcached.conf       '^[[:space:]]*-m[[:space:]]+.*'                   "-m $mem"
    mkdir -p /etc/mysql/mariadb.conf.d
    local tuning="/etc/mysql/mariadb.conf.d/99-koha-tuning.cnf"
    local tuning_bak="/tmp/99-koha-tuning.bak"
    local had_tuning="no"
    if [ -f "$tuning" ]; then
        cp -f "$tuning" "$tuning_bak" 2>/dev/null && had_tuning="yes" || {
            msg_error "" "$(t "Could not back up the MariaDB tuning file. Change cancelled.")" 9 74
            return 1
        }
    else
        rm -f "$tuning_bak"
    fi
    printf '[mysqld]\ninnodb_buffer_pool_size = %s\n' "$db" > "$tuning"
    systemctl restart memcached >/dev/null 2>&1
    if ! systemctl restart mariadb; then
        if [ "$had_tuning" = "yes" ] && [ -f "$tuning_bak" ]; then
            cp -f "$tuning_bak" "$tuning" 2>/dev/null || true
        else
            rm -f "$tuning"
        fi
        systemctl restart mariadb >/dev/null 2>&1
        msg_error "" "$(t "MariaDB failed to start with innodb_buffer_pool_size=\$db.\nThe change was REVERTED and the database is back up.\n\nPick a smaller profile.")" 12 76
        return 1
    fi
    systemctl restart koha-common >/dev/null 2>&1
    /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1
    if [ "$(get_search_engine)" = "Elasticsearch" ]; then
        if ! adjust_elasticsearch_heap || ! systemctl restart elasticsearch >/dev/null 2>&1; then
            msg_error "" "$(t "Elasticsearch memory tuning failed or the service did not restart.")" 9 74
            return 1
        fi
    fi
    log "tuning profile=$profile plack=$wk memcached=$mem innodb=$db"
    msg_ok "$(t "Profile \$profile applied.\n\nPlack: \$wk workers\nMemcached: \${mem} MB\nMariaDB InnoDB: \$db\n\nAll services restarted successfully.")" 13 74
}

