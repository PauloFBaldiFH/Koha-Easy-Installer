# The page: Perl code around the strings of the panel language.
marc_replace_script() {
    cat <<'MRPL1'
#!/usr/bin/perl

# marc_replace.pl (koha-easy-installer)
# Replaces an existing bibliographic record, found by its biblionumber,
# with a record from an .mrc (ISO 2709) or .xml (MARCXML) file or from
# pasted text (Biblioteca Nacional "245 10 |a", MarcEdit "=245  10$a" or
# "245 10 $a" lines), without the staged import of Koha. Based on the
# script of the library; installed and removed by the panel (Library
# tools > Replace a MARC record).
#
# Safety: login with the editcatalogue permission; POST only with a valid
# CSRF token (Koha::Token, and the Koha 24.05+ "cud-" operations); a
# preview first; then, in one transaction, the current record is locked
# (SELECT ... FOR UPDATE) and compared with the preview, saved as MARCXML
# and replaced with ModBiblio. The item fields (952, or the field of
# items.itemnumber) are always left out: the items are never touched.
#
# AI cataloguing (tabs "AI cataloguing" and "AI settings"): photos of a
# book (cover, title page, verso with the CIP block) go to the vision model
# set in the AI settings (a cloud API with a token, or Ollama / LM Studio
# on the library's network); KohaEasy::Cataloguing::Vision checks its
# answer against a fixed schema and KohaEasy::Cataloguing::Rules applies
# the cataloguing rules (AACR2 punctuation, author notation of the
# library's PHA or Cutter-Sanborn table, CDD). The librarian corrects the
# draft, checks the preview and only then the record is added (AddBiblio)
# in one transaction, under a database lock, after a check for the same
# ISBN and with a copy of the record and of the model's answer saved; a
# form sent twice adds nothing. With a biblionumber the draft goes to the
# replacement above instead. Without the two modules the tabs only say so.
#
# Technical note (kept from the original): no named sub captures
# file-scope lexical variables, because under Koha's persistent Plack the
# Perl process lives between requests and that causes "Variable is not
# available" errors. The settings below are package variables.

use Modern::Perl;
use CGI qw ( -utf8 );
use C4::Auth qw( checkauth haspermission );
use C4::Biblio qw( AddBiblio ModBiblio GetFrameworkCode GetMarcFromKohaField );
use C4::Charset qw( MarcToUTF8Record );
use C4::Context;
use Koha::BiblioFrameworks;
use Koha::Biblios;
use Koha::Database;
use Koha::ItemTypes;
use Koha::Token;
use Digest::SHA qw( sha1_hex );
use Encode qw( decode encode );
use Fcntl qw( O_CREAT O_EXCL O_WRONLY );
use JSON::PP;
use MIME::Base64 qw( decode_base64 encode_base64 );
use MARC::Record;
use MARC::Field;
use MARC::File::USMARC;
use MARC::File::XML ( BinaryEncoding => 'utf8', RecordFormat => 'USMARC' );
use POSIX qw( strftime );

sub _d { return decode( 'UTF-8', decode_base64( $_[0] ) ) }
MRPL1
    local k
    printf "our \$BACKUP_DIR = '%s';\nour \$TABLE_DIR = '%s';\nour \$VISION_CONF = \"\$BACKUP_DIR/vision.conf\";\nour \$USER = '';\nour %%T = (\n" "$MR_DIR" "$CAT_DIR"
    for k in title intro paste paste_hint file bn itype keep preview replace cancel err_csrf err_bn err_nobib \
             err_input err_parse err_many err_lines err_title err_changed err_backup err_mod current new items_kept \
             items_dropped charset confirm ok view prev_dl undo_hint warnings not_found $MR_VISION_KEYS; do
        printf '    %s => _d(q{%s}),\n' "$k" "$(mr_text "$k" | base64 -w0)"
    done
    printf ');\n'
    cat <<'MRPL2'

run();

sub h {
    my $s = shift // '';
    $s =~ s/&/&amp;/g;
    $s =~ s/</&lt;/g;
    $s =~ s/>/&gt;/g;
    $s =~ s/"/&quot;/g;
    $s =~ s/'/&#39;/g;
    return $s;
}

sub short_error {
    my $e = shift // '';
    $e =~ s/ at \S+ line \d+.*//s;
    return substr( $e, 0, 300 );
}

# Pasted text: Biblioteca Nacional "245 10 |a Title" ("_" is a blank
# indicator), MarcEdit "=245  10$aTitle" ("\" is a blank indicator) or
# "245 10 $a Title" lines; the leader as 000, LDR or a line on its own.
sub parse_mnemonic_marc {
    my ($text) = @_;
    my $record = MARC::Record->new();
    my ( $leader, @bad );
    my $n = 0;

    for my $line ( split /\r?\n/, $text ) {
        $n++;
        next unless $line =~ /\S/;
        $line =~ s/\s+$//;
        my ( $tag, $rest, $mrk );
        if ( $line =~ /^=(LDR|\d{3})  ?(.*)$/ ) {
            ( $tag, $rest, $mrk ) = ( $1, $2, 1 );
        } elsif ( $line =~ /^(LDR|\d{3}) (.*)$/ ) {
            ( $tag, $rest ) = ( $1, $2 );
        } elsif ( !defined $leader && $line =~ /^\s*(\d{5}[a-z ]{3}[a-z ][a ]\d\d.{12})$/ ) {
            $leader = $1;
            next;
        } else {
            push @bad, $n;
            next;
        }

        if ( $tag eq '000' || $tag eq 'LDR' ) {
            $rest =~ s/^\s+//;
            $rest =~ s/\\/ /g if $mrk;
            $leader = substr( $rest . ( ' ' x 24 ), 0, 24 );
            next;
        }

        if ( $tag lt '010' ) {
            my $data = $rest;
            $data =~ s/^\s+//;
            $data =~ s/\\/ /g if $mrk;
            $record->append_fields( MARC::Field->new( $tag, $data ) );
            next;
        }

        my ( $ind1, $ind2, $sf );
        if ($mrk) {
            ( $ind1, $ind2, $sf ) = ( substr( $rest, 0, 1 ), substr( $rest, 1, 1 ), substr( $rest, 2 ) );
        } elsif ( $rest =~ /^([0-9 _#\\])([0-9 _#\\])\s*([|\$].*)$/ ) {
            ( $ind1, $ind2, $sf ) = ( $1, $2, $3 );
        } elsif ( $rest =~ /^\s*([|\$].*)$/ ) {
            ( $ind1, $ind2, $sf ) = ( ' ', ' ', $1 );
        } else {
            push @bad, $n;
            next;
        }
        for ( $ind1, $ind2 ) { $_ = ' ' if !defined $_ || $_ eq '_' || $_ eq '#' || $_ eq '\\' || $_ eq '' }

        my $delim = $mrk ? '$' : substr( $sf, 0, 1 );
        my @subfields;
        for my $part ( split /\Q$delim\E/, $sf ) {
            next unless length $part;
            my $code  = substr( $part, 0, 1 );
            my $value = substr( $part, 1 );
            $value =~ s/\{dollar\}/\$/g if $mrk;
            $value =~ s/^\s+//;
            $value =~ s/\s+$//;
            push @subfields, ( $code, $value ) if $code =~ /^[a-z0-9]$/ && length $value;
        }
        if ( !@subfields ) { push @bad, $n; next }
        $record->append_fields( MARC::Field->new( $tag, $ind1, $ind2, @subfields ) );
    }

    $leader //= '00000nam a2200000 a 4500';
    substr( $leader, 9, 1 ) = 'a';    # pasted text is Unicode
    $record->leader($leader);
    return ( $record, \@bad );
}

# ( record, charset, [warnings] ) from the pasted text or the uploaded
# file; dies with the message to show.
sub read_record {
    my ($cgi) = @_;
    my $pasted_text = $cgi->param('marctext');
    if ( defined $pasted_text && $pasted_text =~ /\S/ ) {
        my ( $record, $bad ) = parse_mnemonic_marc($pasted_text);
        die $T{err_lines} . ' ' . join( ', ', @$bad ) . "\n" if @$bad;
        die $T{err_parse} . "\n" unless $record->fields;
        return ( $record, 'UTF-8', [] );
    }

    my $fh = $cgi->upload('marcfile');
    die $T{err_input} . "\n" unless $fh;
    binmode $fh;
    my $raw = do { local $/; <$fh> };
    die $T{err_input} . "\n" unless defined $raw && length $raw;

    if ( $raw =~ /^\s*(<\?xml|<)/ ) {
        my $count = () = $raw =~ /<(?:\w+:)?record[\s>]/g;
        die $T{err_many} . "\n" if $count > 1;
        my $record = eval { MARC::Record->new_from_xml( $raw, 'UTF-8', 'MARC21' ) };
        die $T{err_parse} . ' ' . short_error($@) . "\n" unless $record;
        return ( $record, 'UTF-8 (MARCXML)', [] );
    }

    my $count = () = $raw =~ /\x1D/g;
    die $T{err_many} . "\n" if $count > 1;
    my $flavour = C4::Context->preference('marcflavour') || 'MARC21';
    my ( $record, $charset, $errors ) = eval { MarcToUTF8Record( $raw, $flavour ) };
    die $T{err_parse} . ' ' . short_error($@) . "\n" unless $record && $record->fields;
    return ( $record, $charset, ref $errors eq 'ARRAY' ? $errors : [] );
}

# Koha's field for the items (952 in MARC 21) is always left out.
sub strip_items {
    my ($record) = @_;
    my ($itemtag) = GetMarcFromKohaField('items.itemnumber');
    $itemtag ||= '952';
    my @items = $record->field($itemtag);
    $record->delete_fields(@items) if @items;
    return scalar @items;
}

sub set_itemtype {
    my ( $record, $itemtype ) = @_;
    return unless defined $itemtype && $itemtype ne '';
    my $field942 = $record->field('942');
    if ($field942) {
        if ( $field942->subfield('c') ) {
            $field942->update( c => $itemtype );
        } else {
            $field942->add_subfields( c => $itemtype );
        }
    } else {
        $record->insert_fields_ordered( MARC::Field->new( '942', ' ', ' ', c => $itemtype ) );
    }
    return;
}

sub current_metadata {
    my ( $biblionumber, $lock ) = @_;
    my ($xml) = C4::Context->dbh->selectrow_array(
        "SELECT metadata FROM biblio_metadata WHERE biblionumber = ? AND format = 'marcxml'" . ( $lock ? ' FOR UPDATE' : '' ),
        undef, $biblionumber );
    return $xml;
}

sub digest { my $s = shift // ''; return sha1_hex( utf8::is_utf8($s) ? encode( 'UTF-8', $s ) : $s ) }

# A file written whole or not at all (a temporary file renamed over it);
# dies on failure.
sub write_atomic {
    my ( $file, $data ) = @_;
    die "exists: $file\n" if -e $file;
    open( my $fh, '>:raw', "$file.tmp" ) or die "$file.tmp: $!\n";
    print {$fh} utf8::is_utf8($data) ? encode( 'UTF-8', $data ) : $data;
    close($fh) or die "$file.tmp: $!\n";
    chmod 0640, "$file.tmp";
    rename( "$file.tmp", $file ) or die "$file: $!\n";
    return 1;
}

# The previous version as MARCXML; returns its stamp (dies on failure).
sub save_version {
    my ( $biblionumber, $xml ) = @_;
    my $stamp = strftime( '%Y%m%d-%H%M%S', localtime );
    write_atomic( "$BACKUP_DIR/$biblionumber-$stamp.xml", $xml );
    return $stamp;
}

sub run {
    my $cgi = CGI->new;

    # Staff login with permission to edit the catalogue (the session of
    # the staff interface is reused: no new login).
    my ( $user, $cookie, $sessionID ) = checkauth( $cgi, 0, { editcatalogue => 'edit_catalogue' }, 'intranet' );
    $USER = $user // '';    # package variable: set again on every request (Plack)
    my $op = $cgi->param('op') // '';

    if ( $cgi->request_method eq 'GET' && $op eq 'download' ) {
        send_version( $cgi, $cookie );
        return;
    }

    print $cgi->header( -cookie => $cookie, -charset => 'utf-8' );

    if ( $cgi->request_method eq 'POST' ) {
        handle_post( $cgi, $op );
    } elsif ( $op eq 'vision' ) {
        render_vision_form( $cgi, '' );
    } elsif ( $op eq 'vision-settings' ) {
        render_settings( $cgi, '' );
    } else {
        render_form( $cgi, '' );
    }

    return;
}

sub send_version {
    my ( $cgi, $cookie ) = @_;
    my $biblionumber = $cgi->param('biblionumber') // '';
    my $stamp        = $cgi->param('version')      // '';
    my $file         = "$BACKUP_DIR/$biblionumber-$stamp.xml";
    if ( $biblionumber =~ /^\d+$/ && $stamp =~ /^\d{8}-\d{6}$/ && -f $file && open( my $fh, '<:raw', $file ) ) {
        my $data = do { local $/; <$fh> };
        close $fh;
        print $cgi->header( -type => 'application/xml', -charset => 'utf-8', -attachment => "biblio-$biblionumber-$stamp.xml", -cookie => $cookie );
        print $data;
        return;
    }
    print $cgi->header( -status => '404 Not Found', -cookie => $cookie, -charset => 'utf-8' );
    render_form( $cgi, '<div class="msg err">' . h( $T{not_found} ) . '</div>' );
    return;
}

sub handle_post {
    my ( $cgi, $op ) = @_;

    my $csrf_ok = Koha::Token->new->check_csrf(
        {
            session_id => scalar $cgi->cookie('CGISESSID'),
            token      => scalar $cgi->param('csrf_token'),
        }
    );
    if ( !$csrf_ok ) {
        my $msg = '<div class="msg err">' . h( $T{err_csrf} ) . '</div>';
        if    ( $op =~ /^cud-vision-(?:settings|test)$/ ) { render_settings( $cgi, $msg ) }
        elsif ( $op =~ /^cud-vision/ )                    { render_vision_form( $cgi, $msg ) }
        else                                              { render_form( $cgi, $msg ) }
        return;
    }

    # AI cataloguing: a new record, or a draft sent to the replacement below.
    if ( $op =~ /^cud-vision/ ) {
        handle_vision( $cgi, $op );
        return;
    }

    my $biblionumber = $cgi->param('biblionumber');
    $biblionumber =~ s/\D//g if defined $biblionumber;
    if ( !$biblionumber ) {
        render_form( $cgi, '<div class="msg err">' . h( $T{err_bn} ) . '</div>' );
        return;
    }
    my $biblio = Koha::Biblios->find($biblionumber);
    if ( !$biblio ) {
        render_form( $cgi, '<div class="msg err">' . h( $T{err_nobib} ) . " ($biblionumber)</div>" );
        return;
    }

    if ( $op eq 'cud-replace' ) {
        do_replace( $cgi, $biblionumber );
    } else {
        do_preview( $cgi, $biblionumber, $biblio );
    }
    return;
}

sub do_preview {
    my ( $cgi, $biblionumber, $biblio ) = @_;
    my ( $record, $charset, $warnings ) = eval { read_record($cgi) };
    if ( !$record ) {
        render_form( $cgi, '<div class="msg err">' . h( short_error($@) ) . '</div>' );
        return;
    }
    set_itemtype( $record, scalar $cgi->param('itemtype') );
    my $dropped = strip_items($record);
    if ( !$record->field('245') ) {
        render_form( $cgi, '<div class="msg err">' . h( $T{err_title} ) . '</div>' );
        return;
    }

    my $xml     = encode( 'UTF-8', $record->as_xml_record('MARC21') );
    my $current = current_metadata($biblionumber);
    my $token   = Koha::Token->new->generate_csrf( { session_id => scalar $cgi->cookie('CGISESSID') } );
    my $items   = $biblio->items->count;

    my $body = '<h2>' . h( $T{title} ) . '</h2>';
    $body .= '<div class="msg warn"><b>' . h( $T{warnings} ) . '</b><br>' . join( '<br>', map { h($_) } @$warnings ) . '</div>' if @$warnings;
    $body .= '<p>' . h( $T{confirm} ) . '</p>';
    $body .= '<h3>' . h( $T{current} ) . " ($biblionumber)</h3><p><b>" . h( $biblio->title ) . '</b> ' . h( $biblio->author // '' ) . '</p>';
    $body .= '<p>' . h( $T{items_kept} ) . " $items</p>";
    $body .= '<p>' . h( $T{items_dropped} ) . " $dropped</p>" if $dropped;
    $body .= '<p>' . h( $T{charset} ) . ' ' . h($charset) . '</p>';
    $body .= '<h3>' . h( $T{new} ) . '</h3><pre>' . h( $record->as_formatted ) . '</pre>';
    $body .= '<form method="post">'
        . '<input type="hidden" name="op" value="cud-replace">'
        . '<input type="hidden" name="csrf_token" value="' . h($token) . '">'
        . '<input type="hidden" name="biblionumber" value="' . h($biblionumber) . '">'
        . '<input type="hidden" name="record" value="' . encode_base64( $xml, '' ) . '">'
        . '<input type="hidden" name="digest" value="' . digest($current) . '">'
        . '<input type="submit" value="' . h( $T{replace} ) . '"> '
        . '<a href="marc_replace.pl?biblionumber=' . h($biblionumber) . '">' . h( $T{cancel} ) . '</a></form>';
    render_page($body);
    return;
}

sub do_replace {
    my ( $cgi, $biblionumber ) = @_;
    my $record = eval { MARC::Record->new_from_xml( decode_base64( scalar $cgi->param('record') // '' ), 'UTF-8', 'MARC21' ) };
    if ( !$record || !$record->field('245') ) {
        render_form( $cgi, '<div class="msg err">' . h( $T{err_parse} ) . '</div>' );
        return;
    }
    strip_items($record);
    my $expected      = $cgi->param('digest') // '';
    my $frameworkcode = GetFrameworkCode($biblionumber);
    my $stamp;

    my $success = eval {
        Koha::Database->new->schema->txn_do(
            sub {
                my $current = current_metadata( $biblionumber, 1 );
                die "CHANGED\n" unless defined $current && digest($current) eq $expected;
                $stamp = eval { save_version( $biblionumber, $current ) };
                die 'BACKUP ' . short_error($@) . "\n" unless $stamp;
                ModBiblio( $record, $biblionumber, $frameworkcode ) or die "MODBIBLIO\n";
            }
        );
        1;
    };

    if ($success) {
        render_page( '<h2>' . h( $T{title} ) . '</h2><div class="msg ok">' . h( $T{ok} ) . " ($biblionumber) "
                . qq{<a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=$biblionumber" target="_blank">} . h( $T{view} ) . '</a></div>'
                . qq{<p><a href="marc_replace.pl?op=download&amp;biblionumber=$biblionumber&amp;version=$stamp">} . h( $T{prev_dl} ) . '</a><br>'
                . h( $T{undo_hint} ) . '</p><p><a href="marc_replace.pl">' . h( $T{title} ) . '</a></p>' );
        return;
    }
    my $err = $@ // '';
    my $msg =
          $err =~ /^CHANGED/   ? $T{err_changed}
        : $err =~ /^BACKUP (.*)/ ? "$T{err_backup} $1"
        :                        $T{err_mod} . ' ' . short_error( $err =~ /^MODBIBLIO/ ? 'ModBiblio' : $err );
    render_form( $cgi, '<div class="msg err">' . h($msg) . '</div>' );
    return;
}

