# NOTE: the helpers below use "__t_" local names on purpose. Values are read
# with ${!name} from the caller's scope, so a local called e.g. "name" here
# would hide the caller's variable of the same name.

# Prints the variables referenced in a template ("name", or "name:-" when
# it has a default value), one per line, sorted. A "${" that is not closed
# (typical machine-translation damage) is reported as "?broken".
_t_vars() {
    local __t_s="$1" __t_rest __t_names=()
    while [[ "$__t_s" == *'$'* ]]; do
        __t_rest="${__t_s#*\$}"
        if [[ "$__t_rest" =~ ^\{([A-Za-z_][A-Za-z0-9_]*)(:-[^}]*)?\} ]]; then
            __t_names+=("${BASH_REMATCH[1]}${BASH_REMATCH[2]:+:-}")
        elif [[ "$__t_rest" == '{'* ]]; then
            __t_names+=("?broken")
        elif [[ "$__t_rest" =~ ^([A-Za-z_][A-Za-z0-9_]*) ]]; then
            __t_names+=("${BASH_REMATCH[1]}")
        fi
        __t_s="$__t_rest"
    done
    [ ${#__t_names[@]} -gt 0 ] && printf '%s\n' "${__t_names[@]}" | sort -u
    return 0
}

# A translation is only used if it keeps the same variables and printf markers.
_t_is_safe() {
    local __t_a="${1//[^%]/}" __t_b="${2//[^%]/}"
    [ "${#__t_a}" -eq "${#__t_b}" ] || return 1
    if [[ "$1" == *'$'* || "$2" == *'$'* ]]; then
        [ "$(_t_vars "$1")" = "$(_t_vars "$2")" ] || return 1
    fi
    return 0
}

# Replaces $VAR, ${VAR} and ${VAR:-default} with the caller's values (no eval).
_t_expand() {
    local __t_s="$1" __t_out="" __t_rest __t_name
    local __t_re_brace='^\{([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}(.*)$'
    local __t_re_plain='^([A-Za-z_][A-Za-z0-9_]*)(.*)$'
    while [[ "$__t_s" == *'$'* ]]; do
        __t_out+="${__t_s%%\$*}"
        __t_rest="${__t_s#*\$}"
        if [[ "$__t_rest" =~ $__t_re_brace ]]; then
            __t_name="${BASH_REMATCH[1]}"
            __t_s="${BASH_REMATCH[4]}"
            if [ -n "${BASH_REMATCH[2]}" ] && [ -z "${!__t_name:-}" ]; then
                __t_out+="${BASH_REMATCH[3]}"
            else
                __t_out+="${!__t_name:-}"
            fi
        elif [[ "$__t_rest" =~ $__t_re_plain ]]; then
            __t_name="${BASH_REMATCH[1]}"
            __t_s="${BASH_REMATCH[2]}"
            __t_out+="${!__t_name:-}"
        else
            __t_out+='$'
            __t_s="$__t_rest"
        fi
    done
    printf '%s' "${__t_out}${__t_s}"
}

t() {
    local __t_src="${1:-}" __t_res __t_val
    [ -z "$__t_src" ] && return 0
    __t_res="$__t_src"
    if [ "${SYS_LANG:-en}" != "en" ]; then
        if [ "$SYS_LANG" = "pt" ] && [ -n "${_MENU_PT[$__t_src]+x}" ]; then
            __t_res="${_MENU_PT[$__t_src]}"
        elif [ -n "${_TRANS_CACHE[$__t_src]+x}" ]; then
            __t_val="${_TRANS_CACHE[$__t_src]}"
            _t_is_safe "$__t_src" "$__t_val" && __t_res="$__t_val"
        fi
    fi
    if [[ "$__t_res" == *'$'* ]]; then
        _t_expand "$__t_res"
    else
        printf '%s' "$__t_res"
    fi
}

# Every dictionary starts with a header naming the panel version it was
# generated for. A dictionary from another version (e.g. the lang/ folder of
# an old git clone) is only used as a last resort: it lacks the new texts and
# may still carry old, bad translations.
LANG_CACHE_HEADER="# koha-easy-installer lang ${PANEL_VERSION# }"
_cache_is_current() {
    [ -s "$1" ] && [ "$(head -n1 "$1" 2>/dev/null)" = "$LANG_CACHE_HEADER" ]
}

# Locates the dictionary of a language. Order: a copy made for this panel
# version (lang/ folder next to the script, copy installed with the panel,
# copy downloaded from GitHub); otherwise download it again; otherwise any
# copy available.
_find_translation_cache() {
    local lang="$1" f
    local near="" bundled="${CONFIG_DIR}/lang/${lang}.cache"
    local dl="${CONFIG_DIR}/translations_${lang}.cache"
    [ -n "$_SCRIPT_DIR" ] && near="${_SCRIPT_DIR}/lang/${lang}.cache"

    for f in "$near" "$bundled" "$dl"; do
        [ -n "$f" ] && _cache_is_current "$f" && { printf '%s' "$f"; return 0; }
    done

    # Download again when missing, older than the panel or more than a day old
    # (so an offline server does not wait for the network on every start).
    if [ "$(id -u)" -eq 0 ] && command -v curl >/dev/null 2>&1 && \
       { [ ! -s "$dl" ] || [ "$dl" -ot "$_SCRIPT_PATH" ] || [ -n "$(find "$dl" -mmin +1440 2>/dev/null)" ]; }; then
        mkdir -p "$CONFIG_DIR" 2>/dev/null
        if curl -4fsSL --connect-timeout 3 --max-time 15 "${LANG_REPO_URL}/${lang}.cache" -o "${dl}.part" 2>/dev/null \
           && grep -q '|' "${dl}.part" 2>/dev/null; then
            mv -f "${dl}.part" "$dl"
        else
            rm -f "${dl}.part"
            [ -s "$dl" ] && touch "$dl" 2>/dev/null
        fi
    fi
    _cache_is_current "$dl" && { printf '%s' "$dl"; return 0; }

    for f in "$dl" "$bundled" "$near"; do
        [ -n "$f" ] && [ -s "$f" ] && { printf '%s' "$f"; return 0; }
    done
    return 1
}

load_panel_translations() {
    _TRANS_CACHE=()
    [ "${SYS_LANG:-en}" = "en" ] && return 0
    local cache k v
    cache="$(_find_translation_cache "$SYS_LANG")" || return 0
    if command -v python3 >/dev/null 2>&1; then
        while IFS= read -r -d '' k && IFS= read -r -d '' v; do
            _TRANS_CACHE["$k"]="$v"
        done < <(python3 - "$cache" 2>/dev/null << 'PYEOF'
import sys, base64
out = sys.stdout.buffer
with open(sys.argv[1], "rb") as fh:
    for line in fh:
        line = line.strip()
        if not line or line.startswith(b"#") or b"|" not in line:
            continue
        k, v = line.split(b"|", 1)
        try:
            k = base64.b64decode(k, validate=True)
            v = base64.b64decode(v, validate=True)
        except Exception:
            continue
        if k and v and b"\0" not in k and b"\0" not in v:
            out.write(k + b"\0" + v + b"\0")
PYEOF
)
    else
        while IFS='|' read -r k v || [ -n "$k" ]; do
            [ -z "$k" ] || [ -z "$v" ] && continue
            k="$(printf '%s' "$k" | base64 -d 2>/dev/null)" || continue
            v="$(printf '%s' "$v" | base64 -d 2>/dev/null)" || continue
            [ -n "$k" ] && [ -n "$v" ] && _TRANS_CACHE["$k"]="$v"
        done < "$cache"
    fi
    return 0
}

# Labels of the whiptail buttons, translated (see the whiptail() wrapper below).
refresh_dialog_buttons() {
    WT_YES="$(t "Yes")"; WT_NO="$(t "No")"; WT_OK="$(t "OK")"; WT_CANCEL="$(t "Cancel")"
}

# Every dialog gets translated buttons. Options given by the caller come
# later on the command line, so they still win (e.g. --cancel-button "Back").
whiptail() {
    command whiptail --yes-button "${WT_YES:-Yes}" --no-button "${WT_NO:-No}" \
        --ok-button "${WT_OK:-OK}" --cancel-button "${WT_CANCEL:-Cancel}" "$@"
}

# Applies and saves the panel language ($1 = code such as pt-BR).
set_panel_language() {
    KOHA_PANEL_LANG_FULL="$1"
    KOHA_PANEL_LANG="$(normalize_panel_language "$1")"
    SYS_LANG="$KOHA_PANEL_LANG"
    export KOHA_PANEL_LANG_FULL KOHA_PANEL_LANG SYS_LANG
    if [ "$(id -u)" -eq 0 ]; then
        mkdir -p "$CONFIG_DIR" 2>/dev/null
        touch "$TRANSLATION_CONFIG" 2>/dev/null
        sed -i -e '/^[[:space:]]*KOHA_PANEL_LANG_FULL=/d' -e '/^[[:space:]]*KOHA_PANEL_LANG=/d' \
            "$TRANSLATION_CONFIG" 2>/dev/null || true
        printf 'KOHA_PANEL_LANG_FULL="%s"\nKOHA_PANEL_LANG="%s"\n' \
            "$KOHA_PANEL_LANG_FULL" "$KOHA_PANEL_LANG" >> "$TRANSLATION_CONFIG"
    fi
    load_panel_translations
    refresh_dialog_buttons
}

load_panel_translations
refresh_dialog_buttons

# ======================================================================
# 3. SHIELDED APT
# ======================================================================
APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o Acquire::ForceIPv4=true)
# Full APT output is kept here so a failed installation can be diagnosed.
APT_LOG="/var/log/koha-easy-install/apt.log"

apt_is_locked() {
    local f
    if command -v fuser >/dev/null 2>&1; then
        for f in /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock; do
            fuser "$f" >/dev/null 2>&1 && return 0
        done
        return 1
    fi
    pgrep -x 'apt|apt-get|dpkg|unattended-upgr' >/dev/null 2>&1
}

wait_for_apt_locks() {
    systemctl stop apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1
    APT_TIMERS_STOPPED="yes"

    local wait_time=0
    while apt_is_locked; do
        [ "$wait_time" -eq 0 ] && echo "$(t "Waiting for another package manager process to finish...")"
        sleep 3
        wait_time=$((wait_time + 3))
        if [ "$wait_time" -ge 300 ]; then
            restore_apt_timers
            return 1
        fi
    done
    if ! DEBIAN_FRONTEND=noninteractive dpkg --configure -a >>"$APT_LOG" 2>&1; then
        restore_apt_timers
        return 1
    fi
    return 0
}

apt_update_indices() {
    local attempt=1 max=3
    mkdir -p "$(dirname "$APT_LOG")" 2>/dev/null
    while [ "$attempt" -le "$max" ]; do
        if apt-get update -y -o Acquire::ForceIPv4=true >>"$APT_LOG" 2>&1; then
            return 0
        fi
        sleep 2
        if apt-get update -y --fix-missing -o Acquire::ForceIPv4=true >>"$APT_LOG" 2>&1; then
            return 0
        fi
        sleep 2
        attempt=$((attempt + 1))
    done
    return 1
}

apt_install() {
    local packages=("$@") attempt=1 max=3
    mkdir -p "$(dirname "$APT_LOG")" 2>/dev/null
    while [ "$attempt" -le "$max" ]; do
        printf '\n===== %s | apt-get install %s (attempt %s) =====\n' "$(date '+%F %T')" "${packages[*]}" "$attempt" >>"$APT_LOG"
        if DEBIAN_FRONTEND=noninteractive apt-get install "${APT_OPTS[@]}" "${packages[@]}" 2>&1 | tee -a "$APT_LOG"; then
            return 0
        fi
        apt_update_indices >/dev/null 2>&1
        DEBIAN_FRONTEND=noninteractive dpkg --configure -a >>"$APT_LOG" 2>&1
        DEBIAN_FRONTEND=noninteractive apt-get -f install "${APT_OPTS[@]}" >>"$APT_LOG" 2>&1
        sleep 3
        attempt=$((attempt + 1))
    done
    return 1
}

# Last lines of the APT log, for error dialogs.
apt_log_tail() {
    tail -n "${1:-8}" "$APT_LOG" 2>/dev/null | cut -c1-76
}

