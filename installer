# ======================================================================
# 5. BACKUP / RESTORE LOCK
# ======================================================================
# The same lock as the cron backups (/root/backup_sql.sh, backup_marc.sh):
# a nightly backup never dumps a catalog that is being restored, and a
# restore never starts while a backup is being written. The kernel releases
# it if the panel dies.
BACKUP_LOCK_FILE="/var/lock/koha_backup.lock"
backup_lock_acquire() {
    { exec 8>>"$BACKUP_LOCK_FILE"; } 2>/dev/null || return 1
    flock -n 8 && return 0
    exec 8>&-
    return 1
}
backup_lock_release() {
    exec 8>&-
    return 0
}

# Starts or restarts Koha daemons (Plack, Zebra, workers, indexers) without
# the panel's lock descriptors (7 to 9): a daemon inheriting them would keep
# the locks after the panel exits, so "sudo config.sh" would say it is
# already running and every nightly backup would be skipped.
koha_ctl() { "$@" 7>&- 8>&- 9>&-; }
plack_restart() { koha_ctl /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1; }

# Maintenance marker: while it names a live panel process, the indexing
# watchdogs leave Koha alone (restore, full reindex, engine switch).
MARKER_DIR="/run/koha-easy-install"
maintenance_begin() {
    mkdir -p "$MARKER_DIR" 2>/dev/null || return 0
    printf '%s\n' "$$" > "${MARKER_DIR}/maintenance.in-progress" && MAINT_MARKER_OWNED="${MARKER_DIR}/maintenance.in-progress"
    return 0
}
maintenance_end() {
    [ -n "$MAINT_MARKER_OWNED" ] && rm -f "$MAINT_MARKER_OWNED"
    MAINT_MARKER_OWNED=""
    return 0
}

