function_update_system() {
    prompt_yes_no "$(t "Update")" \
"$(t "System and Koha packages will be updated and database\nmigrations applied.\n\nRecommended: make a backup first.\n\nContinue?")" 13 74 || return 0
    clear
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"; then
        restore_apt_timers
        msg_error "" "$(t "Package upgrade failed. Koha migrations will not run.")" 10 76
        return 1
    fi
    if is_koha_installed; then
        display_explanation "Applying database migrations..."
        if ! /usr/sbin/koha-upgrade-schema "$INSTANCE"; then
            restore_apt_timers
            msg_error "" "$(t "Database migration failed. Services will not be restarted automatically to avoid hiding the error.")" 11 78
            return 1
        fi
        if ! systemctl restart memcached apache2 koha-common >/dev/null 2>&1; then
            restore_apt_timers
            msg_error "" "$(t "One of the core services did not restart after the update.")" 9 72
            return 1
        fi
        if ! ensure_koha_services >/dev/null 2>&1 && ! plack_running; then
            restore_apt_timers
            msg_error "" "$(t "Plack did not restart after the update.")" 9 70
            return 1
        fi
        if [ "$(get_search_engine)" = "Elasticsearch" ]; then
            if ! manage_koha_indexers start; then
                restore_apt_timers
                msg_error "" "$(t "The Elasticsearch indexer could not be started after the update.")" 10 76
                return 1
            fi
        else
            zebra_stop
            if ! zebra_start; then
                restore_apt_timers
                msg_error "" "$(t "Zebra could not be started after the update.")" 9 72
                return 1
            fi
        fi
    fi
    display_explanation "Cleaning orphan packages..."
    apt-get clean -y >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1 || true
    journalctl --vacuum-time=14d >/dev/null 2>&1 || true
    restore_apt_timers
    if validate_complete_system "$(t "system update")"; then
        msg_ok "$(t "Update finished with no critical errors.")" 9 70
    else
        msg_info "$(t "Update with warnings")" "$(t "The update ran but validation found \$V_FAIL failure(s) and \$V_WARN warning(s).\n\nLog: \$VALIDATION_LOG")" 11 76
        show_validation_report
        return 1
    fi
    return 0
}

