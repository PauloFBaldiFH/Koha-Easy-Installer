detect_koha_locale() {
    local sys_loc="${LC_ALL:-${LANG:-en}}"
    case "$sys_loc" in
        pt_BR*) echo "pt-BR" ;;
        pt_PT*) echo "pt-PT" ;;
        it_IT*|it_*) echo "it-IT" ;;
        es_ES*|es_*) echo "es-ES" ;;
        fr_FR*|fr_*) echo "fr-FR" ;;
        de_DE*|de_*) echo "de-DE" ;;
        ru_RU*|ru_*) echo "ru-RU" ;;
        pl_PL*|pl_*) echo "pl-PL" ;;
        zh_CN*) echo "zh-Hans-CN" ;;
        zh_TW*) echo "zh-Hant-TW" ;;
        ja_JP*) echo "ja-Jpan-JP" ;;
        *)      echo "" ;;
    esac
}

