# Terminal size: the controlling terminal, then $LINES/$COLUMNS, then 24x80.
ui_term_size() {
    local size
    size=$( { stty size </dev/tty; } 2>/dev/null ) || size=""
    UI_LINES="${size% *}"; UI_COLS="${size#* }"
    [[ "$UI_LINES" =~ ^[0-9]+$ ]] || UI_LINES="${LINES:-24}"
    [[ "$UI_COLS" =~ ^[0-9]+$ ]] || UI_COLS="${COLUMNS:-80}"
    [[ "$UI_LINES" =~ ^[0-9]+$ ]] && [ "$UI_LINES" -ge 8 ] || UI_LINES=24
    [[ "$UI_COLS" =~ ^[0-9]+$ ]] && [ "$UI_COLS" -ge 24 ] || UI_COLS=80
}

# ui_measure WIDTH TEXT: UI_ROWS = rows once wrapped like newt does (at word
# boundaries, "\n" = line break), UI_LONGEST = longest line. CJK characters
# take two columns.
ui_measure() {
    local width="$1" text="$2" line word len cur k=1 n=0 words=()
    UI_ROWS=0; UI_LONGEST=0
    case "${KOHA_PANEL_LANG:-en}" in ja|zh|ko) k=2 ;; esac
    [ "$width" -lt 10 ] && width=10
    text="${text//\\n/$'\n'}"
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1)); [ "$n" -gt 400 ] && break
        len=$(( ${#line} * k ))
        [ "$len" -gt "$UI_LONGEST" ] && UI_LONGEST=$len
        UI_ROWS=$((UI_ROWS + 1))
        [ "$len" -le "$width" ] && continue
        read -ra words <<< "$line"
        cur=0
        for word in "${words[@]}"; do
            len=$(( ${#word} * k ))
            if [ "$cur" -eq 0 ]; then
                cur=$len
            elif [ $((cur + 1 + len)) -le "$width" ]; then
                cur=$((cur + 1 + len))
            else
                UI_ROWS=$((UI_ROWS + 1)); cur=$len
            fi
            while [ "$cur" -gt "$width" ]; do UI_ROWS=$((UI_ROWS + 1)); cur=$((cur - width)); done
        done
    done <<< "$text"
    return 0
}

# ui_layout WHIPTAIL_ARGS...: UI_ARGS = the same arguments with the panel's
# geometry (the caller's height/width are only a fallback) and padded title.
ui_layout() {
    UI_ARGS=("$@")
    local n=$# i box="" text h w lh rows maxh maxw items extra scroll=0 wide=0
    for ((i = 0; i < n; i++)); do
        case "${UI_ARGS[i]}" in
            --msgbox|--yesno|--infobox|--inputbox|--passwordbox|--textbox|--gauge|--menu|--checklist|--radiolist)
                box="${UI_ARGS[i]}"; break ;;
            --scrolltext) wide=1 ;;
            --title)
                [[ "${UI_ARGS[i+1]:-}" == " "* ]] || UI_ARGS[i+1]=" ${UI_ARGS[i+1]:-} "
                i=$((i + 1)) ;;
            --backtitle|--yes-button|--no-button|--ok-button|--cancel-button|--default-item|--output-fd)
                i=$((i + 1)) ;;
        esac
    done
    [ -n "$box" ] && [ $((i + 3)) -lt "$n" ] || return 0
    ui_term_size
    maxw=$((UI_COLS - 2)); maxh=$((UI_LINES - 2))
    if [ "$box" = "--textbox" ]; then
        text=$(head -n 400 -- "${UI_ARGS[i+1]}" 2>/dev/null); wide=1
    else
        text="${UI_ARGS[i+1]}"
    fi
    w=$UI_WIDTH
    if [ "$wide" = "1" ]; then
        ui_measure 1000 "$text"
        [ $((UI_LONGEST + 6)) -gt "$w" ] && w=$((UI_LONGEST + 6))
        [ "$w" -gt "$UI_WIDTH_WIDE" ] && w=$UI_WIDTH_WIDE
    fi
    [ "$w" -gt "$maxw" ] && w=$maxw
    ui_measure $((w - 4)) "$text"
    rows=$UI_ROWS; [ "$rows" -lt 1 ] && rows=1
    case "$box" in
        --menu|--checklist|--radiolist)
            if [ "$box" = "--menu" ]; then items=$(( (n - i - 5) / 2 )); extra=7
            else items=$(( (n - i - 5) / 3 )); extra=6; fi
            [ "$items" -lt 1 ] && items=1
            lh=$items
            [ "$lh" -gt $((maxh - rows - extra)) ] && lh=$((maxh - rows - extra))
            [ "$lh" -lt 3 ] && lh=3
            [ "$lh" -gt "$items" ] && lh=$items
            UI_ARGS[i+4]=$lh
            h=$((rows + lh + extra)) ;;
        --inputbox|--passwordbox) h=$((rows + 7)) ;;
        --gauge) h=$((rows + 5)) ;;
        *) h=$((rows + 6)) ;;
    esac
    [ "$h" -gt "$maxh" ] && { h=$maxh; scroll=1; }
    UI_ARGS[i+2]=$h
    UI_ARGS[i+3]=$w
    if [ "$scroll" = "1" ] && [ "$box" != "--gauge" ]; then
        UI_ARGS=("${UI_ARGS[@]:0:i}" --scrolltext "${UI_ARGS[@]:i}")
    fi
    return 0
}

# Plain symbols for the classic Windows console (conhost), which has no
# font for emoji and most pictographs: they show as boxes or question marks
# and push the dialogs' borders out of line. KEI_PLAIN_GLYPHS=1 (set below
# for WSL outside Windows Terminal, or passed by the Windows installer)
# turns them into ASCII; the menu icons are dropped.
declare -A KEI_GLYPH_ASCII=(
    ["✔"]="+" ["✓"]="+" ["☑"]="+" ["✖"]="x" ["●"]="*" ["•"]="*" ["◆"]="*"
    ["⚠"]="!" ["→"]="->" ["⇄"]="<->" ["↔"]="<->"
)
KEI_GLYPH_ICONS=("⚙" "ℹ" "↻" "↶" "▣" "▤" "▦" "⌁" "⌕" "☁" "◈" "◌" "◷" "⏱" "✦" "★" "⟳" "⇩" "✉" "✎" "✏" "📖" "📋" "️")
KEI_GLYPH_SED=""
for _g in "${!KEI_GLYPH_ASCII[@]}"; do KEI_GLYPH_SED+="s/${_g}/${KEI_GLYPH_ASCII[$_g]}/g;"; done
for _g in "${KEI_GLYPH_ICONS[@]}"; do KEI_GLYPH_SED+="s/${_g} *//g;"; done
unset _g

# REPLY = $1 with those symbols replaced (an icon goes with the spaces after it).
kei_plain_text() {
    local s="$1" g
    if [[ "$s" != *[![:ascii:]]* ]]; then REPLY="$s"; return 0; fi
    for g in "${!KEI_GLYPH_ASCII[@]}"; do s=${s//"$g"/"${KEI_GLYPH_ASCII[$g]}"}; done
    for g in "${KEI_GLYPH_ICONS[@]}"; do
        s=${s//"$g  "/}; s=${s//"$g "/}; s=${s//"$g"/}
    done
    REPLY="$s"
}

# Applies kei_plain_text to every dialog argument; a --textbox file is shown
# from a converted copy (removed on exit with the other /tmp/koha_tmp_* files).
kei_plain_args() {
    local i n=${#UI_ARGS[@]} f
    for ((i = 0; i < n; i++)); do
        if [ "${UI_ARGS[i]}" = "--textbox" ] && [ $((i + 1)) -lt "$n" ] && [ -f "${UI_ARGS[i+1]}" ]; then
            if f=$(mktemp /tmp/koha_tmp_glyphs.XXXXXX) && sed "$KEI_GLYPH_SED" "${UI_ARGS[i+1]}" > "$f"; then
                UI_ARGS[i+1]=$f
            fi
            i=$((i + 1))
            continue
        fi
        kei_plain_text "${UI_ARGS[i]}"
        UI_ARGS[i]=$REPLY
    done
}

# Every dialog gets the panel's look, geometry and translated buttons.
# Options given by the caller come later on the command line, so they still
# win (e.g. --cancel-button "Back").
whiptail() {
    ui_layout "$@"
    [ "${KEI_PLAIN_GLYPHS:-0}" = "1" ] && kei_plain_args
    NEWT_COLORS="$UI_THEME" command whiptail --backtitle "Koha Easy Installer & Manager v${PANEL_VERSION# }" \
        --yes-button "${WT_YES:-Yes}" --no-button "${WT_NO:-No}" \
        --ok-button "${WT_OK:-OK}" --cancel-button "${WT_CANCEL:-Cancel}" "${UI_ARGS[@]}"
}

