function_cloudflare_status() {
    if [ ! -f /etc/cloudflared/config.yml ]; then
        msg_error "" "$(t "The tunnel is not configured yet.\nUse the installation option first.")" 9 70
        return
    fi

    local opac_host staff_host c_status
    opac_host=$(grep -B1 "localhost:80$" /etc/cloudflared/config.yml | grep "hostname:" | awk '{print $NF}' 2>/dev/null)
    staff_host=$(grep -B1 "localhost:8080$" /etc/cloudflared/config.yml | grep "hostname:" | awk '{print $NF}' 2>/dev/null)

    [ -z "$opac_host" ] && opac_host="$(t "Not configured")"
    [ -z "$staff_host" ] && staff_host="$(t "Not configured")"

    c_status="OFFLINE"
    systemctl is-active --quiet cloudflared && c_status="ONLINE"

    local tmp_cf
    tmp_cf=$(mktemp /tmp/koha_cf.XXXXXX) || return 1

    cat > "$tmp_cf" << EOF
$(t "TUNNEL STATUS:") ${c_status}
----------------------------------------------------------------------

$(t "PUBLIC INTERNET URLS:")

  $(t "Public Catalog (OPAC):")
  https://${opac_host}

  $(t "Administration (Staff):")
  https://${staff_host}

----------------------------------------------------------------------
$(t "ACTIVE SECURITY FEATURES:")

  • $(t "Hidden IP: server real IP is invisible from internet attacks.")
  • $(t "Closed Ports: no need to forward router/firewall ports.")
  • $(t "SSL Encryption: automatic secure HTTPS connections.")
EOF

    whiptail --title "$(t "Cloudflare Information")" --textbox "$tmp_cf" 20 76 2>/dev/null || true
    rm -f "$tmp_cf"
}

function_cloudflare_setup() {
    msg_info "$(t "Step 1: Domain & Nameservers")" \
"$(t "HOW TO LINK YOUR DOMAIN TO CLOUDFLARE:\n\n1. GET A FREE DOMAIN:\n    - Digital Plat (fast/automated): https://domain.digitalplat.org/\n    - nic.eu.org (manual, takes 14 to 45 days): https://nic.eu.org\n    - Or ask local IT for an official CNAME (e.g. catalog.palotina.pr.gov.br)\n\n2. ADD TO CLOUDFLARE (dash.cloudflare.com):\n    - Click 'Add a site/domain', type your domain and select Free.\n    - Cloudflare provides TWO Nameservers. Copy both.\n\n3. UPDATE AT YOUR DOMAIN REGISTRAR:\n    - Replace existing servers with the TWO from Cloudflare.\n    - In Cloudflare, click 'Check nameservers' until status is Active.\n\nThis part can't be automated, but everything from here on is fully automatic.")" 22 78

    clear
    display_explanation "Installing cloudflared..."
    if ! command -v cloudflared >/dev/null 2>&1; then
        if ! wait_for_apt_locks; then return 1; fi
        mkdir -p /etc/apt/keyrings && chmod 0755 /etc/apt/keyrings
        if ! curl -fsSL --retry 3 --max-time 60 https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg; then
            restore_apt_timers
            msg_error "" "$(t "Failed to download the Cloudflare key.")" 8 66
            return 1
        fi
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list
        if ! apt_update_indices; then
            rm -f /etc/apt/sources.list.d/cloudflared.list
            restore_apt_timers
            msg_error "" "$(t "Could not update the Cloudflare repository.")" 9 72
            return 1
        fi
        if ! apt_install cloudflared; then
            restore_apt_timers
            return 1
        fi
        restore_apt_timers
    fi

    if [ ! -f "$REAL_HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_info "$(t "Cloudflare Tunnel")" \
"$(t "AUTHORIZATION (first time only):\n\nA link will appear below. Copy it into any browser, select the\ndomain you already activated in Cloudflare, and click Authorize.\n\nNo need to paste anything back - the server detects it automatically.")" 12 76
        clear
        cloudflared tunnel login
        echo ""
    fi

    if [ ! -f "$REAL_HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_error "" "$(t "Authorization not completed. Try again.")" 8 66
        return 1
    fi

    local tunnel_name="koha-library"
    display_explanation "Checking Cloudflare tunnel..."
    
    local tunnel_id_check
    tunnel_id_check=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')

    if [ -n "$tunnel_id_check" ] && { [ -f "$REAL_HOME/.cloudflared/${tunnel_id_check}.json" ] || [ -f "/root/.cloudflared/${tunnel_id_check}.json" ]; }; then
        log "Tunnel '$tunnel_name' already exists with credentials; reusing..."
    else
        display_explanation "Creating tunnel '\$tunnel_name'..."
        if [ -n "$tunnel_id_check" ]; then
            cloudflared tunnel delete -f "$tunnel_name" >/dev/null 2>&1 || true
        fi

        if ! cloudflared tunnel create "$tunnel_name"; then
            msg_error "" "$(t "Failed to create tunnel.")" 10 74
            return 1
        fi
    fi

    local tunnel_id
    tunnel_id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')
    if [ -z "$tunnel_id" ]; then
        msg_error "" "$(t "Could not identify the tunnel ID.")" 8 66
        return 1
    fi

    local cred_file
    cred_file=$(find "$REAL_HOME/.cloudflared" /root/.cloudflared -name "${tunnel_id}.json" 2>/dev/null | head -n1)
    if [ -z "$cred_file" ]; then
        msg_error "" "$(t "Tunnel credentials file (.json) not found.")" 9 70
        return 1
    fi

    local dominio opac_sub staff_sub
    dominio=$(whiptail --title "$(t "Your Domain")" --inputbox "$(t "Enter the domain you already activated in Cloudflare (e.g. bibliotecapalotina.org):")" 10 74 3>&1 1>&2 2>&3) || return 0
    [ -z "$dominio" ] && return 0

    dominio=$(printf '%s' "$dominio" | tr 'A-Z' 'a-z' | sed -e 's|^[a-z]*://||' -e 's|/.*$||' -e 's/[[:space:]]//g')

    opac_sub=$(whiptail --title "OPAC" --inputbox "$(t "Public Catalog subdomain:")" 10 60 "catalog" 3>&1 1>&2 2>&3) || return 0
    staff_sub=$(whiptail --title "Staff" --inputbox "$(t "Administration subdomain:")" 10 60 "admin" 3>&1 1>&2 2>&3) || return 0
    opac_sub=$(printf '%s' "$opac_sub" | tr 'A-Z' 'a-z' | tr -d '[:space:]')
    staff_sub=$(printf '%s' "$staff_sub" | tr 'A-Z' 'a-z' | tr -d '[:space:]')

    local host_re='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$'
    if ! [[ "$dominio" =~ $host_re && "$dominio" == *.* && "$opac_sub" =~ $host_re && "$staff_sub" =~ $host_re ]] \
       || [ "$opac_sub" = "$staff_sub" ]; then
        msg_error "" "$(t "Invalid domain or subdomain. Use only letters, numbers and hyphens (e.g. catalog / admin / mylibrary.org), with different subdomains.")" 10 76
        return 1
    fi

    mkdir -p /etc/cloudflared
    cat > /etc/cloudflared/config.yml <<EOF
tunnel: ${tunnel_id}
credentials-file: ${cred_file}

ingress:
  - hostname: ${opac_sub}.${dominio}
    service: http://localhost:80
  - hostname: ${staff_sub}.${dominio}
    service: http://localhost:8080
  - service: http_status:404
EOF

    display_explanation "Registering subdomains in DNS..."
    cloudflared tunnel route dns -f "$tunnel_name" "${opac_sub}.${dominio}" || true
    cloudflared tunnel route dns -f "$tunnel_name" "${staff_sub}.${dominio}" || true

    display_explanation "Installing tunnel as a service..."
    cloudflared service uninstall >/dev/null 2>&1 || true
    cp /etc/cloudflared/config.yml /etc/cloudflared/config.yml.bak 2>/dev/null || true
    cloudflared --config /etc/cloudflared/config.yml service install
    systemctl enable --now cloudflared >/dev/null 2>&1
    sleep 3

    if systemctl is-active --quiet cloudflared; then
        if is_database_ready; then
            display_explanation "Setting Koha URL system preferences..."
            local full_opac="https://${opac_sub}.${dominio}"
            local full_staff="https://${staff_sub}.${dominio}"

            mysql -e "INSERT INTO ${DB_NAME}.systempreferences (variable, value, type) VALUES ('OPACBaseURL', '${full_opac}', 'Free') ON DUPLICATE KEY UPDATE value='${full_opac}';" >/dev/null 2>&1 || true
            mysql -e "INSERT INTO ${DB_NAME}.systempreferences (variable, value, type) VALUES ('staffClientBaseURL', '${full_staff}', 'Free') ON DUPLICATE KEY UPDATE value='${full_staff}';" >/dev/null 2>&1 || true

            local k_sites="/etc/koha/koha-sites.conf"
            if [ -f "$k_sites" ]; then
                sed -i -E "s|^[[:space:]]*DEFAULTSOPACURL=.*|DEFAULTSOPACURL=\"${full_opac}\"|" "$k_sites" 2>/dev/null || true
                sed -i -E "s|^[[:space:]]*DEFAULTSINTRAURL=.*|DEFAULTSINTRAURL=\"${full_staff}\"|" "$k_sites" 2>/dev/null || true
            fi

            systemctl restart memcached >/dev/null 2>&1 || true
            /usr/sbin/koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
        fi

        function_cloudflare_status
    else
        msg_error "" "$(t "The service is not active. Check: journalctl -u cloudflared -n 30")" 9 74
    fi
}

function_configure_cloudflare() {
    while true; do
        local tunnel_active="$(t "INACTIVE")"
        systemctl is-active --quiet cloudflared && tunnel_active="$(t "ACTIVE")"

        local choice
        choice=$(whiptail --title "$(t "Cloudflare Tunnel Manager")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Tunnel Status: \$tunnel_active\n\nCloudflare Tunnel safely exposes Koha without opening ports.\n\nWhat do you want to do?")" 18 78 4 \
            "1" "$(t "⚙  Install and Configure Tunnel (First Use)")" \
            "2" "$(t "ℹ  View Public Links and Security Status")" \
            "3" "$(t "↻  Restart Tunnel Service")" \
            "4" "$(t "✖  Disable and Remove Tunnel (Go Offline)")" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 ]] && break

        case "$choice" in
            1) function_cloudflare_setup ;;
            2) function_cloudflare_status ;;
            3)
                clear
                display_explanation "Restarting Cloudflare Tunnel..."
                systemctl restart cloudflared >/dev/null 2>&1
                msg_ok "$(t "Service restarted successfully.")" 8 60
                ;;
            4)
                if prompt_yes_no "$(t "Disable Tunnel")" "$(t "This will stop the service and remove auto-start.\nYour catalog will go offline to the internet.\n\nContinue?")" 10 70; then
                    clear
                    display_explanation "Uninstalling service..."
                    cloudflared service uninstall >/dev/null 2>&1 || true
                    systemctl disable --now cloudflared >/dev/null 2>&1 || true
                    msg_ok "$(t "Tunnel disabled.\nKoha is now only accessible on the local network.")" 10 70
                fi
                ;;
        esac
    done
}

