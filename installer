# Shows why the installation stopped, with the end of the APT log, instead of
# silently going back to the menu.
install_step_failed() {
    local step="$1" details
    restore_apt_timers
    details=$(apt_log_tail 8)
    log "installation aborted at step: $step"
    msg_error "$(t "Installation interrupted")" \
        "$(t 'The installation stopped at the step:\n${step}\n\nLast lines of ${APT_LOG}:\n${details}\n\nFix the cause (internet, disk space, locked APT) and run option 1 again.')" 22 80
    return 1
}

# Adds the Elasticsearch 7 APT repository. If it cannot be reached (Elastic
# blocks some regions and proxies), it is removed again so that it does not
# break "apt-get update" for everything else.
ensure_elastic_repo() {
    local list="/etc/apt/sources.list.d/elastic-7.x.list"
    [ -f "$list" ] && return 0
    mkdir -p /usr/share/keyrings
    if curl -fsSL --retry 3 --max-time 60 https://artifacts.elastic.co/GPG-KEY-elasticsearch \
        | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg 2>/dev/null; then
        apt_source_line /usr/share/keyrings/elasticsearch-keyring.gpg https://artifacts.elastic.co/packages/7.x/apt stable main > "$list"
        if apt_update_indices; then
            return 0
        fi
    fi
    rm -f "$list"
    apt_update_indices >/dev/null 2>&1
    return 1
}

# On Debian 12+ there is no /var/log/auth.log (logs live in journald) and the
# default fail2ban sshd jail refuses to start. Use the systemd backend there.
configure_fail2ban() {
    command -v fail2ban-client >/dev/null 2>&1 || return 0
    if [ ! -f /var/log/auth.log ] && [ -d /etc/fail2ban/jail.d ]; then
        apt_install python3-systemd >/dev/null 2>&1 || true
        cat > /etc/fail2ban/jail.d/koha-easy-install.local << 'EOF'
# Generated by Koha Easy Installer: this system logs to journald.
[sshd]
enabled = true
backend = systemd
EOF
    fi
    systemctl enable fail2ban >/dev/null 2>&1 || true
    systemctl restart fail2ban >/dev/null 2>&1 || true
}

# koha-create needs the templates shipped in /etc/koha (apache-site.conf.in,
# koha-conf-site.xml.in...). They are dpkg "conffiles": if /etc/koha was
# deleted by hand or by an old uninstall while koha-common stayed installed,
# a plain reinstall does NOT bring them back. --force-confmiss does.
ensure_koha_conffiles() {
    local f missing=0
    while read -r f _; do
        [ -n "$f" ] && [ ! -e "$f" ] && missing=$((missing + 1))
    done < <(dpkg-query -W -f='${Conffiles}\n' koha-common 2>/dev/null)
    [ -f /etc/koha/apache-site.conf.in ] || missing=$((missing + 1))
    [ -f /etc/koha/koha-conf-site.xml.in ] || missing=$((missing + 1))
    [ "$missing" -eq 0 ] && return 0

    display_explanation "Restoring missing Koha configuration files..."
    log "koha-common: $missing configuration file(s) missing; reinstalling with --force-confmiss"
    DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y \
        -o Dpkg::Options::=--force-confmiss -o Dpkg::Options::=--force-confold \
        -o Acquire::ForceIPv4=true koha-common 2>&1 | tee -a "$APT_LOG"
    [ -f /etc/koha/apache-site.conf.in ] && [ -f /etc/koha/koha-conf-site.xml.in ]
}

# Copies the panel (and its dictionaries) to /usr/local/bin/config.sh.
install_panel_copy() {
    local src="$_SCRIPT_PATH"
    [ -f "$src" ] || return 0
    if [ "$(readlink -f "$src")" != "$(readlink -f /usr/local/bin/config.sh 2>/dev/null)" ]; then
        install -m 755 "$src" /usr/local/bin/config.sh 2>/dev/null || true
    fi
    if [ -d "${_SCRIPT_DIR}/lang" ] && [ "$(readlink -f "${_SCRIPT_DIR}/lang")" != "$(readlink -f "${CONFIG_DIR}/lang" 2>/dev/null)" ]; then
        mkdir -p "${CONFIG_DIR}/lang"
        cp -f "${_SCRIPT_DIR}"/lang/*.cache "${CONFIG_DIR}/lang/" 2>/dev/null || true
    fi
}

function_install_koha() {
    validate_pre_installation || return 1

    local tz
    if tz=$(choose_timezone) && [ -n "$tz" ]; then
        apply_timezone "$tz" || echo "$(t '[WARN] Could not apply the timezone ${tz}.')"
    fi

    clear
    INSTALL_STARTED_AT=$(date '+%F %T')
    log "installation started"

    wait_for_apt_locks || { msg_error "" "$(t "APT is locked by another process or dpkg failed. Cannot continue.")"; return 1; }

    display_explanation "Configuring locales and UTF-8..."
    apt_update_indices || { install_step_failed "apt-get update"; return 1; }
    apt_install locales || { install_step_failed "locales"; return 1; }

    local sys_locale="${LANG:-en_US.UTF-8}"
    case "$sys_locale" in
        C|POSIX|C.*|POSIX.*|"") sys_locale="en_US.UTF-8" ;;
    esac
    sys_locale="${sys_locale%%.*}.UTF-8"
    # Debian's locale-gen ignores its arguments and only reads /etc/locale.gen.
    sed -i -E "s/^#[[:space:]]*(${sys_locale}[[:space:]]+UTF-8)/\1/i; s/^#[[:space:]]*(en_US\.UTF-8[[:space:]]+UTF-8)/\1/" /etc/locale.gen 2>/dev/null || true
    locale-gen "$sys_locale" en_US.UTF-8 >/dev/null 2>&1 || locale-gen >/dev/null 2>&1
    update-locale LANG="$sys_locale" >/dev/null 2>&1 || true

    display_explanation "Synchronizing the clock (NTP)..."
    apt_install systemd-timesyncd >/dev/null 2>&1
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    timeout 15 bash -c 'until timedatectl show -p NTPSynchronized --value | grep -q yes; do sleep 1; done' >/dev/null 2>&1

    display_explanation "Creating virtual memory (4 GB SWAP)..."
    if [ -z "$(swapon --noheadings --show 2>/dev/null)" ] && [ ! -f /swapfile ]; then
        if [ "$(get_free_space_mb /)" -ge 8192 ] 2>/dev/null; then
            fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
            chmod 600 /swapfile
            mkswap /swapfile >/dev/null 2>&1
            if swapon /swapfile 2>/dev/null; then
                grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
            else
                rm -f /swapfile
                echo "$(t "[WARN] SWAP could not be enabled (normal on WSL/containers).")"
            fi
        else
            echo "$(t "[WARN] Not enough space for a 4 GB SWAP. Skipping.")"
        fi
    fi

    wait_for_apt_locks || { install_step_failed "dpkg --configure -a"; return 1; }
    display_explanation "Upgrading the system..."
    apt_update_indices || { install_step_failed "apt-get update"; return 1; }
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}" 2>&1 | tee -a "$APT_LOG"; then
        restore_apt_timers
        msg_error "" "$(t "System upgrade failed. Koha will not be changed at this stage.")" 10 74
        return 1
    fi

    display_explanation "Installing essential dependencies..."
    apt_install nano curl wget gpg ca-certificates ufw apt-transport-https \
                fail2ban libsasl2-modules rclone avahi-daemon memcached libcache-memcached-fast-perl \
                libxml2-utils unzip pv psmisc || { install_step_failed "$(t "Installing essential dependencies...")"; return 1; }

    # Labels utility installed separately to prevent batch failure if missing from repository
    apt_install glabels >/dev/null 2>&1 || true

    systemctl enable --now avahi-daemon memcached >/dev/null 2>&1
    configure_fail2ban

    display_explanation "Adding Koha and Elasticsearch repositories..."
    mkdir -p /usr/share/keyrings
    if ! curl -fsSL --retry 3 --max-time 60 https://debian.koha-community.org/koha/gpg.asc \
        | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg 2>/dev/null; then
        restore_apt_timers
        msg_error "" "$(t "Could not download the Koha repository key. Check your internet connection.")" 9 74
        return 1
    fi
    apt_source_line /usr/share/keyrings/koha-keyring.gpg https://debian.koha-community.org/koha stable main > /etc/apt/sources.list.d/koha.list

    if ! ensure_elastic_repo; then
        echo "$(t "[WARN] Elasticsearch repository unavailable; continuing with Zebra only.")"
    fi

    apt_update_indices || { install_step_failed "apt-get update (Koha)"; return 1; }
    display_explanation "Installing MariaDB and Koha (longest step)..."
    apt_install mariadb-server koha-common || { install_step_failed "mariadb-server koha-common"; return 1; }
    ensure_koha_conffiles || { install_step_failed "$(t "Restoring missing Koha configuration files...")"; return 1; }
    systemctl enable --now mariadb >/dev/null 2>&1
    if ! mysql -e "SELECT 1;" >/dev/null 2>&1; then
        systemctl restart mariadb >/dev/null 2>&1 || koha_ctl service mariadb start >/dev/null 2>&1 || true
        sleep 2
    fi
    if ! mysql -e "SELECT 1;" >/dev/null 2>&1; then
        restore_apt_timers
        msg_error "" "$(t "MariaDB was installed but is not accepting connections.\n\nCheck: systemctl status mariadb")" 11 76
        return 1
    fi

    display_explanation "Configuring Apache and Koha defaults..."
    define_koha_sites_conf
    a2enmod rewrite cgi deflate headers proxy proxy_http >/dev/null 2>&1
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080' /etc/apache2/ports.conf 2>/dev/null \
        || sed -i '/^[[:space:]]*Listen[[:space:]]\+80$/a Listen 8080' /etc/apache2/ports.conf
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080' /etc/apache2/ports.conf 2>/dev/null \
        || echo 'Listen 8080' >> /etc/apache2/ports.conf
    systemctl restart apache2 memcached >/dev/null 2>&1

    local exists="no"
    [ -d "/etc/koha/sites/${INSTANCE}" ] && exists="yes"
    [ "$(run_sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ] && exists="yes"

    if [ "$exists" = "yes" ]; then
        prompt_yes_no "$(t "Instance already exists")" \
            "$(t "A Koha installation already exists on this machine.\n\nREINSTALLING DELETES the \${DB_NAME} database and all configuration.\nThis CANNOT be undone by this script.\n\nContinue to the final confirmation?")" 16 76 || { restore_apt_timers; return 0; }

        local confirm
        confirm=$(whiptail --title "$(t "FINAL CONFIRMATION")" --inputbox \
            "$(t "Type exactly the word below to erase everything:\n\nREINSTALL")" 12 66 3>&1 1>&2 2>&3) || { restore_apt_timers; return 0; }
        if [ "$confirm" != "REINSTALL" ]; then
            restore_apt_timers
            msg_info "$(t "Cancelled")" "$(t "Wrong confirmation. Nothing was deleted.")" 8 62
            return 0
        fi

        display_explanation "Saving a safety backup before deleting..."
        if ! backup_lock_acquire; then
            restore_apt_timers
            msg_error "" "$(t "Another backup or restore is already running. Reinstallation was cancelled.")" 9 74
            return 1
        fi
        local rescue db_has_tables
        rescue="${DIR_SQL}/PRE-REINSTALLATION_$(date +%Y-%m-%d_%Hh%M%S).sql.gz"
        # "Could not count" is not "empty": no DROP without a verified copy.
        db_has_tables=$(koha_table_count) || db_has_tables="unknown"
        if [ "$db_has_tables" != "0" ]; then
            if ! create_safety_backup "$rescue"; then
                backup_lock_release
                restore_apt_timers
                msg_error "$(t "Safety backup failed")" \
                    "$(t "The pre-reinstallation backup could not be validated.\n\nFor safety, the previous installation will NOT be deleted.")" 11 74
                return 1
            fi
            echo "$(t "Safety backup:") $rescue"
        fi

        display_explanation "Removing the previous installation..."
        manage_koha_indexers stop
        if [ -d "/etc/koha/sites/${INSTANCE}" ]; then
            if ! /usr/sbin/koha-remove "$INSTANCE" >/dev/null 2>&1; then
                backup_lock_release
                restore_apt_timers
                msg_error "" "$(t "Koha could not remove the previous instance. No additional DROP was executed.")" 10 74
                return 1
            fi
        fi
        if ! mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`; DROP USER IF EXISTS '${DB_NAME}'@'localhost'; DROP USER IF EXISTS '${DB_NAME}'@'%'; FLUSH PRIVILEGES;" >/dev/null 2>&1; then
            backup_lock_release
            restore_apt_timers
            msg_error "" "$(t "Could not completely clean the previous database/user.")" 9 74
            return 1
        fi
        rm -rf "/etc/koha/sites/${INSTANCE}"
        backup_lock_release
    fi

    display_explanation "Creating the '\${INSTANCE}' Koha instance..."

    # C.UTF-8 keeps the tools' messages readable in the error box (some of
    # them print badly encoded accents in other locales).
    mkdir -p /var/lib/koha
    if ! LC_ALL=C.UTF-8 LANGUAGE=en koha_ctl /usr/sbin/koha-create --create-db "$INSTANCE" > "${LOG_DIR}/koha-create.log" 2>&1; then
        local err_msg
        err_msg=$(tail -n 15 "${LOG_DIR}/koha-create.log" 2>/dev/null)
        [ -z "$err_msg" ] && err_msg="$(t "Empty log.")"
        restore_apt_timers
        msg_error "" "$(t "Failed to create the Koha instance.\n\nDetails:\n\$err_msg")" 22 80
        return 1
    fi

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_library:/g' "$KOHA_CONF" 2>/dev/null

    # Disable the Debian/Ubuntu default site so that port 80 serves the OPAC.
    a2dissite 000-default default-ssl >/dev/null 2>&1
    rm -f /var/www/html/index.html

    a2enmod headers proxy proxy_http >/dev/null 2>&1
    a2ensite "$INSTANCE" >/dev/null 2>&1
    systemctl enable --now memcached >/dev/null 2>&1
    systemctl restart apache2 memcached koha-common >/dev/null 2>&1

    # Automatic detection and installation of system language package in Koha
    local auto_lang
    auto_lang=$(detect_koha_locale)
    [ -z "$auto_lang" ] && [ "$KOHA_PANEL_LANG_FULL" != "en-GB" ] && auto_lang="$KOHA_PANEL_LANG_FULL"
    if [ -n "$auto_lang" ] && [ "${auto_lang%%-*}" != "en" ]; then
        display_explanation "Installing Koha system language pack (\${auto_lang})..."
        /usr/sbin/koha-translate --install "$auto_lang" >>"${LOG_DIR}/koha-translate.log" 2>&1 || true
    fi

    koha_ctl /usr/sbin/koha-plack --enable "$INSTANCE" >/dev/null 2>&1
    koha_ctl /usr/sbin/koha-plack --start "$INSTANCE" >/dev/null 2>&1
    systemctl restart apache2 >/dev/null 2>&1

    display_explanation "Enabling Zebra and incremental indexing..."
    zebra_start >/dev/null 2>&1
    write_cron_zebra
    zebra_indexer_start >/dev/null 2>&1
    start_koha_workers

    display_explanation "Creating automatic backups and credentials..."
    local db_pass ip
    db_pass=$(get_database_password)
    ip=$(get_server_ip)
    local ssh_login
    ssh_login=$(get_ssh_login "$ip")
    write_backup_scripts
    write_cron_tasks
    koha_email_enable || log "koha-email-enable failed (e-mail notices stay off)"

    cat > "$CREDENTIALS_FILE" << EOF
======================================================================
 $(t "KOHA CREDENTIALS (instance: \${INSTANCE})")
 $(t "Generated on:") $(date '+%F %T')
======================================================================
 $(t "Staff (administration):") http://${ip}:8080
 $(t "OPAC  (catalog)       :") http://${ip}:80

 $(t "Username              :") ${DB_NAME}
 $(t "Password              :") ${db_pass}

 $(t "SSH access            :") ssh ${ssh_login}

 $(t "This password belongs to the database user for initial access")
 $(t "(Web Installer). Afterwards, create a dedicated superlibrarian")
 $(t "(menu 9 > Create super librarian) and store this file safely.")

 $(t "Configuration         :") ${KOHA_CONF}
 $(t "Backups               :") ${DIR_SQL} $(t "and") ${DIR_MARC}
 $(t "Dashboard             :") sudo config.sh
======================================================================
EOF
    chmod 600 "$CREDENTIALS_FILE"

    configure_firewall
    write_banner "$ip" "$DB_NAME"
    install_panel_copy

    display_explanation "Restarting Koha services (Memcached, Plack, Apache)..."
    ensure_koha_services >/dev/null 2>&1

    display_explanation "Cleaning temporary files..."
    apt-get clean -y >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1
    journalctl --vacuum-time=7d >/dev/null 2>&1
    restore_apt_timers

    clear
    validate_complete_system "$(t "installation complete")"
    log "installation complete (ok=$V_OK warn=$V_WARN fail=$V_FAIL)"

    local result_msg
    if [ "$V_FAIL" -eq 0 ]; then
        result_msg="$(t "INSTALLATION COMPLETE WITH NO CRITICAL ERRORS.\n\n")"
    else
        result_msg="$(t "INSTALLATION COMPLETE, BUT WITH FAILURES (\$V_FAIL).\nThe system may have issues.\n\n")"
    fi

    local report_text="${result_msg}"
    report_text+="$(t "ACCESS:")\n"
    report_text+="  Staff: http://${ip}:8080\n"
    report_text+="  OPAC:  http://${ip}:80\n\n"
    report_text+="$(t "CREDENTIALS (saved in /root/koha_credentials.txt):")\n"
    report_text+="  $(t "User:") ${DB_NAME}\n"
    report_text+="  $(t "Pass:") ${db_pass}\n\n"
    report_text+="$(t "NEXT STEP: open Staff in browser for the Web Installer (or use option 3 with a backup).")\n\n"
    report_text+="$(t "Validation:") OK=$V_OK  $(t "Warnings:") $V_WARN  $(t "Failures:") $V_FAIL"

    whiptail --title "$(t "Installation Complete")" \
        --scrolltext --msgbox "$report_text" 22 78 || true
    if [ "$V_FAIL" -gt 0 ] || [ "$V_WARN" -gt 0 ]; then
        local diag_msg
        if [ "$V_FAIL" -gt 0 ]; then
            diag_msg="$(t "Final validation found issues (Failures: \$V_FAIL | Warnings: \$V_WARN).\n\nDo you want to see the detailed report now to know what failed?")"
        else
            diag_msg="$(t "Final validation completed with notices (Failures: 0 | Warnings: \$V_WARN).\n\nDo you want to see the detailed report now?")"
        fi

        if prompt_yes_no "$(t "View Diagnostics")" "$diag_msg" 12 76; then
            show_validation_report
        fi
    fi

    if prompt_yes_no "$(t "Reboot Server (Recommended)")" \
"$(t "To enable full Plack speed, initialize SWAP, and ensure peak catalog performance, rebooting the system now is strongly recommended.\n\nCredentials have been saved to /root/koha_credentials.txt.\n\nDo you want to reboot the server immediately?")" 15 76; then
        clear
        echo "$(t "Rebooting in 5 seconds to consolidate services...")"
        log "post-install automatic reboot requested by user"
        sleep 5
        reboot_now
    else
        msg_info "$(t "Pending Reboot")" \
"$(t "All set! You chose to reboot later.\n\nRemember: if the catalog feels sluggish, restart the server via option 16 in the panel before heavy indexing.")" 11 74
    fi
}

