function_configure_ssl() {
    require_koha || return 0
    prompt_yes_no "$(t "SSL / HTTPS")" \
"$(t "To issue the free certificate you NEED a domain with an A record\npointing to this server's PUBLIC IP, and port 80 reachable.\n\nIf you use Cloudflare Tunnel, CANCEL: HTTPS already comes from it.\n\nContinue?")" 15 76 || return 0
    clear
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! apt_install certbot python3-certbot-apache; then
        restore_apt_timers
        return 1
    fi
    restore_apt_timers
    if ! koha_ctl certbot --apache; then
        msg_error "" "$(t "Certbot could not complete certificate issuance/configuration. Apache will not be reloaded automatically.")" 10 78
        return 1
    fi
    if ! apachectl configtest; then
        msg_error "" "$(t "Apache configuration is invalid after Certbot. The service will not be reloaded.")" 10 76
        return 1
    fi
    if ! systemctl restart apache2 >/dev/null 2>&1; then
        msg_error "" "$(t "The certificate was configured, but Apache failed to restart. Check the service status.")" 10 76
        return 1
    fi
    msg_ok "$(t "HTTPS configured successfully. Certbot will handle automatic renewal.")" 9 72
}

# ======================================================================
# 17. INTEROPERABILITY (SIP2 / Z39.50)
# ======================================================================
function_interoperability() {
    require_koha || return 0
    prompt_yes_no "$(t "SIP2 & Z39.50")" \
"$(t "Z39.50 (port 2100): lets other libraries search your catalog.\nSIP2 (port 6001): lets you connect self-checkout terminals.\n\nEnable both and open the firewall ports?")" 13 78 || return 0
    clear
    ufw allow 2100/tcp >/dev/null 2>&1 || true
    ufw allow 6001/tcp >/dev/null 2>&1 || true

    /usr/sbin/koha-z3950-responder --enable "$INSTANCE" >/dev/null 2>&1 || true
    /usr/sbin/koha-sip --enable "$INSTANCE" >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true

    local z39_ok="no" sip_ok="no"
    if koha_ctl /usr/sbin/koha-z3950-responder --start "$INSTANCE" >/dev/null 2>&1 \
       || systemctl enable --now "koha-z3950-responder@${INSTANCE}" >/dev/null 2>&1 \
       || pgrep -f "z3950_responder.*${INSTANCE}" >/dev/null 2>&1; then
        z39_ok="yes"
    fi
    if koha_ctl /usr/sbin/koha-sip --start "$INSTANCE" >/dev/null 2>&1 \
       || systemctl enable --now "koha-sip-daemon@${INSTANCE}" >/dev/null 2>&1 \
       || pgrep -f "SIPServer.*${INSTANCE}" >/dev/null 2>&1; then
        sip_ok="yes"
    fi

    local z39_status sip_status
    [ "$z39_ok" = "yes" ] && z39_status="$(t "active")" || z39_status="$(t "inactive")"
    [ "$sip_ok" = "yes" ] && sip_status="$(t "active")" || sip_status="$(t "inactive")"

    if [ "$z39_ok" = "yes" ] && [ "$sip_ok" = "yes" ]; then
        msg_ok "$(t "Z39.50 and SIP2 were enabled successfully!\n\nFor SIP2 you still need a circulation account and\nto fill in:\n/etc/koha/sites/\${INSTANCE}/SIPconfig.xml")" 12 76
    else
        msg_error "" "$(t "Activation was partial.\n\nZ39.50: \${z39_status}\nSIP2:    \${sip_status}\n\nCheck: systemctl status koha-z3950-responder@\${INSTANCE} koha-sip-daemon@\${INSTANCE}")" 12 78
        return 1
    fi
}

# ======================================================================
# 18. CLOCK AND TIMEZONE
# ======================================================================
# Lists valid timezones. Falls back to /usr/share/zoneinfo when timedatectl
# does not work (containers, WSL, systems booted without systemd).
list_timezones() {
    local tz_list
    tz_list=$(timedatectl list-timezones 2>/dev/null)
    if [ -z "$tz_list" ] && [ -d /usr/share/zoneinfo ]; then
        tz_list=$(cd /usr/share/zoneinfo && find . -type f -o -type l 2>/dev/null \
            | sed 's|^\./||' \
            | grep -E '^(Africa|America|Antarctica|Arctic|Asia|Atlantic|Australia|Europe|Indian|Pacific)/[A-Za-z0-9_+/-]+$|^UTC$' \
            | sort -u)
    fi
    [ -z "$tz_list" ] && tz_list="UTC"
    printf '%s\n' "$tz_list"
}

get_current_timezone() {
    local tz=""
    command -v timedatectl >/dev/null 2>&1 && tz=$(timedatectl show -p Timezone --value 2>/dev/null)
    [ -z "$tz" ] && [ -f /etc/timezone ] && tz=$(tr -d '[:space:]' < /etc/timezone)
    [ -z "$tz" ] && [ -L /etc/localtime ] && tz=$(readlink -f /etc/localtime | sed 's|.*/zoneinfo/||')
    printf '%s' "${tz:-UTC}"
}

# Applies a timezone, with a fallback for systems where timedatectl fails.
apply_timezone() {
    local tz="$1"
    [ -n "$tz" ] && [ -f "/usr/share/zoneinfo/$tz" ] || return 1
    if ! timedatectl set-timezone "$tz" >/dev/null 2>&1; then
        ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime || return 1
        printf '%s\n' "$tz" > /etc/timezone
    fi
    log "timezone set to $tz"
    return 0
}

# Prints the chosen timezone on stdout. It is called as $(choose_timezone),
# so stdout is captured: every dialog is therefore drawn on the terminal
# (/dev/tty) and only the answer travels through the pipe. Before, the
# yes/no box was drawn inside the capture, stayed invisible and the
# installation looked frozen.
choose_timezone() {
    local detected_tz tty_dev="/dev/tty"
    detected_tz=$(get_current_timezone)
    [ -r "$tty_dev" ] && [ -w "$tty_dev" ] || { printf '%s' "$detected_tz"; return 0; }

    local ask_msg
    ask_msg="$(t 'Detected system timezone: ${detected_tz}\n\nDo you want to use this timezone?')"
    if whiptail --title "$(t "Timezone Configuration")" --yesno "$ask_msg" 11 70 \
            <"$tty_dev" >"$tty_dev" 2>&1; then
        printf '%s' "$detected_tz"
        return 0
    fi

    local all_tz regions=() reg region_menu=()
    all_tz=$(list_timezones)
    mapfile -t regions < <(printf '%s\n' "$all_tz" | cut -d/ -f1 | sort -u)
    for reg in "${regions[@]}"; do
        [ -n "$reg" ] && region_menu+=("$reg" "")
    done

    local chosen_region chosen_city cities=() city city_menu=()
    while true; do
        chosen_region=$(whiptail --title "$(t "Global Timezone Selection")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Select your region/continent:")" 20 60 12 \
            "${region_menu[@]}" 3>&1 1>"$tty_dev" 2>&3 <"$tty_dev") || return 1
        [ -z "$chosen_region" ] && return 1

        if [ "$chosen_region" = "UTC" ]; then
            printf '%s' "UTC"
            return 0
        fi

        mapfile -t cities < <(printf '%s\n' "$all_tz" | grep "^${chosen_region}/" | sed "s|^${chosen_region}/||" | sort)
        city_menu=()
        for city in "${cities[@]}"; do
            [ -n "$city" ] && city_menu+=("$city" "")
        done
        [ ${#city_menu[@]} -eq 0 ] && continue

        # "Back" returns to the region list instead of cancelling everything.
        chosen_city=$(whiptail --title "$(t "Global Timezone Selection")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Select the closest city/timezone:")" 22 65 14 \
            "${city_menu[@]}" 3>&1 1>"$tty_dev" 2>&3 <"$tty_dev") || continue
        if [ -n "$chosen_city" ]; then
            printf '%s' "${chosen_region}/${chosen_city}"
            return 0
        fi
    done
}

function_configure_clock() {
    local tz
    if tz=$(choose_timezone) && [ -n "$tz" ]; then
        if ! apply_timezone "$tz"; then
            msg_error "" "$(t 'Could not apply the timezone ${tz}.')" 9 70
        fi
    fi
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    systemctl restart cron >/dev/null 2>&1
    local cur_tz cur_time
    cur_tz=$(get_current_timezone)
    cur_time=$(date '+%Y-%m-%d %H:%M')
    msg_ok "$(t 'Timezone set to: ${cur_tz}\nCurrent time: ${cur_time}\n\nCron was restarted to pick up the new time.')" 11 74
}

# ======================================================================
# 19. UPDATE SYSTEM AND SCHEMAS
# ======================================================================
function_update_system() {
    prompt_yes_no "$(t "Update")" \
"$(t "System and Koha packages will be updated and database\nmigrations applied.\n\nRecommended: make a backup first.\n\nContinue?")" 13 74 || return 0
    clear
    # koha-common's own postinst migrates the database during "apt-get
    # upgrade": the verified safety copy must exist before the packages move.
    local cur_tables pre_update
    if is_koha_installed && cur_tables=$(koha_table_count) && [ "$cur_tables" -gt 0 ]; then
        if ! backup_lock_acquire; then
            msg_error "" "$(t "Another backup or restore is already running.\nNothing was changed.")" 10 72
            return 1
        fi
        display_explanation "Generating the backup..."
        pre_update="${DIR_SQL}/PRE-UPDATE_$(date +%Y-%m-%d_%Hh%M%S).sql.gz"
        CLEANUP_FILE="$pre_update"
        if ! create_safety_backup "$pre_update"; then
            CLEANUP_FILE=""
            backup_lock_release
            msg_error "$(t "Safety backup failed")" "$(t 'The safety backup of the current database could not be created or validated (check the free space and ${DIR_SQL}).\n\nNothing was changed.')" 12 76
            return 1
        fi
        CLEANUP_FILE=""
        backup_lock_release
        echo "$(t "Safety backup:") $pre_update"
        log "pre-update safety backup: $pre_update"
    fi
    if ! wait_for_apt_locks; then return 1; fi
    apt_update_indices
    if ! DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}"; then
        restore_apt_timers
        msg_error "" "$(t "Package upgrade failed. Koha migrations will not run.")" 10 76
        return 1
    fi
    if is_koha_installed; then
        display_explanation "Applying database migrations..."
        if ! /usr/sbin/koha-upgrade-schema "$INSTANCE"; then
            restore_apt_timers
            msg_error "" "$(t "Database migration failed. Services will not be restarted automatically to avoid hiding the error.")" 11 78
            return 1
        fi
        if ! systemctl restart memcached apache2 koha-common >/dev/null 2>&1; then
            restore_apt_timers
            msg_error "" "$(t "One of the core services did not restart after the update.")" 9 72
            return 1
        fi
        if ! ensure_koha_services >/dev/null 2>&1 && ! plack_running; then
            restore_apt_timers
            msg_error "" "$(t "Plack did not restart after the update.")" 9 70
            return 1
        fi
        if [ "$(get_search_engine)" = "Elasticsearch" ]; then
            if ! manage_koha_indexers start; then
                restore_apt_timers
                msg_error "" "$(t "The Elasticsearch indexer could not be started after the update.")" 10 76
                return 1
            fi
        else
            zebra_stop
            if ! zebra_start; then
                restore_apt_timers
                msg_error "" "$(t "Zebra could not be started after the update.")" 9 72
                return 1
            fi
            ensure_search_indexing >/dev/null 2>&1
        fi
    fi
    display_explanation "Cleaning orphan packages..."
    apt-get clean -y >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1 || true
    journalctl --vacuum-time=14d >/dev/null 2>&1 || true
    restore_apt_timers
    if validate_complete_system "$(t "system update")"; then
        msg_ok "$(t "Update finished with no critical errors.")" 9 70
    else
        msg_info "$(t "Update with warnings")" "$(t "The update ran but validation found \$V_FAIL failure(s) and \$V_WARN warning(s).\n\nLog: \$VALIDATION_LOG")" 11 76
        show_validation_report
        return 1
    fi
    return 0
}

