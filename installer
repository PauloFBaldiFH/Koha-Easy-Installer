    added=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.letter WHERE message_transport_type = 'sms' AND lang = 'default' AND branchcode = '' AND code IN ($(printf "'%s'," "$@" | sed 's/,$//'));")
