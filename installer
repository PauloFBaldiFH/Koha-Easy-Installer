_lt_msg_letters() {
    local log sql code module added
    log=$(tools_log messaging-notices)
    sql="$TOOLS_WORK/letters.sql"
    {
        printf 'START TRANSACTION;\n'
        for code in "$@"; do
            module=$(printf '%s\n' $MSG_LETTERS | awk -F: -v c="$code" '$1 == c { print $2 }')
            [ -n "$module" ] || continue
            printf "INSERT INTO letter (module, code, branchcode, name, is_html, title, content, message_transport_type, lang) SELECT '%s', '%s', '', COALESCE((SELECT l.name FROM letter l WHERE l.module = '%s' AND l.code = '%s' AND l.branchcode = '' LIMIT 1), '%s'), 0, %s, %s, 'sms', 'default' FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM letter WHERE module = '%s' AND code = '%s' AND branchcode = '' AND message_transport_type = 'sms' AND lang = 'default');\n" \
                "$module" "$code" "$module" "$code" "$code" "$(sql_quote "$code")" "$(sql_quote "$(msg_letter_content "$code")")" "$module" "$code"
        done
        printf 'COMMIT;\n'
    } > "$sql"
    cat "$sql" >> "$log"
    tools_safety_backup NOTICES || return 1
    if ! koha_sql_run "$log" "$sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
