# Link in the staff interface: "Replace the record (MARC file)" in the Edit
# menu of the record page (a marked block in IntranetUserJS).
mr_js_block() {
    local label
    label=$(t "Replace the record (MARC file)")
    label=${label//\\/\\\\}; label=${label//\"/\\\"}; label=${label//</\\u003c}
    cat <<MRJS
${MR_JS_BEGIN}
\$(document).ready(function () {
    var m = location.pathname.match(/\/cgi-bin\/koha\/catalogue\/(detail|MARCdetail|ISBDdetail|labeledMARCdetail|moredetail)\.pl\$/);
    var bn = new URLSearchParams(location.search).get("biblionumber");
    if (!m || !bn || !/^[0-9]+\$/.test(bn)) return;
    var menu = \$("#editbiblio").closest(".dropdown-menu");
    if (!menu.length) return;
    var a = \$("<a class=\"dropdown-item\"></a>").attr("href", "/cgi-bin/koha/tools/marc_replace.pl?biblionumber=" + bn).text("${label}");
    menu.append(\$("<li></li>").append(a));
});
${MR_JS_END}
MRJS
}

# IntranetUserJS as stored (--raw: line breaks and backslashes unescaped).
mr_js_current() {
    mysql --default-character-set=utf8mb4 -N -B --raw -e "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'IntranetUserJS';" 2>/dev/null
}

mr_js_sql() {   # mr_js_sql add|remove FILE: SQL that rewrites IntranetUserJS
    local cur new
    cur=$(mr_js_current)
    cur=$(printf '%s\n' "$cur" | awk -v b="$MR_JS_BEGIN" -v e="$MR_JS_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }')
    new="$cur"
    if [ "$1" = "add" ]; then new="${cur:+${cur}$'\n'}$(mr_js_block)"; fi
    printf "START TRANSACTION;\nUPDATE systempreferences SET value = %s WHERE variable = 'IntranetUserJS';\nCOMMIT;\n" "$(sql_quote "$new")" > "$2"
}

mr_installed() { [ -f "$MR_FILE" ]; }
mr_js_on() { mr_js_current | grep -qxF "$MR_JS_BEGIN"; }

function_marc_replace() {
    require_database || return 0
    local opt status
    while true; do
        if mr_installed; then status="$(t "Installed"): /cgi-bin/koha/tools/marc_replace.pl"; else status="$(t "Not installed.")"; fi
        status+=$'\n'"$(t "Loaded tables"): PHA $(cat_table_count pha), Cutter-Sanborn $(cat_table_count cutter), CDD $(cat_table_count cdd)"
        opt=$(ui_menu "$(t "⇄  Replace a MARC record (staff tool)")" "$(t "A page of the staff interface that replaces a record by its biblionumber with a .mrc or .xml file or pasted text, showing a preview first. The items are never changed and the previous version is saved.")"$'\n\n'"$status" \
            "1" "$(t "Install or update the page")" \
            "2" "$(t "Remove the page")" \
            "3" "$(t "Versions saved by the page")" \
            "4" "$(t "Load a table (PHA, Cutter-Sanborn, CDD)")" \
            "5" "$(t "Remove a table")") || return 0
        case "$opt" in
            1) lt_mr_install ;;
            2) lt_mr_remove ;;
            3) lt_mr_versions ;;
            4) lt_cat_load ;;
            5) lt_cat_remove ;;
        esac
        clear
    done
}

lt_mr_install() {
    if [ ! -d "${KOHA_INTRA_CGI}/tools" ]; then
        msg_error "" "$(t "The staff interface folder of Koha was not found. Nothing was changed.")" 9 72
        return 1
    fi
    local link="no"
    prompt_yes_no "$(t "Replace a MARC record")" "$(t "Also add Replace the record (MARC file) to the Edit menu of the record page? (a marked block in the IntranetUserJS preference, removed with the page; a verified backup is made first)")" 11 76 && link="yes"
    tools_locked _lt_mr_install "$link"
}

_lt_mr_install() {
    local link="$1" log new sql updating=0 url
    log=$(tools_log marc-replace)
    new="$TOOLS_WORK/marc_replace.pl"
    marc_replace_script > "$new"
    chmod 644 "$new"
    mr_pm_vision > "$TOOLS_WORK/Vision.pm"
    mr_pm_rules > "$TOOLS_WORK/Rules.pm"
    chmod 644 "$TOOLS_WORK/Vision.pm" "$TOOLS_WORK/Rules.pm"
    display_explanation "Checking the page with the Perl modules of Koha..."
    # Compiled as the instance user with Koha's libraries before it is installed
    # (the page loads the AI cataloguing modules only when their tabs are used).
    if ! koha_exec "$log" perl-check /usr/bin/perl -c "$new"         || ! koha_exec "$log" perl-check /usr/bin/perl -c "$TOOLS_WORK/Vision.pm"         || ! koha_exec "$log" perl-check /usr/bin/perl -c "$TOOLS_WORK/Rules.pm"; then
        ui_textbox "$(t "Replace a MARC record")" "$log"
        msg_error "" "$(t 'The page does not compile with this version of Koha. Nothing was changed.\n\nLog: ${log}')" 11 74
        return 1
    fi
    mr_installed && updating=1
    mkdir -p "$MR_DIR" && chown "${INSTANCE}-koha:${INSTANCE}-koha" "$MR_DIR" 2>/dev/null
    chmod 750 "$MR_DIR"
    if [ "$link" = "yes" ] && ! mr_js_on; then
        tools_safety_backup MARC-REPLACE || return 1
        sql="$TOOLS_WORK/intranetuserjs.sql"
        mr_js_sql add "$sql"
        if ! koha_sql_run "$log" "$sql"; then
            msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
            return 1
        fi
        memcached_flush || true
    fi
    { mkdir -p "$MR_PM_DIR"         && install -o root -g root -m 644 "$TOOLS_WORK/Vision.pm" "$MR_PM_DIR/Vision.pm.new"         && install -o root -g root -m 644 "$TOOLS_WORK/Rules.pm" "$MR_PM_DIR/Rules.pm.new"         && mv -f "$MR_PM_DIR/Vision.pm.new" "$MR_PM_DIR/Vision.pm"         && mv -f "$MR_PM_DIR/Rules.pm.new" "$MR_PM_DIR/Rules.pm"         && install -o root -g root -m 755 "$new" "${MR_FILE}.new" && mv -f "${MR_FILE}.new" "$MR_FILE"; } || {
        msg_error "" "$(t "The page could not be installed. Nothing was changed.")" 8 64; return 1; }
    printf 'installed=%s\nlink=%s\n' "$(date +%F)" "$link" > "$MR_STATE"
    # Plack keeps compiled pages in memory: an updated page needs a restart.
    [ "$updating" = "1" ] && plack_restart
    url="/cgi-bin/koha/tools/marc_replace.pl"
    log "marc_replace: page installed (link=$link)"
    msg_ok "$(t '✔ Page installed. In the staff interface: ${url}\n\nPrevious versions of the replaced records: ${MR_DIR}')" 11 76
}

lt_mr_remove() {
    mr_installed || mr_js_on || { msg_info "$(t "Replace a MARC record")" "$(t "Not installed.")" 8 60; return 0; }
    prompt_yes_no "$(t "Replace a MARC record")" "$(t 'Remove the page (and its link in the Edit menu)? The versions saved in ${MR_DIR} are kept.')" 10 74 defaultno || return 0
    tools_locked _lt_mr_remove
}

_lt_mr_remove() {
    local log sql
    log=$(tools_log marc-replace)
    if mr_js_on; then
        tools_safety_backup MARC-REPLACE || return 1
        sql="$TOOLS_WORK/intranetuserjs.sql"
        mr_js_sql remove "$sql"
        if ! koha_sql_run "$log" "$sql"; then
            msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
            return 1
        fi
        memcached_flush || true
    fi
    rm -f "$MR_FILE" "$MR_STATE" "$MR_PM_DIR/Vision.pm" "$MR_PM_DIR/Rules.pm"
    rmdir "$MR_PM_DIR" 2>/dev/null || true
    plack_restart
    log "marc_replace: page removed"
    msg_ok "$(t "✔ The page was removed.")"
}

lt_mr_versions() {
    local out
    tools_workdir || return 1
    out="$TOOLS_WORK/versions.txt"
    {
        printf '%s\n%s\n\n' "$(t "Versions saved before each replacement (biblionumber-date-time.xml):")" "$MR_DIR"
        find "$MR_DIR" -maxdepth 1 -name '*.xml' -printf '%TY-%Tm-%Td %TH:%TM  %f\n' 2>/dev/null | sort -r | head -n 200
    } > "$out"
    ui_textbox "$(t "Versions saved by the page")" "$out"
}

