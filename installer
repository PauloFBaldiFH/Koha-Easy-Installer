# Country menu: common calling codes, or any other code.
lt_msg_country() {
    local cc area
    cc=$(ui_menu "$(t "Phone numbers")" "$(t "Country of the numbers typed without a country code:")" \
        "55"  "Brasil" "351" "Portugal" "244" "Angola" "258" "Moçambique" "238" "Cabo Verde" \
        "54"  "Argentina" "595" "Paraguay" "598" "Uruguay" "56" "Chile" "57" "Colombia" \
        "52"  "México" "34" "España" "1" "USA / Canada" "other" "$(t "Other code")") || return 0
    if [ "$cc" = "other" ]; then
        cc=$(ui_input "$(t "Phone numbers")" "$(t "Country calling code (digits only):")" "") || return 0
