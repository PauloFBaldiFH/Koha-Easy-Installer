YAZ_MARCDUMP="yaz-marcdump"
BR_TAG="koha-easy-installer"
KOHA_OPAC_TMPL="/usr/share/koha/opac/htdocs/opac-tmpl/bootstrap"
KOHA_INTRA_TMPL="/usr/share/koha/intranet/htdocs/intranet-tmpl/prog"
