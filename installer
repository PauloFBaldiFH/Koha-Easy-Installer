# ======================================================================
# 18. CLOCK AND TIMEZONE
# ======================================================================
# Lists valid timezones. Falls back to /usr/share/zoneinfo when timedatectl
# does not work (containers, WSL, systems booted without systemd).
list_timezones() {
    local tz_list
    tz_list=$(timedatectl list-timezones 2>/dev/null)
    if [ -z "$tz_list" ] && [ -d /usr/share/zoneinfo ]; then
        tz_list=$(cd /usr/share/zoneinfo && find . -type f -o -type l 2>/dev/null \
            | sed 's|^\./||' \
            | grep -E '^(Africa|America|Antarctica|Arctic|Asia|Atlantic|Australia|Europe|Indian|Pacific)/[A-Za-z0-9_+/-]+$|^UTC$' \
            | sort -u)
    fi
    [ -z "$tz_list" ] && tz_list="UTC"
    printf '%s\n' "$tz_list"
}

get_current_timezone() {
    local tz=""
    command -v timedatectl >/dev/null 2>&1 && tz=$(timedatectl show -p Timezone --value 2>/dev/null)
    [ -z "$tz" ] && [ -f /etc/timezone ] && tz=$(tr -d '[:space:]' < /etc/timezone)
    [ -z "$tz" ] && [ -L /etc/localtime ] && tz=$(readlink -f /etc/localtime | sed 's|.*/zoneinfo/||')
    printf '%s' "${tz:-UTC}"
}

# Applies a timezone, with a fallback for systems where timedatectl fails.
apply_timezone() {
    local tz="$1"
    [ -n "$tz" ] && [ -f "/usr/share/zoneinfo/$tz" ] || return 1
    if ! timedatectl set-timezone "$tz" >/dev/null 2>&1; then
        ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime || return 1
        printf '%s\n' "$tz" > /etc/timezone
    fi
    log "timezone set to $tz"
    return 0
}

# Prints the chosen timezone on stdout. It is called as $(choose_timezone),
# so stdout is captured: every dialog is therefore drawn on the terminal
# (/dev/tty) and only the answer travels through the pipe. Before, the
# yes/no box was drawn inside the capture, stayed invisible and the
# installation looked frozen.
choose_timezone() {
    local detected_tz tty_dev="/dev/tty"
    detected_tz=$(get_current_timezone)
    [ -r "$tty_dev" ] && [ -w "$tty_dev" ] || { printf '%s' "$detected_tz"; return 0; }

    local ask_msg
    ask_msg="$(t 'Detected system timezone: ${detected_tz}\n\nDo you want to use this timezone?')"
    if whiptail --title "$(t "Timezone Configuration")" --yesno "$ask_msg" 11 70 \
            <"$tty_dev" >"$tty_dev" 2>&1; then
        printf '%s' "$detected_tz"
        return 0
    fi

    local all_tz regions=() reg region_menu=()
    all_tz=$(list_timezones)
    mapfile -t regions < <(printf '%s\n' "$all_tz" | cut -d/ -f1 | sort -u)
    for reg in "${regions[@]}"; do
        [ -n "$reg" ] && region_menu+=("$reg" "")
    done

    local chosen_region chosen_city cities=() city city_menu=()
    while true; do
        chosen_region=$(whiptail --title "$(t "Global Timezone Selection")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Select your region/continent:")" 20 60 12 \
            "${region_menu[@]}" 3>&1 1>"$tty_dev" 2>&3 <"$tty_dev") || return 1
        [ -z "$chosen_region" ] && return 1

        if [ "$chosen_region" = "UTC" ]; then
            printf '%s' "UTC"
            return 0
        fi

        mapfile -t cities < <(printf '%s\n' "$all_tz" | grep "^${chosen_region}/" | sed "s|^${chosen_region}/||" | sort)
        city_menu=()
        for city in "${cities[@]}"; do
            [ -n "$city" ] && city_menu+=("$city" "")
        done
        [ ${#city_menu[@]} -eq 0 ] && continue

        # "Back" returns to the region list instead of cancelling everything.
        chosen_city=$(whiptail --title "$(t "Global Timezone Selection")" \
            --cancel-button "$(t "Back")" \
            --menu "$(t "Select the closest city/timezone:")" 22 65 14 \
            "${city_menu[@]}" 3>&1 1>"$tty_dev" 2>&3 <"$tty_dev") || continue
        if [ -n "$chosen_city" ]; then
            printf '%s' "${chosen_region}/${chosen_city}"
            return 0
        fi
    done
}

function_configure_clock() {
    local tz
    if tz=$(choose_timezone) && [ -n "$tz" ]; then
        if ! apply_timezone "$tz"; then
            msg_error "" "$(t 'Could not apply the timezone ${tz}.')" 9 70
        fi
    fi
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1
    systemctl restart cron >/dev/null 2>&1
    local cur_tz cur_time
    cur_tz=$(get_current_timezone)
    cur_time=$(date '+%Y-%m-%d %H:%M')
    msg_ok "$(t 'Timezone set to: ${cur_tz}\nCurrent time: ${cur_time}\n\nCron was restarted to pick up the new time.')" 11 74
}

