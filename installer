# ======================================================================
PANEL_LOCK_FILE="/var/run/koha_panel.lock"

exec 9> "$PANEL_LOCK_FILE"
if ! flock -n 9; then
    echo "$(t "The panel is already running in another session. Aborting to prevent conflicts.")"
    exit 1
fi

# ======================================================================
# 5. EXECUTION LOCKS (PID BASED) - BACKUP ONLY
# ======================================================================
BACKUP_LOCK_FILE="/var/run/koha_backup.pid"
backup_lock_acquire() {
    if [ -f "$BACKUP_LOCK_FILE" ]; then
        local b_pid
        b_pid=$(cat "$BACKUP_LOCK_FILE" 2>/dev/null | tr -dc '0-9')
        if [ -n "$b_pid" ] && kill -0 "$b_pid" 2>/dev/null; then
            return 1
        fi
    fi
    echo $$ > "$BACKUP_LOCK_FILE"
    return 0
}
backup_lock_release() {
    rm -f "$BACKUP_LOCK_FILE" 2>/dev/null || true
}

