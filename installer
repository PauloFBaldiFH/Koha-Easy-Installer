# Short SMS versions of the circulation notices, in the panel language.
# {library}, {title}, {name}, {items} become Koha template tags.
msg_letter_content() {
    local s
    case "$1" in
        CHECKOUT) s="$(t "{library}: you borrowed {title}. Thank you for your visit!")" ;;
        CHECKIN)  s="$(t "{library}: {title} was returned. Thank you!")" ;;
        ODUE)     s="$(t "{name}, these items are overdue at {library}: {items}Please return or renew them.")" ;;
        PREDUE)   s="$(t "{name}, {title} is due soon. {library}")" ;;
        DUE)      s="$(t "{name}, {title} is due today. {library}")" ;;
        HOLD)     s="$(t "{name}, your hold {title} is waiting for you at {library}.")" ;;
    esac
    local nl=$'\n' lib="[% branch.branchname %]" name="[% borrower.firstname %]" title="[% biblio.title %]" items
    items="${nl}[% FOREACH overdue IN overdues %]- [% overdue.item.biblio.title %] ([% overdue.date_due | \$KohaDates %])${nl}[% END %]"
    s="${s//\{library\}/$lib}"
    s="${s//\{name\}/$name}"
    s="${s//\{title\}/$title}"
    s="${s//\{items\}/$items}"
    [ "$1" = "ODUE" ] && s="[%- USE KohaDates -%]${s}"
    printf '%s' "$s"
}
MSG_LETTERS="CHECKOUT:circulation CHECKIN:circulation ODUE:circulation PREDUE:circulation DUE:circulation HOLD:reserves"

lt_msg_check() {
