lt_patron_category() {
    require_database || return 0
    local sql from to rule day="" branch
    sql="SELECT categorycode, description FROM ${DB_NAME}.categories ORDER BY description;"
    from=$(tools_pick "$(t "School-year turnover")" "$(t "Move patrons FROM the category:")" "$sql") || return 0
    to=$(tools_pick "$(t "School-year turnover")" "$(t "TO the category:")" "$sql") || return 0
    if [ "$from" = "$to" ]; then
        msg_error "" "$(t "Pick two different categories.\nNothing was changed.")" 9 60
        return 1
    fi
    rule=$(ui_menu "$(t "School-year turnover")" "$(t 'Which patrons of ${from}?')" \
        "all"  "$(t "All of them")" \
        "age"  "$(t "Only those older than the category's age limit")" \
        "date" "$(t "Only those registered before a date")") || return 0
    if [ "$rule" = "date" ]; then
