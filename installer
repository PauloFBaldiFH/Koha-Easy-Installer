# ======================================================================
# 6.5. PLATFORM: LINUX SERVER OR WINDOWS (WSL)
# ----------------------------------------------------------------------
# On Windows the panel runs inside WSL 2. Windows then owns the host:
# swap (.wslconfig), clock, firewall, startup and reboot. Call sites ask
# "host_can <capability>" instead of testing the platform, so the rules
# live in one place.
#   KEI_PLATFORM   linux | wsl2 | wsl1
#   KEI_WSL_NET    mirrored | nat | unknown   (WSL networking mode)
# The Windows installer writes $KEI_WIN_CONF (key=value). It is parsed with
# a whitelist and never sourced.
# ======================================================================
KEI_PROC="${KEI_PROC:-/proc}"
KEI_SYSTEMD_RUNDIR="${KEI_SYSTEMD_RUNDIR:-/run/systemd/system}"
KEI_WIN_CONF="${KEI_WIN_CONF:-${CONF_DIR}/windows.conf}"
KEI_WSL_CONF="${KEI_WSL_CONF:-/etc/wsl.conf}"
KEI_WIN_KEYS="KEI_WIN_VERSION WIN_BUILD WIN_EDITION WIN_NET_MODE WIN_LAN_IP WIN_HOSTNAME WIN_USER WIN_BACKUP_DIR WIN_MEM_GB WIN_UPDATED_AT WIN_AUTOSTART"
KEI_PLATFORM="linux"
KEI_WSL_NET=""

# Prints linux, wsl1 or wsl2. WSL 1 kernels end in "-Microsoft"
# (4.4.0-19041-Microsoft); WSL 2 kernels contain "microsoft-standard-WSL2",
# and custom WSL 2 kernels at least "microsoft" or the WSLInterop handler.
# WSL_DISTRO_NAME is not used: sudo, cron and systemd units drop it.
_detect_platform_kind() {
    case "${KEI_PLATFORM_OVERRIDE:-}" in
        linux|wsl1|wsl2) printf '%s' "$KEI_PLATFORM_OVERRIDE"; return 0 ;;
    esac
    local kernel="" f
    [ -r "$KEI_PROC/sys/kernel/osrelease" ] && kernel=$(head -c 200 "$KEI_PROC/sys/kernel/osrelease" 2>/dev/null)
    case "$kernel" in
        *-Microsoft) printf 'wsl1'; return 0 ;;
        *[Mm]icrosoft*|*WSL2*) printf 'wsl2'; return 0 ;;
    esac
    for f in "$KEI_PROC"/sys/fs/binfmt_misc/WSLInterop*; do
        [ -e "$f" ] && { printf 'wsl2'; return 0; }
    done
    printf 'linux'
}

# WSL networking mode guessed from the default gateway ($1), for when the
# Windows installer left no windows.conf: NAT puts WSL behind a virtual
# switch in 172.16.0.0/12; mirrored mode shares the LAN router of Windows.
_wsl_net_from_gateway() {
    case "$1" in
        "") printf 'unknown' ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) printf 'nat' ;;
        *) printf 'mirrored' ;;
    esac
}

# Checks one windows.conf value; an invalid value is dropped (left empty).
_win_conf_valid() {
    local key="$1" val="$2"
    case "$key" in
        WIN_NET_MODE)   [[ "$val" == mirrored || "$val" == nat ]] ;;
        WIN_AUTOSTART)  [[ "$val" == logon || "$val" == manual ]] ;;
        WIN_BUILD|WIN_MEM_GB) [[ "$val" =~ ^[0-9]{1,6}$ ]] ;;
        WIN_LAN_IP)     [[ "$val" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] ;;
        WIN_HOSTNAME)   [[ "$val" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,62})$ ]] ;;
        WIN_USER)       [[ "$val" =~ ^[A-Za-z0-9._\ -]{1,64}$ && "$val" != *..* ]] ;;
        WIN_BACKUP_DIR) [[ "$val" =~ ^/mnt/[a-z]/[A-Za-z0-9._/\ -]*$ && "$val" != *..* ]] ;;
        *)              [ "${#val}" -le 64 ] ;;
    esac
}

# Reads the Windows handshake file ($1, default $KEI_WIN_CONF) into the
# WIN_* variables named in KEI_WIN_KEYS. Only KEY=value lines with a known
# key and plain characters are taken; everything else is logged and
# skipped. The file must be a regular file owned by root and not writable
# by others (it describes the host the panel trusts). Returns 1 when the
# file is missing or refused.
read_windows_conf() {
    local file="${1:-$KEI_WIN_CONF}" key val line n=0 owner mode
    local re='^([A-Z][A-Z_]*)=([A-Za-z0-9._:/ -]*)$'
    for key in $KEI_WIN_KEYS; do printf -v "$key" '%s' ""; done
    [ -f "$file" ] && [ ! -L "$file" ] && [ -r "$file" ] || return 1
    read -r owner mode < <(stat -c '%u %a' "$file" 2>/dev/null)
    if [ "${owner:-x}" != "0" ] || [ -z "$mode" ] || (( (8#$mode & 8#022) != 0 )); then
        log "windows.conf refused: owner ${owner:-?}, mode ${mode:-?} (must be root and not writable by others)"
        return 1
    fi
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        [ "$n" -gt 200 ] && break
        [ "$n" -eq 1 ] && line="${line#$'\xEF\xBB\xBF'}"   # BOM of Windows PowerShell 5.1
        line="${line%$'\r'}"
        case "$line" in ''|'#'*) continue ;; esac
        if [[ ! "$line" =~ $re ]]; then
            log "windows.conf: line $n ignored (not KEY=value with plain characters)"
            continue
        fi
        key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
        if [[ " $KEI_WIN_KEYS " != *" $key "* ]]; then
            log "windows.conf: unknown key ignored: $key"
        elif ! _win_conf_valid "$key" "$val"; then
            log "windows.conf: invalid value ignored for $key"
        else
            printf -v "$key" '%s' "$val"
        fi
    done < "$file"
    return 0
}

detect_platform() {
    local gw=""
    KEI_PLATFORM=$(_detect_platform_kind)
    KEI_WSL_NET=""
    [ "$KEI_PLATFORM" = "linux" ] && return 0
    read_windows_conf "$KEI_WIN_CONF" || true
    if [ -n "${WIN_NET_MODE:-}" ]; then
        KEI_WSL_NET="$WIN_NET_MODE"
    else
        command -v ip >/dev/null 2>&1 && gw=$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')
        KEI_WSL_NET=$(_wsl_net_from_gateway "$gw")
    fi
    log "platform: $KEI_PLATFORM (network: $KEI_WSL_NET, Windows build: ${WIN_BUILD:-?})"
}

is_wsl() { [ "$KEI_PLATFORM" != "linux" ]; }

# host_can CAPABILITY: may the panel manage this part of the host?
#   swap      create /swapfile          ntp       NTP sync (timesyncd)
#   timezone  change the timezone       firewall  UFW
#   fail2ban  Fail2ban jails            mdns      avahi-daemon
#   reboot    reboot the machine        lan_direct other PCs reach ports 80/8080
# Unknown capabilities are a programming error: logged, answer "no" (2).
host_can() {
    case "$1" in
        swap|ntp|timezone|firewall|fail2ban|mdns|reboot|lan_direct) ;;
        *) log "host_can: unknown capability '$1'"; return 2 ;;
    esac
    [ "$KEI_PLATFORM" = "linux" ] && return 0
    [ "$1" = "lan_direct" ] && [ "$KEI_WSL_NET" = "mirrored" ] && return 0
    # The zone inside Debian is the panel's to set (apply_timezone keeps WSL
    # from putting Windows' zone back at the next start).
    [ "$1" = "timezone" ] && return 0
    return 1
}

