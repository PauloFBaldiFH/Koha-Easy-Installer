}

_lt_patron_category_run() {
    local from="$1" to="$2" log found moved
    local args=(--from "$1" --to "$2" -v)
    case "$3" in
        age)  args+=(--too_old) ;;
        date) args+=(--regbefore "$4") ;;
    esac
    [ "$5" != "*" ] && args+=(--branch "$5")
    log=$(tools_log patron-category)
    display_explanation "Preview (dry run): nothing is changed yet..."
