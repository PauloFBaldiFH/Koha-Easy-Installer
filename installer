# Errors are handled explicitly (no "set -e"): whiptail returns non-zero
# for "Cancel"/"No", and every one of those would otherwise end the panel.
set -o pipefail
umask 022
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# Every screen is drawn in UTF-8. A shell started by wsl.exe, cron or a bare
# SSH session can arrive without any locale; the dialogs then print accents
# and symbols byte by byte, as garbage (â†’ for →). C.UTF-8 is built into
# Debian's libc: no locale package is needed. When even that fails, the
# panel falls back to plain ASCII symbols (KEI_PLAIN_GLYPHS, below).
kei_is_utf8() { case "$(locale charmap 2>/dev/null)" in UTF-8|utf-8|utf8) return 0 ;; esac; return 1; }
if ! kei_is_utf8; then
    if [ -n "${LC_ALL:-}" ]; then export LC_ALL=C.UTF-8; else export LC_CTYPE=C.UTF-8; fi
    kei_is_utf8 || KEI_PLAIN_GLYPHS=1
fi

# ======================================================================
# 1. CLEANUP ON EXIT (Declarado ANTES do trap)
# ======================================================================
APT_TIMERS_STOPPED="no"
restore_apt_timers() {
    [ "$APT_TIMERS_STOPPED" = "yes" ] || return 0
    systemctl start apt-daily.timer apt-daily-upgrade.timer unattended-upgrades >/dev/null 2>&1
    APT_TIMERS_STOPPED="no"
}
# Leftovers of a restore or backup test interrupted before it touched the
# catalog: the temporary database, a partial file and the maintenance
# marker that keeps the indexing watchdogs away.
RESTORE_TRIAL_DB=""
CLEANUP_FILE=""
MAINT_MARKER_OWNED=""
TOOLS_WORK=""
on_exit() {
    restore_apt_timers
    [ -n "$RESTORE_TRIAL_DB" ] && mysql -e "DROP DATABASE IF EXISTS \`${RESTORE_TRIAL_DB}\`;" >/dev/null 2>&1
    [ -n "$CLEANUP_FILE" ] && rm -f "$CLEANUP_FILE"
    [ -n "$MAINT_MARKER_OWNED" ] && rm -f "$MAINT_MARKER_OWNED"
    case "$TOOLS_WORK" in /tmp/koha_tools.?*) rm -rf "$TOOLS_WORK" ;; esac
    rm -f /tmp/koha_tmp_* 2>/dev/null || true
    # No colour or attribute of the dialogs is left behind in the shell.
    [ -t 1 ] && printf '\033[0m'
    return 0
}
# CTRL+C only returns to the menu inside screens that explicitly allow it
# (live log viewer, token prompts). Anywhere else it aborts the panel, so an
# interrupted installation never keeps running the next steps half-configured.
ALLOW_CTRL_C_RETURN=0
on_interrupt() {
    [ "$ALLOW_CTRL_C_RETURN" = "1" ] && return 0
    echo ""
    exit 130
}
SIGNALS_SHIELDED=0
unshield_signals() {
    trap on_interrupt INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    SIGNALS_SHIELDED=0
}
# While the live catalog is being replaced, an interruption (CTRL+C, lost
# SSH connection, kill) would leave Koha without a database. The signals are
# ignored until the restore reaches a consistent state; the commands started
# meanwhile inherit the ignored signals (mysql also gets --sigint-ignore).
shield_signals() { trap '' INT TERM HUP; SIGNALS_SHIELDED=1; }
trap on_exit EXIT
unshield_signals

