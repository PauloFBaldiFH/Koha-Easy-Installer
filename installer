# 30. BRAZIL: LOCALIZATION & MIGRATION (opt-in)
# ----------------------------------------------------------------------
# Presets for Brazilian libraries: migration from Biblivre, SophiA and
# Pergamum, CPF checks, Pimaco label templates, the catalogue card (ficha
# catalográfica) and the national holidays. Nothing here runs during the
# installation or by itself: every tool is started from Library tools >
# Brazil and follows the rules of the other tools (Koha's own programs
# through koha-shell, the backup/restore lock, a preview, an explicit
# confirmation and a verified PRE-* backup before any write).
# ======================================================================
YAZ_MARCDUMP="yaz-marcdump"
BR_TAG="koha-easy-installer"
KOHA_OPAC_TMPL="/usr/share/koha/opac/htdocs/opac-tmpl/bootstrap"
KOHA_INTRA_TMPL="/usr/share/koha/intranet/htdocs/intranet-tmpl/prog"
FICHA_DIR="/var/lib/koha/${INSTANCE}/kei-xslt"
FICHA_STATE="${CONF_DIR}/ficha.state"

file_is_utf8() { iconv -f UTF-8 -t UTF-8 "$1" >/dev/null 2>&1; }
marc_count()   { tr -cd '\035' < "$1" | wc -c; }
xml_escape()   { local s="${1//&/&amp;}"; s="${s//</&lt;}"; printf '%s' "${s//>/&gt;}"; }

# Koha keeps system preferences and the calendar in Memcached: after a
# direct change the cached copies are dropped (flush_all, no restart).
memcached_flush() {
    local reply=""
    { exec 6<>/dev/tcp/127.0.0.1/11211; } 2>/dev/null || return 1
    printf 'flush_all\r\n' >&6
    IFS= read -r -t 3 reply <&6
    exec 6>&-
    [[ "$reply" == OK* ]]
}

# yaz-marcdump (package yaz, also used by Koha's Zebra) converts the
# character set of ISO 2709 files and recomputes their record lengths.
require_yaz() {
    command -v "$YAZ_MARCDUMP" >/dev/null 2>&1 && return 0
    prompt_yes_no "$(t "Missing tool")" "$(t "The MARC conversion needs yaz-marcdump (package yaz, the same toolkit Koha uses for Zebra).\n\nInstall it now?")" 11 72 || return 1
    apt_install yaz >/dev/null 2>&1
    command -v "$YAZ_MARCDUMP" >/dev/null 2>&1 && return 0
    msg_error "" "$(t "The yaz package could not be installed. Nothing was changed.")" 9 70
    return 1
}

# ----------------------------------------------------------------------
# CPF (Brazilian taxpayer number): modulo-11 check digits. One awk function
# used by the validator, the patron converter and the CPF report.
# ----------------------------------------------------------------------
CPF_AWK='function cpf_ok(s,   i, sum, r, same) {
    gsub(/[^0-9]/, "", s)
    if (length(s) != 11) return 0
    same = 1
    for (i = 2; i <= 11; i++) if (substr(s, i, 1) != substr(s, 1, 1)) same = 0
    if (same) return 0
    sum = 0
    for (i = 1; i <= 9; i++) sum += substr(s, i, 1) * (11 - i)
    r = (sum * 10) % 11; if (r == 10) r = 0
    if (r != substr(s, 10, 1) + 0) return 0
    sum = 0
    for (i = 1; i <= 10; i++) sum += substr(s, i, 1) * (12 - i)
    r = (sum * 10) % 11; if (r == 10) r = 0
    return r == substr(s, 11, 1) + 0
}'
# cpf_valid VALUE: 0 when VALUE (digits, dots and dash allowed) is a valid CPF.
cpf_valid() {
    [[ "$1" =~ ^[0-9]{3}\.?[0-9]{3}\.?[0-9]{3}-?[0-9]{2}$ ]] || return 1
    awk -v s="$1" "$CPF_AWK"' BEGIN { exit !cpf_ok(s) }'
}

# ----------------------------------------------------------------------
# 1. Legacy migration: MARC export -> UTF-8 (yaz-marcdump) -> items moved
#    to 952 (MARC::Record, as the instance user) -> Koha's staged import.
# ----------------------------------------------------------------------
# br_preset NAME: item field, 952 subfield map and record call number of a
# legacy export. They follow the usual export layouts; the preview shows
# the result on the real file before anything is written, and "custom"
# takes any other layout ("949 p=a,o=b+c": 952$p from $a, 952$o from $b $c).
br_preset() {
    BR_CN="090:ab|082:a"
    case "$1" in
        biblivre) BR_ITEM_TAG=949; BR_MAP="p=a" ;;
        pergamum) BR_ITEM_TAG=852; BR_MAP="p=p,o=h+i,t=t,z=z,x=x" ;;
        sophia)   BR_ITEM_TAG=990; BR_MAP="p=a,o=b" ;;
        *)
            [[ "$1" =~ ^([0-9]{3})\ ([a-z0-9]=[a-z0-9](\+[a-z0-9])*(,[a-z0-9]=[a-z0-9](\+[a-z0-9])*)*)$ ]] || return 1
            [ "${BASH_REMATCH[1]}" != "952" ] && [ "${BASH_REMATCH[1]}" -ge 10 ] || return 1
            BR_ITEM_TAG="${BASH_REMATCH[1]}"; BR_MAP="${BASH_REMATCH[2]}" ;;
    esac
    return 0
}

# The MARC::Record program that moves the items (written next to the file).
br_write_remapper() {
    cat > "$1" <<'MARCPL'
use strict;
use warnings;
use Getopt::Long;
use MARC::File::USMARC;
use MARC::Field;

# koha-easy-installer: moves the item fields of a legacy export (one item
# per occurrence of --item-tag) into Koha's 952. --map "p=a,o=h+i" builds
# 952$p from $a and 952$o from $h and $i; --callnumber "090:ab|082:a" is the
# record call number used when the item has none. 952$a/$b (library) and
# $y (item type) come from --branch and --itype. Records that already have
# a 952 are kept as they are.
my %o = ( map => '', callnumber => '', sample => 3, branch => '', itype => '' );
GetOptions( \%o, 'in=s', 'out=s', 'item-tag=s', 'map=s', 'callnumber=s',
    'branch=s', 'itype=s', 'dry-run', 'sample=i' ) or exit 2;
die "usage: --in FILE --item-tag TAG --branch CODE (--out FILE | --dry-run)\n"
    unless $o{in} && $o{'item-tag'} && $o{branch} && ( $o{'dry-run'} || $o{out} );

my @map = grep { $_->[0] !~ /^[aby]$/ } map { [ split /=/, $_, 2 ] } grep { /^[a-z0-9]=[a-z0-9+]+$/ } split /,/, $o{map};
my @cn  = map { [ split /:/, $_, 2 ] } grep { /^\d{3}:[a-z0-9]+$/ } split /\|/, $o{callnumber};

sub values_of {
    my ( $field, $codes ) = @_;
    my $v = join ' ', grep { defined && length } map { $field->subfield($_) } @$codes;
    $v =~ s/^\s+|\s+$//g;
    return $v;
}

sub callnumber {
    my ($rec) = @_;
    for my $c (@cn) {
        for my $f ( $rec->field( $c->[0] ) ) {
            next if $f->is_control_field;
            my $v = values_of( $f, [ split //, $c->[1] ] );
            return $v if length $v;
        }
    }
    return '';
}

my $in = MARC::File::USMARC->in( $o{in} ) or die "cannot read $o{in}\n";
my $out;
unless ( $o{'dry-run'} ) {
    open( $out, '>', $o{out} ) or die "cannot write $o{out}: $!\n";
    binmode $out;
}
binmode STDOUT, ':encoding(UTF-8)';

my %n = map { $_ => 0 } qw(records converted items no_barcode kept_952 errors);
my @sample;
while (1) {
    my $rec = eval { $in->next };
    if ($@) { $n{errors}++; next; }
    last unless $rec;
    $n{records}++;
    my @new;
    if ( $rec->field('952') ) {
        $n{kept_952}++;
    } else {
        my @src = grep { !$_->is_control_field } $rec->field( $o{'item-tag'} );
        my $cn  = callnumber($rec);
        for my $f (@src) {
            my %s;
            for my $m (@map) {
                my $v = values_of( $f, [ split /\+/, $m->[1] ] );
                $s{ $m->[0] } = $v if length $v;
            }
            $s{o} = $cn if !defined $s{o} && length $cn;
            $n{no_barcode}++ unless defined $s{p};
            my @subs = ( a => $o{branch}, b => $o{branch} );
            push @subs, y => $o{itype} if length $o{itype};
            push @subs, map { ( $_ => $s{$_} ) } sort keys %s;
            push @new, MARC::Field->new( '952', ' ', ' ', @subs );
        }
        if (@new) {
            $rec->delete_fields(@src);
            # insert_fields_ordered puts a field before those with the same tag
            $rec->insert_fields_ordered($_) for reverse @new;
            $n{converted}++;
            $n{items} += @new;
        }
    }
    push @sample, $rec->as_formatted if @new && @sample < $o{sample};
    next if $o{'dry-run'};
    my $raw = $rec->as_usmarc;
    utf8::encode($raw) if utf8::is_utf8($raw);
    print {$out} $raw;
}
close $out if $out;

print "Records read: $n{records}\n";
print "Records with new 952 items: $n{converted}\n";
print "Items created: $n{items}\n";
print "Items without barcode: $n{no_barcode}\n";
print "Records that already had 952 (kept): $n{kept_952}\n";
print "Unreadable records: $n{errors}\n";
print "\n--- Sample ---\n", join( "\n\n", @sample ), "\n" if @sample;
exit( $n{records} ? 0 : 1 );
MARCPL
    chmod 644 "$1"
}

lt_br_migrate_marc() {
    require_database || return 0
    local file preset spec guess enc branch itype mode encs=()
    file=$(select_file "/root" "mrc iso marc" "$(t "Pick the MARC export of the old system (.mrc or .iso):")" "$(t "MARC file")") || return 0
    if [ ! -r "$file" ] || [ ! -s "$file" ]; then
        msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70
        return 1
    fi
    if ! [[ "$(head -c 5 "$file")" =~ ^[0-9]{5}$ ]]; then
        msg_error "" "$(t "This is not an ISO 2709 MARC file (it must start with the 5-digit record length).\nNothing was changed.")" 10 74
        return 1
    fi
    preset=$(ui_menu "$(t "Legacy migration")" "$(t "Which system exported the file? (the preview shows the result before anything is written)")" \
        "biblivre" "Biblivre (949 \$a)" \
        "pergamum" "Pergamum (852, MARC 21 holdings)" \
        "sophia"   "SophiA (990 \$a \$b)" \
        "custom"   "$(t "Other layout (type the field map)")") || return 0
    if [ "$preset" = "custom" ]; then
        spec=$(ui_input "$(t "Legacy migration")" "$(t "Item field and 952 map, e.g. 949 p=a,o=b+c\n(in 952: p = barcode, o = call number, t = copy, z = public note; library and item type are asked next)")" "949 p=a") || return 0
        if ! br_preset "$spec"; then
            msg_error "" "$(t "Invalid field map. Use: TAG p=a,o=b+c\nNothing was changed.")" 9 70
            return 1
        fi
    else
        br_preset "$preset"
    fi
    # Old systems export either UTF-8 without the leader flag or Latin-1.
    if file_is_utf8 "$file"; then
        guess="UTF-8"; encs=("UTF-8" "Unicode" "ISO-8859-1" "Latin-1 / Windows" "MARC-8" "MARC-8 (ANSEL)")
    else
        guess="ISO-8859-1"; encs=("ISO-8859-1" "Latin-1 / Windows" "UTF-8" "Unicode" "MARC-8" "MARC-8 (ANSEL)")
    fi
    enc=$(ui_menu "$(t "Character encoding")" "$(t 'Encoding of the records (the file says: ${guess}):')" "${encs[@]}") || return 0
    branch=$(tools_pick "$(t "Legacy migration")" "$(t "Library of the items:")" "SELECT branchcode, branchname FROM ${DB_NAME}.branches ORDER BY branchname;") || return 0
    itype=$(tools_pick "$(t "Legacy migration")" "$(t "Item type of the items:")" "SELECT itemtype, description FROM ${DB_NAME}.itemtypes ORDER BY description;") || return 0
    mode=$(ui_menu "$(t "Records already in the catalog")" "$(t "When an incoming record matches one in the catalog (ISBN and title):")" \
        "keep"    "$(t "Keep the catalog record, add only new items")" \
        "replace" "$(t "Replace the catalog record with the incoming one")" \
        "new"     "$(t "Do not compare: every record becomes a new title")") || return 0
    require_yaz || return 1
    tools_workdir || return 1
    _lt_br_migrate_run "$file" "$enc" "$branch" "$itype" "$mode"
}

_lt_br_migrate_run() {
    local file="$1" enc="$2" branch="$3" itype="$4" mode="$5" log name utf8 out script n_in n_out recs items
    local args=()
    log=$(tools_log migrate-marc)
    name="${file##*/}"; name="${name%.*}"; name="${name//[^A-Za-z0-9._-]/_}"
    utf8="${TOOLS_WORK}/${name}-utf8.mrc"; out="${TOOLS_WORK}/${name}-koha.mrc"; script="${TOOLS_WORK}/remap952.pl"
    display_explanation "Converting the characters to UTF-8..."
    printf '$ %s -f %s -t UTF-8 -l 9=97 %s\n' "$YAZ_MARCDUMP" "$enc" "$file" >> "$log"
    "$YAZ_MARCDUMP" -i marc -o marc -f "$enc" -t UTF-8 -l 9=97 "$file" > "$utf8" 2>> "$log"
    n_in=$(marc_count "$file"); n_out=$(marc_count "$utf8")
    if [ "$n_out" -eq 0 ] || [ "$n_out" -ne "$n_in" ] || ! file_is_utf8 "$utf8"; then
        msg_error "" "$(t 'The character conversion failed (${n_out} of ${n_in} records). Nothing was changed.\n\nLog: ${log}')" 11 76
        return 1
    fi
    chown "${INSTANCE}-koha:" "$utf8" 2>/dev/null || true
    chmod 600 "$utf8"
    br_write_remapper "$script"
    args=(--in "$utf8" --item-tag "$BR_ITEM_TAG" --map "$BR_MAP" --callnumber "$BR_CN" --branch "$branch" --itype "$itype")
    display_explanation "Preview (dry run): nothing is changed yet..."
    if ! koha_exec "$log" remap952 /usr/bin/perl "$script" "${args[@]}" --dry-run; then
        ui_textbox "$(t "Legacy migration")" "$log"
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    recs=$(tools_num "$log" "Records read:"); items=$(tools_num "$log" "Items created:")
    ui_textbox "$(t "Preview (dry run)")" "$log"
    prompt_yes_no "$(t "Legacy migration")" "$(t 'Records: ${recs}\nItems moved to 952: ${items}\n\nConvert the file and go on to the MARC import? Nothing enters the catalog before you confirm the import.')" 13 72 defaultno || return 0
    if ! koha_exec "$log" remap952 /usr/bin/perl "$script" "${args[@]}" --out "$out" || [ ! -s "$out" ]; then
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    log "tools: legacy MARC converted ($recs records, $items items, map $BR_ITEM_TAG $BR_MAP)"
    tools_locked _lt_marc_import_run "$out" "ISO2709" "UTF-8" "$mode"
}

# ----------------------------------------------------------------------
# Legacy patron spreadsheets -> import_patrons.pl CSV (with CPF checks).
# Columns are recognised by their usual Portuguese or English names.
# ----------------------------------------------------------------------
br_patrons_awk() {
    cat <<'PATAWK'
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function csvq(s) { gsub(/"/, "\"\"", s); return "\"" s "\"" }
function csv_split(line, f, sep,   n, i, c, q, cur, len) {
    split("", f)
    n = 0; cur = ""; q = 0; len = length(line)
    for (i = 1; i <= len; i++) {
        c = substr(line, i, 1)
        if (q) {
            if (c == "\"") { if (substr(line, i + 1, 1) == "\"") { cur = cur "\""; i++ } else q = 0 }
            else cur = cur c
        } else if (c == "\"") q = 1
        else if (c == sep) { f[++n] = cur; cur = "" }
        else cur = cur c
    }
    f[++n] = cur
    return n
}
function norm(s) {
    s = tolower(trim(s))
    gsub(/á|à|â|ã|ä|Á|À|Â|Ã|Ä/, "a", s); gsub(/é|ê|ë|É|Ê|Ë/, "e", s); gsub(/í|ï|Í|Ï/, "i", s)
    gsub(/ó|ô|õ|ö|Ó|Ô|Õ|Ö/, "o", s); gsub(/ú|ü|Ú|Ü/, "u", s); gsub(/ç|Ç/, "c", s)
    gsub(/[._:#º°ª()\/-]/, " ", s); gsub(/  +/, " ", s)
    return trim(s)
}
function iso_date(s,   d) {
    s = trim(s)
    if (s ~ /^[0-9][0-9]?\/[0-9][0-9]?\/[0-9][0-9][0-9][0-9]$/) { split(s, d, "/"); return sprintf("%04d-%02d-%02d", d[3], d[2], d[1]) }
    if (s ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return s
    return ""
}
BEGIN {
    alias["cardnumber"] = "cardnumber"; alias["matricula"] = "cardnumber"; alias["cartao"] = "cardnumber"
    alias["carteirinha"] = "cardnumber"; alias["n cartao"] = "cardnumber"; alias["numero do cartao"] = "cardnumber"
    alias["codigo"] = "cardnumber"; alias["codigo do leitor"] = "cardnumber"; alias["codigo do usuario"] = "cardnumber"
    alias["id"] = "cardnumber"; alias["registro"] = "cardnumber"; alias["ra"] = "cardnumber"; alias["prontuario"] = "cardnumber"
    alias["nome"] = "fullname"; alias["nome completo"] = "fullname"; alias["name"] = "fullname"; alias["leitor"] = "fullname"
    alias["usuario"] = "fullname"; alias["nome do leitor"] = "fullname"; alias["nome do usuario"] = "fullname"
    alias["surname"] = "surname"; alias["sobrenome"] = "surname"
    alias["firstname"] = "firstname"; alias["primeiro nome"] = "firstname"; alias["prenome"] = "firstname"
    alias["cpf"] = "cpf"; alias["n cpf"] = "cpf"; alias["numero do cpf"] = "cpf"; alias["cpf do leitor"] = "cpf"; alias["documento"] = "cpf"
    alias["email"] = "email"; alias["e mail"] = "email"; alias["correio eletronico"] = "email"
    alias["telefone"] = "phone"; alias["fone"] = "phone"; alias["phone"] = "phone"; alias["tel"] = "phone"
    alias["celular"] = "mobile"; alias["telefone celular"] = "mobile"; alias["whatsapp"] = "mobile"; alias["mobile"] = "mobile"
    alias["data de nascimento"] = "dateofbirth"; alias["nascimento"] = "dateofbirth"; alias["data nasc"] = "dateofbirth"
    alias["dt nascimento"] = "dateofbirth"; alias["dt nasc"] = "dateofbirth"; alias["dateofbirth"] = "dateofbirth"
    alias["endereco"] = "address"; alias["logradouro"] = "address"; alias["rua"] = "address"; alias["address"] = "address"
    alias["bairro"] = "address2"; alias["cidade"] = "city"; alias["municipio"] = "city"; alias["city"] = "city"
    alias["uf"] = "state"; alias["estado"] = "state"; alias["state"] = "state"; alias["cep"] = "zipcode"; alias["zipcode"] = "zipcode"
    alias["sexo"] = "sex"; alias["genero"] = "sex"; alias["sex"] = "sex"
    alias["validade"] = "dateexpiry"; alias["data de validade"] = "dateexpiry"; alias["vencimento"] = "dateexpiry"; alias["dateexpiry"] = "dateexpiry"
    alias["data de cadastro"] = "dateenrolled"; alias["cadastro"] = "dateenrolled"; alias["data de inscricao"] = "dateenrolled"; alias["dateenrolled"] = "dateenrolled"
    alias["branchcode"] = "branchcode"; alias["categorycode"] = "categorycode"; alias["userid"] = "userid"
    alias["sort1"] = "sort1"; alias["sort2"] = "sort2"; alias["othernames"] = "othernames"
    ok = 0; bad = 0; bad_cpf = 0; dup = 0
}
NR == 1 {
    sub(/^\357\273\277/, ""); sub(/\r$/, "")
    nh = csv_split($0, h, sep)
    for (i = 1; i <= nh; i++) {
        k = norm(h[i])
        if ((k in alias) && !(alias[k] in used)) { col[i] = alias[k]; used[alias[k]] = i; printf "  %-24s -> %s\n", trim(h[i]), alias[k] > map }
        else printf "  %-24s -> -\n", trim(h[i]) > map
    }
    if (!("fullname" in used) && !("surname" in used)) exit 3
    if (!("cardnumber" in used) && !("cpf" in used)) exit 4
    card_from_cpf = !("cardnumber" in used)
    split("cardnumber surname firstname email phone mobile dateofbirth address address2 city state zipcode sex dateexpiry dateenrolled branchcode categorycode userid sort1 sort2 othernames", order, " ")
    no = 0
    for (i = 1; i in order; i++) {
        fld = order[i]
        if (fld == "cardnumber" || fld == "surname" || (fld in used) || (fld == "firstname" && ("fullname" in used))) out_f[++no] = fld
    }
    if (("cpf" in used) && !card_from_cpf && cpf_attr) out_f[++no] = "patron_attributes"
    line = ""
    for (i = 1; i <= no; i++) line = line (i > 1 ? "," : "") out_f[i]
    print line > out
    next
}
{
    sub(/\r$/, "")
    if ($0 ~ /^[ \t,;]*$/) next
    csv_split($0, f, sep)
    split("", v)
    for (i in col) v[col[i]] = trim(f[i])
    if (v["fullname"] != "" && v["surname"] == "") {
        full = v["fullname"]; gsub(/  +/, " ", full)
        p = index(full, " ")
        if (p && v["firstname"] == "") { v["firstname"] = substr(full, 1, p - 1); v["surname"] = substr(full, p + 1) }
        else v["surname"] = full
    }
    cpf = v["cpf"]; gsub(/[^0-9]/, "", cpf)
    card = card_from_cpf ? cpf : v["cardnumber"]
    reason = ""
    if (v["cpf"] != "" && !cpf_ok(cpf)) { reason = r_cpf " " v["cpf"]; bad_cpf++ }
    else if (cpf != "" && (cpf in seen_cpf)) { reason = r_dupcpf " (" r_line " " seen_cpf[cpf] ")"; dup++ }
    else if (v["surname"] == "") reason = r_noname
    else if (card == "") reason = r_nocard
    else if (card in seen_card) { reason = r_dupcard " (" r_line " " seen_card[card] ")"; dup++ }
    if (reason != "") { printf "%s %d: %s\n", r_line, NR, reason > rej; bad++; next }
    if (cpf != "") seen_cpf[cpf] = NR
    seen_card[card] = NR
    v["cardnumber"] = card
    v["dateofbirth"] = iso_date(v["dateofbirth"]); v["dateexpiry"] = iso_date(v["dateexpiry"]); v["dateenrolled"] = iso_date(v["dateenrolled"])
    s = toupper(substr(v["sex"], 1, 1)); v["sex"] = (s == "M" || s == "F") ? s : ""
    v["patron_attributes"] = (cpf != "") ? "CPF:" cpf : ""
    line = ""
    for (i = 1; i <= no; i++) line = line (i > 1 ? "," : "") csvq(v[out_f[i]])
    print line > out
    ok++
}
END {
    if (NR == 0) exit 5
    printf "Lines read: %d\nPatrons ready: %d\nRejected: %d\nInvalid CPF: %d\nDuplicates: %d\n", (NR > 0 ? NR - 1 : 0), ok, bad, bad_cpf, dup
    printf "Card number from CPF: %d\n", card_from_cpf
}
PATAWK
}

lt_br_patrons() {
    require_database || return 0
    local file log src utf8 out rej map sep semi comma tab cpf_attr rc branch cat over="no" ready match="cardnumber"
    file=$(select_file "/root" "csv txt" "$(t "Pick the spreadsheet exported by the old system (.csv):")" "$(t "CSV file")") || return 0
    if [ ! -r "$file" ] || [ ! -s "$file" ]; then
        msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70
        return 1
    fi
    tools_workdir || return 1
    log=$(tools_log legacy-patrons)
    utf8="${TOOLS_WORK}/legacy-utf8.csv"; out="${TOOLS_WORK}/legacy-patrons.csv"
    rej="${TOOLS_WORK}/legacy-rejected.txt"; map="${TOOLS_WORK}/legacy-columns.txt"
    # Spreadsheets saved by Excel in Brazil are usually Windows-1252.
    if file_is_utf8 "$file"; then
        cp -f -- "$file" "$utf8"; src="UTF-8"
    else
        iconv -f WINDOWS-1252 -t UTF-8 "$file" > "$utf8" 2>> "$log" || { msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70; return 1; }
        src="Windows-1252"
    fi
    # Byte order mark written by Excel (raw, or already read as Windows-1252).
    sed -i '1s/^\xEF\xBB\xBF//; 1s/^\xC3\xAF\xC2\xBB\xC2\xBF//' "$utf8"
    semi=$(head -n 1 "$utf8" | tr -cd ';' | wc -c); comma=$(head -n 1 "$utf8" | tr -cd ',' | wc -c); tab=$(head -n 1 "$utf8" | tr -cd '\t' | wc -c)
    sep=","; [ "$semi" -gt "$comma" ] && sep=";"; [ "$tab" -gt "$semi" ] && [ "$tab" -gt "$comma" ] && sep=$'\t'
    cpf_attr=0
    [ "$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.borrower_attribute_types WHERE code = 'CPF';")" = "1" ] && cpf_attr=1
    : > "$rej"; : > "$map"
    rc=0
    awk -v sep="$sep" -v out="$out" -v rej="$rej" -v map="$map" -v cpf_attr="$cpf_attr" \
        -v r_cpf="$(t "invalid CPF")" -v r_dupcpf="$(t "duplicate CPF")" -v r_noname="$(t "no name")" \
        -v r_nocard="$(t "no card number")" -v r_dupcard="$(t "duplicate card number")" -v r_line="$(t "line")" \
        "${CPF_AWK}"$'\n'"$(br_patrons_awk)" "$utf8" >> "$log" 2>&1 || rc=$?
    case "$rc" in
        0) ;;
        3|4) msg_error "" "$(t "The spreadsheet needs a name column (Nome) and a card number or CPF column (Matrícula, Código, CPF).\nNothing was changed.")" 11 76; return 1 ;;
        *) msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74; return 1 ;;
    esac
    ready=$(tools_num "$log" "Patrons ready:")
    {
        printf '%s: %s    %s: "%s"\n\n' "$(t "Encoding")" "$src" "$(t "Separator")" "${sep/$'\t'/TAB}"
        printf '%s\n' "$(t "Columns:")"; cat "$map"; printf '\n'
        grep -E '^(Lines read|Patrons ready|Rejected|Invalid CPF|Duplicates):' "$log"
        [ "$(tools_num "$log" "Card number from CPF:")" = "1" ] && printf '\n%s\n' "$(t "No card number column: the CPF is used as the card number.")"
        [ "$cpf_attr" = "0" ] && grep -q ' -> cpf$' "$map" && printf '\n%s\n' "$(t "The CPF is checked but not stored: create a patron attribute type with code CPF to keep it.")"
        if [ -s "$rej" ]; then printf '\n%s\n' "$(t "Rejected lines:")"; head -n 200 "$rej"; fi
    } > "${TOOLS_WORK}/legacy-preview.txt"
    cat "${TOOLS_WORK}/legacy-preview.txt" >> "$log"
    ui_textbox "$(t "Preview (dry run)")" "${TOOLS_WORK}/legacy-preview.txt"
    if [ "${ready:-0}" = "0" ]; then
        msg_info "$(t "Legacy patrons")" "$(t 'No patron is ready to import. Nothing was changed.\n\nLog: ${log}')" 10 72
        return 0
    fi
    prompt_yes_no "$(t "Legacy patrons")" "$(t '${ready} patron(s) converted to the Koha format.\n\nContinue to the patron import (a Koha dry run comes first)?')" 11 72 defaultno || return 0
    branch=$(tools_pick "$(t "Import patrons")" "$(t "Library for the lines without branchcode:")" "SELECT branchcode, branchname FROM ${DB_NAME}.branches ORDER BY branchname;") || return 0
    cat=$(tools_pick "$(t "Import patrons")" "$(t "Category for the lines without categorycode:")" "SELECT categorycode, description FROM ${DB_NAME}.categories ORDER BY description;") || return 0
    prompt_yes_no "$(t "Import patrons")" "$(t 'Update the patrons that are already registered (same ${match})?\n\nNo = keep them as they are and import only the new ones.')" 11 72 defaultno && over="yes"
    tools_locked _lt_patron_import_run "$out" "cardnumber" "$branch" "$cat" "$over"
}

# ----------------------------------------------------------------------
# CPF report (read-only): invalid check digits and CPFs shared by patrons.
# ----------------------------------------------------------------------
lt_br_cpf_audit() {
    require_database || return 0
    local field sql log
    field=$(ui_menu "$(t "Check patron CPFs")" "$(t "Which patron field holds the CPF?")" \
        "cardnumber" "cardnumber" "userid" "userid" "sort1" "sort1" "sort2" "sort2" \
        "attribute" "$(t "Patron attribute with code CPF")") || return 0
    case "$field" in
        cardnumber|userid|sort1|sort2)
            sql="SELECT borrowernumber, COALESCE(cardnumber, ''), ${field}, CONCAT_WS(' ', firstname, surname) FROM ${DB_NAME}.borrowers WHERE COALESCE(${field}, '') <> '' ORDER BY borrowernumber;" ;;
        attribute)
            sql="SELECT b.borrowernumber, COALESCE(b.cardnumber, ''), a.attribute, CONCAT_WS(' ', b.firstname, b.surname) FROM ${DB_NAME}.borrower_attributes a JOIN ${DB_NAME}.borrowers b ON b.borrowernumber = a.borrowernumber WHERE a.code = 'CPF' ORDER BY b.borrowernumber;" ;;
        *) return 0 ;;
    esac
    log=$(tools_log cpf-check)
    run_sql "$sql" | awk -F'\t' -v l_inv="$(t "Invalid CPF")" -v l_dup="$(t "CPF shared by two patrons")" \
        -v l_sum="$(t "Checked: %d   valid: %d   invalid: %d   shared: %d   other values (not a CPF): %d")" \
        "$CPF_AWK"'
        {
            raw = $3; d = raw; gsub(/[^0-9]/, "", d)
            if (raw !~ /^[0-9 .\/-]+$/ || length(d) < 9 || length(d) > 12) { other++; next }
            total++
            if (!cpf_ok(d)) { inv++; printf "%s: %s  (%s %s)\n", l_inv, raw, $2, $4; next }
            valid++
            if (d in seen) { dup++; printf "%s: %s  (%s / %s)\n", l_dup, raw, seen[d], $2 " " $4 }
            else seen[d] = $2 " " $4
        }
        END { printf "\n" l_sum "\n", total, valid, inv, dup, other }' > "$log"
    ui_textbox "$(t "Check patron CPFs")" "$log"
}

