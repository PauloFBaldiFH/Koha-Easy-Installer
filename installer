# ======================================================================
# KEEP THE INSTALLED PANEL UP TO DATE
# ----------------------------------------------------------------------
# After an installation the panel is also copied to /usr/local/bin/config.sh.
# If a newer copy of the installer is run, refresh that copy too, so that
# "sudo config.sh" never keeps running an old version.
# ======================================================================
if [ -f /usr/local/bin/config.sh ] && [ -f "$_SCRIPT_PATH" ] \
   && [ "$(readlink -f "$_SCRIPT_PATH")" != "$(readlink -f /usr/local/bin/config.sh)" ] \
   && ! cmp -s "$_SCRIPT_PATH" /usr/local/bin/config.sh; then
