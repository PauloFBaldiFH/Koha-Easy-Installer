# Catalogue card (ficha catalográfica, AACR2): an XSLT that imports Koha's
# default detail view of the same language and adds the card below it,
# followed by the reference of the record by ABNT NBR 6023 (essential
# elements; the complete formatter is Library tools > Brazil > ABNT).
# Koha picks the file per language ({langcode} in the system preference).
ficha_xsl() {   # ficha_xsl DEFAULT_XSL TITLE PRINT_LABEL ABNT_LABEL
    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
    printf '<!-- Koha Easy Installer: Koha'"'"'s default detail view plus the Brazilian catalogue card (ficha catalografica, AACR2). Generated file. -->\n'
    printf '<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:marc="http://www.loc.gov/MARC21/slim" exclude-result-prefixes="marc">\n'
    printf '  <xsl:import href="%s"/>\n' "$(xml_escape "$1")"
    printf '  <xsl:variable name="kei-title">%s</xsl:variable>\n' "$(xml_escape "$2")"
    printf '  <xsl:variable name="kei-print">%s</xsl:variable>\n' "$(xml_escape "$3")"
    printf '  <xsl:variable name="kei-abnt-label">%s</xsl:variable>\n' "$(xml_escape "$4")"
    cat <<'FICHA'
  <xsl:template match="marc:record">
    <xsl:apply-imports/>
    <xsl:call-template name="kei-ficha"/>
    <xsl:call-template name="kei-abnt"/>
  </xsl:template>

  <xsl:template name="kei-sub">
    <xsl:param name="codes"/>
    <xsl:for-each select="marc:subfield[contains($codes, @code)]">
      <xsl:if test="position() &gt; 1"><xsl:text> </xsl:text></xsl:if>
      <xsl:value-of select="normalize-space(.)"/>
    </xsl:for-each>
  </xsl:template>

  <!-- AACR2 tracings and headings end with a full stop. -->
  <xsl:template name="kei-dot">
    <xsl:param name="s"/>
    <xsl:variable name="v" select="normalize-space($s)"/>
    <xsl:variable name="last" select="substring($v, string-length($v))"/>
    <xsl:choose>
      <xsl:when test="$v = ''"/>
      <xsl:when test="$last = ',' or $last = ';' or $last = ':' or $last = '/'"><xsl:value-of select="concat(normalize-space(substring($v, 1, string-length($v) - 1)), '.')"/></xsl:when>
      <xsl:when test="$last = '.' or $last = '?' or $last = '!' or $last = ')' or $last = '-'"><xsl:value-of select="$v"/></xsl:when>
      <xsl:otherwise><xsl:value-of select="concat($v, '.')"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template name="kei-ficha">
    <xsl:variable name="class">
      <xsl:choose>
        <xsl:when test="marc:datafield[@tag='090']/marc:subfield[@code='a']"><xsl:value-of select="marc:datafield[@tag='090']/marc:subfield[@code='a']"/></xsl:when>
        <xsl:when test="marc:datafield[@tag='082']/marc:subfield[@code='a']"><xsl:value-of select="marc:datafield[@tag='082']/marc:subfield[@code='a']"/></xsl:when>
        <xsl:otherwise><xsl:value-of select="marc:datafield[@tag='080']/marc:subfield[@code='a']"/></xsl:otherwise>
      </xsl:choose>
    </xsl:variable>
    <xsl:variable name="has-entry" select="boolean(marc:datafield[@tag='100' or @tag='110' or @tag='111'])"/>
    <div class="kei-ficha-box" id="kei-ficha">
      <style type="text/css">
.kei-ficha-box { margin: 1.5em 0; }
.kei-ficha { display: flex; gap: 0.3cm; box-sizing: border-box; width: 12.5cm; min-height: 7.5cm; padding: 0.4cm 0.5cm; border: 1px solid #333; background: #fff; color: #000; font-family: "Times New Roman", Times, serif; font-size: 10pt; line-height: 1.35; }
.kei-ficha-num { flex: 0 0 1.7cm; white-space: nowrap; }
.kei-ficha-body { flex: 1 1 auto; }
.kei-ficha-body p { margin: 0 0 0.35em 0; }
.kei-entrada { padding-left: 2.2em; text-indent: -2.2em; }
.kei-par { text-indent: 2.2em; }
.kei-pistas { text-indent: 2.2em; margin-top: 0.7em !important; }
.kei-cdd { text-align: right; margin-top: 0.7em !important; }
@media print {
  body.kei-print * { visibility: hidden; }
  body.kei-print #kei-ficha, body.kei-print #kei-ficha * { visibility: visible; }
  body.kei-print #kei-ficha { position: absolute; left: 0; top: 0; }
  .kei-ficha-print { display: none; }
}
      </style>
      <h3 class="kei-ficha-title"><xsl:value-of select="$kei-title"/></h3>
      <div class="kei-ficha">
        <div class="kei-ficha-num">
          <div><xsl:value-of select="$class"/></div>
          <div><xsl:value-of select="marc:datafield[@tag='090']/marc:subfield[@code='b']"/></div>
        </div>
        <div class="kei-ficha-body">
          <xsl:for-each select="(marc:datafield[@tag='100'] | marc:datafield[@tag='110'] | marc:datafield[@tag='111'])[1]">
            <p class="kei-entrada"><xsl:call-template name="kei-dot"><xsl:with-param name="s"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abcdnq</xsl:with-param></xsl:call-template></xsl:with-param></xsl:call-template></p>
          </xsl:for-each>
          <p>
            <xsl:attribute name="class"><xsl:choose><xsl:when test="$has-entry">kei-par</xsl:when><xsl:otherwise>kei-entrada</xsl:otherwise></xsl:choose></xsl:attribute>
            <xsl:for-each select="marc:datafield[@tag='245'][1]"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abnpc</xsl:with-param></xsl:call-template></xsl:for-each>
            <xsl:for-each select="marc:datafield[@tag='250'][1]"><xsl:text> – </xsl:text><xsl:call-template name="kei-sub"><xsl:with-param name="codes">ab</xsl:with-param></xsl:call-template></xsl:for-each>
            <xsl:for-each select="(marc:datafield[@tag='260'] | marc:datafield[@tag='264'][@ind2='1'])[1]"><xsl:text> – </xsl:text><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abc</xsl:with-param></xsl:call-template></xsl:for-each>
          </p>
          <xsl:if test="marc:datafield[@tag='300' or @tag='490']">
            <p class="kei-par">
              <xsl:for-each select="marc:datafield[@tag='300'][1]"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abce</xsl:with-param></xsl:call-template></xsl:for-each>
              <xsl:for-each select="marc:datafield[@tag='490']"><xsl:text> – (</xsl:text><xsl:call-template name="kei-sub"><xsl:with-param name="codes">av</xsl:with-param></xsl:call-template><xsl:text>)</xsl:text></xsl:for-each>
            </p>
          </xsl:if>
          <xsl:for-each select="marc:datafield[@tag='500']"><p class="kei-par"><xsl:value-of select="normalize-space(marc:subfield[@code='a'])"/></p></xsl:for-each>
          <xsl:for-each select="marc:datafield[@tag='020']/marc:subfield[@code='a']"><p class="kei-par">ISBN <xsl:value-of select="normalize-space(.)"/></p></xsl:for-each>
          <p class="kei-pistas">
            <xsl:for-each select="marc:datafield[@tag='600' or @tag='610' or @tag='611' or @tag='630' or @tag='650' or @tag='651']">
              <xsl:value-of select="position()"/><xsl:text>. </xsl:text>
              <xsl:call-template name="kei-dot"><xsl:with-param name="s">
                <xsl:for-each select="marc:subfield[contains('abcdtvxyz', @code)]">
                  <xsl:if test="position() &gt; 1"><xsl:choose><xsl:when test="contains('vxyz', @code)"><xsl:text> – </xsl:text></xsl:when><xsl:otherwise><xsl:text> </xsl:text></xsl:otherwise></xsl:choose></xsl:if>
                  <xsl:value-of select="normalize-space(.)"/>
                </xsl:for-each>
              </xsl:with-param></xsl:call-template>
              <xsl:text> </xsl:text>
            </xsl:for-each>
            <xsl:for-each select="marc:datafield[@tag='700' or @tag='710' or @tag='711']">
              <xsl:number value="position()" format="I"/><xsl:text>. </xsl:text>
              <xsl:call-template name="kei-dot"><xsl:with-param name="s"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">abcdq</xsl:with-param></xsl:call-template></xsl:with-param></xsl:call-template>
              <xsl:text> </xsl:text>
            </xsl:for-each>
            <xsl:if test="marc:datafield[@tag='245'][1]/@ind1 = '1'">
              <xsl:number value="count(marc:datafield[@tag='700' or @tag='710' or @tag='711']) + 1" format="I"/><xsl:text>. Título.</xsl:text>
            </xsl:if>
          </p>
          <p class="kei-cdd">
            <xsl:if test="marc:datafield[@tag='082']/marc:subfield[@code='a']">CDD <xsl:value-of select="marc:datafield[@tag='082']/marc:subfield[@code='a']"/></xsl:if>
            <xsl:if test="marc:datafield[@tag='080']/marc:subfield[@code='a']"><xsl:text>   CDU </xsl:text><xsl:value-of select="marc:datafield[@tag='080']/marc:subfield[@code='a']"/></xsl:if>
          </p>
        </div>
      </div>
      <button type="button" class="btn btn-default btn-sm kei-ficha-print" onclick="document.body.classList.add('kei-print'); window.print(); document.body.classList.remove('kei-print');"><xsl:value-of select="$kei-print"/></button>
    </div>
  </xsl:template>
  <!-- Reference by ABNT NBR 6023:2018 (essential elements) under the card. -->
  <xsl:variable name="kei-lc" select="'abcdefghijklmnopqrstuvwxyzàáâãäåçèéêëìíîïñòóôõöùúûüý'"/>
  <xsl:variable name="kei-uc" select="'ABCDEFGHIJKLMNOPQRSTUVWXYZÀÁÂÃÄÅÇÈÉÊËÌÍÎÏÑÒÓÔÕÖÙÚÛÜÝ'"/>

  <!-- ISBD punctuation at the end: "Dom Casmurro /", "São Paulo :", "Ática,". -->
  <xsl:template name="kei-bare">
    <xsl:param name="s"/>
    <xsl:variable name="v" select="normalize-space($s)"/>
    <xsl:variable name="last" select="substring($v, string-length($v))"/>
    <xsl:choose>
      <xsl:when test="$v != '' and contains('/:;,=', $last)">
        <xsl:call-template name="kei-bare"><xsl:with-param name="s" select="substring($v, 1, string-length($v) - 1)"/></xsl:call-template>
      </xsl:when>
      <xsl:when test="$last = '.' and not(contains(' .', substring($v, string-length($v) - 2, 1)))"><xsl:value-of select="substring($v, 1, string-length($v) - 1)"/></xsl:when>
      <xsl:otherwise><xsl:value-of select="$v"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <!-- "Assis, Machado de," -> "ASSIS, Machado de" -->
  <xsl:template name="kei-person">
    <xsl:variable name="a"><xsl:call-template name="kei-bare"><xsl:with-param name="s" select="marc:subfield[@code='a']"/></xsl:call-template></xsl:variable>
    <xsl:choose>
      <xsl:when test="contains($a, ',')"><xsl:value-of select="concat(translate(substring-before($a, ','), $kei-lc, $kei-uc), ', ', normalize-space(substring-after($a, ',')))"/></xsl:when>
      <xsl:otherwise><xsl:value-of select="translate($a, $kei-lc, $kei-uc)"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template name="kei-abnt">
    <xsl:variable name="f245" select="marc:datafield[@tag='245'][1]"/>
    <xsl:variable name="title"><xsl:call-template name="kei-bare"><xsl:with-param name="s"><xsl:for-each select="$f245"><xsl:call-template name="kei-sub"><xsl:with-param name="codes">anp</xsl:with-param></xsl:call-template></xsl:for-each></xsl:with-param></xsl:call-template></xsl:variable>
    <xsl:variable name="subtitle"><xsl:call-template name="kei-bare"><xsl:with-param name="s" select="$f245/marc:subfield[@code='b']"/></xsl:call-template></xsl:variable>
    <xsl:variable name="coauthors" select="marc:datafield[@tag='700'][@ind1 != '3'][not(marc:subfield[@code='e'] or marc:subfield[@code='4'])]"/>
    <xsl:variable name="imp" select="(marc:datafield[@tag='260'] | marc:datafield[@tag='264'][@ind2='1'])[1]"/>
    <xsl:variable name="place"><xsl:call-template name="kei-bare"><xsl:with-param name="s" select="$imp/marc:subfield[@code='a'][1]"/></xsl:call-template></xsl:variable>
    <xsl:variable name="publisher"><xsl:call-template name="kei-bare"><xsl:with-param name="s" select="$imp/marc:subfield[@code='b'][1]"/></xsl:call-template></xsl:variable>
    <xsl:variable name="c" select="normalize-space($imp/marc:subfield[@code='c'][1])"/>
    <xsl:variable name="date"><xsl:call-template name="kei-bare"><xsl:with-param name="s"><xsl:choose><xsl:when test="starts-with($c, 'c') or starts-with($c, '©') or starts-with($c, 'p')"><xsl:value-of select="substring($c, 2)"/></xsl:when><xsl:otherwise><xsl:value-of select="$c"/></xsl:otherwise></xsl:choose></xsl:with-param></xsl:call-template></xsl:variable>
    <xsl:if test="$title != ''">
      <div class="kei-abnt" id="kei-abnt" style="margin: 1em 0 1.5em;">
        <h3 class="kei-abnt-title"><xsl:value-of select="$kei-abnt-label"/></h3>
        <p style="font-family: 'Times New Roman', Times, serif; font-size: 12pt; text-align: left;">
          <xsl:choose>
            <xsl:when test="marc:datafield[@tag='100' or @tag='110' or @tag='111']">
              <xsl:for-each select="marc:datafield[@tag='100'][1]"><xsl:call-template name="kei-person"/></xsl:for-each>
              <xsl:for-each select="marc:datafield[@tag='110' or @tag='111'][1]">
                <xsl:variable name="name"><xsl:call-template name="kei-bare"><xsl:with-param name="s" select="marc:subfield[@code='a']"/></xsl:call-template></xsl:variable>
                <xsl:value-of select="translate($name, $kei-lc, $kei-uc)"/>
                <xsl:for-each select="marc:subfield[@code='b']"><xsl:text>. </xsl:text><xsl:call-template name="kei-bare"><xsl:with-param name="s" select="."/></xsl:call-template></xsl:for-each>
              </xsl:for-each>
              <xsl:if test="marc:datafield[@tag='100']">
                <xsl:choose>
                  <xsl:when test="count($coauthors) &gt; 2"><xsl:text> et al</xsl:text></xsl:when>
                  <xsl:otherwise><xsl:for-each select="$coauthors"><xsl:text>; </xsl:text><xsl:call-template name="kei-person"/></xsl:for-each></xsl:otherwise>
                </xsl:choose>
              </xsl:if>
              <xsl:text>. </xsl:text>
              <strong><xsl:value-of select="$title"/></strong>
            </xsl:when>
            <xsl:otherwise>
              <!-- Entry by title: the first word (with a leading article) in capitals, no bold. -->
              <xsl:variable name="w1" select="substring-before(concat($title, ' '), ' ')"/>
              <xsl:variable name="rest" select="substring-after($title, ' ')"/>
              <xsl:choose>
                <xsl:when test="$rest != '' and contains('|o|a|os|as|um|uma|uns|umas|the|an|el|la|los|las|le|les|', concat('|', translate($w1, $kei-uc, $kei-lc), '|'))">
                  <xsl:variable name="w2" select="substring-before(concat($rest, ' '), ' ')"/>
                  <xsl:value-of select="translate(concat($w1, ' ', $w2), $kei-lc, $kei-uc)"/>
                  <xsl:if test="substring-after($rest, ' ') != ''"><xsl:value-of select="concat(' ', substring-after($rest, ' '))"/></xsl:if>
                </xsl:when>
                <xsl:otherwise>
                  <xsl:value-of select="translate($w1, $kei-lc, $kei-uc)"/>
                  <xsl:if test="$rest != ''"><xsl:value-of select="concat(' ', $rest)"/></xsl:if>
                </xsl:otherwise>
              </xsl:choose>
            </xsl:otherwise>
          </xsl:choose>
          <xsl:if test="$subtitle != ''"><xsl:value-of select="concat(': ', $subtitle)"/></xsl:if>
          <xsl:text>. </xsl:text>
          <xsl:for-each select="marc:datafield[@tag='250'][1]"><xsl:call-template name="kei-dot"><xsl:with-param name="s" select="marc:subfield[@code='a']"/></xsl:call-template><xsl:text> </xsl:text></xsl:for-each>
          <xsl:choose>
            <xsl:when test="$place != '' and $publisher != ''"><xsl:value-of select="concat($place, ': ', $publisher)"/></xsl:when>
            <xsl:when test="$place != ''"><xsl:value-of select="concat($place, ': [s. n.]')"/></xsl:when>
            <xsl:when test="$publisher != ''"><xsl:value-of select="concat('[S. l.]: ', $publisher)"/></xsl:when>
            <xsl:otherwise>[S. l.: s. n.]</xsl:otherwise>
          </xsl:choose>
          <xsl:text>, </xsl:text>
          <xsl:choose>
            <xsl:when test="$date != ''"><xsl:value-of select="$date"/></xsl:when>
            <xsl:when test="translate(substring(marc:controlfield[@tag='008'], 8, 4), '0123456789', '') = '' and string-length(marc:controlfield[@tag='008']) &gt; 10"><xsl:value-of select="substring(marc:controlfield[@tag='008'], 8, 4)"/></xsl:when>
            <xsl:otherwise>[s. d.]</xsl:otherwise>
          </xsl:choose>
          <xsl:text>.</xsl:text>
        </p>
      </div>
    </xsl:if>
  </xsl:template>
</xsl:stylesheet>
FICHA
}

# Writes the card stylesheets for every language Koha has (OPAC and staff),
# each one importing the default view of its own language (English when a
# side lacks that language). Prints the number of languages.
ficha_write() {
    local langs=() l d opac staff title print_label abnt_label
    title="$(t "Cataloguing card")"; print_label="$(t "Print the card")"; abnt_label="$(t "Reference (ABNT NBR 6023)")"
    for d in "$KOHA_OPAC_TMPL"/*/xslt/MARC21slim2OPACDetail.xsl "$KOHA_INTRA_TMPL"/*/xslt/MARC21slim2intranetDetail.xsl; do
        [ -f "$d" ] || continue
        l="${d%/xslt/*}"; l="${l##*/}"
        [[ " ${langs[*]} " == *" $l "* ]] || langs+=("$l")
    done
    [ ${#langs[@]} -gt 0 ] || return 1
    for l in "${langs[@]}"; do
        opac="$KOHA_OPAC_TMPL/$l/xslt/MARC21slim2OPACDetail.xsl"; [ -f "$opac" ] || opac="$KOHA_OPAC_TMPL/en/xslt/MARC21slim2OPACDetail.xsl"
        staff="$KOHA_INTRA_TMPL/$l/xslt/MARC21slim2intranetDetail.xsl"; [ -f "$staff" ] || staff="$KOHA_INTRA_TMPL/en/xslt/MARC21slim2intranetDetail.xsl"
        mkdir -p "$FICHA_DIR/$l" || return 1
        ficha_xsl "$opac" "$title" "$print_label" "$abnt_label" > "$FICHA_DIR/$l/opac-detail.xsl" || return 1
        ficha_xsl "$staff" "$title" "$print_label" "$abnt_label" > "$FICHA_DIR/$l/staff-detail.xsl" || return 1
    done
    chown -R "root:${INSTANCE}-koha" "$FICHA_DIR" 2>/dev/null || true
    chmod -R u=rwX,g=rX,o= "$FICHA_DIR"
    printf '%s' "${#langs[@]}"
}

# Languages installed after the card was enabled get their stylesheet too
# (at panel start): Koha would otherwise fail to show their detail pages.
ficha_refresh() {
    [ -s "$FICHA_STATE" ] || return 0
    ficha_write >/dev/null 2>&1 || true
}

lt_br_ficha() {
    require_database || return 0
    local state choice
    state="$(t "off")"
    [ -s "$FICHA_STATE" ] && state="$(t "on")"
    choice=$(ui_menu "$(t "Cataloguing card")" "$(t 'Brazilian catalogue card (ficha catalográfica, AACR2) below the record in the OPAC and in the staff interface. Now: ${state}')" \
        "on" "$(t "Show the card")" "off" "$(t "Hide the card (Koha's default view)")") || return 0
    case "$choice" in
        on)  tools_locked _lt_br_ficha_on ;;
        off) tools_locked _lt_br_ficha_off ;;
    esac
}

_lt_br_ficha_on() {
    local log n opac_now staff_now
    log=$(tools_log ficha)
    opac_now=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'OPACXSLTDetailsDisplay';")
    staff_now=$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'XSLTDetailsDisplay';")
    prompt_yes_no "$(t "Cataloguing card")" "$(t 'The detail pages will use the stylesheets of the panel (the default Koha view plus the card):\n  OPACXSLTDetailsDisplay: ${opac_now}\n  XSLTDetailsDisplay: ${staff_now}\nThe current values are kept to be restored later. A verified backup is made first.')" 14 76 defaultno || return 0
    if ! n=$(ficha_write); then
        msg_error "" "$(t "Koha's default detail stylesheets were not found. Nothing was changed.")" 9 72
        return 1
    fi
    tools_safety_backup FICHA || return 1
    if [ ! -s "$FICHA_STATE" ]; then
        printf 'OPACXSLTDetailsDisplay=%s\nXSLTDetailsDisplay=%s\n' "${opac_now:-default}" "${staff_now:-default}" > "$FICHA_STATE"
    fi
    koha_tool "$log" koha-preferences set OPACXSLTDetailsDisplay "$FICHA_DIR/{langcode}/opac-detail.xsl"
    koha_tool "$log" koha-preferences set XSLTDetailsDisplay "$FICHA_DIR/{langcode}/staff-detail.xsl"
    if [ "$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'XSLTDetailsDisplay';")" != "$FICHA_DIR/{langcode}/staff-detail.xsl" ]; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    log "tools: catalogue card enabled ($n languages)"
    msg_ok "$(t '✔ The catalogue card is shown below each record (${n} language(s)).\n\nSafety backup: ${TOOLS_PRE}')" 11 72
}

_lt_br_ficha_off() {
    local log opac_prev staff_prev
    if [ ! -s "$FICHA_STATE" ]; then
        msg_info "$(t "Cataloguing card")" "$(t "The card is not enabled. Nothing was changed.")" 9 64
        return 0
    fi
    log=$(tools_log ficha)
    opac_prev=$(sed -n 's/^OPACXSLTDetailsDisplay=//p' "$FICHA_STATE"); staff_prev=$(sed -n 's/^XSLTDetailsDisplay=//p' "$FICHA_STATE")
    prompt_yes_no "$(t "Cataloguing card")" "$(t 'Restore the previous detail views?\n  OPACXSLTDetailsDisplay: ${opac_prev}\n  XSLTDetailsDisplay: ${staff_prev}\nA verified backup is made first.')" 12 76 defaultno || return 0
    tools_safety_backup FICHA || return 1
    koha_tool "$log" koha-preferences set OPACXSLTDetailsDisplay "${opac_prev:-default}"
    koha_tool "$log" koha-preferences set XSLTDetailsDisplay "${staff_prev:-default}"
    if [ "$(run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable = 'XSLTDetailsDisplay';")" != "${staff_prev:-default}" ]; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    rm -f "$FICHA_STATE"
    case "$FICHA_DIR" in /var/lib/koha/*/kei-xslt) rm -rf "$FICHA_DIR" ;; esac
    log "tools: catalogue card disabled"
    msg_ok "$(t "✔ Koha's default detail view is back.")" 8 64
}

# ----------------------------------------------------------------------
# 3. Calendar: national holidays and the dates that depend on Easter.
# ----------------------------------------------------------------------
# Easter Sunday (Gregorian calendar), Meeus/Jones/Butcher: YYYY-MM-DD.
br_easter() {
    local y=$1 a b c d e f g h i k l m
    a=$((y % 19)); b=$((y / 100)); c=$((y % 100)); d=$((b / 4)); e=$((b % 4))
    f=$(((b + 8) / 25)); g=$(((b - f + 1) / 3)); h=$(((19 * a + b - d - g + 15) % 30))
    i=$((c / 4)); k=$((c % 4)); l=$(((32 + 2 * e + 2 * i - h - k) % 7))
    m=$(((a + 11 * h + 22 * l) / 451))
    printf '%04d-%02d-%02d\n' "$y" $(((h + l - 7 * m + 114) / 31)) $(((h + l - 7 * m + 114) % 31 + 1))
}

# br_holidays YEAR: "YYYY-MM-DD|title|kind" sorted by date. National
# holidays (Leis 662/1949, 6.802/1980, 14.759/2023) plus Carnival, Good
# Friday and Corpus Christi (Easter - 48/-47, -2, +60 days).
br_holidays() {
    local y=$1 e
    e=$(br_easter "$y")
    {
        printf '%s|%s|N\n' "$y-01-01" "Confraternização Universal" "$y-04-21" "Tiradentes" "$y-05-01" "Dia do Trabalho" \
            "$y-09-07" "Independência do Brasil" "$y-10-12" "Nossa Senhora Aparecida" "$y-11-02" "Finados" \
            "$y-11-15" "Proclamação da República" "$y-12-25" "Natal"
        [ "$y" -ge 2024 ] && printf '%s|%s|N\n' "$y-11-20" "Dia Nacional de Zumbi e da Consciência Negra"
        printf '%s|%s|P\n' "$(date -d "$e -48 days" +%F)" "Carnaval (segunda-feira)" "$(date -d "$e -47 days" +%F)" "Carnaval (terça-feira)" \
            "$(date -d "$e +60 days" +%F)" "Corpus Christi"
        printf '%s|%s|N\n' "$(date -d "$e -2 days" +%F)" "Sexta-feira Santa"
    } | sort
}

# The calendar table: special_holidays up to Koha 26.05, library_single_closures after.
br_calendar_table() {
    local tb
    for tb in special_holidays library_single_closures; do
        [ -n "$(run_sql "SHOW TABLES FROM ${DB_NAME} LIKE '$tb';")" ] && { printf '%s' "$tb"; return 0; }
    done
    return 1
}

lt_br_holidays() {
    require_database || return 0
    local action year branch local_spec=""
    action=$(ui_menu "$(t "Brazilian holidays")" "$(t "Days the library is closed in the Koha calendar:")" \
        "add" "$(t "Add the holidays of a year")" "remove" "$(t "Remove the holidays added by the panel")") || return 0
    year=$(ui_input "$(t "Brazilian holidays")" "$(t "Year (YYYY):")" "$(date +%Y)") || return 0
    if ! [[ "$year" =~ ^20[0-9][0-9]$ ]]; then
        msg_error "" "$(t "Invalid year. Nothing was changed.")" 8 60
        return 1
    fi
    branch=$(tools_pick "$(t "Brazilian holidays")" "$(t "Library")" "SELECT branchcode, branchname FROM ${DB_NAME}.branches ORDER BY branchname;" "*" "$(t "All libraries")") || return 0
    if [ "$action" = "add" ]; then
        local_spec=$(ui_input "$(t "Brazilian holidays")" "$(t "Local holiday (city anniversary, patron saint): DD/MM and the name, e.g. 20/01 São Sebastião.\nLeave it empty to skip.")" "") || return 0
        if [ -n "$local_spec" ]; then
            if ! [[ "$local_spec" =~ ^([0-3][0-9])/([01][0-9])\ +([^|]{2,40})$ ]] || ! date -d "$year-${BASH_REMATCH[2]}-${BASH_REMATCH[1]}" >/dev/null 2>&1; then
                msg_error "" "$(t "Invalid local holiday. Use DD/MM and the name.\nNothing was changed.")" 9 66
                return 1
            fi
            local_spec="$year-${BASH_REMATCH[2]}-${BASH_REMATCH[1]}|${BASH_REMATCH[3]}|M"
        fi
        tools_locked _lt_br_holidays_add "$year" "$branch" "$local_spec"
    else
        tools_locked _lt_br_holidays_remove "$year" "$branch"
    fi
}

# Libraries chosen ("*" = all), quoted for SQL: 'CPL','MPL'
br_branch_list() {
    local b out=""
    if [ "$1" = "*" ]; then
        while IFS= read -r b; do [ -n "$b" ] && out+="${out:+,}$(sql_quote "$b")"; done < <(run_sql "SELECT branchcode FROM ${DB_NAME}.branches ORDER BY branchcode;")
    else
        out=$(sql_quote "$1")
    fi
    printf '%s' "$out"
}

_lt_br_holidays_add() {
    local year="$1" branch="$2" extra="$3" log table branches sql day title kind desc before after added d m
    log=$(tools_log holidays)
    if ! table=$(br_calendar_table); then
        msg_error "" "$(t "Koha's calendar table was not found. Nothing was changed.")" 9 66
        return 1
    fi
    branches=$(br_branch_list "$branch")
    sql="${TOOLS_WORK}/holidays.sql"
    printf 'SET NAMES utf8mb4;\nSTART TRANSACTION;\n' > "$sql"
    {
        printf '%s: %s\n\n' "$(t "Libraries")" "${branches//\'/}"
        { br_holidays "$year"; [ -n "$extra" ] && printf '%s\n' "$extra"; } | sort | while IFS='|' read -r day title kind; do
            printf '  %s  %s  %s\n' "$day" "$(date -d "$day" +%a)" "$title"
        done
    } > "${TOOLS_WORK}/preview.txt"
    { br_holidays "$year"; [ -n "$extra" ] && printf '%s\n' "$extra"; } | while IFS='|' read -r day title kind; do
        case "$kind" in N) desc="Feriado nacional" ;; P) desc="Ponto facultativo nacional" ;; *) desc="Feriado municipal" ;; esac
        desc="$desc [$BR_TAG]"
        d=$((10#${day:8:2})); m=$((10#${day:5:2}))
        if [ "$table" = "special_holidays" ]; then
            printf "INSERT INTO special_holidays (branchcode, day, month, year, isexception, title, description) SELECT b.branchcode, %d, %d, %d, 0, %s, %s FROM branches b WHERE b.branchcode IN (%s) AND NOT EXISTS (SELECT 1 FROM special_holidays s WHERE s.branchcode = b.branchcode AND s.year = %d AND s.month = %d AND s.day = %d AND s.isexception = 0);\n" \
                "$d" "$m" "$year" "$(sql_quote "$title")" "$(sql_quote "$desc")" "$branches" "$year" "$m" "$d"
        else
            printf "INSERT IGNORE INTO library_single_closures (library_id, date, title, description) SELECT b.branchcode, '%s', %s, %s FROM branches b WHERE b.branchcode IN (%s);\n" \
                "$day" "$(sql_quote "$title")" "$(sql_quote "$desc")" "$branches"
        fi
    done >> "$sql"
    printf 'COMMIT;\n' >> "$sql"
    cat "${TOOLS_WORK}/preview.txt" >> "$log"
    ui_textbox "$(t "Preview (dry run)")" "${TOOLS_WORK}/preview.txt"
    prompt_yes_no "$(t "Brazilian holidays")" "$(t 'Add these closed days of ${year} to the Koha calendar? Days already in the calendar are skipped. A verified backup is made first.\n\nCarnival and Corpus Christi are optional days off (ponto facultativo): remove them in Tools > Calendar if the library opens.')" 14 76 defaultno || return 0
    tools_safety_backup CALENDAR || return 1
    before=$(br_holiday_count "$table" "$year")
    if ! koha_sql_run "$log" "$sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    memcached_flush || log "tools: memcached flush failed (the calendar cache expires by itself)"
    after=$(br_holiday_count "$table" "$year")
    added=$((after - before))
    log "tools: holidays $year added ($added rows, $table)"
    msg_ok "$(t '✔ Closed days added to the calendar: ${added}\n\nIn Koha: Tools > Calendar.\nSafety backup: ${TOOLS_PRE}')" 11 72
}

# Rows the panel added for a year (all libraries).
br_holiday_count() {
    if [ "$1" = "special_holidays" ]; then
        run_sql "SELECT COUNT(*) FROM ${DB_NAME}.special_holidays WHERE year = $2 AND description LIKE '%[${BR_TAG}]%';"
    else
        run_sql "SELECT COUNT(*) FROM ${DB_NAME}.library_single_closures WHERE YEAR(date) = $2 AND description LIKE '%[${BR_TAG}]%';"
    fi
}

_lt_br_holidays_remove() {
    local year="$1" branch="$2" log table branches sql n where
    log=$(tools_log holidays)
    table=$(br_calendar_table) || { msg_error "" "$(t "Koha's calendar table was not found. Nothing was changed.")" 9 66; return 1; }
    branches=$(br_branch_list "$branch")
    if [ "$table" = "special_holidays" ]; then
        where="year = $year AND description LIKE '%[${BR_TAG}]%' AND branchcode IN ($branches)"
    else
        where="YEAR(date) = $year AND description LIKE '%[${BR_TAG}]%' AND library_id IN ($branches)"
    fi
    n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.${table} WHERE ${where};")
    if [ "${n:-0}" = "0" ]; then
        msg_info "$(t "Brazilian holidays")" "$(t "The panel added no holiday for this year. Nothing was changed.")" 9 70
        return 0
    fi
    prompt_yes_no "$(t "Brazilian holidays")" "$(t 'Remove ${n} closed day(s) of ${year} added by the panel? Days added by hand are not touched. A verified backup is made first.')" 11 72 defaultno || return 0
    tools_safety_backup CALENDAR || return 1
    sql="${TOOLS_WORK}/holidays.sql"
    printf 'SET NAMES utf8mb4;\nSTART TRANSACTION;\nDELETE FROM %s WHERE %s;\nCOMMIT;\n' "$table" "$where" > "$sql"
    if ! koha_sql_run "$log" "$sql"; then
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    memcached_flush || true
    log "tools: holidays $year removed ($n rows)"
    msg_ok "$(t '✔ Closed days removed: ${n}')" 8 60
}

# ----------------------------------------------------------------------
# 4. Government census reports (MEC / INEP / IBGE / SNBP): read-only SQL
#    reports saved in Koha, like the essential pack (Library tools > 3) but
#    with their own tag, so each pack is installed and removed on its own.
# ----------------------------------------------------------------------
# The figures asked by the INEP School and Higher Education censuses, the
# IBGE surveys, the SNBP registry of public libraries and the MEC course
# evaluations: collection (titles and volumes by item type, library and
# CDD class), growth, circulation, readers (category, sex, age group),
# losses and the age of the collection. Koha asks for the year when the
# report runs (<<...>>, used once per query through the derived table p).
CENSUS_TAG="koha-easy-installer-censo"
# _census_yr COLUMN: COLUMN falls in the year p.y.
_census_yr() { printf "%s >= CONCAT(p.y, '-01-01') AND %s < CONCAT(p.y + 1, '-01-01')" "$1" "$1"; }
census_reports_define() {
    local p ai area sex age unknown
    RP_KEY=(); RP_GROUP=(); RP_NAME=(); RP_SQL=()
    unknown=$(sql_quote "$(t "Not informed")")
    p="(SELECT <<$(t "Census year (YYYY)")>> AS y) p"
    # Items still in the collection (not lost, not withdrawn), with the item
    # type of the item or, without one, of the record (item-level_itypes off).
    ai="(SELECT i.itemnumber, i.biblionumber, i.barcode, i.homebranch, i.notforloan, i.itemcallnumber, i.datelastborrowed, i.issues, COALESCE(NULLIF(i.itype, ''), bi.itemtype) AS itype, NULLIF(b.copyrightdate, 0) AS copyrightdate FROM items i JOIN biblio b ON b.biblionumber = i.biblionumber LEFT JOIN biblioitems bi ON bi.biblionumber = i.biblionumber WHERE i.itemlost = 0 AND i.withdrawn = 0) x"
    # Main class of the CDD: the first digit of the first 3-digit group of the call number.
    area="CASE LEFT(REGEXP_SUBSTR(COALESCE(x.itemcallnumber, ''), '[0-9]{3}'), 1)"
    area+=" WHEN '0' THEN $(sql_quote "000 $(t "Computer science, information and general works")")"
    area+=" WHEN '1' THEN $(sql_quote "100 $(t "Philosophy and psychology")")"
    area+=" WHEN '2' THEN $(sql_quote "200 $(t "Religion")")"
    area+=" WHEN '3' THEN $(sql_quote "300 $(t "Social sciences")")"
    area+=" WHEN '4' THEN $(sql_quote "400 $(t "Language")")"
    area+=" WHEN '5' THEN $(sql_quote "500 $(t "Natural sciences and mathematics")")"
    area+=" WHEN '6' THEN $(sql_quote "600 $(t "Technology (applied sciences)")")"
    area+=" WHEN '7' THEN $(sql_quote "700 $(t "Arts and recreation")")"
    area+=" WHEN '8' THEN $(sql_quote "800 $(t "Literature")")"
    area+=" WHEN '9' THEN $(sql_quote "900 $(t "History and geography")")"
    area+=" ELSE $(sql_quote "$(t "Not classified")") END"
    sex="CASE UPPER(COALESCE(b.sex, '')) WHEN 'F' THEN $(sql_quote "$(t "Female")") WHEN 'M' THEN $(sql_quote "$(t "Male")") ELSE ${unknown} END"
    age="TIMESTAMPDIFF(YEAR, b.dateofbirth, CONCAT(p.y, '-12-31'))"

    _rp censo-summary CIRC "$(t "Census: summary of the year (INEP, IBGE, SNBP)")" \
        "SELECT p.y AS \`$(t "Year")\`, (SELECT COUNT(DISTINCT i.biblionumber) FROM items i WHERE i.itemlost = 0 AND i.withdrawn = 0) AS \`$(t "Titles in the collection (today)")\`, (SELECT COUNT(*) FROM items i WHERE i.itemlost = 0 AND i.withdrawn = 0) AS \`$(t "Volumes in the collection (today)")\`, (SELECT COUNT(*) FROM items i WHERE $(_census_yr i.dateaccessioned)) AS \`$(t "Volumes added in the year")\`, (SELECT COUNT(*) FROM items i WHERE i.itemlost <> 0 AND $(_census_yr i.itemlost_on)) AS \`$(t "Volumes lost in the year")\`, (SELECT COUNT(*) FROM items i WHERE i.withdrawn <> 0 AND $(_census_yr i.withdrawn_on)) AS \`$(t "Volumes withdrawn in the year")\`, (SELECT COUNT(*) FROM deleteditems d WHERE $(_census_yr d.timestamp)) AS \`$(t "Items deleted in the year")\`, (SELECT COUNT(*) FROM borrowers b WHERE b.dateenrolled < CONCAT(p.y + 1, '-01-01') AND (b.dateexpiry IS NULL OR b.dateexpiry >= CONCAT(p.y, '-01-01'))) AS \`$(t "Registered patrons")\`, (SELECT COUNT(*) FROM borrowers b WHERE $(_census_yr b.dateenrolled)) AS \`$(t "New patrons in the year")\`, (SELECT COUNT(DISTINCT s.borrowernumber) FROM statistics s WHERE s.type IN ('issue', 'renew') AND $(_census_yr s.datetime)) AS \`$(t "Active readers in the year")\`, (SELECT COUNT(*) FROM statistics s WHERE s.type = 'issue' AND $(_census_yr s.datetime)) AS \`$(t "Loans")\`, (SELECT COUNT(*) FROM statistics s WHERE s.type = 'renew' AND $(_census_yr s.datetime)) AS \`$(t "Renewals")\`, (SELECT COUNT(*) FROM statistics s WHERE s.type = 'localuse' AND $(_census_yr s.datetime)) AS \`$(t "In-library use")\` FROM ${p}"
    _rp censo-collection-type CAT "$(t "Census: active collection by item type and library")" \
        "SELECT COALESCE(t.description, x.itype, ${unknown}) AS \`$(t "Item type")\`, x.homebranch AS \`$(t "Library")\`, COUNT(DISTINCT x.biblionumber) AS \`$(t "Titles")\`, COUNT(*) AS \`$(t "Volumes")\`, SUM(COALESCE(x.notforloan, 0) = 0) AS \`$(t "For loan")\`, SUM(COALESCE(x.notforloan, 0) <> 0) AS \`$(t "Not for loan (reference)")\` FROM ${ai} LEFT JOIN itemtypes t ON t.itemtype = x.itype GROUP BY 1, 2 ORDER BY 1, 2"
    _rp censo-collection-area CAT "$(t "Census: active collection by knowledge area (CDD)")" \
        "SELECT ${area} AS \`$(t "Knowledge area (CDD)")\`, COUNT(DISTINCT x.biblionumber) AS \`$(t "Titles")\`, COUNT(*) AS \`$(t "Volumes")\` FROM ${ai} GROUP BY 1 ORDER BY 1"
    _rp censo-acquisitions CAT "$(t "Census: volumes added in the year by item type and area")" \
        "SELECT COALESCE(t.description, COALESCE(NULLIF(x.itype, ''), bi.itemtype), ${unknown}) AS \`$(t "Item type")\`, ${area} AS \`$(t "Knowledge area (CDD)")\`, COUNT(DISTINCT x.biblionumber) AS \`$(t "Titles")\`, COUNT(*) AS \`$(t "Volumes")\` FROM ${p} JOIN items x ON $(_census_yr x.dateaccessioned) LEFT JOIN biblioitems bi ON bi.biblionumber = x.biblionumber LEFT JOIN itemtypes t ON t.itemtype = COALESCE(NULLIF(x.itype, ''), bi.itemtype) GROUP BY 1, 2 ORDER BY 1, 2"
    _rp censo-circulation CIRC "$(t "Census: circulation of the year by month")" \
        "SELECT DATE_FORMAT(s.datetime, '%Y-%m') AS \`$(t "Month")\`, SUM(s.type = 'issue') AS \`$(t "Loans")\`, SUM(s.type = 'renew') AS \`$(t "Renewals")\`, SUM(s.type = 'return') AS \`$(t "Returns")\`, SUM(s.type = 'localuse') AS \`$(t "In-library use")\`, COUNT(DISTINCT CASE WHEN s.type IN ('issue', 'renew') THEN s.borrowernumber END) AS \`$(t "Active readers")\` FROM ${p} JOIN statistics s ON $(_census_yr s.datetime) GROUP BY 1 ORDER BY 1"
    _rp censo-loans-type CIRC "$(t "Census: loans of the year by item type and patron category")" \
        "SELECT COALESCE(t.description, COALESCE(NULLIF(s.itemtype, ''), i.itype), ${unknown}) AS \`$(t "Item type")\`, COALESCE(c.description, b.categorycode, ${unknown}) AS \`$(t "Patron category")\`, SUM(s.type = 'issue') AS \`$(t "Loans")\`, SUM(s.type = 'renew') AS \`$(t "Renewals")\`, SUM(s.type = 'localuse') AS \`$(t "In-library use")\` FROM ${p} JOIN statistics s ON $(_census_yr s.datetime) AND s.type IN ('issue', 'renew', 'localuse') LEFT JOIN items i ON i.itemnumber = s.itemnumber LEFT JOIN borrowers b ON b.borrowernumber = s.borrowernumber LEFT JOIN categories c ON c.categorycode = b.categorycode LEFT JOIN itemtypes t ON t.itemtype = COALESCE(NULLIF(s.itemtype, ''), i.itype) GROUP BY 1, 2 ORDER BY 1, 2"
    _rp censo-readers PAT "$(t "Census: readers by category, sex and age group")" \
        "SELECT COALESCE(c.description, b.categorycode) AS \`$(t "Patron category")\`, ${sex} AS \`$(t "Sex")\`, CASE WHEN b.dateofbirth IS NULL THEN ${unknown} WHEN ${age} < 12 THEN '00-11' WHEN ${age} < 18 THEN '12-17' WHEN ${age} < 30 THEN '18-29' WHEN ${age} < 60 THEN '30-59' ELSE '60+' END AS \`$(t "Age group")\`, COUNT(*) AS \`$(t "Registered patrons")\`, SUM(EXISTS (SELECT 1 FROM statistics s WHERE s.borrowernumber = b.borrowernumber AND s.type IN ('issue', 'renew') AND $(_census_yr s.datetime))) AS \`$(t "Active readers in the year")\` FROM ${p} JOIN borrowers b ON b.dateenrolled < CONCAT(p.y + 1, '-01-01') AND (b.dateexpiry IS NULL OR b.dateexpiry >= CONCAT(p.y, '-01-01')) LEFT JOIN categories c ON c.categorycode = b.categorycode GROUP BY 1, 2, 3 ORDER BY 1, 2, 3"
    _rp censo-losses CAT "$(t "Census: losses and withdrawals of the year")" \
        "SELECT r.kind AS \`$(t "Reason")\`, COALESCE(t.description, r.itype, ${unknown}) AS \`$(t "Item type")\`, COUNT(*) AS \`$(t "Volumes")\`, ROUND(SUM(COALESCE(r.price, 0)), 2) AS \`$(t "Replacement value")\` FROM ${p} JOIN (SELECT $(sql_quote "$(t "Lost")") AS kind, i.itemlost_on AS d, COALESCE(NULLIF(i.itype, ''), bi.itemtype) AS itype, i.replacementprice AS price FROM items i LEFT JOIN biblioitems bi ON bi.biblionumber = i.biblionumber WHERE i.itemlost <> 0 UNION ALL SELECT $(sql_quote "$(t "Withdrawn")"), i.withdrawn_on, COALESCE(NULLIF(i.itype, ''), bi.itemtype), i.replacementprice FROM items i LEFT JOIN biblioitems bi ON bi.biblionumber = i.biblionumber WHERE i.withdrawn <> 0 UNION ALL SELECT $(sql_quote "$(t "Damaged")"), i.damaged_on, COALESCE(NULLIF(i.itype, ''), bi.itemtype), i.replacementprice FROM items i LEFT JOIN biblioitems bi ON bi.biblionumber = i.biblionumber WHERE i.damaged <> 0 UNION ALL SELECT $(sql_quote "$(t "Deleted from the catalog (discarded)")"), d.timestamp, d.itype, d.replacementprice FROM deleteditems d) r ON $(_census_yr r.d) LEFT JOIN itemtypes t ON t.itemtype = r.itype GROUP BY 1, 2 ORDER BY 1, 2"
    _rp censo-age CAT "$(t "Census: age of the collection by knowledge area (obsolescence)")" \
        "SELECT ${area} AS \`$(t "Knowledge area (CDD)")\`, COUNT(*) AS \`$(t "Volumes")\`, SUM(YEAR(CURDATE()) - x.copyrightdate <= 5) AS \`$(t "Up to 5 years old")\`, SUM(YEAR(CURDATE()) - x.copyrightdate BETWEEN 6 AND 10) AS \`$(t "6 to 10 years old")\`, SUM(YEAR(CURDATE()) - x.copyrightdate > 10) AS \`$(t "Over 10 years old")\`, SUM(x.copyrightdate IS NULL) AS \`$(t "Year unknown")\`, ROUND(100 * SUM(YEAR(CURDATE()) - x.copyrightdate > 10) / COUNT(*), 1) AS \`$(t "Share over 10 years old (percent)")\` FROM ${ai} GROUP BY 1 ORDER BY 1"
    _rp censo-weeding CAT "$(t "Census: weeding candidates (published over 10 years ago, not borrowed in 5 years)")" \
        "SELECT x.barcode AS \`$(t "Barcode")\`, x.itemcallnumber AS \`$(t "Call number")\`, b.title AS \`$(t "Title")\`, b.author AS \`$(t "Author")\`, x.copyrightdate AS \`$(t "Year")\`, DATE(x.datelastborrowed) AS \`$(t "Last loan")\`, COALESCE(x.issues, 0) AS \`$(t "Loans")\`, x.homebranch AS \`$(t "Library")\` FROM ${ai} JOIN biblio b ON b.biblionumber = x.biblionumber WHERE x.copyrightdate < YEAR(CURDATE()) - 10 AND (x.datelastborrowed IS NULL OR x.datelastborrowed < DATE_SUB(CURDATE(), INTERVAL 5 YEAR)) ORDER BY x.itemcallnumber, b.title"
}

lt_br_census() {
    require_database || return 0
    local choice title
    title="$(t "Government census reports")"
    choice=$(ui_menu "$title" "$(t "Read-only SQL reports with the figures of the INEP School and Higher Education censuses, IBGE surveys, the SNBP registry and MEC evaluations. Koha asks for the census year when a report runs (Reports > Saved reports):")" \
        "1" "$(t "Install or update the pack")" \
