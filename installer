# ======================================================================
# 29. LIBRARY TOOLS
# ----------------------------------------------------------------------
# Day-to-day tasks for the library staff, done with Koha's own command-line
# tools run as the instance user (koha-shell). Everything that writes to the
# database goes through the same steps: the backup/restore lock, a dry run
# shown to the operator, an explicit confirmation, a verified PRE-* backup,
# and only then the real run. The tools never stop or restart Koha: a
# failure leaves the services as they were, and the PRE-* backup undoes any
# change (Restore database). Logs: ${TOOLS_LOG_DIR}.
# ======================================================================
TOOLS_LOG_DIR="${LOG_DIR}/tools"
KOHA_BIN="/usr/share/koha/bin"
PATRON_TEMPLATE="/root/koha_patrons_template.csv"
TOOLS_PRE=""

# Path of one of Koha's command-line scripts (Debian package layout).
koha_script() {
    local d
    for d in "$KOHA_BIN" "$KOHA_BIN/cronjobs" "$KOHA_BIN/maintenance" "$KOHA_BIN/migration_tools" "$KOHA_BIN/admin"; do
        [ -f "$d/$1" ] && { printf '%s' "$d/$1"; return 0; }
    done
    return 1
}

# Quotes one argument for koha-shell, which hands the command line to the
# instance user's shell wrapped in single quotes: a single quote or a line
# break can never get through safely, so such arguments are refused.
kq() {
    case "$1" in *\'*|*$'\n'*) return 1 ;; esac
    local s="$1"
    s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//\$/\\\$}; s=${s//\`/\\\`}
    printf '"%s"' "$s"
}

# koha_tool LOG SCRIPT [ARGS...]: runs a Koha script as the instance user
# (koha-shell), appending the command line and its output to LOG.
koha_tool() {
    local log="$1" name="$2" path
    shift 2
    if ! path=$(koha_script "$name"); then
        printf '%s: not found in %s\n' "$name" "$KOHA_BIN" >> "$log"
        return 127
    fi
    koha_exec "$log" "$name" "$path" "$@"
}

# koha_exec LOG LABEL PROGRAM [ARGS...]: runs PROGRAM as the instance user
# through koha-shell (Koha's environment and Perl libraries), every argument
# quoted with kq. The command line (under LABEL) and its output go to LOG.
koha_exec() {
    local log="$1" label="$2" cmd="" a q
    shift 2
    for a in "$@"; do
        q=$(kq "$a") || { printf 'refused argument: %s\n' "$a" >> "$log"; return 2; }
        cmd+="${cmd:+ }$q"
    done
    printf '$ %s %s\n' "$label" "${*:2}" >> "$log"
    log "tools: $label ${*:2}"
    ( cd "${TOOLS_WORK:-/tmp}" 2>/dev/null || cd /tmp || exit 1
      koha_ctl /usr/sbin/koha-shell "$INSTANCE" -c "$cmd" ) >> "$log" 2>&1 </dev/null
}

# koha_sql_run LOG FILE: runs an SQL file with Koha's own database account
# (koha-mysql, as the instance user through koha-shell). The files start a
# transaction, so a failure keeps nothing.
koha_sql_run() {
    local log="$1" sql="$2"
    printf '$ koha-mysql %s < %s\n' "$INSTANCE" "${sql##*/}" >> "$log"
    log "tools: koha-mysql < ${sql##*/}"
    ( cd "${TOOLS_WORK:-/tmp}" 2>/dev/null || cd /tmp || exit 1
      koha_ctl /usr/sbin/koha-shell "$INSTANCE" -c "/usr/sbin/koha-mysql $(kq "$INSTANCE")" ) < "$sql" >> "$log" 2>&1
}

# Output of the last command written to LOG by koha_tool.
tools_output() { awk '/^\$ /{ out = ""; next } { out = out $0 "\n" } END { printf "%s", out }' "$1"; }
# tools_num LOG LABEL: number after LABEL (at line start) in the last command's output.
tools_num() {
    tools_output "$1" | awk -v label="$2" 'index($0, label) == 1 {
        s = substr($0, length(label) + 1); if (match(s, /[0-9]+/)) v = substr(s, RSTART, RLENGTH)
    } END { print (v == "" ? 0 : v) }'
}
# tools_lead LOG TEXT: number of a "<N> TEXT" line in the last command's output.
tools_lead() {
    tools_output "$1" | awk -v text="$2" 'match($0, /^[0-9]+ /) && index($0, text) == RLENGTH + 1 {
        v = substr($0, 1, RLENGTH - 1)
    } END { print (v == "" ? 0 : v) }'
}

# Work folder for the files handed to Koha's scripts: only root and the
# instance user can read it (patron lists are personal data). Removed on exit.
tools_workdir() {
    if [ -z "$TOOLS_WORK" ] || [ ! -d "$TOOLS_WORK" ]; then
        TOOLS_WORK=$(mktemp -d /tmp/koha_tools.XXXXXX) || return 1
    fi
    chown "${INSTANCE}-koha:" "$TOOLS_WORK" 2>/dev/null || true
    chmod 700 "$TOOLS_WORK"
}
# tools_copy SRC NAME: copy of SRC in the work folder; prints its path.
tools_copy() {
    local dst="${TOOLS_WORK}/$2"
    [ "$1" -ef "$dst" ] || cp -f -- "$1" "$dst" 2>/dev/null || return 1
    chown "${INSTANCE}-koha:" "$dst" 2>/dev/null || true
    chmod 600 "$dst"
    printf '%s' "$dst"
}
# tools_log NAME: new log file (root only) for one run of a tool.
tools_log() {
    local f
    mkdir -p "$TOOLS_LOG_DIR" && chmod 700 "$TOOLS_LOG_DIR"
    f="${TOOLS_LOG_DIR}/$1-$(date +%Y%m%d-%H%M%S).log"
    : > "$f" && chmod 600 "$f"
    printf '%s' "$f"
}

# Runs a tool that writes to the database while holding the backup/restore
# lock: no nightly backup, restore or update can run in the middle of it.
tools_locked() {
    if ! backup_lock_acquire; then
        msg_error "" "$(t "Another backup or restore is already running.\nNothing was changed.")" 10 72
        return 1
    fi
    local rc=0
    tools_workdir && "$@" || rc=$?
    # The copies handed to Koha (patron lists are personal data) go at once.
    [ -d "$TOOLS_WORK" ] && find "$TOOLS_WORK" -mindepth 1 -delete 2>/dev/null
    backup_lock_release
    return "$rc"
}

# Verified PRE-<TAG> dump taken right before a tool writes (the caller holds
# the lock). Sets TOOLS_PRE; returns 1, with nothing changed, if it failed.
tools_safety_backup() {
    TOOLS_PRE="${DIR_SQL}/PRE-${1}_$(date +%Y-%m-%d_%Hh%M%S).sql.gz"
    display_explanation "Generating the backup..."
    CLEANUP_FILE="$TOOLS_PRE"
    if ! create_safety_backup "$TOOLS_PRE"; then
        CLEANUP_FILE=""; TOOLS_PRE=""
        msg_error "$(t "Safety backup failed")" "$(t 'The safety backup of the current database could not be created or validated (check the free space and ${DIR_SQL}).\n\nNothing was changed.')" 12 76
        return 1
    fi
    CLEANUP_FILE=""
    log "tools: safety backup $TOOLS_PRE"
    return 0
}

# Dialogs of the tools (the test battery replaces them).
ui_menu() {     # ui_menu TITLE TEXT TAG ITEM [TAG ITEM ...] -> chosen tag
    local title="$1" text="$2"
    shift 2
    whiptail --title "$title" --menu "$text" 0 0 0 "$@" 3>&1 1>&2 2>&3
}
ui_input() {    # ui_input TITLE TEXT [DEFAULT] -> typed text
    whiptail --title "$1" --inputbox "$2" 0 0 "${3:-}" 3>&1 1>&2 2>&3
}
ui_textbox() {  # ui_textbox TITLE FILE (scrollable)
    whiptail --title "$1" --scrolltext --textbox "$2" 0 0 3>&1 1>&2 2>&3 || true
}
ui_checklist() {  # ui_checklist TITLE TEXT TAG ITEM ON|OFF [...] -> chosen tags, one per line
    local title="$1" text="$2"
    shift 2
    whiptail --title "$title" --separate-output --checklist "$text" 0 0 0 "$@" 3>&1 1>&2 2>&3
}
# tools_pick TITLE TEXT SQL [TAG ITEM]: menu built from a "code<TAB>name" query.
tools_pick() {
    local items=() code name
    [ -n "${4:-}" ] && items+=("$4" "$5")
    while IFS=$'\t' read -r code name; do
        [ -n "$code" ] && items+=("$code" "${name:0:48}")
    done < <(run_sql "$3")
    [ ${#items[@]} -gt 0 ] || return 1
    ui_menu "$1" "$2" "${items[@]}"
}
valid_date() { [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && date -d "$1" >/dev/null 2>&1; }

# ----------------------------------------------------------------------
# 1. MARC import (stage_file.pl, then commit_file.pl) and its undo
# ----------------------------------------------------------------------
lt_marc_import() {
    require_database || return 0
    local file fmt enc="UTF-8" guess mode
    file=$(select_file "/root" "mrc marc iso xml" "$(t "Pick the MARC file (.mrc, .iso or .xml):")" "$(t "MARC file")") || return 0
    if [ ! -r "$file" ] || [ ! -s "$file" ]; then
        msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70
        return 1
    fi
    case "${file,,}" in
        *.xml)
            fmt="MARCXML"
            if ! grep -qE '<([A-Za-z0-9]+:)?record[ >]' "$file"; then
                msg_error "" "$(t "This is not a MARCXML file (no <record> element).\nNothing was changed.")" 10 70
                return 1
            fi ;;
        *)
            fmt="ISO2709"
            if ! [[ "$(head -c 5 "$file")" =~ ^[0-9]{5}$ ]]; then
                msg_error "" "$(t "This is not an ISO 2709 MARC file (it must start with the 5-digit record length).\nNothing was changed.")" 10 74
                return 1
            fi
            # Leader position 09: "a" = Unicode, blank = MARC-8 (offered first).
            local encs=("MARC-8" "MARC-8 (ANSEL)" "UTF-8" "Unicode" "ISO_8859-1" "Latin-1 / Windows")
            guess="MARC-8"
            if [ "$(head -c 10 "$file" | tail -c 1)" = "a" ]; then
                guess="UTF-8"
                encs=("UTF-8" "Unicode" "MARC-8" "MARC-8 (ANSEL)" "ISO_8859-1" "Latin-1 / Windows")
            fi
            enc=$(ui_menu "$(t "Character encoding")" "$(t 'Encoding of the records (the file says: ${guess}):')" "${encs[@]}") || return 0 ;;
    esac
    mode=$(ui_menu "$(t "Records already in the catalog")" "$(t "When an incoming record matches one in the catalog (ISBN and title):")" \
        "keep"    "$(t "Keep the catalog record, add only new items")" \
        "replace" "$(t "Replace the catalog record with the incoming one")" \
        "new"     "$(t "Do not compare: every record becomes a new title")") || return 0
    tools_locked _lt_marc_import_run "$file" "$fmt" "$enc" "$mode"
}

_lt_marc_import_run() {
    local file="$1" fmt="$2" enc="$3" mode="$4" log name work matcher batch valid added replaced items
    local args=()
    log=$(tools_log marc-import)
    name="${file##*/}"; name="${name//[^A-Za-z0-9._-]/_}"
    if ! work=$(tools_copy "$file" "$name"); then
        msg_error "" "$(t "The file could not be copied to the work folder.\nNothing was changed.")" 10 70
        return 1
    fi
    args=(--file "$work" --format "$fmt" --encoding "$enc" --add-items --comment "koha-easy-installer $(date +%F) ${name}")
    if [ "$mode" != "new" ]; then
        # A matcher id that does not exist selects stage_file.pl's built-in rule (ISBN + title).
        matcher=$(run_sql "SELECT COALESCE((SELECT matcher_id FROM ${DB_NAME}.marc_matchers WHERE code='ISBN' AND record_type='biblio' ORDER BY matcher_id LIMIT 1), (SELECT COALESCE(MAX(matcher_id), 0) + 1 FROM ${DB_NAME}.marc_matchers));")
        [[ "$matcher" =~ ^[0-9]+$ ]] || matcher=1
        args+=(--match "$matcher")
        [ "$mode" = "keep" ] && args+=(--no-replace)
    fi

    display_explanation "Preview (dry run): nothing is changed yet..."
    koha_tool "$log" stage_file.pl "${args[@]}"
    batch=$(tools_num "$log" "Batch number assigned:")
    valid=$(tools_num "$log" "Number of valid records:")
    if [ "$batch" = "0" ]; then
        ui_textbox "$(t "MARC import")" "$log"
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 11 76
        return 1
    fi
    if [ "$valid" = "0" ]; then
        ui_textbox "$(t "MARC import")" "$log"
        msg_error "" "$(t 'The file has no valid records. Nothing was added to the catalog.\n\nLog: ${log}')" 11 76
        return 1
    fi
    ui_textbox "$(t "Preview (dry run)")" "$log"
    if ! prompt_yes_no "$(t "MARC import")" "$(t 'Batch ${batch}: ${valid} valid record(s) staged.\n\nImport them into the catalog now? A verified backup is made first, and the import can be undone later (Library tools > Undo a MARC import).')" 14 74 defaultno; then
        msg_info "$(t "MARC import")" "$(t 'Nothing was added to the catalog. The staged batch ${batch} stays in Koha (Cataloging > Manage staged records).')" 10 74
        return 0
    fi
    tools_safety_backup IMPORT || return 1
    display_explanation "Applying the changes..."
    if ! koha_tool "$log" commit_file.pl --batch-number "$batch"; then
        ui_textbox "$(t "MARC import")" "$log"
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    added=$(tools_num "$log" "Number of new records added:")
    replaced=$(tools_num "$log" "Number of records replaced:")
    items=$(tools_num "$log" "Number of items added:")
    log "tools: MARC batch $batch imported (new=$added replaced=$replaced items=$items)"
    msg_ok "$(t '✔ Batch ${batch} imported.\n\nNew records: ${added}\nReplaced records: ${replaced}\nItems added: ${items}\n\nThe new titles are indexed automatically in a few minutes.\nSafety backup: ${TOOLS_PRE}\nLog: ${log}')" 16 76
}

lt_marc_undo() {
    require_database || return 0
    local items=() id when recs note batch
    while IFS=$'\t' read -r id when recs note; do
        [ -n "$id" ] && items+=("$id" "${when}  ${recs}  ${note:0:36}")
    done < <(run_sql "SELECT import_batch_id, DATE_FORMAT(upload_timestamp, '%Y-%m-%d %H:%i'), num_records, COALESCE(NULLIF(comments, ''), file_name, '') FROM ${DB_NAME}.import_batches WHERE import_status = 'imported' AND record_type = 'biblio' ORDER BY import_batch_id DESC LIMIT 30;")
    if [ ${#items[@]} -eq 0 ]; then
        msg_info "$(t "Undo a MARC import")" "$(t "There is no imported batch to undo.")" 9 70
        return 0
    fi
    batch=$(ui_menu "$(t "Undo a MARC import")" "$(t "Pick the batch to undo (date, records, file):")" "${items[@]}") || return 0
    [[ "$batch" =~ ^[0-9]+$ ]] || return 0
    tools_locked _lt_marc_undo_run "$batch"
}

_lt_marc_undo_run() {
    local batch="$1" log recs items deleted reverted gone errors
    log=$(tools_log marc-undo)
    recs=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.import_records WHERE import_batch_id = ${batch} AND status = 'imported';")
    items=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.import_items ii JOIN ${DB_NAME}.import_records ir ON ir.import_record_id = ii.import_record_id WHERE ir.import_batch_id = ${batch} AND ii.status = 'imported';")
    printf 'Preview: batch %s, imported records: %s, imported items: %s\n' "$batch" "${recs:-?}" "${items:-?}" >> "$log"
    prompt_yes_no "$(t "Undo a MARC import")" "$(t 'Batch ${batch}: ${recs} record(s) and ${items} item(s) were imported.\n\nUndo it? New records and their items are deleted; replaced records get their previous version back. A verified backup is made first.')" 14 74 defaultno || return 0
    tools_safety_backup UNDO-IMPORT || return 1
    display_explanation "Applying the changes..."
    if ! koha_tool "$log" commit_file.pl --revert --batch-number "$batch"; then
        ui_textbox "$(t "Undo a MARC import")" "$log"
        msg_error "" "$(t 'The operation failed. The safety backup can bring the database back (Restore database): ${TOOLS_PRE}\n\nLog: ${log}')" 12 76
        return 1
    fi
    deleted=$(tools_num "$log" "Number of records deleted:")
    reverted=$(tools_num "$log" "Number of records reverted:")
    gone=$(tools_num "$log" "Number of items deleted:")
    errors=$(tools_num "$log" "Number of errors:")
    log "tools: MARC batch $batch reverted (deleted=$deleted reverted=$reverted items=$gone errors=$errors)"
    msg_ok "$(t '✔ Batch ${batch} undone.\n\nRecords deleted: ${deleted}\nRecords restored to their previous version: ${reverted}\nItems deleted: ${gone}\nErrors (e.g. items on loan): ${errors}\n\nSafety backup: ${TOOLS_PRE}\nLog: ${log}')" 16 76
}

# ----------------------------------------------------------------------
# 2. Essential SQL reports pack (read-only SELECTs in Koha's saved reports)
# ----------------------------------------------------------------------
# Each report carries "[koha-easy-installer:<key>]" in its notes: installing
# again updates the same reports (same ids, so bookmarks keep working), and
# removing the pack deletes only these.
REPORTS_TAG="koha-easy-installer"
_rp() { RP_KEY+=("$1"); RP_GROUP+=("$2"); RP_NAME+=("$3"); RP_SQL+=("$4"); }
reports_define() {
    RP_KEY=(); RP_GROUP=(); RP_NAME=(); RP_SQL=()
    _rp top-loans CIRC "$(t "Most borrowed titles (last 12 months)")" \
        "SELECT b.biblionumber AS \`$(t "Record")\`, b.title AS \`$(t "Title")\`, b.author AS \`$(t "Author")\`, COUNT(*) AS \`$(t "Loans")\` FROM statistics s JOIN items i ON i.itemnumber = s.itemnumber JOIN biblio b ON b.biblionumber = i.biblionumber WHERE s.type = 'issue' AND s.datetime >= DATE_SUB(CURDATE(), INTERVAL 12 MONTH) GROUP BY b.biblionumber, b.title, b.author ORDER BY COUNT(*) DESC LIMIT 100"
    _rp overdue CIRC "$(t "Overdue loans with patron contacts")" \
        "SELECT p.cardnumber AS \`$(t "Card number")\`, CONCAT_WS(', ', p.surname, p.firstname) AS \`$(t "Patron")\`, p.email AS \`$(t "E-mail")\`, p.phone AS \`$(t "Phone")\`, b.title AS \`$(t "Title")\`, i.barcode AS \`$(t "Barcode")\`, DATE(c.date_due) AS \`$(t "Due date")\`, DATEDIFF(CURDATE(), c.date_due) AS \`$(t "Days overdue")\`, c.branchcode AS \`$(t "Library")\` FROM issues c JOIN borrowers p ON p.borrowernumber = c.borrowernumber JOIN items i ON i.itemnumber = c.itemnumber JOIN biblio b ON b.biblionumber = i.biblionumber WHERE c.date_due < NOW() ORDER BY c.date_due"
    _rp never-borrowed CAT "$(t "Items never borrowed (acquired over 2 years ago)")" \
        "SELECT i.barcode AS \`$(t "Barcode")\`, i.itemcallnumber AS \`$(t "Call number")\`, b.title AS \`$(t "Title")\`, b.author AS \`$(t "Author")\`, i.dateaccessioned AS \`$(t "Acquired")\`, i.homebranch AS \`$(t "Library")\` FROM items i JOIN biblio b ON b.biblionumber = i.biblionumber WHERE COALESCE(i.issues, 0) = 0 AND i.dateaccessioned < DATE_SUB(CURDATE(), INTERVAL 2 YEAR) ORDER BY i.dateaccessioned"
    _rp new-items CAT "$(t "New acquisitions (last 30 days)")" \
        "SELECT i.dateaccessioned AS \`$(t "Acquired")\`, i.barcode AS \`$(t "Barcode")\`, i.itemcallnumber AS \`$(t "Call number")\`, b.title AS \`$(t "Title")\`, b.author AS \`$(t "Author")\`, i.homebranch AS \`$(t "Library")\` FROM items i JOIN biblio b ON b.biblionumber = i.biblionumber WHERE i.dateaccessioned >= DATE_SUB(CURDATE(), INTERVAL 30 DAY) ORDER BY i.dateaccessioned DESC"
    _rp expiring PAT "$(t "Patron accounts expiring in the next 30 days")" \
        "SELECT cardnumber AS \`$(t "Card number")\`, CONCAT_WS(', ', surname, firstname) AS \`$(t "Patron")\`, categorycode AS \`$(t "Category")\`, branchcode AS \`$(t "Library")\`, email AS \`$(t "E-mail")\`, dateexpiry AS \`$(t "Expires")\` FROM borrowers WHERE dateexpiry BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL 30 DAY) ORDER BY dateexpiry"
    _rp loans-month CIRC "$(t "Loans per month and library (last 12 months)")" \
        "SELECT DATE_FORMAT(s.datetime, '%Y-%m') AS \`$(t "Month")\`, s.branch AS \`$(t "Library")\`, COUNT(*) AS \`$(t "Loans")\` FROM statistics s WHERE s.type = 'issue' AND s.datetime >= DATE_SUB(CURDATE(), INTERVAL 12 MONTH) GROUP BY DATE_FORMAT(s.datetime, '%Y-%m'), s.branch ORDER BY 1, 2"
    _rp missing-data CAT "$(t "Items without barcode or call number")" \
        "SELECT b.biblionumber AS \`$(t "Record")\`, b.title AS \`$(t "Title")\`, i.barcode AS \`$(t "Barcode")\`, i.itemcallnumber AS \`$(t "Call number")\`, i.homebranch AS \`$(t "Library")\` FROM items i JOIN biblio b ON b.biblionumber = i.biblionumber WHERE COALESCE(i.barcode, '') = '' OR COALESCE(i.itemcallnumber, '') = '' ORDER BY b.title"
    _rp lost-items CAT "$(t "Lost items")" \
        "SELECT i.barcode AS \`$(t "Barcode")\`, b.title AS \`$(t "Title")\`, i.itemcallnumber AS \`$(t "Call number")\`, COALESCE(av.lib, i.itemlost) AS \`$(t "Status")\`, i.itemlost_on AS \`$(t "Since")\`, i.homebranch AS \`$(t "Library")\` FROM items i JOIN biblio b ON b.biblionumber = i.biblionumber LEFT JOIN authorised_values av ON av.category = 'LOST' AND av.authorised_value = i.itemlost WHERE i.itemlost <> 0 ORDER BY i.itemlost_on DESC"
}

# SQL string literal.
sql_quote() { local s="${1//\\/\\\\}"; s="${s//\'/\\\'}"; printf "'%s'" "$s"; }

lt_reports() {
    require_database || return 0
    local choice
    choice=$(ui_menu "$(t "Essential reports pack")" "$(t "Read-only SQL reports for Koha (Reports > Saved reports):")" \
        "1" "$(t "Install or update the pack")" \
        "2" "$(t "Remove the pack")") || return 0
    case "$choice" in
        1) tools_locked _lt_reports_install ;;
        2) tools_locked _lt_reports_remove ;;
    esac
}

_lt_reports_install() {
    local i key mark state log script ok=0 created=0 updated=0 notes
    reports_define
    log=$(tools_log reports)
    script="${TOOLS_WORK}/reports.sql"
    printf 'START TRANSACTION;\nSET @owner := (SELECT borrowernumber FROM borrowers WHERE flags %% 2 = 1 ORDER BY borrowernumber LIMIT 1);\n' > "$script"
    # Dry run: every query must compile against this Koha's schema (EXPLAIN runs nothing).
    for i in "${!RP_KEY[@]}"; do
        key="${RP_KEY[i]}"; mark="[${REPORTS_TAG}:${key}]"
        if ! mysql --default-character-set=utf8mb4 "$DB_NAME" -e "EXPLAIN ${RP_SQL[i]}" >/dev/null 2>> "$log"; then
            printf '⚠ %s — %s\n' "${RP_NAME[i]}" "$(t "skipped: not compatible with this Koha version")" >> "$log"
            continue
        fi
        if [ "$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.saved_sql WHERE LOCATE($(sql_quote "$mark"), notes) > 0;")" = "0" ]; then
            state="$(t "new")"; created=$((created + 1))
        else
            state="$(t "update")"; updated=$((updated + 1))
        fi
        printf '● %s — %s\n' "${RP_NAME[i]}" "$state" >> "$log"
        ok=$((ok + 1))
        notes="$(t "Read-only report installed by Koha Easy Installer.") ${mark}"
        {
            printf 'UPDATE saved_sql SET report_name = %s, savedsql = %s, notes = %s, report_group = %s, last_modified = NOW() WHERE LOCATE(%s, notes) > 0;\n' \
                "$(sql_quote "${RP_NAME[i]}")" "$(sql_quote "${RP_SQL[i]}")" "$(sql_quote "$notes")" "$(sql_quote "${RP_GROUP[i]}")" "$(sql_quote "$mark")"
            printf 'INSERT INTO saved_sql (borrowernumber, date_created, last_modified, savedsql, report_name, type, notes, cache_expiry, public, report_group) SELECT @owner, NOW(), NOW(), %s, %s, %s, %s, 300, 0, %s FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM saved_sql WHERE LOCATE(%s, notes) > 0);\n' \
                "$(sql_quote "${RP_SQL[i]}")" "$(sql_quote "${RP_NAME[i]}")" "'1'" "$(sql_quote "$notes")" "$(sql_quote "${RP_GROUP[i]}")" "$(sql_quote "$mark")"
        } >> "$script"
    done
    printf 'COMMIT;\n' >> "$script"
    if [ "$ok" -eq 0 ]; then
        ui_textbox "$(t "Essential reports pack")" "$log"
        msg_error "" "$(t 'None of the reports is compatible with this Koha version. Nothing was changed.\n\nLog: ${log}')" 11 74
        return 1
    fi
    { printf '\n'; grep -E '^(●|⚠) ' "$log"; } > "${TOOLS_WORK}/preview.txt"
    ui_textbox "$(t "Preview (dry run)")" "${TOOLS_WORK}/preview.txt"
    prompt_yes_no "$(t "Essential reports pack")" "$(t 'New reports: ${created}\nReports to update: ${updated}\n\nInstall them now? A verified backup is made first.')" 12 70 defaultno || return 0
    tools_safety_backup REPORTS || return 1
    if ! mysql --default-character-set=utf8mb4 "$DB_NAME" < "$script" >> "$log" 2>&1; then
        msg_error "" "$(t 'The reports could not be saved (no change was kept).\n\nLog: ${log}')" 11 74
        return 1
    fi
    log "tools: reports pack installed (new=$created updated=$updated)"
    msg_ok "$(t '✔ Reports installed: ${ok}\n\nIn Koha: Reports > Saved reports.\nSafety backup: ${TOOLS_PRE}')" 12 74
}

_lt_reports_remove() {
    local n log mark_all="[${REPORTS_TAG}:"
    log=$(tools_log reports)
    n=$(run_sql "SELECT COUNT(*) FROM ${DB_NAME}.saved_sql WHERE LOCATE($(sql_quote "$mark_all"), notes) > 0;")
    if [ "${n:-0}" = "0" ]; then
        msg_info "$(t "Essential reports pack")" "$(t "The pack is not installed. Nothing was changed.")" 9 70
        return 0
    fi
    run_sql "SELECT CONCAT('● ', report_name) FROM ${DB_NAME}.saved_sql WHERE LOCATE($(sql_quote "$mark_all"), notes) > 0 ORDER BY id;" > "${TOOLS_WORK}/preview.txt"
    cat "${TOOLS_WORK}/preview.txt" >> "$log"
    ui_textbox "$(t "Preview (dry run)")" "${TOOLS_WORK}/preview.txt"
    prompt_yes_no "$(t "Essential reports pack")" "$(t 'Remove the ${n} report(s) of the pack? Other saved reports are not touched. A verified backup is made first.')" 11 72 defaultno || return 0
    tools_safety_backup REPORTS || return 1
    if ! run_sql "DELETE FROM ${DB_NAME}.saved_sql WHERE LOCATE($(sql_quote "$mark_all"), notes) > 0;" >/dev/null; then
        msg_error "" "$(t 'The reports could not be removed.\n\nLog: ${log}')" 10 72
        return 1
    fi
    log "tools: reports pack removed ($n)"
    msg_ok "$(t '✔ Reports removed: ${n}')" 8 60
}

# ----------------------------------------------------------------------
# 3. Patrons: CSV import (import_patrons.pl) and school-year category
#    turnover (update_patrons_category.pl). Both have a native dry run.
# ----------------------------------------------------------------------
lt_patron_import() {
    require_database || return 0
    local file header match branch cat over="no"
    [ -e "$PATRON_TEMPLATE" ] || { printf '%s\n' 'cardnumber,surname,firstname,dateofbirth,email,phone,branchcode,categorycode,dateexpiry,userid' > "$PATRON_TEMPLATE"; chmod 600 "$PATRON_TEMPLATE"; }
    msg_info "$(t "Import patrons")" "$(t 'The first line of the CSV names Koha patron columns, separated by commas:\n  cardnumber,surname,firstname,dateofbirth,email,phone,branchcode,categorycode,dateexpiry,userid\n\nSave it as "CSV UTF-8". Empty template: ${PATRON_TEMPLATE}\nLibrary and category are asked next for the lines that leave them empty.')" 16 76
    file=$(select_file "/root" "csv" "$(t "Pick the patron file (.csv):")" "$(t "CSV file")") || return 0
    if [ ! -r "$file" ] || [ ! -s "$file" ]; then
        msg_error "" "$(t "The file is empty or cannot be read.\nNothing was changed.")" 10 70
        return 1
    fi
    if ! iconv -f UTF-8 -t UTF-8 "$file" >/dev/null 2>&1; then
        msg_error "" "$(t 'The file is not UTF-8. Save it again as "CSV UTF-8" and try again.\nNothing was changed.')" 10 74
        return 1
    fi
    header=$(head -n 1 "$file" | tr -d '\r" ' | tr '[:upper:]' '[:lower:]')
    if [[ "$header" == *";"* && "$header" != *","* ]]; then
        msg_error "" "$(t "The columns are separated by semicolons (;). Koha needs commas (,): save the file again as CSV with commas.\nNothing was changed.")" 11 74
        return 1
    fi
    if [[ ",${header}," == *",cardnumber,"* ]]; then match="cardnumber"
    elif [[ ",${header}," == *",userid,"* ]]; then match="userid"
    else match=""
    fi
    if [ -z "$match" ] || [[ ",${header}," != *",surname,"* ]]; then
        msg_error "" "$(t "The first line must name the columns and include surname and cardnumber (or userid).\nNothing was changed.")" 11 74
        return 1
    fi
    branch=$(tools_pick "$(t "Import patrons")" "$(t "Library for the lines without branchcode:")" "SELECT branchcode, branchname FROM ${DB_NAME}.branches ORDER BY branchname;") || return 0
    cat=$(tools_pick "$(t "Import patrons")" "$(t "Category for the lines without categorycode:")" "SELECT categorycode, description FROM ${DB_NAME}.categories ORDER BY description;") || return 0
    prompt_yes_no "$(t "Import patrons")" "$(t 'Update the patrons that are already registered (same ${match})?\n\nNo = keep them as they are and import only the new ones.')" 11 72 defaultno && over="yes"
    tools_locked _lt_patron_import_run "$file" "$match" "$branch" "$cat" "$over"
}

_lt_patron_import_run() {
    local file="$1" match="$2" branch="$3" cat="$4" over="$5" log work n_new n_upd n_skip n_bad
    local args=()
    log=$(tools_log patron-import)
    if ! work=$(tools_copy "$file" patrons.csv); then
        msg_error "" "$(t "The file could not be copied to the work folder.\nNothing was changed.")" 10 70
        return 1
    fi
    args=(--file "$work" --matchpoint "$match" --default "branchcode=${branch}" --default "categorycode=${cat}" -v -v)
    [ "$over" = "yes" ] && args+=(--overwrite)
    display_explanation "Preview (dry run): nothing is changed yet..."
    if ! koha_tool "$log" import_patrons.pl "${args[@]}"; then
        ui_textbox "$(t "Import patrons")" "$log"
        msg_error "" "$(t 'Koha could not complete the request. Nothing was changed.\n\nLog: ${log}')" 10 74
        return 1
    fi
    n_new=$(tools_num "$log" "Imported:"); n_upd=$(tools_num "$log" "Overwritten:")
    n_skip=$(tools_num "$log" "Skipped:"); n_bad=$(tools_num "$log" "Invalid:")
    ui_textbox "$(t "Preview (dry run)")" "$log"
    if [ $((n_new + n_upd)) -eq 0 ]; then
        msg_info "$(t "Import patrons")" "$(t 'Nothing to import: ${n_skip} already registered, ${n_bad} invalid line(s).\nNothing was changed.\n\nLog: ${log}')" 11 74
        return 0
    fi
    prompt_yes_no "$(t "Import patrons")" "$(t 'Dry run:\n  New patrons      : ${n_new}\n  Updated patrons  : ${n_upd}\n  Already registered: ${n_skip}\n  Invalid lines    : ${n_bad}\n\nImport now? A verified backup is made first.')" 15 70 defaultno || return 0
    tools_safety_backup PATRONS || return 1
    display_explanation "Applying the changes..."
    if ! koha_tool "$log" import_patrons.pl "${args[@]}" --confirm; then
